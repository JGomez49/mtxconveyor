// 2026-11-14: + rotation correction (MTX choice, see public/js/motorYield.js analyse()), per-run averages, MY vs MD plot.
// nameFn = the run-name function of render() so runs match the per-run table. Returns { m: Map interval -> slide result, runs }.
function myFor(nameFn){
  var m = new Map(), out = { m: m, runs: {} }; if(!MY_SV || !RES) return out;
  nameFn = nameFn || function(x){ return x.run || ''; };
  var mainIv = RES.intervals.filter(function(x){ return !x.leg || x.leg === 'Main'; });
  var runOf = function(md){ var c = mainIv.filter(function(x){ return x.from <= md && md <= x.to; }); return c.length ? (nameFn(c[c.length - 1]) || '') : ''; };
  var a = MotorYield.analyse(MY_SV, RES.intervals, runOf, { minRotLen: +$('myMinRot').value || 30, minSlid: $('myMinSlid').value === '' ? 3 : +$('myMinSlid').value, minPct: $('myMinPct').value === '' ? 20 : +$('myMinPct').value });
  RES.intervals.forEach(function(x, i){ if(a.slides[i]) m.set(x, a.slides[i]); }); out.runs = a.runs; return out;
}
// 2026-11-14: MY / MY corr cells with the quality rules: blank + reason (short / low %), greyed when noisy
function myCells(sl, o){
  if(!sl) return '</td><td>';
  if(!o) return '—</td><td>—';
  var tip = esc(o.reason || '') + (o.flag ? (o.reason ? ' · ' : '') + esc(o.flag) : ''), st = o.noisy ? ' style="color:var(--muted)"' : '';
  if(o.status !== 'ok') return '<span title="' + tip + ' (raw ' + fmt(o.myRaw, 1) + ')">≤</span></td><td title="' + tip + '">≤';
  return '<span' + st + ' title="' + tip + '">' + fmt(o.my, 2) + (o.noisy ? '*' : '') + '</span></td><td' + st + ' title="' + tip + '">' + (o.myCorr != null ? fmt(o.myCorr, 2) + (o.noisy ? '*' : '') : '—');
}
function myPlot(MY){
