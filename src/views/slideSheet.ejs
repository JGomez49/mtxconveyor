  pts.forEach(function(x){ var r = MY.m.get(x).run || '—'; if(runs.indexOf(r) < 0) runs.push(r); });
  var pal = ['#4da3ff', '#f5a623', '#2ecc71', '#ff5c5c', '#b37feb', '#36cfc9', '#ffd666', '#ff85c0', '#95de64', '#adc6ff'], tr = [];
  runs.forEach(function(r, i){ var p = pts.filter(function(x){ return (MY.m.get(x).run || '—') === r; }), c = pal[i % pal.length];
    var txt = p.map(function(x){ var o = MY.m.get(x); return esc(r) + ' · ' + fmt(L(x.from), 1) + '–' + fmt(L(x.to), 1) + ' · TF ' + fmt(x.tf, 0) + '°<br>MY ' + fmt(o.my, 2) + (o.myCorr != null ? ' · corrected ' + fmt(o.myCorr, 2) : '') + ' °/30 m'; });
    tr.push({ x: p.map(function(x){ return L((x.from + x.to) / 2); }), y: p.map(function(x){ return MY.m.get(x).my; }), mode: 'markers', name: r + ' — MY', legendgroup: r, marker: { size: 8, color: c, symbol: 'circle-open', line: { width: 2 } }, text: txt, hoverinfo: 'text' });
    var pc = p.filter(function(x){ return MY.m.get(x).myCorr != null; });
    if(pc.length) tr.push({ x: pc.map(function(x){ return L((x.from + x.to) / 2); }), y: pc.map(function(x){ return MY.m.get(x).myCorr; }), mode: 'markers', name: r + ' — MY corrected', legendgroup: r, marker: { size: 7, color: c }, hoverinfo: 'skip' });
  });
  Plotly.newPlot('myPlot', tr, { title: { text: 'Motor Yield along the well (open = MY, filled = rotation-corrected)', font: { size: 15 } }, paper_bgcolor: css('--panel'), plot_bgcolor: css('--panel'), font: { color: css('--text'), size: 13 },
