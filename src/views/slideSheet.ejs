    $('lasInfo').innerHTML = 'Saved slide sheet <b>' + esc(s.name) + '</b> (' + esc(s.wellKey) + ') — from ' + esc((s.las && s.las.file) || 'LAS') + ', ' + ((s.las && s.las.rows) || 0).toLocaleString() + ' rows. Load the LAS again to change the settings or segments.';
    $('btnRun').disabled = true; render(); renderCompare(); $('btnSsa').disabled = !SSA_VERS.length; $('btnXls').disabled = false; $('btnDD').disabled = false; $('btnSave').disabled = USER_ROLE === 'viewer';
  }catch(err){ alert('Could not load: ' + err.message); }
}
