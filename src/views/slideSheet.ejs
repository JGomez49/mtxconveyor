function exportExcel(){
  if(!RES) return;
  var runs = tdRuns(), u = UNIT === 'metric' ? 'm' : 'ft';
  var MY = myFor(function(x){ var r = runs.length && (!x.leg || x.leg === 'Main') ? runAt(runs, x.from) : null; return r ? (r.name || r.id) : (x.run || ''); }).m;   // 2026-11-14 Motor Yield
  var data = RES.intervals.map(function(x){ var o = {}, r = runs.length ? runAt(runs, x.from) : null;
    o['Leg'] = x.leg || 'Main'; o['Run'] = x.run || (r ? (r.name || r.id) : ''); o['Mode'] = x.mode === 'slide' ? 'Slide' : 'Rotate'; o['From (' + u + ')'] = +L(x.from).toFixed(2); o['To (' + u + ')'] = +L(x.to).toFixed(2); o['Length (' + u + ')'] = +L(x.len).toFixed(2);
    o['Toolface (deg)'] = x.mode === 'slide' ? +x.tf.toFixed(1) : ''; o['TF ref'] = x.tfRef; o['TF spread (deg)'] = x.mode === 'slide' ? +x.tfSd.toFixed(1) : '';
    o['ROP (' + u + '/h)'] = isFinite(x.rop) ? +L(x.rop).toFixed(1) : ''; o['Motor Yield (deg/30 m)'] = MY.has(x) && MY.get(x).my != null ? +MY.get(x).my.toFixed(2) : ''; o['MY status'] = MY.has(x) ? (MY.get(x).noisy ? 'noisy: ' : '') + (MY.get(x).reason || MY.get(x).status) : ''; o['MY rotation-corrected (deg/30 m, MTX choice)'] = MY.has(x) && MY.get(x).myCorr != null ? +MY.get(x).myCorr.toFixed(2) : ''; o['WOB'] = isFinite(x.wob) ? +x.wob.toFixed(1) : ''; o['Diff P'] = isFinite(x.difp) ? +x.difp.toFixed(0) : ''; o['RPM'] = isFinite(x.rpm) ? +x.rpm.toFixed(0) : '';
    o['Inc start'] = x.incStart; o['Inc end'] = x.incEnd; o['Az start'] = x.azStart; o['Az end'] = x.azEnd; o['Start'] = new Date(x.tStart * 1000).toISOString(); o['End'] = new Date(x.tEnd * 1000).toISOString(); return o; });
  var wb = XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(data), 'Slide sheet');
  XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet([Object.assign({ Well: LAS ? (LAS.well.WELL || '') : (SAVED && SAVED.las ? SAVED.las.well : ''), 'Segment roles': (ROLE || []).map(function(r, i){ return (i + 1) + ':' + r; }).join(', ') }, RES.opts, { exclude: undefined, legs: undefined })]), 'Settings');
  XLSX.writeFile(wb, 'SlideSheet_' + String((LAS && LAS.well.WELL) || $('ssName').value || 'EDR').replace(/[^a-z0-9\-_ ]/gi, '_') + '.xlsx');
}
