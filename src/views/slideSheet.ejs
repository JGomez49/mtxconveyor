    las: LAS ? { file: LASFILE, well: LAS.well.WELL || '', rig: LAS.well.RIG || '', rows: LAS.n, tStart: LAS.TIME[0], tEnd: LAS.TIME[LAS.n - 1] } : (SAVED ? SAVED.las : {}),
