    '<h2>6 · QC — predicted vs measured attitude at the next survey</h2>' + tb(['Interval (' + u + ')', 'Predicted Inc / Az', 'Measured Inc / Az', 'ΔInc (°)', 'ΔAz (°)'], r.qc.map(function(q){ return '<tr><td>' + fmt(L(q.from), 1) + '–' + fmt(L(q.to), 1) + '</td><td>' + fmt(q.predInc, 2) + ' / ' + fmt(q.predAz, 2) + '</td><td>' + fmt(q.measInc, 2) + ' / ' + fmt(q.measAz, 2) + '</td><td>' + fmt(q.dInc, 2) + '</td><td>' + fmt(q.dAz, 2) + '</td></tr>'; })) +
