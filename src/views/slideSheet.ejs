// slide footage belongs to the run drilling at that depth (same rule as the T&D Hookload: deepest start wins)
function runAt(runs, md){ var c = runs.filter(function(r){ return r.from <= md && md <= r.to; }); return c.length ? c[c.length - 1] : null; }

// ---------------- detection + rendering
function run(){
  if(!LAS) return;
  try{
    // 2026-11-13 (John): hole-depth segments. Usually a jump back in hole depth is an EDR error, sometimes another leg
    // (multilateral). Default on first build: a segment whose DRILLED depth range overlaps an earlier segment's is
    // "Ignore" when it made < 50 m of new hole (EDR glitch, e.g. FOXCK 495-507 m) and "Leg 2/3…" otherwise; the user
    // confirms or changes each one.
    if(!ROLE){
      var g0 = SlideSheetModel.detect(LAS, Object.assign(opts(), { exclude: [], legs: [] })).segments, nLeg = 1;
      // overlap is checked against EVERY other segment (FOXCK: the 12 m glitch comes BEFORE the real 495-3073 m segment)
      var ovl = function(g, h){ return g.drilledFrom != null && h.drilledFrom != null && g.drilledFrom < h.drilledTo - 1 && g.drilledTo > h.drilledFrom + 1; };
      ROLE = g0.map(function(g, i){
        if(g.drilledFrom == null) return 'Main';
        var others = g0.filter(function(h, j){ return j !== i && ovl(g, h); });
        if(!others.length) return 'Main';
        if(g.drilled < 50 && others.some(function(h){ return h.drilled > g.drilled; })) return 'Ignore';
        return g0.slice(0, i).some(function(h){ return ovl(g, h) && h.drilled >= 50; }) ? 'Leg ' + (++nLeg) : 'Main';
      });
    }
    RES = SlideSheetModel.detect(LAS, opts());
  }catch(err){ $('summary').innerHTML = '<span class="bad">' + esc(err.message) + '</span>'; return; }
  render(); renderCompare(); $('btnXls').disabled = false; $('btnDD').disabled = false; $('btnSave').disabled = !job.noteId || USER_ROLE === 'viewer'; $('btnSsa').disabled = !SSA_VERS.length;
}
function setRole(i, v){ ROLE[i] = v; run(); }
function render(){
  if(!RES) return;
  var u = UNIT === 'metric' ? ' m' : ' ft', runs = tdRuns();
  // segments: flag a segment whose depth range overlaps an earlier one (depth reset / other well / re-drill)
  var segs = RES.segments, flagged = 0;
  $('segBody').innerHTML = segs.map(function(g, i){
    var ov = g.drilledFrom != null && segs.slice(0, i).some(function(h){ return h.drilledFrom != null && g.drilledFrom < h.drilledTo - 1 && g.drilledTo > h.drilledFrom + 1; });
    var note = i === 0 ? '' : ov ? '<span class="warn">re-drills ' + fmt(L(g.drilledFrom), 1) + '–' + fmt(L(g.drilledTo), 1) + u + ' already drilled in an earlier segment — EDR error (Ignore) or another leg (Leg 2…)?</span>' : 'hole depth jumped back; drilling continues from ' + fmt(L(g.drilledFrom), 1) + u;
    if(ov) flagged++;
    var role = ROLE ? ROLE[i] : 'Main', ro = ['Main', 'Leg 2', 'Leg 3', 'Leg 4', 'Ignore'];
    return '<tr' + (role === 'Ignore' ? ' style="opacity:.55"' : '') + '><td><select ' + (LAS ? '' : 'disabled ') + 'onchange="setRole(' + i + ', this.value)" style="min-height:32px;padding:3px 6px">' + ro.map(function(o){ return '<option' + (o === role ? ' selected' : '') + '>' + o + '</option>'; }).join('') + '</select></td><td>' + (i + 1) + '</td><td>' + tstr(g.tStart) + '</td><td>' + tstr(g.tEnd) + '</td><td>' + fmt(L(g.drilledFrom), 1) + '</td><td>' + fmt(L(g.drilledTo), 1) + '</td><td>' + fmt(L(g.drilled), 1) + '</td><td style="text-align:left;white-space:normal">' + note + '</td></tr>';
  }).join('');
  $('segNote').style.display = segs.length > 1 ? '' : 'none';
  $('segNote').innerHTML = segs.length > 1 ? '<b>The hole depth jumps back ' + (segs.length - 1) + ' time(s) in this file.</b> On pad wells the EDR can carry another well\'s depth, or the depth is reset by hand. Usually that is an EDR error (set the segment to <b>Ignore</b>); on a multilateral well it can be another leg (<b>Leg 2…</b>, kept and reported separately). Defaults: of two segments that drill the same depths, the shorter one is set to Ignore if it made &lt; 50 m; if both are long, the later one becomes the next leg — please confirm' + (flagged ? ' (' + flagged + ' re-drill segment(s) here)' : '') + '. Example (FOXCK): a 12 m "slide" at 495–507 m existed only in a short segment after a reset.' : '';
  var S = RES.summary;
  $('summary').innerHTML = '<b>' + RES.slides.length + ' slides</b> · drilled ' + fmt(L(S.drilled), 1) + u + ' · slid ' + fmt(L(S.slid), 1) + u + ' (' + fmt(S.slidePct, 1) + ' %)' + (runs.length ? ' · grouped by T&amp;D runs of scenario "' + esc($('scenSel').value) + '"' : ' · load a job to group by BHA run');
  var multi = RES.intervals.some(function(x){ return x.leg && x.leg !== 'Main'; });
  // T&D runs are those of the selected well (main bore); other legs are listed without a run
  var name = function(x){ var r = runs.length && (!x.leg || x.leg === 'Main') ? runAt(runs, x.from) : null; return (multi ? (x.leg || 'Main') + ' · ' : '') + (r ? (r.name || r.id) : x.run ? x.run : (runs.length && (!x.leg || x.leg === 'Main') ? '—' : '')); };   // x.run = saved run name
  // per-run summary
  var groups = {}, order = [];
  var MY = myFor(name);   // 2026-11-14 Motor Yield (+ rotation correction, per-run averages)
  RES.intervals.forEach(function(x){ var k = name(x) || 'All'; if(!groups[k]){ groups[k] = { d:0, s:0, n:0, a:Infinity, b:-Infinity }; order.push(k); } var g = groups[k]; g.d += x.len; if(x.mode === 'slide'){ g.s += x.len; g.n++; } g.a = Math.min(g.a, x.from); g.b = Math.max(g.b, x.to); });
  $('runBody').innerHTML = order.map(function(k){ var g = groups[k]; return '<tr><td>' + esc(k) + '</td><td>' + fmt(L(g.a), 1) + ' – ' + fmt(L(g.b), 1) + '</td><td>' + fmt(L(g.d), 1) + '</td><td>' + fmt(L(g.s), 1) + '</td><td>' + fmt(L(g.d - g.s), 1) + '</td><td>' + fmt(g.d ? 100 * g.s / g.d : 0, 1) + '</td><td>' + g.n + '</td>' +
    (function(q){ return q ? '<td>' + (q.rotBuild == null ? '—' : fmt(q.rotBuild, 2) + ' / ' + (q.rotWalk == null ? '—' : fmt(q.rotWalk, 2))) + '</td><td>' + (q.myAvg == null ? '—' : fmt(q.myAvg, 2)) + '</td><td>' + (q.myCorrAvg == null ? '—' : fmt(q.myCorrAvg, 2)) + '</td>' : '<td>—</td><td>—</td><td>—</td>'; })(MY.runs[k === 'All' ? '' : k]) + '</tr>'; }).join('');
  var list = $('showRot').checked ? RES.intervals : RES.slides, k = 0;
  $('ivBody').innerHTML = list.map(function(x){
    var sl = x.mode === 'slide'; if(sl) k++;
    return '<tr class="' + x.mode + '"><td>' + (sl ? k : '') + '</td><td>' + esc(name(x)) + '</td><td><span class="tag ' + (sl ? 's' : 'r') + '">' + (sl ? 'SLIDE' : 'ROTATE') + '</span></td><td>' + fmt(L(x.from), 2) + '</td><td>' + fmt(L(x.to), 2) + '</td><td>' + fmt(L(x.len), 2) + '</td>' +
      '<td>' + (sl ? '<b>' + fmt(x.tf, 0) + '</b>' : '') + '</td><td>' + (sl ? x.tfRef : '') + '</td><td>' + (sl ? fmt(x.tfSd, 0) : '') + '</td><td>' + fmt(L(x.rop), 1) + '</td><td>' + myCells(sl, MY.m.get(x)) + '</td><td>' + fmt(x.wob, 1) + '</td><td>' + fmt(x.difp, 0) + '</td><td>' + fmt(x.rpm, 0) + '</td>' +
      '<td>' + fmt(x.incStart, 2) + ' → ' + fmt(x.incEnd, 2) + '</td><td>' + fmt(x.azStart, 1) + ' → ' + fmt(x.azEnd, 1) + '</td><td>' + tstr(x.tStart) + '</td></tr>';
  }).join('');
  plot(); myPlot(MY);
}
function css(v){ return getComputedStyle(document.body).getPropertyValue(v).trim(); }
