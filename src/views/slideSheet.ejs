    { title: { text: 'Slides along the well — measured toolface', font: { size: 15 } }, paper_bgcolor: css('--panel'), plot_bgcolor: css('--panel'), font: { color: css('--text'), size: 13 }, margin: { l: 60, r: 14, t: 40, b: 50 },
      xaxis: { title: 'Bit depth (' + (UNIT === 'metric' ? 'm' : 'ft') + ')', gridcolor: css('--border') }, yaxis: { title: 'Toolface (°)', range: [0, 360], dtick: 45, gridcolor: css('--border') }, legend: { orientation: 'h', y: -0.2 } },
