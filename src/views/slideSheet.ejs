// ---------------- DD sheet comparison
function loadDD(evt){
  var f = evt.target.files[0]; if(!f) return;
  var rd = new FileReader();
  rd.onload = function(e){
    try{
      var wb = XLSX.read(new Uint8Array(e.target.result), { type: 'array' });
      var rows = XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]], { header: 1, defval: '' });
      DD = SlideSheetModel.readDDSheet(rows); DD.file = f.name; renderCompare();
    }catch(err){ $('ddInfo').innerHTML = '<span class="bad">' + esc(err.message) + '</span>'; }
    evt.target.value = '';
  };
  rd.readAsArrayBuffer(f);
}
function renderCompare(){
  if(!DD || !RES) return;
  var C = SlideSheetModel.compare(RES.slides, DD.slides, Lm(+$('ddTol').value));
  var tot = function(a){ return a.reduce(function(s, x){ return s + (x.to - x.from); }, 0); };
  $('ddInfo').innerHTML = esc(DD.file) + ': ' + DD.slides.length + ' slides, ' + fmt(L(tot(DD.slides)), 1) + (UNIT === 'metric' ? ' m' : ' ft') + ' · EDR: ' + RES.slides.length + ' slides, ' + fmt(L(tot(RES.slides)), 1) +
    ' · <b>' + (DD.slides.length - C.ddMissing) + ' / ' + DD.slides.length + '</b> DD slides found in the EDR' + (C.edrOnly.length ? ' · <span class="warn">' + C.edrOnly.length + ' EDR slide(s) not on the DD sheet</span>' : '');
  var rows = C.rows.map(function(r){
    var q = r.dd, e = r.edr;
    if(!e.length) return '<tr><td>' + fmt(L(q.from), 1) + '</td><td>' + fmt(L(q.to), 1) + '</td><td>' + esc(q.set) + '</td><td colspan="6" class="bad" style="text-align:left">not found in the EDR</td></tr>';
    return e.map(function(x, j){ return '<tr><td>' + (j ? '' : fmt(L(q.from), 1)) + '</td><td>' + (j ? '' : fmt(L(q.to), 1)) + '</td><td>' + (j ? '' : esc(q.set)) + '</td><td>' + fmt(L(x.from), 1) + '</td><td>' + fmt(L(x.to), 1) + '</td><td>' + fmt(L(x.from - q.from), 1) + '</td><td>' + fmt(L(x.to - q.to), 1) + '</td><td><b>' + fmt(x.tf, 0) + '</b></td><td>' + x.tfRef + '</td></tr>'; }).join('');
  }).join('') + C.edrOnly.map(function(x){ return '<tr><td colspan="3" class="warn" style="text-align:left">not on the DD sheet</td><td>' + fmt(L(x.from), 1) + '</td><td>' + fmt(L(x.to), 1) + '</td><td></td><td></td><td><b>' + fmt(x.tf, 0) + '</b></td><td>' + x.tfRef + '</td></tr>'; }).join('');
  $('cmpBody').innerHTML = rows;
}
function Lm(v){ return UNIT === 'metric' ? v : v * FT; }


