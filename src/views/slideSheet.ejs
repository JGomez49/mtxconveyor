<!-- 2026-11-13 (John): "?" help — content cites books / papers only (no test results). -->
<div class="hp-modal" id="ssHelp" onclick="if(event.target===this)closeSsHelp()"><div class="hp-box"><div id="ssHelpBody"></div><p style="text-align:right;margin:12px 0 0"><button type="button" onclick="closeSsHelp()">Close</button></p></div></div>
<script>
var SS_REF = {
  ebook: 'ISCWSA, <i>Introduction to Wellbore Positioning</i> (eBook V9.10, 2017) — ch.8 pp. 57–58 (slide sheet analysis); ch.5 (MWD gravity / magnetic toolface switch); ch.7 (minimum curvature).',
  bourg: 'Bourgoyne, Millheim, Chenevert &amp; Young, <i>Applied Drilling Engineering</i>, SPE Textbook Series Vol. 2 (1986), Ch. 8 — dogleg angle, Eq. 8.33.',
  mardia: 'Mardia &amp; Jupp, <i>Directional Statistics</i>, Wiley (2000) — circular mean and circular standard deviation (not in the project folder).',
  las: 'Canadian Well Logging Society, <i>LAS Version 2.0</i> file standard — ~V / ~W / ~C / ~A sections, NULL value.'
};
var SS_HELP = {
  s1: ['1 · EDR data and job', 'Load the rig EDR as a LAS 2.0 file (1-second data). The header gives the well name, the depth unit and the NULL value; the curves used are hole depth, bit depth, rotary RPM, toolface and the drilling parameters. Choosing a job links the slide sheet to its wells, trajectories and T&amp;D runs, so slides can be split by BHA run and saved to the job.', ['las']],
  s2: ['2 · Detection settings', 'New hole is drilled when the hole depth increases with the bit on bottom. Over the RPM window a footage is a <b>slide</b> when the average RPM is about zero and the RPM never exceeds the rocking limit; otherwise it is <b>rotate</b>. The slide toolface is the circular mean of the measured toolface and its spread the circular standard deviation (an arithmetic mean is wrong across 0°/360°). Toolface is high-side (gravity) above the MWD switch inclination and magnetic below it. Hole-depth segments let you mark main bore, other legs or footage to ignore.', ['ebook','mardia']],
  s3: ['3 · Slide sheet', 'The slide sheet lists every slide and rotate interval: depth from/to, toolface and its reference, toolface spread, ROP, WOB and differential pressure, and the surveyed inclination / azimuth around it. It is the record the slide sheet analysis needs: where the BHA slid, how far and on which toolface.', ['ebook']],
  s4: ['4 · Compare with the DD slide sheet', 'Optional check of the EDR-built sheet against the directional driller\'s hand-written sheet: intervals are matched by depth overlap and differences in footage and toolface are listed.', ['ebook']],
  s5: ['5 · Survey correction — SSA', 'Per BHA run, the total curvature between the run\'s surveys (sum of minimum-curvature dogleg angles) divided by the slid length gives the dogleg capability of the assembly. Fill-in stations are added at the start and end of each slide: ΔInc = DLS·L·cos(TF), ΔAz = DLS·L·sin(TF)/sin(Inc). Minimum curvature is then run through the original and fill-in stations. Assumptions stated by the source: DLS constant over the run, all curvature generated while sliding, constant toolface during the slide — a rough guide to the likely TVD adjustment. Slides on magnetic toolface are not filled in (the formulas use high-side toolface). SSA is the last correction in the chain.', ['ebook','bourg']],
  plot: ['Slide sheet plot', 'Depth-based view of the intervals: slides coloured by toolface, rotate footage between them, with the surveyed inclination / azimuth for reference.', ['ebook']],
  ssaPlot: ['SSA plot', 'Change of position (TVD and lateral) at the measured stations between the original survey and the survey with fill-in stations.', ['ebook','bourg']]
};
function openSsHelp(k){ var h = SS_HELP[k]; if(!h) return;
  document.getElementById('ssHelpBody').innerHTML = '<h3>' + h[0] + '</h3><p>' + h[1] + '</p><div class="ref"><b>References</b><br>' + h[2].map(function(r){ return SS_REF[r]; }).join('<br>') + '</div>';
  document.getElementById('ssHelp').style.display = 'flex'; }
function closeSsHelp(){ document.getElementById('ssHelp').style.display = 'none'; }
(function(){
  function btn(k){ var b = document.createElement('button'); b.type = 'button'; b.className = 'pp-help'; b.textContent = '?'; b.title = 'Help'; b.onclick = function(e){ e.stopPropagation(); openSsHelp(k); }; return b; }
  document.querySelectorAll('.panel > h2').forEach(function(h){ var m = /^\s*(\d)\s*·/.exec(h.textContent); if(m && SS_HELP['s' + m[1]]) h.appendChild(btn('s' + m[1])); });
  ['plot','ssaPlot'].forEach(function(id){ var el = document.getElementById(id); if(!el) return; var w = document.createElement('div'); w.style.cssText = 'text-align:right;margin-top:6px'; w.appendChild(btn(id)); el.parentNode.insertBefore(w, el); });
  document.addEventListener('keydown', function(e){ if(e.key === 'Escape') closeSsHelp(); });
})();
</script>
