  if(!w || !job.noteId){ $('ssaVer').innerHTML = ''; $('btnSsa').disabled = true; return; }
  try{ var d = await (await fetch('/notes/surveyVersions?noteId=' + encodeURIComponent(job.noteId) + '&wellKey=' + encodeURIComponent(w.wellKey))).json(); if(d.ok) SSA_VERS = d.versions; }catch(e){}
  var nm = { stretch:'PipeStretch', sag:'SAG', shortcollar:'Short Collar', msa:'MSA', ssa:'SSA' };
  $('ssaVer').innerHTML = SSA_VERS.map(function(v, i){ var ch = (v.chain || []).map(function(c){ return nm[c.type] || c.tag; }).join(' → ');
    return '<option value="' + i + '">' + esc(v.original ? 'Original — ' + v.wellName : v.wellName + (ch ? ' — ' + ch : '')) + '</option>'; }).join('');
  $('btnSsa').disabled = !RES || !SSA_VERS.length;
}
async function ssaRun(){
  var v = SSA_VERS[+$('ssaVer').value]; if(!v || !RES){ alert('Load a job, pick a well and build or load the slide sheet first.'); return; }
  if((v.chain || []).some(function(c){ return c.type === 'ssa'; })){ alert('This version already has an SSA correction.'); return; }
  try{
    var d = await (await fetch('/notes/surveyVersion/' + v.id)).json(); if(!d.ok) throw new Error(d.error);
    var sv = d.version.survey.filter(function(s){ return !s.interp; });
    SSA_SRC = { version: v, survey: sv, chain: d.version.chain || [] };
    var runs = tdRuns(), ints = RES.intervals.map(function(x){ return Object.assign({}, x, { run: x.run || runNameOf(x, runs) }); });
    var r = SsaModel.compute(sv.map(function(s){ return { md: s.md, inc: s.inc, az: s.az }; }), ints, { minInc: +$('ssaMinInc').value });
    // positions: minimum curvature through measured stations, before and after adding the fill-ins (same tie)
    var tie = { tvd: 0, n: 0, e: 0 }, base = SagModel.minimumCurvature(sv.map(function(s){ return { md: s.md, inc: s.inc, az: s.az }; }), tie);
    var mg = SsaModel.merge(sv, r.fillIns), mc = SagModel.minimumCurvature(mg.map(function(m){ return { md: m.md, inc: m.inc, az: m.az }; }), tie);
    r.delta = []; mg.forEach(function(m, j){ if(!m.interp) r.delta.push({ md: m.md, dTvd: mc[j].tvd - base[m.idx].tvd, dN: mc[j].n - base[m.idx].n, dE: mc[j].e - base[m.idx].e }); });
    SSA = r; ssaRender();
    $('btnSsaSave').disabled = !r.fillIns.length || USER_ROLE === 'viewer'; $('btnSsaRep').disabled = false;
  }catch(err){ $('ssaInfo').innerHTML = '<span class="bad">' + esc(err.message) + '</span>'; }
}
function ssaRender(){
  if(!SSA) return; var u = UNIT === 'metric' ? ' m' : ' ft', r = SSA, last = r.delta[r.delta.length - 1] || {};
