      { x: r.delta.map(function(x){ return L(x.md); }), y: r.delta.map(function(x){ return L(x.dN); }), name: 'ΔN', mode: 'lines', line: { color: '#d98200', width: 2 } }, { x: r.delta.map(function(x){ return L(x.md); }), y: r.delta.map(function(x){ return L(x.dE); }), name: 'ΔE', mode: 'lines', line: { color: '#2e8b57', width: 2 } }],
