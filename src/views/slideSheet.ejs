<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Slide Sheet — MTX</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/plotly.js/2.32.0/plotly.min.js"></script>
<script src="/js/tdModel.js"></script>
<script src="/js/slideSheetModel.js"></script>
<script src="/js/sagModel.js"></script>
<script src="/js/ssaModel.js"></script>
<script src="/js/motorYield.js"></script><%# 2026-11-14 Motor Yield per slide %>
<script src="/js/chainReport.js"></script>
<style>
  /* 2026-11-13 (John): "?" help buttons — books and papers only, no test results. Same pattern as SAG / PipeStretch;
     the size override is needed because of the page-wide button padding. */
  .pp-help{padding:0!important;min-height:0!important;width:28px!important;height:28px!important;border-radius:50%!important;margin-left:8px;font-weight:700;vertical-align:middle;cursor:pointer;background:var(--panel2);color:var(--accent);border:1px solid var(--border);}
  .hp-modal{position:fixed;inset:0;background:rgba(0,0,0,.55);display:none;align-items:center;justify-content:center;z-index:9999;}
  .hp-modal .hp-box{background:var(--panel);color:var(--text);border:1px solid var(--border);border-radius:8px;max-width:760px;width:92%;max-height:84vh;overflow:auto;padding:18px 22px;font-size:14.5px;line-height:1.5;}
  .hp-modal h3{margin:0 0 10px;font-size:18px;} .hp-modal .ref{color:var(--muted);font-size:13px;border-top:1px solid var(--border);margin-top:12px;padding-top:8px;}
  /*
    Slide Sheet (ADDED 2026-11-13, John — step 1 of "survey correction by slide-sheet analysis").
    Builds the slide sheet from the rig EDR (Pason LAS, 1 s) instead of the directional driller's hand-written
    sheet. Engine + detection rules + validation notes: public/js/slideSheetModel.js and the project doc
    claude/slidesheet-edr-findings.md. Same layout / theme / sizes as PipeStretch (2026-11-11).
    Step 2 (later): survey correction from these slides (ISCWSA eBook pp. 57-58).
  */
  :root{ --bg:#0f1216; --panel:#171b21; --panel2:#1e232b; --border:#2a313c; --text:#e6e9ef; --muted:#8a93a3; --accent:#4da3ff; --good:#2ecc71; --bad:#ff5c5c; --warn:#f5a623; }
  *{box-sizing:border-box;}
  body{margin:0;font-family:-apple-system,Segoe UI,Roboto,Arial,sans-serif;background:var(--bg);color:var(--text);}
  header{padding:12px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;}
  header h1{font-size:22px;margin:0;font-weight:600;} header .sub{color:var(--muted);font-size:13.5px;}
  .wrap{padding:14px 18px 40px;}
  .panel{background:var(--panel);border:1px solid var(--border);border-radius:8px;padding:16px 18px;margin-bottom:16px;}
  .panel h2{font-size:17px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);margin:0 0 14px;}
  table{width:100%;border-collapse:collapse;font-size:14px;}
  th,td{border-bottom:1px solid var(--border);padding:7px 9px;text-align:right;white-space:nowrap;}
  th{color:var(--muted);font-weight:600;position:sticky;top:0;background:var(--panel2);} td:first-child,th:first-child{text-align:left;}
  input,select,button{background:var(--panel2);color:var(--text);border:1px solid var(--border);border-radius:5px;font-size:15px;padding:8px 11px;min-height:40px;}
  input[type=number]{width:110px;} input[type=checkbox]{min-height:0;width:auto;}
  button{cursor:pointer;} button.primary{background:var(--accent);border-color:var(--accent);color:#061325;font-weight:600;} button:disabled{opacity:.5;cursor:not-allowed;}
  .row{display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end;margin-bottom:12px;}
  .field{display:flex;flex-direction:column;gap:5px;font-size:13.5px;color:var(--text);white-space:nowrap;}
  .muted{color:var(--muted);font-size:14px;} .ok{color:var(--good);} .bad{color:var(--bad);} .warn{color:var(--warn);}
  .note{background:var(--panel2);border-left:3px solid var(--accent);padding:9px 12px;font-size:14px;color:var(--muted);margin:6px 0;line-height:1.5;}
  .scroll{max-height:560px;overflow:auto;border:1px solid var(--border);border-radius:6px;}
  .plot{height:420px;}
  #prog{height:8px;background:var(--panel2);border-radius:4px;overflow:hidden;width:260px;display:inline-block;vertical-align:middle;} #prog div{height:100%;width:0;background:var(--accent);}
  tr.slide td{color:var(--text);} tr.rotate td{color:var(--muted);}
  .tag{display:inline-block;padding:1px 8px;border-radius:10px;font-size:12px;font-weight:600;} .tag.s{background:rgba(245,166,35,.18);color:var(--warn);} .tag.r{background:rgba(77,163,255,.15);color:var(--accent);}
  body.light-mode{ --bg:#f0f4f8; --panel:#ffffff; --panel2:#f6f8fa; --border:#c8d4de; --text:#0a0d10; --muted:#454e57; --accent:#0a6fd6; --good:#14843f; --bad:#c62828; --warn:#a86400; }
  body.light-mode button.primary{color:#fff;}
  @media (max-width:768px){ .wrap{padding:8px 8px 30px;} .panel{padding:12px;} .row > .field{flex:1 1 45%;} .row > .field input,.row > .field select{width:100% !important;} .plot{height:320px;} }
</style>
</head>
<body>
<header>
  <div><h1>🧭 Slide Sheet</h1><div class="sub">Slides and rotations from the rig EDR (Pason LAS, 1 s) — measured depths and toolface</div></div>
  <div class="row" style="margin:0">
    <select id="unitSel" onchange="setUnit(this.value)"><option value="metric">Metric (m)</option><option value="imperial">Imperial (ft)</option></select>
    <input id="ssName" placeholder="Slide sheet name" style="width:190px">
    <button onclick="saveSheet()" id="btnSave" disabled title="Saves the slide sheet (not the LAS) to the job + well selected in panel 1">💾 Save to job</button>
    <select id="savedSel" style="width:240px"><option value="">— saved in this job —</option></select>
    <button onclick="openSaved()">Load</button><button onclick="delSaved()">Delete</button>
    <button onclick="exportExcel()" id="btnXls" disabled>⬇ Export slide sheet (Excel)</button>
  </div>
</header>
<div class="wrap">
  <div class="panel">
    <h2>1 · EDR data (Pason LAS) and job (optional)</h2>
    <div class="row">
      <label><button onclick="document.getElementById('lasFile').click()">⬆ Load LAS file</button>
        <input type="file" id="lasFile" accept=".las,.txt,.LAS" style="display:none" onchange="loadLas(event)"></label>
      <span id="prog"><div></div></span> <span id="lasInfo" class="muted"></span>
    </div>
    <div class="note">Use the <b>LAS export (1-second data)</b>. The 10-minute Drilling Mechanics CSV comes from the same EDR but cannot show slides — a slide lasts minutes, so one 10-minute sample mixes sliding and rotating.
      Needed curves: TIME, DEPT (hole depth), BDEP (bit depth), RPM, TF (Pason: gravity toolface, or 1000 + magnetic toolface); optional ROP, WOB, DIFP, INCL, AZ.</div>
    <div class="row">
      <div class="field"><span>MTX Job ID (optional — groups slides by T&amp;D BHA run)</span><input id="mtxId" placeholder="e.g. 1838" style="width:140px"></div>
      <button onclick="loadJob()">Load job</button>
      <div class="field"><span>Well / leg</span><select id="wellSel" style="width:260px" onchange="onWellChange()"></select></div>
      <div class="field"><span>T&amp;D scenario (runs)</span><select id="scenSel" style="width:200px" onchange="run()"></select></div>
    </div>
    <div id="jobStatus" class="muted"></div>
  </div>

  <div class="panel">
    <h2>2 · Detection settings</h2>
    <div class="row">
      <div class="field"><span>Bit on bottom: hole − bit depth &lt; (m)</span><input type="number" id="oBot" value="0.5" step="0.1"></div>
      <div class="field"><span>RPM window (s)</span><input type="number" id="oWin" value="61" step="1"></div>
      <div class="field"><span>Slide: |mean RPM| &lt;</span><input type="number" id="oMean" value="5" step="1"></div>
      <div class="field"><span>Slide: max |RPM| ≤ (rocking)</span><input type="number" id="oMax" value="20" step="1"></div>
      <div class="field"><span>Merge gap (m)</span><input type="number" id="oGap" value="1" step="0.1"></div>
      <div class="field"><span>Shortest slide (m)</span><input type="number" id="oMin" value="0.5" step="0.1"></div>
      <button class="primary" onclick="run()" id="btnRun" disabled>Build slide sheet</button>
      <button onclick="resetOpts()">Defaults</button>
    </div>
    <div class="note"><b>Rules</b> (every threshold can be changed):
      new hole = hole depth increasing with the bit on bottom; <b>slide</b> = over the RPM window the average RPM is ~0 and RPM never exceeds the rocking limit (top-drive rocking reads about ±10 RPM while sliding); otherwise <b>rotate</b>.
      Slide toolface = circular mean of the measured toolface while making hole; spread = circular standard deviation.</div>
    <h3 class="muted" style="font-size:15px;margin:14px 0 6px">Hole-depth segments</h3>
    <div class="note warnbox" id="segNote" style="display:none;border-left-color:var(--warn)"></div>
    <div class="scroll" style="max-height:240px"><table>
      <thead><tr><th>Segment is</th><th>#</th><th>From (time)</th><th>To (time)</th><th>Drilled from</th><th>Drilled to</th><th>New hole (<span class="uL">m</span>)</th><th>Note</th></tr></thead>
      <tbody id="segBody"><tr><td colspan="8" class="muted">Load a LAS file and press "Build slide sheet".</td></tr></tbody></table></div>
  </div>

  <div class="panel">
    <h2>3 · Slide sheet</h2>
    <div id="summary" class="muted"></div>
    <div class="scroll" style="max-height:220px;margin:8px 0"><table>
      <thead><tr><th>Run</th><th>Bit MD (<span class="uL">m</span>)</th><th>Drilled</th><th>Slid</th><th>Rotated</th><th>Slide %</th><th>Slides</th><th title="Rotary tendency from survey intervals of this run with no sliding (MTX choice — no published formula)">Rot build / walk (°/30 m)</th><th title="Sum of bracket curvature / sum of slid length, distinct survey brackets">MY avg (°/30 m)</th><th title="Same, after removing the rotary build/walk (MTX choice)">MY corr avg (°/30 m)</th></tr></thead>
      <tbody id="runBody"></tbody></table></div>
    <div class="row"><label class="field" style="flex-direction:row;align-items:center;gap:8px"><input type="checkbox" id="showRot" onchange="render()"> Show rotating intervals too</label></div>
    <div class="scroll"><table>
      <thead><tr><th>#</th><th>Run</th><th>Mode</th><th>From (<span class="uL">m</span>)</th><th>To (<span class="uL">m</span>)</th><th>Length</th><th>Toolface (°)</th><th>Ref</th><th>TF spread (°)</th>
        <th>ROP (<span class="uL">m</span>/h)</th><th title="Motor Yield = interval DLS × course length ÷ slid length between the surveys bracketing the slide (original well survey of the selected well; rotation assumed to add no curvature). Pason Slide Performance; ISCWSA eBook pp. 57-58.">MY (°/30 m)</th><th title="Motor Yield after removing the rotary build/walk of the run (MTX choice — no published formula; see public/js/motorYield.js). — = no rotate-only survey interval in the run (hover for reason).">MY corr (°/30 m)</th><th>WOB</th><th>Diff P</th><th>RPM</th><th>Inc start→end</th><th>Az start→end</th><th>Start (local)</th></tr></thead>
      <tbody id="ivBody"></tbody></table></div>
    <div id="plot" class="plot" style="margin-top:12px"></div>
    <%# 2026-11-14 (John): Motor Yield vs MD, coloured by run; rotation-correction setting %>
    <div class="row" style="margin-top:10px"><div class="field"><span>Min. rotate-only footage per run for the rotation correction (m)</span><input type="number" id="myMinRot" value="30" min="0" step="1" style="width:90px" onchange="render()"></div>
      <%# 2026-11-14 (John): per-slide quality rules (MTX choices) %>
      <div class="field"><span>MY: min. slid between surveys (m)</span><input type="number" id="myMinSlid" value="3" min="0" step="0.5" style="width:80px" onchange="render()"></div>
      <div class="field"><span>MY: min. slide % of survey interval</span><input type="number" id="myMinPct" value="20" min="0" max="100" step="1" style="width:80px" onchange="render()"></div>
      <span class="muted" style="font-size:12px">MY = interval DLS × CL ÷ slid (Pason; ISCWSA eBook pp. 57–58). Blank (≤) = too little slid for a per-slide MY (still counted in the run averages); <b>*</b> grey = survey noise &gt; 25 % of MY (±0.1° Inc per survey assumed). <b>MY corr</b> removes the run's rotary build/walk measured on survey intervals without sliding — <b>MTX choice, no published formula</b>.</span></div>
    <div id="myPlot" class="plot" style="margin-top:8px"></div>
  </div>

  <div class="panel">
    <h2>4 · Compare with the directional driller's slide sheet (optional)</h2>
    <div class="row">
      <label><button onclick="document.getElementById('ddFile').click()" id="btnDD" disabled>⬆ Load DD slide sheet (Excel)</button>
        <input type="file" id="ddFile" accept=".xlsx,.xls,.csv" style="display:none" onchange="loadDD(event)"></label>
      <div class="field"><span>Match tolerance (<span class="uL">m</span>)</span><input type="number" id="ddTol" value="2" step="0.5" onchange="renderCompare()"></div>
      <span id="ddInfo" class="muted"></span>
    </div>
    <div class="note">The sheet's "Slide From / To" columns are found automatically (the CNRL layout: Slide From | To | Meters | Set @). The DD sheet records the <b>intended</b> ("set") toolface; the EDR gives the <b>measured</b> one.</div>
    <div class="scroll"><table>
      <thead><tr><th>DD from</th><th>DD to</th><th>DD set TF</th><th>EDR from</th><th>EDR to</th><th>Δ from</th><th>Δ to</th><th>EDR toolface (°)</th><th>Ref</th></tr></thead>
      <tbody id="cmpBody"></tbody></table></div>
  </div>
  <!-- ADDED 2026-11-13 (John): survey correction by Slide Sheet Analysis (SSA), ISCWSA eBook pp. 57-58 (public/js/ssaModel.js) -->
  <div class="panel">
    <h2>5 · Survey correction — Slide Sheet Analysis (SSA)</h2>
    <div class="note"><b>ISCWSA eBook (2017) pp. 57–58.</b> Per BHA run, the dogleg capability = total curvature between the run's surveys ÷ footage slid (all curvature happens while sliding).
      Fill-in stations are added at the start and end of every slide: ΔInc = DLS × length × cos(toolface), ΔAz = DLS × length × sin(toolface) / sin(Inc); minimum curvature is then run through the original + fill-in stations.
      The eBook calls it "a rough guide to the likely TVD adjustment" (assumptions: constant DLS per run, curvature only while sliding, constant toolface per slide).
      Only the <b>Main</b> leg and <b>high-side (gravity) toolface</b> slides are used; magnetic-toolface slides (near vertical) are skipped and listed. SSA adds stations, so it must be the <b>last</b> correction of a chain.</div>
    <div class="row">
      <div class="field"><span>Survey version (start from)</span><select id="ssaVer" style="width:360px"></select></div>
      <div class="field"><span>Min. inclination for ΔAz (°)</span><input type="number" id="ssaMinInc" value="3" step="0.5"></div>
      <button class="primary" onclick="ssaRun()" id="btnSsa" disabled>Calculate SSA</button>
      <button onclick="ssaSave()" id="btnSsaSave" disabled>💾 Save as new version in job</button>
      <button onclick="ssaChainQc()" title="Combined QC report of the version selected here">📄 Chain QC report</button>
    </div>
    <div id="ssaInfo" class="muted"></div>
    <div id="ssaOut" style="display:none">
      <h3 class="muted" style="font-size:15px;margin:12px 0 6px">BHA runs — dogleg capability</h3>
      <div class="scroll" style="max-height:220px"><table><thead><tr><th>Run</th><th>Survey MD range (<span class="uL">m</span>)</th><th>Surveys</th><th>Total curvature (°)</th><th>Slid (<span class="uL">m</span>)</th><th>DLS (°/30 m)</th></tr></thead><tbody id="ssaRuns"></tbody></table></div>
      <div id="ssaPlot" class="plot" style="height:380px;margin-top:12px"></div>
      <h3 class="muted" style="font-size:15px;margin:12px 0 6px">Fill-in stations</h3>
      <div class="scroll" style="max-height:320px"><table><thead><tr><th>MD (<span class="uL">m</span>)</th><th>Inc (°)</th><th>Az (°)</th><th>At</th><th>Slide (<span class="uL">m</span>)</th><th>Toolface (°)</th><th>Run</th></tr></thead><tbody id="ssaFill"></tbody></table></div>
      <h3 class="muted" style="font-size:15px;margin:12px 0 6px">QC — attitude predicted at the next survey vs measured</h3>
      <div class="scroll" style="max-height:260px"><table><thead><tr><th>Survey interval (<span class="uL">m</span>)</th><th>Predicted Inc / Az</th><th>Measured Inc / Az</th><th>ΔInc (°)</th><th>ΔAz (°)</th></tr></thead><tbody id="ssaQc"></tbody></table></div>
      <div id="ssaSkip" class="muted" style="margin-top:8px"></div>
    </div>
  </div>
  <!-- 2026-11-14 (John): Technical report panel, same layout as SAGcorrection's panel 6 — the report header, summary and sign-off
       take these fields. -->
  <div class="panel">
    <h2>6 · Technical report</h2>
    <div class="row">
      <div class="field"><span>Well</span><input id="rpWell" style="width:240px"></div>
      <div class="field"><span>Job / MTX ID</span><input id="rpJob" style="width:140px"></div>
      <div class="field"><span>Run / section</span><input id="rpRun" style="width:140px"></div>
      <div class="field"><span>Prepared by</span><input id="rpBy" style="width:160px" value="<%= (user && user.name) || '' %>"></div>
      <div class="field"><span>Checked by</span><input id="rpChk" style="width:160px"></div>
      <div class="field"><span>Toolcode (corrected well)</span><input id="rpTool" style="width:160px" placeholder="e.g. MWD+HRGM+SSA"></div>
    </div>
    <div class="row">
      <div class="field" style="flex:1"><span>Comments (shown in the summary)</span><input id="rpNotes" style="width:100%"></div>
      <button class="primary" onclick="ssaReport()" id="btnSsaRep" disabled style="align-self:flex-end">📄 Build report (PDF)</button>
    </div>
    <div class="note">Needs the SSA calculation (panel 5). The report opens in a new tab — use <b>Print → Save as PDF</b> there (A4/Letter, headers and backgrounds on). Well and Job fill in from the loaded job when left empty.</div>
  </div>

</div>
<script>
var USER_ROLE = <%- JSON.stringify(user && user.role || '') %>;
var LASFILE = '', FT = 0.3048, UNIT = 'metric', LAS = null, RES = null, DD = null, job = { noteId:null, wells:[], td:null, mtxJobId:'' };
var EXCL = [], ROLE = null, SAVED = null;   // ROLE[i] = 'Main' | 'Leg 2' | 'Leg 3' | 'Leg 4' | 'Ignore' per hole-depth segment (2026-11-13)
function $(id){ return document.getElementById(id); }
function L(v){ return UNIT === 'metric' ? v : v / FT; }
function fmt(v, d){ return (v == null || !isFinite(v)) ? '—' : (+v).toFixed(d); }
function esc(t){ return String(t == null ? '' : t).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }
function tstr(t){ if(!isFinite(t)) return '—'; var d = new Date(t * 1000); return d.toLocaleDateString() + ' ' + d.toLocaleTimeString([], {hour:'2-digit', minute:'2-digit'}); }
function setUnit(u){ UNIT = u; document.querySelectorAll('.uL').forEach(function(e){ e.textContent = u === 'metric' ? 'm' : 'ft'; }); render(); renderCompare(); }
function opts(){ return { onBottomTol:+$('oBot').value, window:+$('oWin').value, slideMeanRpm:+$('oMean').value, slideMaxRpm:+$('oMax').value, mergeGap:+$('oGap').value, minSlide:+$('oMin').value,
  exclude: (ROLE || []).map(function(r, i){ return r === 'Ignore' ? i : -1; }).filter(function(i){ return i >= 0; }),
  legs: (ROLE || []).map(function(r){ return r === 'Ignore' ? 'Main' : r; }),
  breaks: (typeof tdRuns === 'function' ? tdRuns() : []).map(function(r){ return r.from; }) }; }   // split at T&D run starts
function resetOpts(){ var d = SlideSheetModel.DEFAULTS; $('oBot').value = d.onBottomTol; $('oWin').value = d.window; $('oMean').value = d.slideMeanRpm; $('oMax').value = d.slideMaxRpm; $('oGap').value = d.mergeGap; $('oMin').value = d.minSlide; }

// ---------------- LAS loading: streamed in 8 MB chunks (the test file is 228 MB / 1.07 M rows)
async function loadLas(evt){
  var f = evt.target.files[0]; if(!f) return;
  var p = new SlideSheetModel.LasParser(), dec = new TextDecoder(), CH = 8 << 20, t0 = Date.now();
  $('lasInfo').textContent = 'Reading ' + f.name + '…'; $('btnRun').disabled = true;
  try{
    for(var off = 0; off < f.size; off += CH){
      var buf = await f.slice(off, Math.min(off + CH, f.size)).arrayBuffer();
      p.push(dec.decode(buf, {stream: off + CH < f.size}));
      $('prog').firstChild.style.width = Math.min(100, 100 * (off + CH) / f.size) + '%';
      await new Promise(function(r){ setTimeout(r, 0); });
    }
    LAS = p.finish(); ROLE = null; RES = null; SAVED = null; LASFILE = f.name;
    var w = LAS.well;
    $('lasInfo').innerHTML = '<span class="ok">✔ ' + esc(w.WELL || f.name) + '</span> · ' + LAS.n.toLocaleString() + ' rows · ' + tstr(LAS.TIME[0]) + ' → ' + tstr(LAS.TIME[LAS.n - 1]) +
      (w.RIG ? ' · ' + esc(w.RIG) : '') + ' · ' + ((Date.now() - t0) / 1000).toFixed(1) + ' s' + (LAS.missing.length ? ' · <span class="warn">missing curves: ' + esc(LAS.missing.join(', ')) + '</span>' : '');
    $('btnRun').disabled = false; run();
  }catch(err){ $('lasInfo').innerHTML = '<span class="bad">' + esc(err.message) + '</span>'; }
  evt.target.value = '';
}

// ---------------- job + T&D runs (bit-MD ranges of the T&D modeler's BHA runs)
async function loadJob(){
  var id = $('mtxId').value.trim(); if(!id) return;
  $('jobStatus').textContent = 'Loading…';
  try{
    var r = await fetch('/notes/tdModel/lookupByMtxId/' + encodeURIComponent(id)), d = await r.json(); if(!r.ok) throw new Error(d.error || r.status);
    job = { noteId: d.noteId, mtxJobId: id, title: d.title, wells: (d.subjectWells || []).filter(function(w){ return !w.isVersion; }), td: await (await fetch('/notes/tdModel/' + d.noteId)).json() };
    $('wellSel').innerHTML = job.wells.map(function(w, i){ return '<option value="' + i + '">' + esc(w.wellKey) + '</option>'; }).join('');
    onWellChange();
    $('jobStatus').innerHTML = '<span class="ok">✔ ' + esc(d.title) + '</span> · ' + job.wells.length + ' subject well(s)' + (job.td ? '' : ' · no saved T&D model');
    refreshSaved(); $('btnSave').disabled = !RES || USER_ROLE === 'viewer';
  }catch(err){ $('jobStatus').innerHTML = '<span class="bad">' + esc(err.message) + '</span>'; }
}
function onWellChange(){
  var w = job.wells[+$('wellSel').value], td = job.td, opts = [];
  if(td && td.scenarios && w) Object.keys(td.scenarios).forEach(function(s){ var e = (td.scenarios[s].resultsByWell || {})[w.wellKey]; if(e && e.params && e.params.plan && (e.params.plan.runs || []).length) opts.push(s); });
  $('scenSel').innerHTML = opts.length ? opts.map(function(s){ return '<option' + (td.activeScenario === s ? ' selected' : '') + '>' + esc(s) + '</option>'; }).join('') : '<option value="">(no T&D runs for this well)</option>';
  if(LAS) run(); else render();
  ssaRefreshVersions(); myLoadSurvey();
}
// ---- Motor Yield (ADDED 2026-11-14, John) — engine + sources: public/js/motorYield.js
