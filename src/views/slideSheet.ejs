  try{ var d = await (await fetch('/notes/slideSheet/item/' + id)).json(); if(!d.ok) throw new Error(d.error);
    var s = d.sheet; SAVED = s; LAS = null; ROLE = s.roles || null;
    RES = { intervals: s.intervals, slides: s.intervals.filter(function(x){ return x.mode === 'slide'; }), summary: s.summary || {}, segments: s.segments || [], opts: s.settings || {} };
    var o = s.settings || {}; if(o.onBottomTol != null){ $('oBot').value = o.onBottomTol; $('oWin').value = o.window; $('oMean').value = o.slideMeanRpm; $('oMax').value = o.slideMaxRpm; $('oGap').value = o.mergeGap; $('oMin').value = o.minSlide; }
