    ' · max |ΔTVD| ' + fmt(L(Math.max.apply(null, r.delta.map(function(x){ return Math.abs(x.dTvd); }))), 3) + u;
  $('ssaRuns').innerHTML = r.runs.map(function(x){ return '<tr><td>' + esc(x.name) + '</td><td>' + (x.mdFrom == null ? '—' : fmt(L(x.mdFrom), 1) + ' – ' + fmt(L(x.mdTo), 1)) + '</td><td>' + x.surveys + '</td><td>' + fmt(x.curv, 2) + '</td><td>' + fmt(L(x.slid), 1) + '</td><td>' + (x.dls == null ? '<span class="muted">no slides — not used</span>' : '<b>' + fmt(x.dls * 30, 2) + '</b>') + '</td></tr>'; }).join('');
  $('ssaFill').innerHTML = r.fillIns.map(function(f){ return '<tr><td>' + fmt(L(f.md), 2) + '</td><td>' + fmt(f.inc, 2) + '</td><td>' + fmt(f.az, 2) + '</td><td>' + f.at + '</td><td>' + fmt(L(f.slide.from), 1) + '–' + fmt(L(f.slide.to), 1) + '</td><td>' + fmt(f.slide.tf, 0) + '</td><td>' + esc(f.slide.run) + '</td></tr>'; }).join('');
  $('ssaQc').innerHTML = r.qc.map(function(q){ var bad = Math.abs(q.dInc) > 2 || Math.abs(q.dAz) > 5; return '<tr' + (bad ? ' class="warn"' : '') + '><td>' + fmt(L(q.from), 1) + '–' + fmt(L(q.to), 1) + '</td><td>' + fmt(q.predInc, 2) + ' / ' + fmt(q.predAz, 2) + '</td><td>' + fmt(q.measInc, 2) + ' / ' + fmt(q.measAz, 2) + '</td><td>' + fmt(q.dInc, 2) + '</td><td>' + fmt(q.dAz, 2) + '</td></tr>'; }).join('');
  var why = {}; r.skipped.forEach(function(x){ why[x.why] = (why[x.why] || 0) + 1; });
  $('ssaSkip').innerHTML = r.skipped.length ? 'Skipped: ' + Object.keys(why).map(function(k){ return why[k] + ' × ' + esc(k); }).join(' · ') : '';
  if(window.Plotly) Plotly.newPlot('ssaPlot', [
      { x: r.delta.map(function(x){ return L(x.md); }), y: r.delta.map(function(x){ return L(x.dTvd); }), name: 'ΔTVD', mode: 'lines', line: { color: '#9467bd', width: 2 } },
      { x: r.delta.map(function(x){ return L(x.md); }), y: r.delta.map(function(x){ return L(x.dN); }), name: 'ΔN', mode: 'lines', line: { color: '#f5a623', width: 2 } },
      { x: r.delta.map(function(x){ return L(x.md); }), y: r.delta.map(function(x){ return L(x.dE); }), name: 'ΔE', mode: 'lines', line: { color: '#2ecc71', width: 2 } }],
    { title: { text: 'Position change at the measured stations (SSA − before)', font: { size: 15 } }, paper_bgcolor: css('--panel'), plot_bgcolor: css('--panel'), font: { color: css('--text'), size: 13 }, margin: { l: 60, r: 14, t: 40, b: 50 },
      xaxis: { title: 'MD' + u, gridcolor: css('--border') }, yaxis: { title: 'Change' + u, gridcolor: css('--border') }, legend: { orientation: 'h', y: -0.2 } }, { displaylogo: false, responsive: true });
}
