  var B = '#00539B', tb = function(h, rows){ return '<table><tr>' + h.map(function(x){ return '<th>' + x + '</th>'; }).join('') + '</tr>' + rows.join('') + '</table>'; };
  var css2 = 'body{font-family:Segoe UI,Arial,sans-serif;color:#111;margin:24px 30px;font-size:12px}h1{color:' + B + ';font-size:22px;margin:0}h2{color:' + B + ';font-size:16px;border-bottom:2px solid ' + B + ';padding-bottom:3px;margin-top:22px}table{border-collapse:collapse;width:100%;margin:6px 0}th,td{border:1px solid #ccc;padding:3px 6px;text-align:right}th{background:#eef3f9}td:first-child,th:first-child{text-align:left}.hdr{display:flex;justify-content:space-between;align-items:center;border-bottom:4px solid ' + B + ';padding-bottom:8px}@media print{.np{display:none}}';
  var chain = (SSA_SRC.chain || []).map(function(c){ return c.tag || c.type; });
  var h = '<!doctype html><html><head><meta charset="utf-8"><title>SSA report</title><style>' + css2 + '</style></head><body><div class="np"><button onclick="print()">🖨 Print / Save as PDF</button></div>' +
    '<div class="hdr"><div><h1>Survey Correction — Slide Sheet Analysis</h1><div>' + esc(rpVal('rpWell') || job.wells[+$('wellSel').value].wellKey) + ((rpVal('rpJob') || job.mtxJobId) ? ' · ' + esc(rpVal('rpJob') || ('MTX ' + job.mtxJobId)) : '') + (rpVal('rpRun') ? ' · ' + esc(rpVal('rpRun')) : '') + '</div></div><img src="https://res.cloudinary.com/metacortexjohn/image/upload/v1711167914/Canadian_Natural_logo_ygbbox.png" style="height:54px"></div>' +
    '<h2>1 · Summary</h2>' + tb(['Item', 'Value'], [['Starting survey version', esc(SSA_SRC.version.wellName)], ['Corrections before SSA', chain.length ? esc(['Original'].concat(chain).join(' → ')) : 'none (original survey)'], ['Slide sheet', esc(SAVED ? SAVED.name : ($('ssName').value || 'built from ' + LASFILE)) + ' — from the rig EDR'],
      ['Fill-in stations', r.fillIns.length + ' (from ' + r.slides + ' slides; ' + r.skipped.length + ' slide piece(s) skipped)'], ['At the last survey', 'ΔTVD ' + fmt(L(last.dTvd), 3) + ' ' + u + ' · ΔN ' + fmt(L(last.dN), 3) + ' · ΔE ' + fmt(L(last.dE), 3) + ' ' + u], ['Date', new Date().toISOString().slice(0, 10)]].concat(rpRows()).map(function(x){ return '<tr><td>' + x[0] + '</td><td style="text-align:left">' + x[1] + '</td></tr>'; })) +
    '<h2>2 · Method</h2><p>ISCWSA eBook V9.10 (2017), pp. 57–58: per BHA run the dogleg capability is the total curvature between the run\'s surveys (minimum curvature; Bourgoyne et al. Eq. 8.33) divided by the footage slid (all curvature is assumed to happen while sliding). Fill-in stations at the start and end of each slide: ΔInc = DLS × length × cos(toolface), ΔAz = DLS × length × sin(toolface) / sin(Inc). Minimum curvature through the original + fill-in stations. Assumptions (eBook): DLS unchanged during the run; curvature only while sliding; toolface constant during the slide — "a rough guide to the likely TVD adjustment". Slides and measured toolface from the rig EDR (Pason LAS); magnetic-toolface slides and legs other than Main are not used.</p>' +
    '<h2>3 · BHA runs</h2>' + tb(['Run', 'Survey MD range (' + u + ')', 'Surveys', 'Total curvature (°)', 'Slid (' + u + ')', 'DLS (°/30 m)'], r.runs.map(function(x){ return '<tr><td>' + esc(x.name) + '</td><td>' + (x.mdFrom == null ? '—' : fmt(L(x.mdFrom), 1) + '–' + fmt(L(x.mdTo), 1)) + '</td><td>' + x.surveys + '</td><td>' + fmt(x.curv, 2) + '</td><td>' + fmt(L(x.slid), 1) + '</td><td>' + (x.dls == null ? 'not used' : fmt(x.dls * 30, 2)) + '</td></tr>'; })) +
    '<h2>4 · Position change at the measured stations</h2>' + (img ? '<img src="' + img + '" style="width:100%">' : '') +
