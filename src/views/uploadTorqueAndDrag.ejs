        var c = d.case.inputData || {}, opts = [{ label: 'Case BHA (panel 2) — ' + (c.bhaRows || []).length + ' rows', rows: c.bhaRows || [] }];
        (c.runs || []).forEach(function (R) { opts.push({ label: 'Run "' + R.name + '" — bit MD ' + (+R.bitIn_m).toFixed(1) + '–' + (+R.bitOut_m).toFixed(1) + ' m — ' + (R.rows || []).length + ' rows', rows: R.rows || [] }); });
        sagPickData = { name: d.case.name, opts: opts };
        bs.innerHTML = opts.map(function (o, k) { return '<option value="' + k + '">' + String(o.label).replace(/</g, '&lt;') + '</option>'; }).join('');
