      <!-- SECTION 08: MODEL REFERENCES -->
      <div>
        <div class="sec-hdr" onclick="toggleSec(this)">
          <span class="sec-num">08</span><span class="sec-ttl">Model References</span><span class="sec-tog">v</span>
        </div>
        <div class="sec-body">
          <p class="hint" style="line-height:1.75">
            <strong>Soft-string T&amp;D:</strong> Johancsik, Friesen &amp; Dawson (1984), JPT 36(6), SPE-11380-PA;
            Sheppard, Wick &amp; Burgess (1987), SPE Drilling Eng. 2(4), SPE-15463-PA.<br>
            <strong>Sinusoidal buckling onset:</strong> Dawson &amp; Paslay (1984), JPT 36(10), SPE-11167-PA
            (F<sub>sin</sub> = 2&radic;(EIw&middot;sin&theta;/r<sub>c</sub>)); near-vertical (&lt;3&deg;):
            Lubinski (1950), API Drill. &amp; Prod. Practice (F &asymp; 1.94(EIw&sup2;)<sup>1/3</sup>).<br>
            <strong>Helical onset:</strong> Chen, Lin &amp; Cheatham (1990), JPT 42(2), SPE-19176-PA
            (&radic;2&times;F<sub>sin</sub>) or Wu &amp; Juvkam-Wold (1993), ASME JERT 115 (1.83&times;F<sub>sin</sub>)
            — selectable in Global Parameters.<br>
            <strong>Buckled wall contact:</strong> Mitchell (1986), SPE Drilling Eng. 1(6), SPE-13064-PA
            (N<sub>h</sub> = r<sub>c</sub>F&sup2;/4EI per unit length), applied where compression exceeds the
            helical limit; this drives slack-off lock-up.<br>
            <strong>Model limits:</strong> Mitchell &amp; Samuel (2009), SPE Drill. &amp; Compl. 24(1), SPE-105068-PA.
            <strong>Constants &amp; survey method:</strong> Mitchell &amp; Miska (2011), Fundamentals of Drilling
            Engineering, SPE Textbook Vol. 12 (E = 206.8 GPa); minimum curvature per Sawaryn &amp; Thorogood (2005),
            SPE-84246-PA.<br>
            <strong>Combined motion:</strong> when tripping with rotation, wall friction is resolved along the
            resultant sliding velocity — axial drag &times; v<sub>a</sub>/|v|, torque &times; v<sub>t</sub>/|v|,
            v<sub>t</sub> = &pi;&middot;OD&middot;RPM — per Samuel (2010), SPE-128059-MS and Mitchell &amp; Samuel
            (2009); sliding without rotation carries Torque at Bit to surface unchanged.<br>
            <strong>Display convention:</strong> side force normalized per WellPlan "Contact Force Normalization
            Length" (default 9.45 m = one Range 2 drill-pipe joint).
          </p>
        </div>
      </div>

      <!-- SECTION 09: WELLBORE SCHEMATIC -->
      <div class="sec">
        <div class="sec-hdr" onclick="toggleSec(this)">
          <span class="sec-num">09</span><span class="sec-ttl">Wellbore Schematic</span><span class="sec-tog">v</span>
        </div>
        <div class="sec-body">
          <div class="brow">
            <button class="btn btn-g" onclick="renderWellboreSchematic()">🖼 Generate / Refresh Schematic</button>
          </div>
          <div id="schematicWrap" style="overflow-x:auto;"></div>
          <p class="hint">The Full Wellbore panel is drawn to true measured-depth scale from the Casing (01) and
            Open Hole (05) sections above. The BHA panel (from section 04) uses equal-height rows for every
            component instead — a BHA mixes long drill pipe joints with short subs, and scaling rows by true
            length either crushes short components' labels together or wastes space on long ones — so true depth
            is still shown as text at each row, just not as the row's pixel height. Only the Bit renders as a
            real photo; every other component is a flat colored block, and each component type always gets the
            same color across every job (e.g. Drill Collar is always the same gray). Not a substitute for the
            official well schematic — a quick visual sanity check of what's currently entered before you run the
            model.</p>
        </div>
      </div>

    </div><!-- /inputs -->

  </div><!-- /app -->

  <div class="sbar">
    <div class="sdot" id="sdot"></div>
    <span id="smsg">Awaiting input — CNRL example loaded, click Run</span>
  </div>

  <script>
    // =============================================================
    // UNIT SYSTEM
    // Internal model always uses SI: m, N, N.m, kg/m3, kg/m
    // Display converts for imperial: ft, klbf, kft.lbf, ppg, lb/ft
    // =============================================================
    var UNIT = 'metric';
    var FT = 0.3048;
    var KN2KLBF = 0.224809;
    var NM2FTLBF = 0.737562;
    var KGM32PPG = 0.0083454;
    var KGM2LBFT = 0.67197;
    var G = 9.81;

    function normLenTxt() {
      var nl = (cachedPar && cachedPar.normLen) || (+document.getElementById('normLen').value) || 9.45;
      return 'kgf/' + nl + ' m';
    }

    function dU(t) {
      if (UNIT === 'metric') {
        if (t === 'depth') return 'm';
        if (t === 'force') return 'kDaN';
        if (t === 'torque') return 'N.m';
        if (t === 'sf') return normLenTxt();
      } else {
        if (t === 'depth') return 'ft';
        if (t === 'force') return 'klbf';
        if (t === 'torque') return 'kft.lbf';
        if (t === 'sf') return normLenTxt();
      }
      return '';
    }

    // =============================================================
    // THEME (dark/light) — persists via the same localStorage key used
    // site-wide, and rebuilds any already-computed charts in place (no
    // page reload) so in-progress survey/casing/BHA edits aren't lost.
    // =============================================================
    var TD_THEME_KEY = 'mtxThemePreference';
    function setTheme(mode) {
      var isLight = mode === 'light';
      document.body.classList.toggle('light-mode', isLight);
      localStorage.setItem(TD_THEME_KEY, isLight ? 'light' : 'dark');
      var darkBtn = document.getElementById('btnThemeDark'), lightBtn = document.getElementById('btnThemeLight');
      if(darkBtn) darkBtn.classList.toggle('active', !isLight);
      if(lightBtn) lightBtn.classList.toggle('active', isLight);
      // If a model has already been run, rebuild so the charts pick up the new colours.
      if(cachedSurv) runModel();
    }

    // =============================================================
    // PRESENTATION MODE — 2026-11-08 round 2: COMPACT removed at John's
    // request; <body class="present"> is now static, so large type is the
    // only view. (Round 1 had a PRESENT/COMPACT toggle saved in
    // localStorage 'mtxTdPresentation'; that key is no longer read.)
    //
    // LEGEND TOGGLE (added 2026-11-08 round 2): shows/hides the legend on
    // every Chart.js plot and the Plotly 3D view. Default: shown on PC,
    // hidden on phones (<=700px, same breakpoint as the phone CSS). Not
    // saved between sessions — the default depends on the device.
    // =============================================================
    var SHOW_LEGEND = !(window.matchMedia && window.matchMedia('(max-width: 700px)').matches);
    function setLegend(on) {
      SHOW_LEGEND = !!on;
      var a = document.getElementById('btnLegOn'), b = document.getElementById('btnLegOff');
      if (a) a.classList.toggle('active', SHOW_LEGEND);
      if (b) b.classList.toggle('active', !SHOW_LEGEND);
      CO = buildCO();
      // Update charts in place (no model re-run needed).
      Object.keys(charts || {}).forEach(function (k) {
        try { charts[k].options.plugins.legend.display = SHOW_LEGEND; charts[k].update('none'); } catch (e) { }
      });
      var p3 = document.getElementById('plotly3d');
      if (p3 && p3.data && typeof Plotly !== 'undefined') Plotly.relayout(p3, { showlegend: SHOW_LEGEND });
    }

    function setUnits(u) {
      if (PLAN && u !== UNIT) { planSyncTables(); planReadRuns(); planReadSections(); } // keep SI copy before switching
      setUnitsCore(u);
      if (PLAN) planRenderAll();
    }
    function setUnitsCore(u) {
      var prev = UNIT;
      UNIT = u;
      document.getElementById('btnMet').classList.toggle('active', u === 'metric');
      document.getElementById('btnImp').classList.toggle('active', u === 'imperial');
      if (prev === u) return;
      var toImp = (u === 'imperial');
      // Scalar depth fields
      ['ohTop', 'td'].forEach(function (id) {
        var el = document.getElementById(id);
        el.value = toImp ? (+el.value / FT).toFixed(1) : (+el.value * FT).toFixed(1);
      });
      // Force fields
      ['blockWeight', 'wobRot', 'wobSlid'].forEach(function (id) {
        var el = document.getElementById(id);
        el.value = toImp ? (+el.value * KN2KLBF).toFixed(2) : (+el.value / KN2KLBF).toFixed(2);
      });
      // Mud weight
      (function () {
        var el = document.getElementById('mudWeight');
        el.value = toImp ? (+el.value * KGM32PPG).toFixed(3) : (+el.value / KGM32PPG).toFixed(0);
      })();
      // Torque limit
      (function () {
        var el = document.getElementById('torqueLimit');
        el.value = toImp ? (+el.value * NM2FTLBF / 1000).toFixed(1) : (+el.value / NM2FTLBF * 1000).toFixed(0);
      })();
      // Table depth columns
      convCol('survBody', 0, toImp ? 1 / FT : FT);
      convCol('casBody', 3, toImp ? 1 / FT : FT);
      convCol('casBody', 4, toImp ? 1 / FT : FT);
      convCol('bhaBody', 3, toImp ? 1 / FT : FT);
      convCol('bhaBody', 4, toImp ? KGM2LBFT : 1 / KGM2LBFT);
      updateLabels();
    }

    function convCol(tbId, col, fac) {
      document.querySelectorAll('#' + tbId + ' tr').forEach(function (r) {
        var ins = r.querySelectorAll('input');
        if (ins[col] && ins[col].value !== '') {
          ins[col].value = (+ins[col].value * fac).toFixed(2);
        }
      });
    }

    function updateLabels() {
      var M = (UNIT === 'metric');
      document.getElementById('lMW').textContent = M ? 'Mud Weight (kg/m3)' : 'Mud Weight (ppg)';
      document.getElementById('lBW').textContent = M ? 'Block Weight (kDaN)' : 'Block Weight (klbf)';
      document.getElementById('lWOBr').textContent = M ? 'WOB Rotating (kDaN)' : 'WOB Rotating (klbf)';
      document.getElementById('lWOBs').textContent = M ? 'WOB Sliding (kDaN)' : 'WOB Sliding (klbf)';
      document.getElementById('lTQ').textContent = M ? 'Torque Limit (N.m)' : 'Torque Limit (kft.lbf)';
      document.getElementById('th_md').textContent = M ? 'MD (m)' : 'MD (ft)';
      document.getElementById('th_ctop').textContent = M ? 'Top (m)' : 'Top (ft)';
      document.getElementById('th_cshoe').textContent = M ? 'Shoe (m)' : 'Shoe (ft)';
      document.getElementById('th_blen').textContent = M ? 'Length (m)' : 'Length (ft)';
      document.getElementById('th_bwt').textContent = M ? 'Wt (kg/m)' : 'Wt (lb/ft)';
      document.getElementById('lOHtop').textContent = M ? 'OH Top (m MD)' : 'OH Top (ft MD)';
      document.getElementById('lTD').textContent = M ? 'Total Depth TD (m MD)' : 'Total Depth TD (ft MD)';
    }

    // =============================================================
    // TABLE ROW BUILDERS
    // =============================================================
    function mkCell(v, ph) {
      return '<td><input type="number" value="' + v + '" placeholder="' + ph + '" step="any"/></td>';
    }
    function mkText(v, ph) {
      // 2026-11-08 round 5: escape the value — names like 4-3/4" MOTOR (BHA library,
      // SAGcorrection) were cut at the quote mark and broke the input.
      return '<td><input type="text" value="' + esc(v) + '" placeholder="' + ph + '"/></td>';
    }
    function delBtn() {
      return '<td><button class="del" onclick="this.closest(\'tr\').remove()">x</button></td>';
    }

    function addSurv(md, inc, az) {
      md = md || ''; inc = inc || ''; az = az || '';
      var tr = document.createElement('tr');
      tr.innerHTML = mkCell(md, 'MD') + mkCell(inc, 'Inc') + mkCell(az, 'Az') + delBtn();
      document.getElementById('survBody').appendChild(tr);
    }

    function addCas(nm, od, id_, top, shoe, ffidx) {
      nm = nm || ''; od = od || ''; id_ = id_ || ''; top = top || ''; shoe = shoe || ''; ffidx = ffidx || '1';
      var tr = document.createElement('tr');
      var sel = '<td><select style="background:var(--panel);border:1px solid var(--border);color:var(--text-bright);font-family:var(--mono);font-size:9px;width:100%;padding:3px">'
        + '<option value="1"' + (ffidx === '1' ? ' selected' : '') + '>1</option>'
        + '<option value="2"' + (ffidx === '2' ? ' selected' : '') + '>2</option>'
        + '</select></td>';
      tr.innerHTML = mkText(nm, 'Name') + mkCell(od, 'OD') + mkCell(id_, 'ID') + mkCell(top, 'Top') + mkCell(shoe, 'Shoe') + sel + delBtn();
      document.getElementById('casBody').appendChild(tr);
    }

    function addBHA(nm, od, id_, len, wt) {
      nm = nm || ''; od = od || ''; id_ = id_ || ''; len = len || ''; wt = wt || '';
      var tr = document.createElement('tr');
      tr.innerHTML = mkText(nm, 'Component') + mkCell(od, 'OD') + mkCell(id_, 'ID') + mkCell(len, 'Len') + mkCell(wt, 'Wt') + delBtn();
      document.getElementById('bhaBody').appendChild(tr);
    }

    // ---------------- BHA from a SAGcorrection case (ADDED 2026-11-07, John) ----------------
    // Lists the saved SAGcorrection cases (same endpoints and role check as that page); a case gives its BHA (panel 2)
    // and, when it uses runs, one BHA per run. SAG rows are SI (od_mm, id_mm, len_m, wt_kgm); converted to this table's
    // display units like importBHAExcel. Empty weight -> steel density (this page's field) x pi/4 (OD^2 - ID^2).
    var sagPickData = null;
    async function sagPickOpen() {
      var box = document.getElementById('sagPick'); box.style.display = '';
      var sel = document.getElementById('sagPickCase'); sel.innerHTML = '<option>Loading…</option>';
      try {
        var r = await fetch('/notes/sagCorrection/cases'); var d = await r.json();
        if (!r.ok || !d.cases) throw new Error(d.error || ('HTTP ' + r.status));
        sel.innerHTML = '<option value="">— SAGcorrection case —</option>' + d.cases.map(function (c) {
          return '<option value="' + c._id + '">' + String(c.name).replace(/</g, '&lt;') + ' · ' + (c.createdByName || '') + ' · ' + new Date(c.createdAt).toLocaleDateString() + '</option>'; }).join('');
        document.getElementById('sagPickBha').innerHTML = '';
      } catch (err) { sel.innerHTML = '<option value="">Could not list cases: ' + err.message + '</option>'; }
    }
    async function sagPickCase() {
