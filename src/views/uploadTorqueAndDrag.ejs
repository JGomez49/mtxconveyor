      if (!rows.length) { alert('That BHA has no valid rows.'); return; }
      var M = (UNIT === 'metric'), rho = +document.getElementById('steelDens').value || 7850, filled = 0;
      document.getElementById('bhaBody').innerHTML = '';
      rows.forEach(function (r) {
        var od = +r.od_mm, id_ = +r.id_mm || 0, len = +r.len_m, wt = (r.wt_kgm === '' || r.wt_kgm == null || !(+r.wt_kgm > 0)) ? null : +r.wt_kgm;
        if (wt == null) { wt = rho * Math.PI / 4 * ((od / 1000) * (od / 1000) - (id_ / 1000) * (id_ / 1000)); filled++; }
        addBHA(String(r.name || ''), od, id_, +(M ? len : len / FT).toFixed(3), +(M ? wt : wt * KGM2LBFT).toFixed(3));
      });
      document.getElementById('sagPick').style.display = 'none';
      setStatus('ok', 'Imported ' + rows.length + ' BHA component(s) from SAGcorrection case "' + sagPickData.name + '" (' + o.label.split(' — ')[0] + ')' + (filled ? ' — ' + filled + ' empty weight(s) filled from OD/ID × steel density' : '') + ' — replaced the previous table.');
