

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Torque and Drag Modeler v5</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/plotly.js/2.27.0/plotly.min.js"></script>
  <script src="/js/tdModel.js"></script>
  <link
    href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Barlow:wght@300;400;500;600;700&family=Barlow+Condensed:wght@400;600;700&display=swap"
    rel="stylesheet" />
  <style>
    :root {
      --bg: #0a0e14;
      --panel: #111820;
      --panel2: #161e28;
      --border: #1e2d3d;
      --accent: #00c8ff;
      --accent2: #ff6b35;
      --accent3: #39ff14;
      --text: #c8d8e8;
      --text-dim: #5a7080;
      --text-bright: #e8f4ff;
      --red: #ff4060;
      --yellow: #ffd060;
      --purple: #c084fc;
      --teal: #2dd4bf;
      --mono: 'Share Tech Mono', monospace;
      --sans: 'Barlow', sans-serif;
      --cond: 'Barlow Condensed', sans-serif;
    }

    /* Light theme: white background, black text; accent/status colours
       kept the same since they carry meaning (they read fine on white too). */
    body.light-mode {
      --bg: #f0f4f8;
      --panel: #ffffff;
      --panel2: #ffffff;
      --border: #c8d4de;
      --text: #000000;
      --text-dim: #495057;
      --text-bright: #000000;
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0
    }

    html {
      font-size: 13px
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--sans);
      min-height: 100vh;
      overflow-x: hidden
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: linear-gradient(rgba(0, 200, 255, .025) 1px, transparent 1px), linear-gradient(90deg, rgba(0, 200, 255, .025) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none;
      z-index: 0
    }

    /* HEADER */
    header {
      /* sticky so Run + toggles stay reachable while scrolling (2026-11-08) */
      position: sticky;
      top: 0;
      z-index: 50;
      flex-wrap: wrap;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      padding: 10px 20px;
      display: flex;
      align-items: center;
      gap: 14px
    }

    .logo-hex {
      width: 34px;
      height: 34px;
      background: var(--accent);
      clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      color: var(--bg);
      font-weight: 700;
      flex-shrink: 0
    }

    .hdr-title {
      flex: 1
    }

    .hdr-title h1 {
      font-family: var(--cond);
      font-size: 19px;
      font-weight: 700;
      color: var(--text-bright);
      letter-spacing: 2px;
      text-transform: uppercase
    }

    .hdr-title p {
      font-family: var(--mono);
      font-size: 8px;
      color: var(--accent);
      letter-spacing: 1px;
      margin-top: 1px
    }

    .hdr-right {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap
    }

    .btn-run.hdr-run {
      width: auto;
      margin-top: 0
    }

    header .btn.btn-run.hdr-save {
      background: transparent;
      color: var(--accent2);
      border: 1px solid var(--accent2);
      box-shadow: none
    }

    header .btn.btn-run.hdr-save:hover {
      background: var(--accent2);
      color: #fff
    }

    .unit-toggle {
      display: flex;
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 3px;
      overflow: hidden
    }

    .unit-btn {
      font-family: var(--mono);
      font-size: 9px;
      padding: 4px 10px;
      border: none;
      background: none;
      color: var(--text-dim);
      cursor: pointer;
      letter-spacing: 1px;
      transition: all .15s
    }

    .unit-btn.active {
      background: var(--accent);
      color: var(--bg);
      font-weight: 700
    }

    .badge {
      font-family: var(--mono);
      font-size: 8px;
      color: var(--accent3);
      border: 1px solid var(--accent3);
      padding: 2px 6px;
      border-radius: 2px;
      letter-spacing: 1px
    }

    /* LAYOUT
       CHANGED 2026-11-08 (John): the old layout was a fixed 390px left input
       column + results on the right, too small to read on meeting-room TVs and
       phones. Now a single full-width column, top to bottom:
         sticky header (title, Run, theme/unit/presentation toggles)
         -> Job Connection card -> summary tiles -> plots (1 per row, each with
         a collapsed data-table accordion) -> input accordions (all collapsed)
         -> sticky status bar.
       Pure layout change — no calculation code touched. */
    .app {
      position: relative;
      z-index: 1;
      display: block;
      max-width: 1800px;
      margin: 0 auto;
      padding: 0 14px
    }

    .td-card {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 4px;
      margin: 14px 0
    }

    .td-card-hdr {
      padding: 9px 14px;
      background: var(--panel2);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: 8px
    }

    .td-card-body {
      padding: 11px 14px
    }

    .right {
      display: flex;
      flex-direction: column
    }

    .inputs {
      margin: 14px 0
    }

    .inputs-ttl {
      font-family: var(--cond);
      font-size: 13px;
      font-weight: 700;
      color: var(--text-bright);
      letter-spacing: 2px;
      text-transform: uppercase;
      padding: 6px 0
    }

    .inputs .sec,
    .inputs>div {
      border: 1px solid var(--border);
      border-radius: 4px;
      margin-bottom: 8px;
      overflow: hidden
    }

    /* Wide screens: let input fields flow across the width instead of 2 narrow columns */
    @media (min-width: 900px) {
      .inputs .fg,
      .inputs .fg.tri,
      .td-card .fg {
        grid-template-columns: repeat(auto-fill, minmax(240px, 320px))
      }
    }

    /* LEFT SECTIONS */
    .sec {
      border-bottom: 1px solid var(--border)
    }

    .sec-hdr {
      padding: 9px 14px;
      background: var(--panel);
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      user-select: none;
      transition: background .15s
    }

    .sec-hdr:hover {
      background: var(--panel2)
    }

    .sec-num {
      font-family: var(--mono);
      font-size: 8px;
      color: var(--accent);
      background: rgba(0, 200, 255, .1);
      border: 1px solid rgba(0, 200, 255, .3);
      padding: 2px 5px;
      border-radius: 2px;
      flex-shrink: 0
    }

    .sec-ttl {
      font-family: var(--cond);
      font-size: 11px;
      font-weight: 600;
      color: var(--text-bright);
      letter-spacing: 1px;
      text-transform: uppercase;
      flex: 1
    }

    .sec-tog {
      font-size: 8px;
      color: var(--text-dim);
      transition: transform .2s
    }

    .sec-tog.open {
      transform: rotate(180deg)
    }

    .sec-body {
      padding: 11px 14px;
      background: var(--bg);
      display: none
    }

    .sec-body.open {
      display: block
    }

    /* FORMS */
    .fg {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px;
      margin-bottom: 6px
    }

    .fg.tri {
      grid-template-columns: 1fr 1fr 1fr
    }

    .fg.one {
      grid-template-columns: 1fr
    }

    label {
      font-family: var(--mono);
      font-size: 8px;
      color: var(--text-dim);
      letter-spacing: 1px;
      text-transform: uppercase;
      display: block;
      margin-bottom: 2px
    }

    input[type=number],
    input[type=text],
    select {
      width: 100%;
      background: var(--panel);
      border: 1px solid var(--border);
      color: var(--text-bright);
      font-family: var(--mono);
      font-size: 11px;
      padding: 5px 6px;
      border-radius: 3px;
      outline: none;
      transition: border-color .15s
    }

    input:focus,
    select:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 2px rgba(0, 200, 255, .1)
    }

    select option {
      background: var(--panel)
    }

    .hint {
      font-family: var(--mono);
      font-size: 8px;
      color: var(--text-dim);
      margin-top: 4px;
      line-height: 1.5
    }

    /* INPUT DATA TABLES */
    .tbl-wrap {
      overflow-x: auto;
      margin-bottom: 6px
    }

    table.dt {
      width: 100%;
      border-collapse: collapse;
      font-family: var(--mono);
      font-size: 9px
    }

    table.dt th {
      background: var(--panel2);
      color: var(--accent);
      font-size: 7px;
      letter-spacing: 1px;
      text-transform: uppercase;
      padding: 3px 4px;
      text-align: center;
      border: 1px solid var(--border);
      white-space: nowrap
    }

    table.dt td {
      border: 1px solid var(--border);
      padding: 1px
    }

    table.dt td input {
      border: none;
      background: transparent;
      text-align: center;
      padding: 3px;
      font-size: 9px;
      width: 100%;
      min-width: 34px;
      color: var(--text-bright);
      font-family: var(--mono)
    }

    table.dt td input:focus {
      background: rgba(0, 200, 255, .08)
    }

    table.dt tr:hover td {
      background: rgba(255, 255, 255, .015)
    }

    .del {
      background: none;
      border: none;
      color: var(--red);
      cursor: pointer;
      font-size: 10px;
      padding: 2px 4px;
      opacity: .4;
      transition: opacity .15s
    }

    .del:hover {
      opacity: 1
    }

    /* BUTTONS */
    .brow {
      display: flex;
      gap: 6px;
      margin-top: 6px;
      flex-wrap: wrap
    }

    .btn {
      font-family: var(--cond);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      padding: 5px 10px;
      border-radius: 3px;
      border: none;
      cursor: pointer;
      transition: all .15s
    }

    .btn-g {
      background: transparent;
      border: 1px solid var(--border);
      color: var(--text-dim)
    }

    .btn-g:hover {
      border-color: var(--accent);
      color: var(--accent)
    }

    .btn-del {
      background: transparent;
      border: 1px solid var(--red);
      color: var(--red)
    }

    .btn-del:hover {
      background: var(--red);
      color: #fff
    }

    .btn-run {
      background: linear-gradient(135deg, var(--accent2), #ff8c55);
      color: #fff;
      font-size: 11px;
      padding: 8px 18px;
      width: 100%;
      margin-top: 2px;
      letter-spacing: 2px
    }

    .btn-run:hover {
      transform: translateY(-1px);
      box-shadow: 0 4px 18px rgba(255, 107, 53, .4)
    }

    .btn-run:active {
      transform: none
    }

    .btn-cal {
      background: linear-gradient(135deg, var(--purple), #a855f7);
      color: #fff;
      font-size: 10px;
      padding: 5px 11px
    }

    .btn-cal:hover {
      box-shadow: 0 3px 12px rgba(192, 132, 252, .4)
    }

    /* EDR */
    .edr-box {
      background: rgba(0, 200, 255, .04);
      border: 1px solid rgba(0, 200, 255, .2);
      border-radius: 4px;
      padding: 10px;
      margin-bottom: 8px
    }

    .edr-ttl {
      font-family: var(--cond);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 7px
    }

    .drop {
      border: 2px dashed var(--border);
      border-radius: 4px;
      padding: 16px;
      text-align: center;
      cursor: pointer;
      transition: all .2s;
      position: relative;
      margin-bottom: 6px
    }

    .drop:hover,
    .drop.over {
      border-color: var(--accent);
      background: rgba(0, 200, 255, .05)
    }

    .drop p {
      font-family: var(--mono);
      font-size: 9px;
      color: var(--text-dim);
      line-height: 1.7
    }

    .drop strong {
      color: var(--accent)
    }

    .drop input[type=file] {
      position: absolute;
      inset: 0;
      opacity: 0;
      cursor: pointer;
      width: 100%;
      height: 100%
    }

    .edr-st {
      font-family: var(--mono);
      font-size: 9px;
      color: var(--accent3);
      margin-top: 5px;
      display: none
    }

    .col-map {
      display: none;
      grid-template-columns: 1fr 1fr;
      gap: 5px;
      margin-top: 7px
    }

    .col-map label {
      font-size: 7px
    }

    /* CALIBRATION */
    .cal-box {
      background: rgba(192, 132, 252, .06);
      border: 1px solid rgba(192, 132, 252, .25);
      border-radius: 4px;
      padding: 10px;
      margin-bottom: 8px
    }

    .cal-ttl {
      font-family: var(--cond);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--purple);
      margin-bottom: 8px
    }

    .srow {
      display: grid;
      grid-template-columns: 1fr auto 56px;
      gap: 7px;
      align-items: center;
      margin-bottom: 7px
    }

    .slbl {
      font-family: var(--mono);
      font-size: 8px;
      color: var(--text-dim);
      letter-spacing: 1px
    }

    input[type=range] {
      width: 100%;
      -webkit-appearance: none;
      height: 4px;
      background: var(--border);
      border-radius: 2px;
      outline: none
    }

    input[type=range]::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 13px;
      height: 13px;
      border-radius: 50%;
      background: var(--purple);
      cursor: pointer;
      box-shadow: 0 0 5px rgba(192, 132, 252, .6)
    }

    .sval {
      font-family: var(--mono);
      font-size: 10px;
      color: var(--purple);
      text-align: right
    }

    .rmse-box {
      font-family: var(--mono);
      font-size: 9px;
      color: var(--text-dim);
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 3px;
      padding: 6px 9px;
      margin-top: 7px;
      line-height: 1.7;
      display: none
    }

    /* RESULTS TOOLBAR */
    .rtbar {
      background: var(--panel);
      border-bottom: 1px solid var(--border);
      padding: 7px 14px;
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap
    }

    .rtbar h2 {
      font-family: var(--cond);
      font-size: 13px;
      font-weight: 700;
      color: var(--text-bright);
      letter-spacing: 2px;
      text-transform: uppercase;
      white-space: nowrap
    }

    /* Summary values @ TD — CHANGED 2026-11-08 from small pills to large
       tiles (same markup/ids written by runModel(), only restyled). */
    .chips {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 8px;
      width: 100%;
      margin-top: 6px
    }

    .chip {
      font-family: var(--mono);
      font-size: 14px;
      padding: 10px 12px;
      border-radius: 4px;
      border: 1px solid;
      text-align: center;
      white-space: normal
    }

    .cb {
      color: var(--accent);
      border-color: rgba(0, 200, 255, .3);
      background: rgba(0, 200, 255, .07)
    }

    .co {
      color: var(--accent2);
      border-color: rgba(255, 107, 53, .3);
      background: rgba(255, 107, 53, .07)
    }

    .cg {
      color: var(--accent3);
      border-color: rgba(57, 255, 20, .3);
      background: rgba(57, 255, 20, .07)
    }

    .cr {
      color: var(--red);
      border-color: rgba(255, 64, 96, .3);
      background: rgba(255, 64, 96, .07)
    }

    .cp {
      color: var(--purple);
      border-color: rgba(192, 132, 252, .3);
      background: rgba(192, 132, 252, .07)
    }

    /* CHARTS — stacked panels each with chart left + table right */
    .charts {
      padding: 14px 0;
      display: flex;
      flex-direction: column;
      gap: 14px
    }

    /* plot panel */
    .pp {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 4px;
      overflow: hidden;
      position: relative
    }

    .pp::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      z-index: 2
    }

    .pp.c-bl::before {
      background: var(--accent)
    }

    .pp.c-or::before {
      background: var(--accent2)
    }

    .pp.c-te::before {
      background: var(--teal)
    }

    .pp.c-pu::before {
      background: var(--purple)
    }

    .pp.c-gr::before {
      background: var(--accent3)
    }

    .pp.c-wh::before {
      background: #ffffff
    }

    .pp-hdr {
      padding: 7px 12px;
      background: var(--panel2);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center
    }

    /* Depth timeline (2026-11-08 round 5) */
    .tl { position: relative; padding: 4px 0 8px; user-select: none }
    .tl-axis { position: relative; height: 18px; margin: 0 40px 2px 4px; font-family: var(--mono); font-size: 10px; color: var(--text-dim) }
    .tl-axis span { position: absolute; transform: translateX(-50%); white-space: nowrap }
    .tl-axis .tl-td { transform: translateX(-100%); color: var(--text-bright) }
    .tl-lane-lbl { font-family: var(--cond); font-size: 11px; letter-spacing: 1px; text-transform: uppercase; color: var(--text-dim); margin: 4px 0 12px }
    .tl-lane { position: relative; height: 30px; margin: 0 40px 4px 4px; background: var(--bg); border: 1px solid var(--border); border-radius: 3px }
    .tl-sec, .tl-run, .tl-gap { position: absolute; top: 2px; bottom: 2px; border-radius: 3px; overflow: hidden }
    .tl-sec span, .tl-run span { display: block; padding: 0 6px; line-height: 24px; font-family: var(--mono); font-size: 11px; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis }
    .tl-sec { opacity: .85 }
    .tl-shoe { position: absolute; top: -12px; transform: translateX(-50%); color: var(--text-bright); font-size: 10px }
    .tl-run { background: var(--accent); cursor: pointer; border: 2px solid transparent }
    .tl-run span { color: #001018 }
    .tl-run.off { background: repeating-linear-gradient(45deg, var(--border), var(--border) 6px, transparent 6px, transparent 12px); }
    .tl-run.off span { color: var(--text-dim) }
    .tl-run.sel { border-color: var(--accent2); box-shadow: 0 0 0 2px var(--accent2) }
    .tl-gap { background: repeating-linear-gradient(45deg, rgba(255,64,96,.55), rgba(255,64,96,.55) 5px, transparent 5px, transparent 10px) }
    body.present .tl-lane { height: 40px }
    body.present .tl-sec span, body.present .tl-run span { line-height: 34px; font-size: 14px }
    body.present .tl-axis { font-size: 13px; height: 22px }
    body.present .tl-lane-lbl { font-size: 13px }

    /* "?" help button + floating window (2026-11-08 round 3) */
    .pp-help {
      margin-left: auto;
      width: 30px;
      height: 30px;
      border-radius: 50%;
      border: 1px solid var(--accent);
      background: transparent;
      color: var(--accent);
      font-family: var(--cond);
      font-size: 17px;
      font-weight: 700;
      cursor: pointer;
      flex-shrink: 0
    }

    .pp-help:hover {
      background: var(--accent);
      color: var(--bg)
    }

    .hp-modal {
      position: fixed;
      inset: 0;
      z-index: 200;
      background: rgba(0, 0, 0, .55);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 16px
    }

    .hp-modal.open {
      display: flex
    }

    .hp-win {
      background: var(--panel);
      border: 1px solid var(--accent);
      border-radius: 6px;
      width: 100%;
      max-width: 860px;
      max-height: 88vh;
      display: flex;
      flex-direction: column;
      box-shadow: 0 10px 40px rgba(0, 0, 0, .5)
    }

    .hp-hdr {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 16px;
      border-bottom: 1px solid var(--border);
      background: var(--panel2)
    }

    .hp-hdr h3 {
      flex: 1;
      font-family: var(--cond);
      font-size: 20px;
      letter-spacing: 1px;
      color: var(--text-bright);
      text-transform: uppercase
    }

    .hp-x {
      background: none;
      border: 1px solid var(--border);
      color: var(--text);
      font-size: 18px;
      width: 34px;
      height: 34px;
      border-radius: 4px;
      cursor: pointer
    }

    .hp-body {
      padding: 6px 18px 18px;
      overflow-y: auto;
      font-family: var(--sans);
      font-size: 16px;
      line-height: 1.55;
      color: var(--text)
    }

    .hp-body h4 {
      font-family: var(--cond);
      font-size: 15px;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--accent);
      margin: 16px 0 6px
    }

    .hp-body p {
      margin: 6px 0
    }

    .hp-eq {
      font-family: var(--mono);
      font-size: 15px;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 8px 12px;
      line-height: 1.8;
      overflow-x: auto
    }

    .hp-eq-in {
      font-family: var(--mono);
      white-space: nowrap
    }

    .hp-src {
      font-size: 13px;
      padding-left: 20px;
      color: var(--text-dim)
    }

    .hp-src li {
      margin: 4px 0
    }

    @media (max-width: 700px) {
      .hp-modal { padding: 0 }
      .hp-win { max-height: 100vh; height: 100%; border-radius: 0 }
      .hp-body { font-size: 15px }
    }

    .pp-ttl {
      font-family: var(--cond);
      font-size: 9px;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--text-dim)
    }

    /* CHANGED 2026-11-08: chart now full width (was 60/40 chart|table);
       the data table sits under it in a collapsed accordion (.pp-tsec). */
    .pp-chart {
      position: relative;
      height: 420px
    }

    .pp-chart.tall {
      height: 520px
    }

    .pp-chart.h3d {
      height: 600px
    }

    .pp-tsec {
      border-top: 1px solid var(--border)
    }

    .pp-thdr {
      padding: 7px 12px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      user-select: none;
      font-family: var(--cond);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--text-dim)
    }

    .pp-thdr:hover {
      background: var(--panel2)
    }

    .pp-thdr .sec-tog {
      margin-left: auto
    }

    .pp-tsec .pp-tbl {
      display: none
    }

    .pp-tsec.open .pp-tbl {
      display: block
    }

    .pp-chart canvas {
      position: absolute;
      inset: 6px
    }

    /* plotly 3d fills chart area */
    .pp-plotly {
      width: 100%;
      height: 100%
    }

    /* panel result table */
    .pp-tbl {
      overflow: auto;
      max-height: 480px
    }

    table.ptbl {
      width: 100%;
      border-collapse: collapse;
      font-family: var(--mono);
      font-size: 8px
    }

    table.ptbl th {
      background: var(--panel2);
      color: var(--accent);
      font-size: 7px;
      letter-spacing: .5px;
      text-transform: uppercase;
      padding: 3px 5px;
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 2;
      white-space: nowrap;
      text-align: right
    }

    table.ptbl th:first-child {
      text-align: left
    }

    table.ptbl td {
      border-bottom: 1px solid rgba(30, 45, 61, .6);
      padding: 2px 5px;
      text-align: right;
      color: var(--text)
    }

    table.ptbl td:first-child {
      text-align: left;
      color: var(--text-dim)
    }

    table.ptbl tr:hover td {
      background: rgba(0, 200, 255, .04)
    }

    /* PLACEHOLDER */
    .ph {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 80px 40px;
      text-align: center;
      min-height: 400px
    }

    .ph-icon {
      font-size: 48px;
      margin-bottom: 14px;
      opacity: .25
    }

    .ph h3 {
      font-family: var(--cond);
      font-size: 15px;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 5px;
      opacity: .4
    }

    .ph p {
      font-size: 11px;
      line-height: 1.6;
      max-width: 320px;
      opacity: .35
    }

    /* STATUS BAR */
    .sbar {
      position: sticky;
      bottom: 0;
      z-index: 40;
      background: var(--panel);
      border-top: 1px solid var(--border);
      padding: 5px 14px;
      font-family: var(--mono);
      font-size: 8px;
      color: var(--text-dim);
      display: flex;
      align-items: center;
      gap: 10px
    }

    .sdot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--text-dim);
      flex-shrink: 0
    }

    .sdot.ok {
      background: var(--accent3);
      box-shadow: 0 0 5px var(--accent3)
    }

    .sdot.err {
      background: var(--red);
      box-shadow: 0 0 5px var(--red)
    }

    .sdot.run {
      background: var(--accent);
      animation: pulse 1s infinite
    }

    @keyframes pulse {

      0%,
      100% {
        opacity: 1
      }

      50% {
        opacity: .3
      }
    }

    .errbox {
      background: rgba(255, 64, 96, .1);
      border: 1px solid rgba(255, 64, 96, .4);
      border-radius: 3px;
      padding: 7px 11px;
      font-family: var(--mono);
      font-size: 9px;
      color: var(--red);
      line-height: 1.6;
      display: none;
      margin: 8px 14px
    }

    /* ============================================================
       PRESENTATION MODE (added 2026-11-08, John) — large type for
       meeting-room TVs. ON by default; choice saved per browser in
       localStorage key 'mtxTdPresentation' (same mechanism as the
       site-wide theme preference). Chart fonts/line widths follow
       via isPresent() in buildCO()/mkLine()/Plotly layout.
       ============================================================ */
    body.present .hdr-title h1 { font-size: 26px }
    body.present .hdr-title p { font-size: 11px }
    body.present .unit-btn { font-size: 13px; padding: 7px 14px }
    body.present .badge { font-size: 11px }
    body.present .sec-hdr { padding: 13px 16px }
    body.present .sec-num { font-size: 12px }
    body.present .sec-ttl,
    body.present .inputs-ttl,
    body.present .rtbar h2 { font-size: 18px }
    body.present .sec-tog { font-size: 12px }
    body.present .sec-body,
    body.present .td-card-body { padding: 14px 16px }
    body.present label { font-size: 12px }
    body.present input[type=number],
    body.present input[type=text],
    body.present select { font-size: 16px; padding: 8px 9px }
    body.present .hint { font-size: 12px }
    body.present table.dt { font-size: 14px }
    body.present table.dt th { font-size: 11px; padding: 6px }
    body.present table.dt td input { font-size: 14px; padding: 6px; min-width: 60px }
    body.present .btn { font-size: 14px; padding: 8px 14px }
    body.present .btn-run { font-size: 16px; padding: 11px 24px }
    body.present .chip { font-size: 20px; padding: 14px }
    body.present .pp-ttl { font-size: 15px }
    body.present .pp-thdr { font-size: 14px; padding: 10px 14px }
    body.present table.ptbl { font-size: 13px }
    body.present table.ptbl th { font-size: 11px; padding: 6px 8px }
    body.present table.ptbl td { padding: 4px 8px }
    body.present .pp-chart { height: 520px }
    body.present .pp-chart.tall { height: 640px }
    body.present .pp-chart.h3d { height: 720px }
    body.present .sbar { font-size: 12px }
    body.present .slbl, body.present .sval { font-size: 13px }
    body.present .drop p { font-size: 13px }
    body.present #buckPanel { font-size: 15px !important }
    /* helMode select carries an inline font-size, so it needs !important */
    body.present #helMode { font-size: 16px !important; padding: 8px !important }

    /* PHONES */
    @media (max-width: 700px) {
      /* not sticky on phones: the wrapped header would cover ~1/3 of the screen */
      header { position: relative; padding: 8px 10px; gap: 8px }
      body.present .hdr-title h1 { font-size: 20px }
      body.present .unit-btn { font-size: 11px; padding: 6px 10px }
      body.present .chip { font-size: 15px; padding: 10px 6px }
      body.present #buckPanel { font-size: 12px !important }
      .hdr-title p { display: none }
      .hdr-right { width: 100% }
      .btn-run.hdr-run { flex: 1 1 100% }
      .app { padding: 0 8px }
      .pp-chart, .pp-chart.tall { height: 360px }
      .pp-chart.h3d { height: 420px }
      body.present .pp-chart, body.present .pp-chart.tall { height: 420px }
      body.present .pp-chart.h3d { height: 460px }
      .chips { grid-template-columns: 1fr 1fr }
      /* keep the first column (component / name / MD) visible while the table scrolls sideways */
      table.dt td:first-child, table.dt th:first-child { position: sticky; left: 0; z-index: 1; background: var(--panel) }
    }

    ::-webkit-scrollbar {
      width: 4px;
      height: 4px
    }

    ::-webkit-scrollbar-track {
      background: transparent
    }

    ::-webkit-scrollbar-thumb {
      background: var(--border);
      border-radius: 3px
    }
  </style>
</head>

<body class="present">

  <header>
    <div class="logo-hex">+</div>
    <div class="hdr-title">
      <h1>Torque &amp; Drag Modeler</h1>
      <p>SOFT-STRING (JOHANCSIK 1984) · 3D TRAJECTORY · WELLPLAN-STYLE OUTPUT · EDR CALIBRATION</p>
    </div>
    <div class="hdr-right">
      <!-- Run moved here from the bottom of the old left panel (2026-11-08) -->
      <button class="btn btn-run hdr-run" onclick="runModel()">RUN T&amp;D MODEL</button>
      <!-- 2026-11-08 round 6: Save moved here from the Job Connection card, where it only
           appeared after a job WITH subject-well trajectories was loaded. -->
      <button class="btn btn-run hdr-run hdr-save" id="btnHdrSave" onclick="saveModelToJob()" title="Save parameters + results of the selected well / scenario to the job (shown in job.ejs)">&#128190; SAVE TO JOB</button>
      <!-- 2026-11-08 (round 2): PRESENT/COMPACT toggle removed (John: large
           type only). Replaced by a legend show/hide toggle for all plots. -->
      <div class="unit-toggle" title="Show / hide plot legends (default: shown on PC, hidden on phones)">
        <button class="unit-btn" id="btnLegOn" onclick="setLegend(true)">LEGEND</button>
        <button class="unit-btn" id="btnLegOff" onclick="setLegend(false)">HIDE</button>
      </div>
      <div class="unit-toggle">
        <button class="unit-btn active" id="btnThemeDark" onclick="setTheme('dark')">DARK</button>
        <button class="unit-btn" id="btnThemeLight" onclick="setTheme('light')">LIGHT</button>
      </div>
      <div class="unit-toggle">
        <button class="unit-btn" id="btnImp" onclick="setUnits('imperial')">IMPERIAL</button>
        <button class="unit-btn active" id="btnMet" onclick="setUnits('metric')">METRIC</button>
      </div>
      <div class="badge">v5.0</div>
    </div>
  </header>

  <div class="app">

    <!-- ===== 00 JOB CONNECTION (always visible, above results) =====
         CHANGED 2026-11-08: was the first section of the old left panel.
         Class td-setup keeps it wired to auto-save (see initTdAutoSave). -->
    <div class="td-card td-setup">
        <div class="td-card-hdr">
          <span class="sec-num">00</span><span class="sec-ttl">Job Connection</span>
        </div>
        <div class="td-card-body">
          <div class="fg">
            <div><label>Job ID (MTX ID)</label><input type="text" id="tdMtxJobId" placeholder="e.g. 1953" /></div>
            <div style="display:flex; align-items:flex-end;">
              <button class="btn btn-g" style="width:100%;" onclick="loadJobByMtxId()">Load Job</button>
            </div>
          </div>
          <div class="fg one" id="tdWellRow" style="display:none;">
            <div>
              <label>Well / Leg</label>
              <select id="tdWellSelect" onchange="onTdWellChange()"></select>
            </div>
          </div>
          <div class="fg one" id="tdScenarioRow" style="display:none;">
            <div>
              <label>Scenario (job-wide — shared across every well)</label>
              <select id="tdScenarioSelect" onchange="onTdScenarioChange()"></select>
            </div>
          </div>
          <div class="brow" id="tdScenarioBtnRow" style="display:none;">
            <button class="btn btn-g" onclick="tdSaveAsNewScenario()">➕ Save As New Scenario</button>
            <button class="btn btn-g" onclick="tdSetActiveScenario()">⭐ Set as Active</button>
            <button class="btn btn-g btn-del" onclick="tdDeleteScenario()">🗑 Delete Scenario</button>
          </div>
          <div class="brow" id="tdSaveRow" style="display:none;"></div><!-- Save button now in the header (round 6) -->
          <p class="hint" id="tdJobStatus">Enter a Job ID to pull its subject-well trajectories in as survey data, and to load/save casing, BHA, and friction-factor parameters for that job.</p>
        </div>
    </div>

    <!-- ===== RESULTS (moved above the inputs) ===== -->
    <div class="right">
      <div class="rtbar">
        <h2>Results</h2>
        <div class="chips" id="chips">
          <span class="chip cb">ROT OB @ TD: --</span>
          <span class="chip co">SLIDE @ TD: --</span>
          <span class="chip cg">TRIP OUT @ TD: --</span>
          <span class="chip cr">TRIP IN @ TD: --</span>
          <span class="chip cp">TORQUE @ TD: --</span>
        </div>
      </div>
      <!-- Snapshot depth (added 2026-11-08) -->
      <div class="brow" id="snapBar" style="align-items:center;margin:8px 0 0">
        <span class="slbl" title="Effective Tension, Side Forces and Surf. Torque are computed with the bit at this depth">SNAPSHOT (Eff. Tension / Side Forces / Torque)</span>
        <div class="unit-toggle">
          <button class="unit-btn" id="btnSnapAuto" onclick="planSetSnapMode('auto')">AUTO</button>
          <button class="unit-btn" id="btnSnapMan" onclick="planSetSnapMode('manual')">MANUAL</button>
        </div>
        <select id="snapRun" onchange="planSnapChanged()" style="width:auto;max-width:100%"></select>
        <span id="snapMDWrap" style="display:none"><label id="lSnapMD" style="display:inline;margin-right:6px">Bit MD (m)</label><input type="number" id="snapMD" step="any" style="width:120px" onchange="planSnapChanged()"/></span>
        <button class="btn btn-g" onclick="runModel()">Apply</button>
        <span class="hint" id="snapInfo" style="margin:0"></span>
      </div>
      <div id="errbox" class="errbox"></div>
      <div id="buckPanel" style="display:none;margin:10px 0 0;padding:10px 12px;border:1px solid var(--border);background:var(--panel);font-family:var(--mono);font-size:11px;line-height:1.7"></div>
      <div class="charts" id="chartsArea">
        <div class="ph" id="ph">
          <div class="ph-icon">O</div>
          <h3>Ready to Model</h3>
          <p>The CNRL ETS 158861 example is pre-loaded, plus an <strong>illustrative intermediate BHA run</strong> (222 mm hole, 200–1138 m — made-up test values) to show hole sections &amp; runs. Click <strong>Run T&amp;D Model</strong> to compute all plots
            and tables.</p>
        </div>
      </div>
    </div>

    <!-- ===== INPUT ACCORDIONS (all collapsed by default; several can be open) =====
         CHANGED 2026-11-08: these were the old left panel. Class td-setup keeps
         them wired to auto-save. -->
    <div class="inputs td-setup">
      <div class="inputs-ttl">Model Inputs</div>

      <!-- 01 GLOBAL -->
      <div class="sec">
        <div class="sec-hdr" onclick="toggleSec(this)">
          <span class="sec-num">01</span><span class="sec-ttl">Global Parameters</span><span
            class="sec-tog">v</span>
        </div>
        <div class="sec-body">
          <div class="fg">
            <div><label id="lMW">Mud Weight (kg/m3)</label><input type="number" id="mudWeight" value="1040" step="1" />
            </div>
            <div><label id="lBW">Block Weight (kDaN)</label><input type="number" id="blockWeight" value="10" step="0.1" />
            </div>
          </div>
          <div class="fg">
            <div><label id="lWOBr">WOB Rotating (kDaN)</label><input type="number" id="wobRot" value="20" step="0.5" />
            </div>
            <div><label id="lWOBs">WOB Sliding (kDaN)</label><input type="number" id="wobSlid" value="19" step="0.5" />
            </div>
          </div>
          <div class="fg">
            <div><label id="lTQ">Torque Limit (N.m)</label><input type="number" id="torqueLimit" value="35000"
                step="100" /></div>
            <div><label>Steel Density (kg/m3)</label><input type="number" id="steelDens" value="7850" step="10" /></div>
          </div>
          <div class="fg">
            <div><label title="WellPlan 'Contact Force Normalization Length'. Side force plots as kgf per this length of string. One Range 2 DP joint = 9.45 m.">SF
                Norm. Length (m)</label><input type="number" id="normLen" value="9.45" step="0.01" min="0.1" /></div>
            <div><label title="Helical buckling onset. Chen-Lin-Cheatham (1990): sqrt(2) x sinusoidal. Wu &amp; Juvkam-Wold (1993): 1.83 x sinusoidal.">Helical
                Criterion</label><select id="helMode"
                style="background:var(--panel);border:1px solid var(--border);color:var(--text-bright);font-family:var(--mono);font-size:10px;width:100%;padding:5px">
                <option value="chen" selected>Chen-Cheatham (1.41x)</option>
                <option value="wu">Wu-Juvkam-Wold (1.83x)</option>
              </select></div>
          </div>
          <div class="fg">
            <div><label title="Torque applied at the bit while on bottom (WellPlan 'Torque at Bit'). Carried to surface unchanged when sliding (no rotation).">Torque
                at Bit (N.m)</label><input type="number" id="torqBit" value="15" step="1" /></div>
            <div><label title="Trip speed for Tripping In / Out (WellPlan 'Trip Speed').">Trip Speed
                (m/min)</label><input type="number" id="tripSpeed" value="18.29" step="0.1" /></div>
          </div>
          <div class="fg">
            <div><label title="Rotary speed while tripping in. If > 0, wall friction splits between axial drag and torque along the resultant velocity (WellPlan 'tripping with rotation').">Trip
                In RPM</label><input type="number" id="tripInRPM" value="5" step="1" min="0" /></div>
            <div><label title="Rotary speed while tripping out (WellPlan job reports often use 0 / NA).">Trip
                Out RPM</label><input type="number" id="tripOutRPM" value="0" step="1" min="0" /></div>
          </div>
          <div class="fg tri">
            <div><label>FF Casing 1</label><input type="number" id="ff1" value="0.25" step="0.01" min="0.01"
                max="0.8" /></div>
            <div><label>FF Casing 2</label><input type="number" id="ff2" value="0.20" step="0.01" min="0.01"
                max="0.8" /></div>
            <div><label>FF Open Hole</label><input type="number" id="ffOH" value="0.32" step="0.01" min="0.01"
                max="0.8" /></div>
          </div>
          <p class="hint">FF typical: 0.15-0.25 cased / 0.25-0.40 open hole. CNRL defaults loaded. Mud weight and FF Open Hole are set per hole section (03B); WOB and torque at bit per BHA run (04).</p>
        </div>
      </div>

      <!-- 02 SURVEY -->
      <div class="sec">
        <div class="sec-hdr" onclick="toggleSec(this)">
          <span class="sec-num">02</span><span class="sec-ttl">Well Survey Trajectory</span><span
            class="sec-tog">v</span>
        </div>
        <div class="sec-body">
          <div class="tbl-wrap">
            <table class="dt">
              <thead>
                <tr>
                  <th id="th_md">MD (m)</th>
                  <th>Inc (deg)</th>
                  <th>Az (deg)</th>
                  <th></th>
                </tr>
              </thead>
              <tbody id="survBody"></tbody>
            </table>
          </div>
          <div class="brow">
            <button class="btn btn-g" onclick="addSurv()">+ Row</button>
            <button class="btn btn-g" onclick="loadCNRL()">Load CNRL Example</button>
          </div>
          <p class="hint">CNRL ETS 158861 matches the Landmark WellPlan report exactly.</p>
        </div>
      </div>

      <!-- 03 CASING -->
      <div class="sec">
        <div class="sec-hdr" onclick="toggleSec(this)">
          <span class="sec-num">03</span><span class="sec-ttl">Casing / Liner Program</span><span
            class="sec-tog">v</span>
        </div>
        <div class="sec-body">
          <div class="tbl-wrap">
            <table class="dt">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>OD (mm)</th>
                  <th>ID (mm)</th>
                  <th id="th_ctop">Top (m)</th>
                  <th id="th_cshoe">Shoe (m)</th>
                  <th>FF</th>
                  <th></th>
                </tr>
              </thead>
              <tbody id="casBody"></tbody>
            </table>
          </div>
          <div class="brow">
            <button class="btn btn-g" onclick="addCas()">+ String</button>
            <button class="btn btn-g" onclick="loadCNRLCas()">Load CNRL</button>
            <button class="btn btn-g" onclick="importFromCasingDesign()" title="Pull casing strings (name, OD, ID, shoe MD) from a saved Casing Design scenario for this well">🧱 Import from Casing Design</button>
          </div>
          <p class="hint">FF idx: 1=FF1 (Casing 1), 2=FF2 (Casing 2). OD/ID always in mm.</p>
        </div>
      </div>

      <!-- 04 HOLE SECTIONS & BHA RUNS (2026-11-08; merged into one accordion in round 5) -->
      <div class="sec">
        <div class="sec-hdr" onclick="toggleSec(this)">
          <span class="sec-num">04</span><span class="sec-ttl">Hole Sections &amp; BHA Runs</span><span class="sec-tog">v</span>
        </div>
        <div class="sec-body">
          <div id="planTimeline" class="tl"></div>
          <p class="hint" id="planWarn"></p>
          <div class="inputs-ttl" style="font-size:13px;margin-top:10px">Hole Sections</div>
          <div class="brow" style="align-items:center;margin-bottom:8px">
            <span class="slbl">SECTION LIMITS</span>
            <div class="unit-toggle" title="Auto: limits follow the casing shoes (surface, each shoe, TD). Manual: type From / To.">
              <button class="unit-btn" id="btnSecAuto" onclick="planSetSectionMode('auto')">AUTO</button>
              <button class="unit-btn" id="btnSecMan" onclick="planSetSectionMode('manual')">MANUAL</button>
            </div>
          </div>
          <div class="tbl-wrap">
            <table class="dt">
              <thead><tr><th>Section</th><th id="th_sfrom">From (m)</th><th id="th_sto">To (m)</th><th>Hole &Oslash; (mm)</th><th id="th_smw">MW (kg/m3)</th><th>FF Open Hole</th><th></th></tr></thead>
              <tbody id="secBody"></tbody>
            </table>
          </div>
          <div class="brow" id="secAddRow"><button class="btn btn-g" onclick="planAddSection()">+ Section</button></div>
          <p class="hint">Each section has its own hole size, mud weight and open-hole friction factor. When a run drills a section, that section's casing is not set yet: the model uses only casings whose shoe is at or above the run's From MD, and the hole size / FF Open Hole of the section below them. Mud weight = the section the run is drilling. Cased-hole FF stays FF Casing 1 / 2 (Global Parameters).</p>
          <div class="inputs-ttl" style="font-size:13px;margin-top:14px">BHA Runs</div>
          <!-- BHA runs (added 2026-11-08) -->
          <div class="tbl-wrap">
            <table class="dt">
              <thead><tr><th title="Run shown in the BHA / Drill Pipe tables below">Edit</th><th title="Use this run in the T&amp;D model">T&amp;D</th><th>Run</th><th id="th_rfrom">From (m)</th><th id="th_rto">To (m)</th><th id="th_rwobr">WOB Rot (kDaN)</th><th id="th_rwobs">WOB Slide (kDaN)</th><th>Torque @ Bit (N.m)</th><th></th></tr></thead>
              <tbody id="runBody"></tbody>
            </table>
          </div>
          <div class="brow">
            <button class="btn btn-g" onclick="planAddRun(false)">+ Run</button>
            <button class="btn btn-g" onclick="planAddRun(true)">&#10697; Duplicate Edited Run</button>
          </div>
          
          <p class="hint">From / To = bit MD drilled by that BHA. Untick <strong>T&amp;D</strong> for runs that should not be modelled (e.g. a clean-out re-run over the same interval); where two ticked runs overlap, the one starting deeper is used.</p>
          <div class="inputs-ttl" style="font-size:13px;margin-top:10px">BHA — editing: <span id="runEditName" style="color:var(--accent)">—</span></div>
          <div class="tbl-wrap">
            <table class="dt">
              <thead>
                <tr>
                  <th>Component</th>
                  <th>OD (mm)</th>
                  <th>ID (mm)</th>
                  <th id="th_blen">Length (m)</th>
                  <th id="th_bwt">Wt (kg/m)</th>
                  <th></th>
                </tr>
              </thead>
              <tbody id="bhaBody"></tbody>
            </table>
          </div>
          <div class="brow">
            <button class="btn btn-g" onclick="addBHA()">+ Component</button>
            <button class="btn btn-g" onclick="loadCNRLBHA()">Load CNRL</button>
            <button class="btn btn-g" onclick="exportBHAExcel()">⬇ Export to Excel</button>
            <button class="btn btn-g" onclick="document.getElementById('bhaImportFile').click()">⬆ Import from Excel</button>
            <input type="file" id="bhaImportFile" accept=".xlsx,.xls" style="display:none;" onchange="importBHAExcel(event)"/>
            <!-- ADDED 2026-11-07 (John: modules inter-connected): BHA from a saved SAGcorrection case -->
            <button class="btn btn-g" onclick="sagPickOpen()">⬇ From SAGcorrection case</button>
            <!-- ADDED 2026-11-08 round 5: component catalogue public/data/bhaLibrary.json -->
            <button class="btn btn-g" onclick="libPickOpen()">&#128218; From BHA Library</button>
