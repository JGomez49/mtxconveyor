    //  [JFD]  K&M HERDIT Course/SPE Papers/SPE-11380-PA.pdf — Johancsik,
    //         Friesen & Dawson (1984), Eqs. 1-3, friction range 0.25-0.40.
    //  [MIT]  K&M HERDIT Course/SPE Papers/SPE-13064-PA.pdf — Mitchell
    //         (1986), Eq. A-18 Wn = rF^2/(4EI).
    //  [KM05] K&M HERDIT Course/Course/Section 05 - TD&B Fundamentals.pdf
    //  [KM15] K&M HERDIT Course/Course/Section 15 - TD&B Modeling.pdf
    //  [BOU]  Chapters/08_Directional_Drilling_and_Deviation_Control.pdf —
    //         Bourgoyne et al., Applied Drilling Engineering, Sec. 8.3.3
    //         (Eqs. 8.33-8.37) and Sec. 8.4.6.
    //  [COP]  DirectionalDrillingandWellborePositioningManual.pdf, Sec. 4.3.
    // Items marked "not in folder" are references cited by tdModel.js
    // whose original paper is not in the folder.
    // =============================================================
    var TD_SRC = {
      JFD: 'Johancsik, Friesen &amp; Dawson (1984), "Torque and Drag in Directional Wells — Prediction and Measurement", JPT, SPE-11380-PA, Eqs. 1–3 <em>(K&amp;M HERDIT Course / SPE Papers / SPE-11380-PA.pdf)</em>',
      MIT: 'Mitchell (1986), "Simple Frictional Analysis of Helical Buckling of Tubing", SPE-13064-PA, Eq. A-18 <em>(K&amp;M HERDIT Course / SPE Papers / SPE-13064-PA.pdf)</em>',
      KM05: 'K&amp;M Technology Group (2014), ERD course, Section 05 — TD&amp;B Fundamentals <em>(K&amp;M HERDIT Course / Course)</em>',
      KM15: 'K&amp;M Technology Group (2014), ERD course, Section 15 — TD&amp;B Modeling <em>(K&amp;M HERDIT Course / Course)</em>',
      BOU: 'Bourgoyne et al., Applied Drilling Engineering, Ch. 8, Sec. 8.3.3 (Eqs. 8.33–8.37) and Sec. 8.4.6 <em>(Chapters / 08_Directional_Drilling_and_Deviation_Control.pdf)</em>',
      COP: 'Directional Drilling and Wellbore Positioning Manual (WE-MN-DRL-005), Sec. 4.3 <em>(DirectionalDrillingandWellborePositioningManual.pdf)</em>',
      CODE: 'MTX implementation: <code>public/js/tdModel.js</code>'
    };

    var TD_EQ_N = 'N = &radic;[ (F&middot;&Delta;&alpha;&middot;sin&theta;)&sup2; + (F&middot;&Delta;&theta; + W&middot;sin&theta;)&sup2; ]';

    var TD_HELP = {
      traj: {
        title: '3D-DLS — 3D Well Trajectory',
        what: '<p>The wellbore drawn in 3D: Local East, Local North and TVD (true vertical depth), measured from the first survey station. The line colour is the dogleg severity (DLS) at each station — see the colour bar under the plot. The green diamond is the surface location; the red &times; is TD. Hover any station to read MD, TVD, N/E, Inc, Az and DLS.</p>',
        how: '<p>Positions are calculated station-to-station with the <strong>Minimum Curvature</strong> method, which assumes the hole is a circular arc between two surveys [BOU]:</p>'
          + '<p class="hp-eq">cos &beta; = cos(I<sub>2</sub>&minus;I<sub>1</sub>) &minus; sin I<sub>1</sub> sin I<sub>2</sub> [1 &minus; cos(A<sub>2</sub>&minus;A<sub>1</sub>)]<br>'
          + 'F = (2/&beta;)&middot;tan(&beta;/2) &nbsp;(F = 1 when &beta; &asymp; 0)<br>'
          + '&Delta;TVD = &Delta;MD/2 &middot; (cos I<sub>1</sub> + cos I<sub>2</sub>) &middot; F<br>'
          + '&Delta;N = &Delta;MD/2 &middot; (sin I<sub>1</sub> cos A<sub>1</sub> + sin I<sub>2</sub> cos A<sub>2</sub>) &middot; F<br>'
          + '&Delta;E = &Delta;MD/2 &middot; (sin I<sub>1</sub> sin A<sub>1</sub> + sin I<sub>2</sub> sin A<sub>2</sub>) &middot; F</p>'
          + '<p>&beta; is the overall angle change between the two stations, F is the ratio factor, I = inclination, A = azimuth. DLS = &beta; / &Delta;MD, reported in deg/30 m [BOU Sec. 8.4.6].</p>',
        why: '<p>Minimum Curvature is the method the positioning manual in your folder recommends for all wellbore position calculations between survey points [COP]. The colouring shows where the doglegs are, and doglegs are where string tension creates extra wall contact force ("brake drum" torque and drag) [KM05].</p>',
        src: ['BOU', 'COP', 'KM05', 'CODE']
      },
      et: {
        title: 'Effective Tension',
        what: '<p>Axial load along the whole string at one moment in time, with the bit at the <strong>Snapshot</strong> depth chosen above the plots (Auto = end of a BHA run, Manual = any MD; it uses the BHA run, hole sections and casings that exist at that depth) — K&amp;M call this the <strong>"snapshot"</strong> view [KM15]. One curve per operation: Tripping In, Tripping Out, Rotating On Bottom, Slide Drilling and Rotating Off Bottom. Positive = tension, negative = compression. The plotted values include the Block Weight entered in Global Parameters. The Sinusoidal and Helical Limit lines are on the same basis: where a case curve drops below a limit line, that part of the string is buckled.</p>',
        how: '<p>Soft-string model of Johancsik et al. [JFD]. The string is cut into 10 m elements and the calculation starts at the bit and moves up. Boundary at the bit: compression = WOB for the on-bottom cases (WOB Rotating / WOB Sliding), zero off bottom. For each element:</p>'
          + '<p class="hp-eq">' + TD_EQ_N + ' &nbsp;&nbsp;(Eq. 1)<br>&Delta;F = W&middot;cos&theta; &plusmn; &mu;&middot;N &nbsp;&nbsp;(Eq. 2: + pulling out, &minus; running in)</p>'
          + '<p>F = axial force at the bottom of the element, W = buoyed element weight (weight &times; (1 &minus; mud density / steel density)), &theta; = inclination, &Delta;&theta; / &Delta;&alpha; = inclination / azimuth change over the element, &mu; = friction factor of that interval (FF Casing 1, FF Casing 2 or FF Open Hole). When rotating with no axial motion there is no axial friction term. When tripping <em>with</em> rotation, friction is split along the resultant velocity: axial share = V<sub>a</sub>/V<sub>r</sub>, torque share = V<sub>c</sub>/V<sub>r</sub>, V<sub>r</sub> = &radic;(V<sub>a</sub>&sup2;+V<sub>c</sub>&sup2;), V<sub>c</sub> = &pi;&middot;OD&middot;RPM [KM05].</p>'
          + '<p>Where the compression exceeds the helical limit, the extra wall contact of the coiled pipe is added to N [MIT Eq. A-18; KM05]: <span class="hp-eq-in">N<sub>b</sub> = r&middot;F&sup2; / (4&middot;E&middot;I)</span> per unit length (r = radial clearance, E = Young\'s modulus, I = moment of inertia). If that extra drag would exceed the buoyed weight of the element, MTX caps it and flags lock-up; loads above a locked interval are lower-bound estimates.</p>'
          + '<p><strong>Buckling limits</strong> [KM05 slide 56, from SPE 11167]: sinusoidal <span class="hp-eq-in">F<sub>cs</sub> = &radic;(4&middot;E&middot;I&middot;W&middot;sin&theta; / r)</span>; helical <span class="hp-eq-in">F<sub>cb</sub> = 1.414 &times; F<sub>cs</sub></span> (Chen-Cheatham, default). The alternative Wu-Juvkam-Wold 1.83&times; criterion and the Lubinski formula MTX uses below 3&deg; inclination are cited in tdModel.js, but those papers are not in the folder.</p>',
        why: '<p>This is where the string is in tension or compression for each operation. Sinusoidal ("snaky") buckling still transfers weight, but inefficiently. Helical ("coiled") buckling prevents further weight transfer: while sliding or tripping in, the extra contact force compounds on itself and can cause lock-up; while rotating, it causes a rapid increase in torque [KM05]. Buckling is most likely in vertical sections, tangents (especially slim pipe above a liner top) and near the heel of long horizontals [KM05].</p>'
          + '<p>Note: a snapshot only says "<em>if</em> you can get this deep, this is what will happen". Check the Hookload plot for the loads on the way down [KM15].</p>',
        src: ['JFD', 'MIT', 'KM05', 'KM15', 'CODE']
      },
      hl: {
        title: 'Hookload',
        what: '<p>The surface load the weight indicator should show as the bit moves through the well — K&amp;M call this the <strong>"driller\'s view"</strong> or tripping-type calculation [KM15]. One curve per operation (Tripping In = slack-off, Tripping Out = pick-up, Rotating On/Off Bottom, Slide Drilling), plotted against bit depth. A dashed vertical line marks where the BHA run changes. If EDR data was loaded, the measured hook load is overlaid as points.</p>',
        how: '<p>For every bit depth (each 30.48 m, plus the end of each run) MTX rebuilds the string of the BHA run drilling at that depth (its BHA, then its drill pipe, with only the casings already set and the hole size, mud weight and FF Open Hole of the hole sections), and runs the same calculation as the Effective Tension plot from the bit to surface: Johancsik Eqs. 1–2 [JFD], helical-buckling contact [MIT], velocity-resolved friction when rotating while tripping [KM05]. The value plotted is the surface force plus the Block Weight.</p>',
        why: '<p>A snapshot at TD can look fine while the tripping calculation shows the worst load at an intermediate depth, with the string stopping long before TD [KM15]. Pick-up is much more sensitive to the friction factor than slack-off [KM05]. Comparing this plot with real EDR hook loads is how friction factors are calibrated: Johancsik et al. back-calculated friction by iterating the model until it matched measured pick-up, slack-off and torque, and found 0.25–0.40 typical for water-base mud [JFD]. Block weight errors directly corrupt a back-calculated FF, so block weight must be right [KM15].</p>',
        src: ['JFD', 'MIT', 'KM05', 'KM15', 'CODE']
      },
      sf: {
        title: 'Side Forces',
        what: '<p>The normal (contact) force between the pipe and the hole wall along the string with the bit at TD, for each operation. Shown in kgf per "SF Norm. Length" (Global Parameters; default 9.45 m = one Range 2 drill-pipe joint).</p>',
        how: '<p>N for each 10 m element comes from Johancsik Eq. 1 [JFD]:</p><p class="hp-eq">' + TD_EQ_N + '</p>'
          + '<p>It has two parts: the weight of the pipe lying on the low side (W&middot;sin&theta;), and the tension F pulling the pipe against the wall through inclination and azimuth changes [JFD; KM05]. Where the pipe is helically buckled, the coil contact N<sub>b</sub> = r&middot;F&sup2;/(4EI) is added [MIT]. MTX converts N to kgf per metre and multiplies it by the normalization length.</p>',
        why: '<p>Friction = &mu; &times; N, so side force is the source of all torque and drag [JFD]. High tension through shallow doglegs creates high contact force and can cause severe casing wear. K&amp;M flag casing-wear concern when side forces exceed about 2 k-lbf (&asymp; 1 tonne) per tool joint [KM05]. Pick-up side force across a build is much higher than slack-off [KM05].</p>',
        src: ['JFD', 'MIT', 'KM05', 'CODE']
      },
      tq: {
        title: 'Surf. Torque',
        what: '<p>Torque carried by the string at each depth, with the bit at TD, for each operation. The value at MD 0 is the surface (top drive / rotary) torque, which is the only point the driller actually sees [KM05]. The dashed red line is the Torque Limit from Global Parameters. If EDR data was loaded, measured torque is overlaid as points.</p>',
        how: '<p>Johancsik Eq. 3 [JFD], summed from the bit up:</p><p class="hp-eq">&Delta;M = &mu; &middot; N &middot; r</p>'
          + '<p>N = element contact force (see Side Forces), r = half the component OD entered in the Drill String table. Starting value at the bit: Torque at Bit for on-bottom cases, zero off bottom. Slide Drilling has no rotation, so there is no torsional friction and the surface torque equals the bit torque. Tripping with RPM &gt; 0 gets only the torque share V<sub>c</sub>/V<sub>r</sub> of the friction [KM05].</p>',
        why: '<p>Torque is very sensitive to the friction factor and builds quickly through build sections [KM05]. Compare the surface value with the Torque Limit, which should reflect drill pipe connection make-up torque and the pipe\'s torque limit [KM05].</p>',
        src: ['JFD', 'KM05', 'CODE']
      },
      inc: {
        title: 'Inclination',
        what: '<p>Hole inclination (angle from vertical) against measured depth. Between survey stations the values are linearly interpolated onto the 10 m calculation points used by the T&amp;D model.</p>',
        how: '<p>Taken directly from the survey table (section 02), extended to TD at the last surveyed angle if the survey stops short.</p>',
        why: '<p>Inclination controls both terms of the force balance: the low-side contact W&middot;sin&theta; that creates friction, and the axial weight W&middot;cos&theta; that pulls the string down [JFD; KM05]. Small angle changes matter at high angle: cos 80&deg; is 33% different from cos 75&deg; [KM15]. Pipe is harder to buckle at higher angles (gravity holds it on the low side), but not impossible [KM05].</p>',
        src: ['JFD', 'KM05', 'KM15', 'CODE']
      },
      dls: {
        title: 'DLS — Dogleg Severity',
        what: '<p>Dogleg severity (deg/30 m) against measured depth, i.e. how sharply the hole curves. Values between survey stations are linearly interpolated onto the 10 m calculation points.</p>',
        how: '<p>DLS = &beta; / &Delta;MD &times; 30 m, where &beta; is the overall angle change between two survey stations [BOU Sec. 8.4.6; Eq. 8.33]:</p>'
          + '<p class="hp-eq">cos &beta; = cos(I<sub>2</sub>&minus;I<sub>1</sub>) &minus; sin I<sub>1</sub> sin I<sub>2</sub> [1 &minus; cos(A<sub>2</sub>&minus;A<sub>1</sub>)]</p>',
        why: '<p>In curved sections, tension creates extra contact force like a brake drum, so pick-up, slack-off and rotating loads all differ through doglegs [KM05]. Doglegs under high tension (shallow in the well) create high side forces and casing wear. Build rates of 2–3&deg;/100 ft are <em>not</em> "low", and not all doglegs are equal [KM05]. Trajectories that start with a slow build and accelerate (pseudo-catenary) reduce side forces [KM05].</p>',
        src: ['BOU', 'KM05', 'CODE']
      }
    };

    function openTdHelp(key) {
      var h = TD_HELP[key]; if (!h) return;
      document.getElementById('hpTitle').innerHTML = h.title;
      document.getElementById('hpBody').innerHTML =
        '<h4>What you are looking at</h4>' + h.what
        + '<h4>How it is calculated</h4>' + h.how
        + '<h4>Why it matters</h4>' + h.why
        + '<h4>Sources (in the MTX AC folder)</h4><ol class="hp-src">'
        + h.src.map(function (k) { return '<li><strong>[' + k + ']</strong> ' + TD_SRC[k] + '</li>'; }).join('')
        + '</ol>';
      document.getElementById('hpModal').classList.add('open');
    }
    function closeTdHelp() { document.getElementById('hpModal').classList.remove('open'); }
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeTdHelp(); });

    // =============================================================
    // HOLE SECTIONS + BHA RUNS — UI (added 2026-11-08, John)
    // PLAN is kept in SI and saved inside params.plan (see tdModel.js header
    // "HOLE SECTIONS + BHA RUNS" for the model rules). The existing BHA table
    // (#bhaBody) and the new DP table (#dpBody) are the editors of the run
    // ticked "Edit", so Load CNRL / Excel import-export / SAGcorrection import
    // all keep working — they act on the run being edited.
    // Old jobs (no plan) are migrated on load: sections from the casing
    // program (Auto) + one run OH Top -> TD with the old BHA, WOB, torque at
    // bit, mud weight and FF OH. Regression-tested on the CNRL example:
    // identical results to the single-BHA model.
    // =============================================================
    var PLAN = null, CUR_RUN = null, HL_RUN_MARKS = [];

    function pM() { return UNIT === 'metric'; }
    function dDisp(m) { return pM() ? m : m / FT; }
    function dSI(v) { return pM() ? v : v * FT; }
    function fDisp(N) { return pM() ? N / 10000 : N / 1000 * KN2KLBF; }
    function fSI(v) { return pM() ? v * 10000 : v / KN2KLBF * 1000; }
    function mwDisp(k) { return pM() ? k : k * KGM32PPG; }
    function mwSI(v) { return pM() ? v : v / KGM32PPG; }
    // keep up to 6 decimals, trailing zeros trimmed: re-rendering a table must not round the inputs
    function r2(v, n) { return (v == null || !isFinite(v)) ? '' : String(+(+v).toFixed(6)); }
    function esc(t) { return String(t == null ? '' : t).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;'); }
    function planTD() { var v = +document.getElementById('td').value || 0; return pM() ? v : v * FT; }
    function newRunId() { return 'r' + Date.now().toString(36) + Math.floor(Math.random() * 1e4).toString(36); }

    // ---- build a plan from the legacy single-BHA inputs (migration / first load)
    function planInitFromLegacy() {
      var par = getParams(); // PLAN is null here, so no plan is attached
      PLAN = {
        sectionMode: 'auto', snapMode: 'auto', snapRunId: null, snapMD: par.td,
        sections: [],
        runs: [{
          id: newRunId(), name: 'Run 1', use: true,
          from: Math.min(par.ohTop || 0, par.td), to: par.td,
          wobRot: par.wobRot, wobSlid: par.wobSlid, torqBit: par.torqBit,
          bha: getBHA(), dp: []
        }]
      };
      planAutoSections(par.ohDiam_m, par.mudDens, par.ffOH);
      CUR_RUN = PLAN.runs[0].id;
      planRenderAll();
    }

    // Auto mode: section boundaries = surface, each casing shoe (< TD), TD.
    // Values (name, hole, MW, FF OH) are kept by position when shoes change.
    function planAutoSections(holeDef, mwDef, ffDef) {
      if (!PLAN || PLAN.sectionMode !== 'auto') return;
      var td = planTD();
      var shoes = getCasings().map(function (c) { return c.shoe; })
        .filter(function (s) { return s > 0 && s < td; }).sort(function (a, b) { return a - b; });
      var b = [0].concat(shoes.filter(function (s, i, a) { return i === 0 || s !== a[i - 1]; })).concat([td]);
      var old = PLAN.sections || [], out = [];
      for (var i = 0; i < b.length - 1; i++) {
        var o = old[i] || old[old.length - 1] || {};
        out.push({
          name: (old[i] && old[i].name) || ('Section ' + (i + 1)),
          from: b[i], to: b[i + 1],
          hole_m: o.hole_m != null ? o.hole_m : (holeDef || 0.159),
          mudDens: o.mudDens != null ? o.mudDens : (mwDef || 1040),
          ffOH: o.ffOH != null ? o.ffOH : (ffDef != null ? ffDef : 0.30)
        });
      }
      PLAN.sections = out;
    }

    // ---- read tables -> PLAN (SI)
    function planReadSections() {
      if (!PLAN) return;
      PLAN.sections = Array.from(document.querySelectorAll('#secBody tr')).map(function (tr) {
        var g = function (k) { return tr.querySelector('[data-k="' + k + '"]').value; };
        return { name: g('name'), from: dSI(+g('from')), to: dSI(+g('to')), hole_m: +g('hole') / 1000, mudDens: mwSI(+g('mw')), ffOH: +g('ff') };
      });
      planWarn();
    }
    function planReadRuns() {
      if (!PLAN) return;
      var byId = {}; PLAN.runs.forEach(function (r) { byId[r.id] = r; });
      PLAN.runs = Array.from(document.querySelectorAll('#runBody tr')).map(function (tr) {
        var id = tr.getAttribute('data-id'), r = byId[id] || { id: id, bha: [], dp: [] };
        var g = function (k) { return tr.querySelector('[data-k="' + k + '"]'); };
        r.use = g('use').checked; r.name = g('name').value;
        r.from = dSI(+g('from').value); r.to = dSI(+g('to').value);
        r.wobRot = fSI(+g('wobr').value); r.wobSlid = fSI(+g('wobs').value); r.torqBit = +g('tqb').value || 0;
        return r;
      });
      var cur = planCurRun(); document.getElementById('runEditName').textContent = cur ? cur.name : '—';
      planRenderSnapRuns(); planWarn();
    }
    function planCurRun() { return PLAN ? PLAN.runs.filter(function (r) { return r.id === CUR_RUN; })[0] : null; }
    // copy the BHA / DP editor tables into the run being edited
    function planSyncTables() {
      var r = planCurRun(); if (!r) return;
      r.bha = getBHA(); r.dp = getDP();
    }

    function getDP() {
      var M = pM();
      return Array.from(document.querySelectorAll('#dpBody tr')).map(function (r) {
        var ins = r.querySelectorAll('input');
        return { name: ins[0].value, od_m: +ins[1].value / 1000, id_m: +ins[2].value / 1000,
          len: M ? +ins[3].value : +ins[3].value * FT, wt: M ? +ins[4].value : +ins[4].value / KGM2LBFT };
      }).filter(function (r) { return r.od_m > 0 && r.len > 0; });
    }
    function addDP(nm, od, id_, len, wt) {
      var tr = document.createElement('tr');
      tr.innerHTML = mkText(nm || '', 'DP / HWDP') + mkCell(od || '', 'OD') + mkCell(id_ || '', 'ID') + mkCell(len || '', 'Len') + mkCell(wt || '', 'Wt') + delBtn();
      document.getElementById('dpBody').appendChild(tr);
    }
    function planLoadRunTables(r) {
      var M = pM();
      document.getElementById('bhaBody').innerHTML = '';
      document.getElementById('dpBody').innerHTML = '';
      (r.bha || []).forEach(function (c) { addBHA(c.name, r2(c.od_m * 1000), r2(c.id_m * 1000), r2(M ? c.len : c.len / FT), r2(M ? c.wt : c.wt * KGM2LBFT)); });
      (r.dp || []).forEach(function (c) { addDP(c.name, r2(c.od_m * 1000), r2(c.id_m * 1000), r2(M ? c.len : c.len / FT), r2(M ? c.wt : c.wt * KGM2LBFT)); });
      document.getElementById('runEditName').textContent = r.name;
    }

    // ---- render PLAN -> tables
    function planRenderSections() {
      var auto = PLAN.sectionMode === 'auto', ro = auto ? ' readonly title="Auto: from the casing program"' : '';
      document.getElementById('btnSecAuto').classList.toggle('active', auto);
      document.getElementById('btnSecMan').classList.toggle('active', !auto);
      document.getElementById('secAddRow').style.display = auto ? 'none' : '';
      document.getElementById('secBody').innerHTML = PLAN.sections.map(function (s) {
        return '<tr>'
          + '<td><input type="text" data-k="name" value="' + esc(s.name) + '"/></td>'
          + '<td><input type="number" step="any" data-k="from" value="' + r2(dDisp(s.from), 1) + '"' + ro + '/></td>'
          + '<td><input type="number" step="any" data-k="to" value="' + r2(dDisp(s.to), 1) + '"' + ro + '/></td>'
          + '<td><input type="number" step="any" data-k="hole" value="' + r2(s.hole_m * 1000, 1) + '"/></td>'
          + '<td><input type="number" step="any" data-k="mw" value="' + r2(mwDisp(s.mudDens), pM() ? 0 : 2) + '"/></td>'
          + '<td><input type="number" step="any" data-k="ff" value="' + r2(s.ffOH, 2) + '"/></td>'
          + '<td>' + (auto ? '' : '<button class="del" onclick="this.closest(\'tr\').remove();planReadSections();scheduleAutoSave()">x</button>') + '</td></tr>';
      }).join('');
    }
    function planRenderRuns() {
      document.getElementById('runBody').innerHTML = PLAN.runs.map(function (r) {
        return '<tr data-id="' + r.id + '">'
          + '<td style="text-align:center"><input type="radio" name="runEdit" data-k="edit"' + (r.id === CUR_RUN ? ' checked' : '') + ' onchange="planSwitchRun(\'' + r.id + '\')"/></td>'
          + '<td style="text-align:center"><input type="checkbox" data-k="use"' + (r.use !== false ? ' checked' : '') + '/></td>'
          + '<td><input type="text" data-k="name" value="' + esc(r.name) + '"/></td>'
          + '<td><input type="number" step="any" data-k="from" value="' + r2(dDisp(r.from), 1) + '"/></td>'
          + '<td><input type="number" step="any" data-k="to" value="' + r2(dDisp(r.to), 1) + '"/></td>'
          + '<td><input type="number" step="any" data-k="wobr" value="' + r2(fDisp(r.wobRot), 2) + '"/></td>'
          + '<td><input type="number" step="any" data-k="wobs" value="' + r2(fDisp(r.wobSlid), 2) + '"/></td>'
          + '<td><input type="number" step="any" data-k="tqb" value="' + r2(r.torqBit, 0) + '"/></td>'
          + '<td><button class="del" title="Delete run" onclick="planDelRun(\'' + r.id + '\')">x</button></td></tr>';
      }).join('');
    }
    function planRenderSnap() {
      var man = PLAN.snapMode === 'manual';
      document.getElementById('btnSnapAuto').classList.toggle('active', !man);
      document.getElementById('btnSnapMan').classList.toggle('active', man);
      document.getElementById('snapRun').style.display = man ? 'none' : '';
      document.getElementById('snapMDWrap').style.display = man ? '' : 'none';
      document.getElementById('snapMD').value = r2(dDisp(PLAN.snapMD != null ? PLAN.snapMD : planTD()), 1);
      document.getElementById('lSnapMD').textContent = pM() ? 'Bit MD (m)' : 'Bit MD (ft)';
      planRenderSnapRuns();
    }
    function planRenderSnapRuns() {
      var act = TDModelCore.planActiveRuns(PLAN), sel = document.getElementById('snapRun');
      var deep = act.length ? act.reduce(function (a, b) { return b.to >= a.to ? b : a; }) : null;
      var cur = act.filter(function (r) { return r.id === PLAN.snapRunId; })[0] || deep;
      sel.innerHTML = act.map(function (r) {
        return '<option value="' + r.id + '"' + (cur && r.id === cur.id ? ' selected' : '') + '>End of ' + esc(r.name) + ' — bit at ' + r2(dDisp(r.to), 0) + (pM() ? ' m' : ' ft') + '</option>';
      }).join('') || '<option value="">No run ticked "T&D"</option>';
    }
    function planRenderAll() {
      if (!PLAN) return;
      planRenderSections(); planRenderRuns(); planRenderSnap();
      var cur = planCurRun() || PLAN.runs[0];
      if (cur) { CUR_RUN = cur.id; planLoadRunTables(cur); }
      planLabels(); planWarn();
    }
    function planLabels() {
      var M = pM(), dU = M ? '(m)' : '(ft)', fU = M ? '(kDaN)' : '(klbf)';
      var set = function (id, t) { var e = document.getElementById(id); if (e) e.textContent = t; };
      set('th_sfrom', 'From ' + dU); set('th_sto', 'To ' + dU); set('th_smw', M ? 'MW (kg/m3)' : 'MW (ppg)');
      set('th_rfrom', 'From ' + dU); set('th_rto', 'To ' + dU); set('th_rwobr', 'WOB Rot ' + fU); set('th_rwobs', 'WOB Slide ' + fU);
      set('th_dlen', M ? 'Length (m)' : 'Length (ft)'); set('th_dwt', M ? 'Wt (kg/m)' : 'Wt (lb/ft)');
      set('lLibLen', M ? 'Length (m)' : 'Length (ft)');
    }

    // ---- actions
    function planSetSectionMode(m) {
      if (!PLAN) return; planReadSections();
      PLAN.sectionMode = m; planAutoSections(); planRenderSections(); planWarn(); scheduleAutoSave();
    }
    function planAddSection() {
      planReadSections();
      var last = PLAN.sections[PLAN.sections.length - 1] || { to: 0, hole_m: 0.159, mudDens: 1040, ffOH: 0.3 };
      PLAN.sections.push({ name: 'Section ' + (PLAN.sections.length + 1), from: last.to, to: planTD(), hole_m: last.hole_m, mudDens: last.mudDens, ffOH: last.ffOH });
      planRenderSections(); planWarn(); scheduleAutoSave();
    }
    function planAddRun(copy) {
      planSyncTables(); planReadRuns();
      var src = copy ? planCurRun() : null, last = PLAN.runs[PLAN.runs.length - 1];
      var r = src ? JSON.parse(JSON.stringify(src)) : {
        use: true, from: last ? last.to : 0, to: planTD(),
        wobRot: last ? last.wobRot : 200000, wobSlid: last ? last.wobSlid : 190000, torqBit: last ? last.torqBit : 0, bha: [], dp: []
      };
      r.id = newRunId(); r.name = src ? src.name + ' (copy)' : 'Run ' + (PLAN.runs.length + 1);
      PLAN.runs.push(r); CUR_RUN = r.id;
      planRenderRuns(); planLoadRunTables(r); planRenderSnapRuns(); planWarn(); scheduleAutoSave();
    }
    function planDelRun(id) {
      planSyncTables(); planReadRuns();
      if (PLAN.runs.length <= 1) { alert('A well needs at least one BHA run.'); return; }
      var r = PLAN.runs.filter(function (x) { return x.id === id; })[0];
      if (!confirm('Delete run "' + (r ? r.name : '') + '" and its BHA / drill pipe?')) return;
      PLAN.runs = PLAN.runs.filter(function (x) { return x.id !== id; });
      if (CUR_RUN === id) CUR_RUN = PLAN.runs[0].id;
      planRenderRuns(); planLoadRunTables(planCurRun()); planRenderSnapRuns(); planWarn(); scheduleAutoSave();
    }
    function planSwitchRun(id) {
      planSyncTables(); CUR_RUN = id; var r = planCurRun(); if (r) planLoadRunTables(r);
      planRenderTimeline();
    }
    function planSetSnapMode(m) {
      if (!PLAN) return; PLAN.snapMode = m; planRenderSnap(); scheduleAutoSave();
    }
    function planSnapChanged() {
      if (!PLAN) return;
      PLAN.snapRunId = document.getElementById('snapRun').value || null;
      PLAN.snapMD = dSI(+document.getElementById('snapMD').value);
      scheduleAutoSave();
    }

    // Checks shown under the runs table (warnings only — nothing is blocked)
    function planWarn() {
      var el = document.getElementById('planWarn'); if (!el || !PLAN) return;
      var w = [], td = planTD(), act = TDModelCore.planActiveRuns(PLAN), u = pM() ? ' m' : ' ft';
      var f = function (v) { return r2(dDisp(v), 0) + u; };
      if (!act.length) w.push('No run is ticked "T&D" (or the ticked runs have no BHA / DP) — the model falls back to the BHA table as a single string.');
      PLAN.runs.forEach(function (r) {
        if (!(r.to > r.from)) w.push('Run "' + r.name + '": To must be deeper than From.');
        if (r.to > td + 0.01) w.push('Run "' + r.name + '" ends below TD (' + f(td) + ').');
      });
      var cov = 0;
      // 2026-11-08 round 5: also report MD above the first run (not covered by any run)
      if (act.length && act[0].from > 0.5) w.push('No T&D run from surface to ' + f(act[0].from) + ' — Hookload uses the first run ("' + act[0].name + '") there.');
      act.forEach(function (r) { if (r.from > cov + 0.5 && cov > 0) w.push('Gap: no T&D run between ' + f(cov) + ' and ' + f(r.from) + ' (Hookload is not plotted there).'); cov = Math.max(cov, r.to); });
      // runs that fall outside their hole section (section = the one at the run's mid-depth,
      // whose mud weight the model uses for the whole run)
      PLAN.runs.forEach(function (r) {
        if (!(r.to > r.from)) return;
        var sec = TDModelCore.planSectionAt(PLAN, (r.from + r.to) / 2);
        if (!sec) return;
        if (r.from < sec.from - 0.5 || r.to > sec.to + 0.5)
          w.push('Run "' + r.name + '" (' + f(r.from) + '–' + f(r.to) + ') falls outside its hole section "' + sec.name + '" (' + f(sec.from) + '–' + f(sec.to) + '): the whole run uses that section\'s mud weight; hole size still follows the section at each MD.');
      });
      if (act.length && cov < td - 0.5) w.push('No T&D run reaches TD — last run ends at ' + f(cov) + '.');
      for (var i = 0; i < act.length; i++) for (var j = i + 1; j < act.length; j++)
        if (act[j].from < act[i].to - 0.5) w.push('Runs "' + act[i].name + '" and "' + act[j].name + '" overlap — where both apply, the one starting deeper is used.');
      if (PLAN.sectionMode === 'manual') {
        var ss = PLAN.sections.slice().sort(function (a, b) { return a.from - b.from; }), c = 0;
        ss.forEach(function (s) { if (s.from > c + 0.5) w.push('Sections: gap between ' + f(c) + ' and ' + f(s.from) + '.'); c = Math.max(c, s.to); });
        if (c < td - 0.5) w.push('Sections do not reach TD (' + f(td) + ').');
      }
      el.innerHTML = w.length ? w.map(function (t) { return '&#9888; ' + esc(t); }).join('<br>') : '&#10003; Sections and runs cover the well.';
      el.style.color = w.length ? 'var(--yellow)' : 'var(--accent3)';
      planRenderTimeline();
    }

    // FF calibration "Apply to Model": the open-hole slider applies to every section.
    function planApplyFFOH(v) {
      if (!PLAN) return; planReadSections();
      PLAN.sections.forEach(function (s) { s.ffOH = v; }); planRenderSections();
    }

    // Plan as saved in params (SI, deep copy, editors synced first).
    function planForSave() {
      if (!PLAN) return null;
      if (document.getElementById('runBody').children.length) { planSyncTables(); planReadRuns(); }
      if (PLAN.sectionMode === 'auto') planAutoSections(); else planReadSections();
      return JSON.parse(JSON.stringify(PLAN));
    }

    function initPlanUI() {
      // legacy single-value inputs now live per section / per run
      ['mudWeight', 'wobRot', 'wobSlid', 'torqBit', 'ffOH', 'ohDiam', 'ohTop'].forEach(function (id) {
        var e = document.getElementById(id); if (e && e.parentNode) e.parentNode.style.display = 'none';
      });
      var sb = document.getElementById('secBody'), rb = document.getElementById('runBody');
      sb.addEventListener('input', planReadSections);
      rb.addEventListener('input', planReadRuns);
      rb.addEventListener('change', function (e) { if (e.target.getAttribute('data-k') !== 'edit') planReadRuns(); });
      // auto sections follow the casing program and TD
      var casChanged = function () { if (PLAN && PLAN.sectionMode === 'auto') { planAutoSections(); planRenderSections(); planWarn(); } };
      document.getElementById('casBody').addEventListener('input', casChanged);
      document.getElementById('td').addEventListener('input', function () { casChanged(); planWarn(); });
      if (window.MutationObserver) {
        new MutationObserver(casChanged).observe(document.getElementById('casBody'), { childList: true });
        ['secBody', 'runBody', 'dpBody'].forEach(function (id) {
          new MutationObserver(scheduleAutoSave).observe(document.getElementById(id), { childList: true });
        });
      }
    }

    // =============================================================
    // RESET FOR A NEW WELL (2026-11-08 round 6): used when a job well with
    // no saved T&D setup is loaded. Keeps the BHA / drill pipe and WOB /
    // torque of the run being edited and the section values (hole size,
    // MW, FF OH by position), but rebuilds: sections = AUTO from the
    // casing program and this well's TD; ONE run from the deepest casing
    // shoe above TD (0 if none) to TD; snapshot AUTO.
    // =============================================================
    function planResetForWell() {
      if (!PLAN) { planInitFromLegacy(); return; }
      planSyncTables();
      var cur = planCurRun() || PLAN.runs[0] || {};
      var td = planTD();
      var top = getCasings().reduce(function (a, c) { return (c.shoe < td && c.shoe > a) ? c.shoe : a; }, 0);
      PLAN.sectionMode = 'auto';
      PLAN.snapMode = 'auto'; PLAN.snapRunId = null; PLAN.snapMD = td;
      PLAN.runs = [{
        id: newRunId(), name: 'Run 1', use: true, from: top, to: td,
        wobRot: cur.wobRot, wobSlid: cur.wobSlid, torqBit: cur.torqBit,
        bha: cur.bha || getBHA(), dp: cur.dp || []
      }];
      CUR_RUN = PLAN.runs[0].id;
      planAutoSections();
      planRenderAll();
    }

    // =============================================================
    // DEPTH TIMELINE (added 2026-11-08 round 5): sections as coloured
    // blocks, casing shoes as ticks, BHA runs as segments (overlapping runs
    // stacked in lanes), uncovered MD shaded red. Click a run to edit it.
    // =============================================================
    var TL_COLORS = ['#2563eb', '#0d9488', '#7c3aed', '#c2410c', '#be185d', '#4d7c0f', '#0369a1'];
    function planSelectRun(id) {
      planSwitchRun(id);
      document.querySelectorAll('#runBody input[data-k="edit"]').forEach(function (r) { r.checked = r.closest('tr').getAttribute('data-id') === id; });
      planRenderTimeline();
      var ed = document.getElementById('runEditName'); if (ed && ed.scrollIntoView) ed.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    }
    function planRenderTimeline() {
      var el = document.getElementById('planTimeline'); if (!el || !PLAN) return;
      var td = planTD(); if (!(td > 0)) { el.innerHTML = ''; return; }
      var u = pM() ? 'm' : 'ft', pct = function (md) { return Math.max(0, Math.min(100, md / td * 100)); };
      var h = '';
      // axis ticks
      var stepRaw = td / 6, mag = Math.pow(10, Math.floor(Math.log10(stepRaw))), step = [1, 2, 2.5, 5, 10].map(function (k) { return k * mag; }).filter(function (v) { return v >= stepRaw; })[0];
      h += '<div class="tl-axis">';
      for (var d = 0; d <= td * 0.82; d += step) h += '<span style="left:' + pct(d) + '%">' + Math.round(dDisp(d)) + '</span>';
      h += '<span style="left:100%" class="tl-td">TD ' + Math.round(dDisp(td)) + ' ' + u + '</span></div>';
      // sections lane
      h += '<div class="tl-lane-lbl">Hole sections</div><div class="tl-lane">';
      PLAN.sections.slice().sort(function (a, b) { return a.from - b.from; }).forEach(function (s, i) {
        h += '<div class="tl-sec" style="left:' + pct(s.from) + '%;width:' + (pct(s.to) - pct(s.from)) + '%;background:' + TL_COLORS[i % TL_COLORS.length] + '" title="' + esc(s.name) + ': ' + r2(dDisp(s.from)) + '–' + r2(dDisp(s.to)) + ' ' + u + ', hole ' + r2(s.hole_m * 1000) + ' mm, MW ' + r2(mwDisp(s.mudDens)) + ', FF OH ' + r2(s.ffOH) + '"><span>' + esc(s.name) + ' · ' + r2(+(s.hole_m * 1000).toFixed(1)) + ' mm</span></div>';
      });
      getCasings().forEach(function (c) {
        if (c.shoe > 0 && c.shoe <= td) h += '<div class="tl-shoe" style="left:' + pct(c.shoe) + '%" title="' + esc(c.name) + ' shoe ' + r2(dDisp(c.shoe)) + ' ' + u + '">&#9660;</div>';
      });
      h += '</div>';
      // runs lanes (greedy stacking of overlaps)
      var runs = PLAN.runs.slice().sort(function (a, b) { return a.from - b.from; }), lanes = [];
      runs.forEach(function (r) {
        var k = 0; while (lanes[k] && lanes[k].some(function (o) { return r.from < o.to - 0.5 && o.from < r.to - 0.5; })) k++;
        (lanes[k] = lanes[k] || []).push(r);
      });
      // uncovered MD (ticked runs only)
      var act = TDModelCore.planActiveRuns(PLAN), gaps = [], cov = 0;
      act.forEach(function (r) { if (r.from > cov + 0.5) gaps.push([cov, r.from]); cov = Math.max(cov, r.to); });
      if (cov < td - 0.5) gaps.push([cov, td]);
      h += '<div class="tl-lane-lbl">BHA runs <span style="opacity:.7">(click to edit)</span></div>';
      (lanes.length ? lanes : [[]]).forEach(function (lane, li) {
        h += '<div class="tl-lane tl-runs">';
        if (li === 0) gaps.forEach(function (g) { h += '<div class="tl-gap" style="left:' + pct(g[0]) + '%;width:' + (pct(g[1]) - pct(g[0])) + '%" title="No T&amp;D run ' + r2(dDisp(g[0]), 0) + '–' + r2(dDisp(g[1]), 0) + ' ' + u + '"></div>'; });
        lane.forEach(function (r) {
          var cls = 'tl-run' + (r.use === false ? ' off' : '') + (r.id === CUR_RUN ? ' sel' : '');
          h += '<div class="' + cls + '" style="left:' + pct(r.from) + '%;width:' + Math.max(0.6, pct(r.to) - pct(r.from)) + '%" onclick="planSelectRun(\'' + r.id + '\')" title="' + esc(r.name) + ': ' + r2(dDisp(r.from)) + '–' + r2(dDisp(r.to)) + ' ' + u + (r.use === false ? ' (not used in T&amp;D)' : '') + ' — click to edit"><span>' + esc(r.name) + '</span></div>';
        });
        h += '</div>';
      });
      el.innerHTML = h;
    }

    // =============================================================
    // BHA LIBRARY picker (added 2026-11-08 round 5) — public/data/bhaLibrary.json
    // (dimensional catalogue converted from Hydraulics.xls: DC, HWDP, DP,
    // SWDP, MWD, motors). Adds ONE component on top of the BHA or Drill
    // Pipe table of the run being edited (tables are bottom-up). Missing
    // weight -> steel density x pi/4 (OD^2 - ID^2), same rule as the
    // SAGcorrection import; MWD / motor weight = catalogue weight / length.
    // =============================================================
    var BHA_LIB = null, LIB_CATS = [
      ['drillCollar', 'Drill Collar'], ['hwdp', 'HWDP'], ['drillPipe', 'Drill Pipe'], ['swdp', 'SWDP'], ['mwd', 'MWD / LWD'], ['motor', 'Motor']];
    async function libPickOpen() {
      var box = document.getElementById('libPick'); box.style.display = '';
      if (!BHA_LIB) {
        try { BHA_LIB = await (await fetch('/data/bhaLibrary.json')).json(); }
        catch (e) { document.getElementById('libNote').textContent = 'Could not load the BHA library: ' + e.message; return; }
      }
      var cat = document.getElementById('libCat');
      if (!cat.options.length) cat.innerHTML = LIB_CATS.map(function (c) { return '<option value="' + c[0] + '">' + c[1] + '</option>'; }).join('');
      libPickCat();
    }
    function libItemLabel(cat, it) {
      var base = (it.description ? it.description + ' — ' : '') + 'OD ' + it.od_mm + ' mm';
      if (it.id_mm != null) base += ' × ID ' + it.id_mm + ' mm';
      if (it.grade) base += ' · ' + it.grade;
      if (it.actWt_kgm != null) base += ' · ' + it.actWt_kgm + ' kg/m';
      if (it.tjType) base += ' · ' + it.tjType + (it.tjOd_mm ? ' (TJ OD ' + it.tjOd_mm + ')' : '');
      if (it.length_m != null) base += ' · ' + it.length_m + ' m';
      return base;
    }
    function libPickCat() {
      var cat = document.getElementById('libCat').value, items = (BHA_LIB && BHA_LIB[cat]) || [];
      document.getElementById('libItem').innerHTML = items.map(function (it, i) { return '<option value="' + i + '">' + esc(libItemLabel(cat, it)) + '</option>'; }).join('');
      document.getElementById('libTarget').value = (cat === 'drillPipe' || cat === 'hwdp' || cat === 'swdp') ? 'dp' : 'bha';
      libPickItem();
    }
    function libPickItem() {
      var cat = document.getElementById('libCat').value, it = ((BHA_LIB && BHA_LIB[cat]) || [])[+document.getElementById('libItem').value];
      if (!it) return;
      var len = it.length_m != null ? it.length_m : (cat === 'drillCollar' ? 9.45 : cat === 'hwdp' ? 9.45 : 9.45);
      document.getElementById('libLen').value = r2(dDisp(len));
      document.getElementById('lLibLen').textContent = pM() ? 'Length (m)' : 'Length (ft)';
      document.getElementById('libNote').textContent = (it.id_mm == null && it.equivId_mm == null)
        ? 'Catalogue has no ID for this item: ID is left at 0 (solid) — type the real bore if known (it affects weight and buckling stiffness).'
        : 'Adds one row on top of the selected table (lists are bottom-up).';
    }
    function libPickAdd() {
      var cat = document.getElementById('libCat').value, it = ((BHA_LIB && BHA_LIB[cat]) || [])[+document.getElementById('libItem').value];
      if (!it) return;
      var M = pM(), od = +it.od_mm, idv = it.id_mm != null ? +it.id_mm : (it.equivId_mm != null ? +it.equivId_mm : 0);
      var lenSI = dSI(+document.getElementById('libLen').value || 0);
      var wt = it.actWt_kgm != null ? +it.actWt_kgm
        : (it.weight_kg != null && it.length_m) ? +it.weight_kg / +it.length_m
        : (+document.getElementById('steelDens').value || 7850) * Math.PI / 4 * ((od / 1000) * (od / 1000) - (idv / 1000) * (idv / 1000));
      var name = (it.description || (LIB_CATS.filter(function (c) { return c[0] === cat; })[0][1] + ' ' + od)) + (it.grade ? ' ' + it.grade : '');
      var args = [name, r2(od), r2(idv), r2(M ? lenSI : lenSI / FT), r2(M ? wt : wt * KGM2LBFT)];
      if (document.getElementById('libTarget').value === 'dp') addDP.apply(null, args); else addBHA.apply(null, args);
      setStatus('ok', 'Added "' + name + '" from the BHA library to the ' + (document.getElementById('libTarget').value === 'dp' ? 'Drill Pipe' : 'BHA') + ' table of run "' + ((planCurRun() || {}).name || '') + '".');
    }

    // =============================================================
    // PRELOADED EXAMPLE (added 2026-11-08 round 5, John's request): the
    // CNRL ETS 158861 survey / casing / BHA (production run, matches the
    // WellPlan report at TD) PLUS an ILLUSTRATIVE intermediate run used to
    // test hole sections & runs. The intermediate BHA, drill pipe, WOB,
    // torque, 222.3 mm hole, 1100 kg/m3 MW and FF 0.35 are made-up test
    // values, NOT field data. Effective Tension / Side Forces / Torque with
    // the bit at TD are unchanged (they use the production run); Hookload
    // above 1138 m uses the illustrative run.
    // =============================================================
    function planLoadExample() {
      planInitFromLegacy();
      var s2 = PLAN.sections.filter(function (s) { return Math.abs(s.from - 200) < 1 && Math.abs(s.to - 1138) < 1; })[0];
      if (s2) { s2.name = 'Intermediate (example)'; s2.hole_m = 0.2223; s2.mudDens = 1100; s2.ffOH = 0.35; }
      PLAN.runs[0].name = 'Production 159 (CNRL)';
      PLAN.runs.unshift({
        id: newRunId(), name: 'Intermediate 222 (example)', use: true, from: 200, to: 1138,
        wobRot: 80000, wobSlid: 60000, torqBit: 2000,
        bha: [{ name: 'Bit 222', od_m: 0.2223, id_m: 0, len: 0.3, wt: 150 },
              { name: 'Motor 171', od_m: 0.171, id_m: 0.08, len: 9, wt: 140 },
              { name: 'DC 165', od_m: 0.165, id_m: 0.071, len: 90, wt: 130 }],
        dp: [{ name: 'HWDP 127', od_m: 0.127, id_m: 0.0762, len: 150, wt: 74 },
             { name: 'DP 127', od_m: 0.127, id_m: 0.1086, len: 10, wt: 29 }]
      });
      CUR_RUN = PLAN.runs[1].id; // edit the CNRL production run by default
      planRenderAll();
    }

    // =============================================================
    // UI HELPERS
    // =============================================================
    function toggleSec(hdr) {
      var body = hdr.nextElementSibling;
      var tog = hdr.querySelector('.sec-tog');
      var open = body.classList.toggle('open');
      tog.classList.toggle('open', open);
    }
    function setStatus(t, m) {
      document.getElementById('sdot').className = 'sdot ' + t;
      document.getElementById('smsg').textContent = m;
    }
    function showErr(m) { var b = document.getElementById('errbox'); b.textContent = 'Error: ' + m; b.style.display = 'block'; }
    function hideErr() { document.getElementById('errbox').style.display = 'none'; }

    // Drag-and-drop on EDR zone
    var dz = document.getElementById('dropZ');
    dz.addEventListener('dragover', function (e) { e.preventDefault(); dz.classList.add('over'); });
    dz.addEventListener('dragleave', function () { dz.classList.remove('over'); });
    dz.addEventListener('drop', function (e) {
      e.preventDefault(); dz.classList.remove('over');
      if (e.dataTransfer.files[0]) handleEDR(e.dataTransfer.files[0]);
    });

    // =============================================================
    // INIT
    // =============================================================
    (function init() {
      var savedTheme = localStorage.getItem(TD_THEME_KEY);
      if(savedTheme === 'light') setTheme('light');

      setLegend(SHOW_LEGEND);

      updateLabels();
      loadCNRL();
      loadCNRLCas();
      loadCNRLBHA();
      initPlanUI();
      planLoadExample(); // CNRL + illustrative 2-run example (round 5)
      document.getElementById('sl1').value = 0.25;
      document.getElementById('sl2').value = 0.20;
      document.getElementById('sl3').value = 0.32;
      document.getElementById('v1').textContent = '0.25';
      document.getElementById('v2').textContent = '0.20';
      document.getElementById('v3').textContent = '0.32';

      // Deep-link support: /uploadTorqueAndDrag?mtxJobId=1953 auto-loads that job
      var urlParams = new URLSearchParams(window.location.search);
      var deepLinkJobId = urlParams.get('mtxJobId');
      if (deepLinkJobId) {
        document.getElementById('tdMtxJobId').value = deepLinkJobId;
        loadJobByMtxId();
      }
    })();
  </script>
  <!-- Plot help floating window (2026-11-08 round 3) -->
  <div class="hp-modal" id="hpModal" onclick="if(event.target===this)closeTdHelp()">
    <div class="hp-win" role="dialog" aria-modal="true" aria-labelledby="hpTitle">
      <div class="hp-hdr"><h3 id="hpTitle"></h3><button class="hp-x" onclick="closeTdHelp()" aria-label="Close">&times;</button></div>
      <div class="hp-body" id="hpBody"></div>
    </div>
  </div>
</body>

</html>

