    // per string after import. "Top" is 0 for surface/intermediate/
    // production (matches the CNRL example convention above); for a liner,
    // it's approximated from the liner's hanger TVD if that was entered in
    // Casing Design (TVD, not MD — close enough for near-vertical/low-
    // inclination hanger depths, but check it for high-angle wells).
    async function importFromCasingDesign() {
      if (!tdCurrentNoteId || !tdCurrentWellKey) { alert('Load a job and select a well first (section 00).'); return; }
      try {
        var res = await fetch('/notes/casingDesign/' + tdCurrentNoteId);
        if (!res.ok) { alert('Could not reach the Casing Design module for this job.'); return; }
        var doc = await res.json();
        if (!doc || !doc.resultsByWell || !doc.resultsByWell[tdCurrentWellKey]) {
          alert('No saved Casing Design setup found for well "' + tdCurrentWellKey + '" on this job. Set one up in Casing Design first.');
