      <!-- 07 CALIBRATION -->
      <div class="sec">
        <div class="sec-hdr" onclick="toggleSec(this)">
          <span class="sec-num">07</span><span class="sec-ttl">Friction Factor Calibration</span><span
            class="sec-tog">v</span>
        </div>
        <div class="sec-body">
          <div class="cal-box">
            <div class="cal-ttl">Interactive FF Calibration vs EDR</div>
            <div class="srow">
              <span class="slbl">FF CASING 1</span>
              <input type="range" id="sl1" min="0.05" max="0.60" step="0.01" value="0.25" oninput="onSlider()" />
              <span class="sval" id="v1">0.25</span>
            </div>
            <div class="srow">
              <span class="slbl">FF CASING 2</span>
              <input type="range" id="sl2" min="0.05" max="0.60" step="0.01" value="0.20" oninput="onSlider()" />
              <span class="sval" id="v2">0.20</span>
            </div>
            <div class="srow">
              <span class="slbl">FF OPEN HOLE</span>
              <input type="range" id="sl3" min="0.05" max="0.70" step="0.01" value="0.32" oninput="onSlider()" />
