    // =============================================================
    // READ INPUTS (always returns SI units internally)
    // =============================================================
    function getParams() {
      var M = (UNIT === 'metric');
      return {
        mudDens: M ? +document.getElementById('mudWeight').value : +document.getElementById('mudWeight').value / KGM32PPG,
        blockW: M ? +document.getElementById('blockWeight').value * 10000 : +document.getElementById('blockWeight').value / KN2KLBF * 1000,
        wobRot: M ? +document.getElementById('wobRot').value * 10000 : +document.getElementById('wobRot').value / KN2KLBF * 1000,
        wobSlid: M ? +document.getElementById('wobSlid').value * 10000 : +document.getElementById('wobSlid').value / KN2KLBF * 1000,
        torqLim: M ? +document.getElementById('torqueLimit').value : +document.getElementById('torqueLimit').value / NM2FTLBF * 1000,
        ff1: +document.getElementById('ff1').value,
        ff2: +document.getElementById('ff2').value,
        ffOH: +document.getElementById('ffOH').value,
        steelDens: +document.getElementById('steelDens').value,
        ohDiam_m: +document.getElementById('ohDiam').value / 1000,
        ohTop: M ? +document.getElementById('ohTop').value : +document.getElementById('ohTop').value * FT,
        td: M ? +document.getElementById('td').value : +document.getElementById('td').value * FT,
        normLen: +document.getElementById('normLen').value || 9.45,
        helicalMode: document.getElementById('helMode').value,
        torqBit: +document.getElementById('torqBit').value || 0,
        tripSpeed: +document.getElementById('tripSpeed').value || 18.29,
        tripInRPM: +document.getElementById('tripInRPM').value || 0,
        tripOutRPM: +document.getElementById('tripOutRPM').value || 0,
        ffCal1: +document.getElementById('sl1').value,
        ffCal2: +document.getElementById('sl2').value,
        ffCal3: +document.getElementById('sl3').value
      };
    }

    function getSurvey() {
      var M = (UNIT === 'metric');
      return Array.from(document.querySelectorAll('#survBody tr')).map(function (r) {
        var ins = r.querySelectorAll('input');
        return { md: M ? +ins[0].value : +ins[0].value * FT, inc: +ins[1].value, az: +ins[2].value };
      }).filter(function (r) { return !isNaN(r.md) && r.md >= 0; }).sort(function (a, b) { return a.md - b.md; });
    }

    function getCasings() {
      var M = (UNIT === 'metric');
      return Array.from(document.querySelectorAll('#casBody tr')).map(function (r) {
        var ins = r.querySelectorAll('input');
        var sel = r.querySelector('select');
        return {
          name: ins[0].value,
          od_m: +ins[1].value / 1000,
          id_m: +ins[2].value / 1000,
          top: M ? +ins[3].value : +ins[3].value * FT,
          shoe: M ? +ins[4].value : +ins[4].value * FT,
          ffidx: sel ? +sel.value : 1
        };
      }).filter(function (r) { return r.od_m > 0 && r.shoe > 0; });
    }

    function getBHA() {
      var M = (UNIT === 'metric');
      return Array.from(document.querySelectorAll('#bhaBody tr')).map(function (r) {
        var ins = r.querySelectorAll('input');
        return {
          name: ins[0].value,
          od_m: +ins[1].value / 1000,
          id_m: +ins[2].value / 1000,
          len: M ? +ins[3].value : +ins[3].value * FT,
          wt: M ? +ins[4].value : +ins[4].value / KGM2LBFT
        };
      }).filter(function (r) { return r.od_m > 0 && r.len > 0; });
    }

    // =============================================================
    // JOB CONNECTION — pull subject-well trajectories from a job, and
    // load/save casing, BHA, and parameter sets tied to that job.
    // =============================================================
    var tdCurrentNoteId = null;
    var tdCurrentWellKey = null;
    var tdSubjectWells = [];

    async function loadJobByMtxId() {
      var mtxId = document.getElementById('tdMtxJobId').value.trim();
      var statusEl = document.getElementById('tdJobStatus');
      if (!mtxId) { statusEl.textContent = 'Enter a Job ID first.'; return; }
      statusEl.textContent = 'Looking up job ' + mtxId + '…';
      try {
        var res = await fetch('/notes/tdModel/lookupByMtxId/' + encodeURIComponent(mtxId));
        var data = await res.json();
        if (!res.ok) { statusEl.textContent = '❌ ' + (data.error || res.statusText); return; }
        if (!data.subjectWells || !data.subjectWells.length) {
          statusEl.textContent = '⚠ Job "' + data.title + '" found, but has no subject-well trajectories uploaded yet.';
          return;
        }
        tdCurrentNoteId = data.noteId;
        tdSubjectWells = data.subjectWells;

        var sel = document.getElementById('tdWellSelect');
        sel.innerHTML = '';
        tdSubjectWells.forEach(function (w) {
          var opt = document.createElement('option');
          opt.value = w.wellKey; opt.textContent = w.wellKey;
          sel.appendChild(opt);
        });
        document.getElementById('tdWellRow').style.display = '';
        document.getElementById('tdSaveRow').style.display = '';
        var dmEdrBtn = document.getElementById('btnUseDMEdr');
        if(dmEdrBtn) dmEdrBtn.disabled = false;
        statusEl.textContent = '✅ Loaded "' + data.title + '" (noteId: ' + data.noteId + ') — ' + tdSubjectWells.length + ' subject well(s)/leg(s) found.'
          + ' Check this noteId matches the /notes/job/<id> URL you expect.'
          + (data.duplicateWarning ? '\n⚠ ' + data.duplicateWarning : '');
        console.log('[T&D] Loaded job:', data.title, '| noteId:', data.noteId, data.duplicateWarning ? '| ' + data.duplicateWarning : '');

        await fetchSavedTDDoc();
        onTdWellChange();
      } catch (err) {
        statusEl.textContent = '❌ Error: ' + err.message;
      }
    }

    function onTdWellChange() {
      var sel = document.getElementById('tdWellSelect');
      var wellKey = sel.value;
      tdCurrentWellKey = wellKey;
      var well = tdSubjectWells.find(function (w) { return w.wellKey === wellKey; });
      if (!well || !well.survey.length) return;
      document.getElementById('survBody').innerHTML = '';
      well.survey.forEach(function (s) { addSurv(s.md, s.inc, s.az); });
      var lastMd = well.survey[well.survey.length - 1].md;
      document.getElementById('td').value = (UNIT === 'metric') ? lastMd.toFixed(1) : (lastMd / FT).toFixed(1);
      // Apply THIS well's saved casing/BHA/params (per-well storage) so
      // switching wells always restores its own setup.
      var applied = applySavedWellParams(wellKey);
      setStatus('ok', 'Survey loaded for ' + wellKey + ' (' + well.survey.length + ' stations).'
        + (applied ? ' Restored saved casing/BHA/parameters for this well.' : ' Adjust casing/BHA/params, then Run.'));
    }

    // ------------------------------------------------------------------
    // Saved-parameter plumbing.
    // The backend stores one entry PER WELL in resultsByWell[wellKey]
    // (casings, bha, params, results). The old loader read the legacy
    // top-level doc.casings/bha/params fields, which are empty for
    // anything saved since the per-well migration — which made it look
    // like parameters were never saved. We now fetch the doc once per job
    // (fetchSavedTDDoc) and apply the entry for the selected well on every
    // well change (applySavedWellParams).
    // ------------------------------------------------------------------
    var tdSavedDoc = null;      // full TDModel doc for the loaded job
    var tdApplyingSaved = false; // suppress auto-save while programmatically filling inputs

    async function fetchSavedTDDoc() {
      tdSavedDoc = null;
      if (!tdCurrentNoteId) return;
      try {
        var res = await fetch('/notes/tdModel/' + tdCurrentNoteId);
        tdSavedDoc = await res.json();
      } catch (err) { console.warn('fetchSavedTDDoc error:', err); }
    }

    // Returns true if a saved entry existed and was applied.
    function applySavedWellParams(wellKey) {
      var entry = null;
      if (tdSavedDoc) {
        if (tdSavedDoc.resultsByWell && tdSavedDoc.resultsByWell[wellKey]) {
          entry = tdSavedDoc.resultsByWell[wellKey];
        } else if (tdSavedDoc.params && (tdSavedDoc.wellKey === wellKey || !tdSavedDoc.wellKey)) {
          entry = tdSavedDoc; // legacy pre-migration document
        }
      }
      if (!entry) return false;
      tdApplyingSaved = true;
      try { applySavedEntry(entry); } finally { tdApplyingSaved = false; }
      return true;
    }

    // Values are stored in SI, so we force metric display before applying
    // them so the raw field values line up directly.
    function applySavedEntry(doc) {
        if (UNIT !== 'metric') setUnits('metric');

        if (doc.casings && doc.casings.length) {
          document.getElementById('casBody').innerHTML = '';
          doc.casings.forEach(function (c) {
            addCas(c.name, (c.od_m * 1000).toFixed(1), (c.id_m * 1000).toFixed(1),
              c.top.toFixed(1), c.shoe.toFixed(1), String(c.ffidx || 1));
          });
        }
        if (doc.bha && doc.bha.length) {
          document.getElementById('bhaBody').innerHTML = '';
          doc.bha.forEach(function (c) {
            addBHA(c.name, (c.od_m * 1000).toFixed(1), (c.id_m * 1000).toFixed(1),
              c.len.toFixed(2), c.wt.toFixed(3));
          });
        }
        if (doc.params) {
          var p = doc.params;
          if (p.mudDens != null) document.getElementById('mudWeight').value = p.mudDens;
          if (p.blockW != null) document.getElementById('blockWeight').value = (p.blockW / 10000);
          if (p.wobRot != null) document.getElementById('wobRot').value = (p.wobRot / 10000);
          if (p.wobSlid != null) document.getElementById('wobSlid').value = (p.wobSlid / 10000);
          if (p.torqLim != null) document.getElementById('torqueLimit').value = p.torqLim;
          if (p.ff1 != null) document.getElementById('ff1').value = p.ff1;
          if (p.ff2 != null) document.getElementById('ff2').value = p.ff2;
          if (p.ffOH != null) document.getElementById('ffOH').value = p.ffOH;
          if (p.steelDens != null) document.getElementById('steelDens').value = p.steelDens;
          if (p.ohDiam_m != null) document.getElementById('ohDiam').value = (p.ohDiam_m * 1000).toFixed(1);
          if (p.ohTop != null) document.getElementById('ohTop').value = p.ohTop;
          if (p.normLen != null) document.getElementById('normLen').value = p.normLen;
          if (p.helicalMode != null) document.getElementById('helMode').value = p.helicalMode;
          if (p.torqBit != null) document.getElementById('torqBit').value = p.torqBit;
          if (p.tripSpeed != null) document.getElementById('tripSpeed').value = p.tripSpeed;
          if (p.tripInRPM != null) document.getElementById('tripInRPM').value = p.tripInRPM;
          if (p.tripOutRPM != null) document.getElementById('tripOutRPM').value = p.tripOutRPM;
          // FF calibration slider state
          if (p.ffCal1 != null) { document.getElementById('sl1').value = p.ffCal1; document.getElementById('v1').textContent = (+p.ffCal1).toFixed(2); }
          if (p.ffCal2 != null) { document.getElementById('sl2').value = p.ffCal2; document.getElementById('v2').textContent = (+p.ffCal2).toFixed(2); }
          if (p.ffCal3 != null) { document.getElementById('sl3').value = p.ffCal3; document.getElementById('v3').textContent = (+p.ffCal3).toFixed(2); }
        }
    }

    // Reuses the current job's already-saved "Hook Load vs Measured Depth"
    // plot from Drilling Mechanics as the EDR calibration reference,
    // instead of re-uploading the same Pason CSV a second time. That plot
    // stores its Average Hook Load in kDaN (Drilling Mechanics' convention);
    // calcRMSE works internally in true kN, so we convert (1 kDaN = 10 kN).
    async function useDrillingMechanicsEDR() {
      var hint = document.getElementById('dmEdrHint');
      if (!tdCurrentNoteId) { alert('Load a job first (section 00).'); return; }
      hint.textContent = 'Loading saved Hook Load data...';
      try {
        var res = await fetch('/notes/pasonPlots/' + tdCurrentNoteId);
        var doc = await res.json();
        var hl = doc && doc.plots && doc.plots['hl'];
        if (!hl || !hl.rows || !hl.rows.length) {
          hint.textContent = 'No Hook Load vs Measured Depth plot saved for this job in Drilling Mechanics yet -- upload a Pason CSV there first, or use the manual upload above.';
          return;
        }
        edrData = hl.rows
          .filter(function (r) { return r[1] !== '' && r[1] !== null && r[1] !== undefined; })
          .map(function (r) { return { md_m: Number(r[0]), hl_kN: Number(r[1]) * 10 }; })
          .filter(function (r) { return !isNaN(r.md_m) && !isNaN(r.hl_kN); })
          .sort(function (a, b) { return a.md_m - b.md_m; });

        if (!edrData.length) {
          hint.textContent = 'That plot had no usable Average Hook Load values.';
          return;
        }
        hint.textContent = 'Loaded ' + edrData.length + ' Hook Load points from Drilling Mechanics (Average curve, converted kDaN to kN). Slide FF or click Auto-Fit below.';
        var f1 = +document.getElementById('sl1').value;
        var f2 = +document.getElementById('sl2').value;
        var f3 = +document.getElementById('sl3').value;
        if (cachedSurv) showRMSE(f1, f2, f3);
      } catch (err) {
        hint.textContent = 'Error: ' + err.message;
        console.error('useDrillingMechanicsEDR error:', err);
      }
    }

    // ------------------------------------------------------------------
    // AUTO-SAVE: any change to the T&D setup (casing program, BHA, open
    // hole, global parameters, FF calibration) is persisted to the loaded
    // job/well after a short debounce — no manual Save needed. The manual
    // Save Model button still exists and additionally stores chart results.
    // The backend preserves previously saved results when an auto-save
    // carries none, so tweaking a parameter never wipes the last run.
    // ------------------------------------------------------------------
    var tdAutoSaveTimer = null;

    function scheduleAutoSave() {
      if (!tdCurrentNoteId || !tdCurrentWellKey) return; // no job/well loaded
      if (tdApplyingSaved) return;                       // programmatic fill
      if (tdAutoSaveTimer) clearTimeout(tdAutoSaveTimer);
      tdAutoSaveTimer = setTimeout(autoSaveParams, 1500);
    }

    async function autoSaveParams() {
      tdAutoSaveTimer = null;
      if (!tdCurrentNoteId || !tdCurrentWellKey) return;
      var statusEl = document.getElementById('tdJobStatus');
      try {
        var payload = {
          noteId: tdCurrentNoteId,
          wellKey: tdCurrentWellKey,
          casings: getCasings(),
          bha: getBHA(),
          params: getParams(),
          results: lastChartData, // may be null; backend keeps prior results
          autosave: true
        };
        var res = await fetch('/notes/tdModel/' + tdCurrentNoteId, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        var data = await res.json();
        if (res.ok && data.success) {
          statusEl.textContent = 'Auto-saved parameters for ' + tdCurrentWellKey + ' at ' + new Date().toLocaleTimeString() + '.';
          // keep the in-memory saved doc in sync so well switches re-apply the latest
          if (tdSavedDoc) {
            tdSavedDoc.resultsByWell = tdSavedDoc.resultsByWell || {};
            tdSavedDoc.resultsByWell[tdCurrentWellKey] = Object.assign(
              {}, tdSavedDoc.resultsByWell[tdCurrentWellKey] || {},
              { casings: payload.casings, bha: payload.bha, params: payload.params });
          }
        } else {
          statusEl.textContent = 'Auto-save failed: ' + (data.error || res.statusText);
        }
      } catch (err) {
        statusEl.textContent = 'Auto-save failed: ' + err.message;
      }
    }

    function initTdAutoSave() {
      var left = document.querySelector('.left');
      if (!left) return;
      // Any typed or picked change in the setup column (params, casing/BHA
      // cell edits, OH inputs, sliders, selects) — delegated:
      left.addEventListener('input', scheduleAutoSave, true);
      left.addEventListener('change', scheduleAutoSave, true);
      // Structural changes (add/remove casing or BHA rows) don't fire
      // input events — watch the table bodies:
      ['casBody', 'bhaBody'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el && window.MutationObserver) {
          new MutationObserver(scheduleAutoSave).observe(el, { childList: true });
        }
      });
    }
    initTdAutoSave();

    async function saveModelToJob() {
      if (!tdCurrentNoteId) { alert('Load a job first (enter a Job ID and click Load Job).'); return; }
      if (!lastChartData) {
        if (!confirm('You haven\'t run the model yet, so no chart results exist to save — only the casing/BHA/parameters will be saved, and job.ejs will show "No Torque & Drag model saved yet" until you run the model and save again. Continue anyway?')) return;
      }
      var statusEl = document.getElementById('tdJobStatus');
      statusEl.textContent = 'Saving…';
      try {
        var payload = {
          noteId: tdCurrentNoteId,
          wellKey: tdCurrentWellKey,
          casings: getCasings(),
          bha: getBHA(),
          params: getParams(),
          results: lastChartData,
        };
        var res = await fetch('/notes/tdModel/' + tdCurrentNoteId, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        var data = await res.json();
        console.log('[T&D] Save response:', data, '| noteId used:', tdCurrentNoteId);
        if (res.ok) {
          statusEl.textContent = data.savedResults
            ? '✅ Saved parameters and chart results (noteId: ' + tdCurrentNoteId + ') — job.ejs should now show the charts.'
            : '⚠ Saved parameters only — NO chart results were saved (run the model first, then Save again, to make the charts appear on job.ejs).';
        } else {
          statusEl.textContent = '❌ Save failed: ' + (data.error || res.statusText);
        }
      } catch (err) {
        statusEl.textContent = '❌ Error: ' + err.message;
      }
    }

    // =============================================================
    // MINIMUM CURVATURE — trajectory calculation
    // Returns array of {md, inc, az, tvd, ns, ew, dls}
    // =============================================================
    // minCurvature, interpTraj, holeAt, pipeAt, interpSurv, computeModel,
    // computeHookload now live in the shared module /js/tdModel.js (loaded
    // via <script> above) as window.TDModelCore — the SAME module the
    // backend uses, so there is exactly one implementation of this physics.

    // =============================================================
    // EDR
    // =============================================================
    var edrData = null, rawHdrs = [], rawRows = [];

    function handleEDR(file) {
      if (!file) return;
      var reader = new FileReader();
      reader.onload = function (e) { parseCSV(e.target.result); };
      reader.readAsText(file);
    }

    function parseCSV(txt) {
      var lines = txt.trim().split(/\r?\n/).filter(function (l) { return l.trim(); });
      if (lines.length < 2) return;
      var hi = 0;
      for (var i = 0; i < Math.min(10, lines.length); i++) { if (/[a-zA-Z]/.test(lines[i])) { hi = i; break; } }
      var del = lines[hi].includes('\t') ? '\t' : ',';
      rawHdrs = lines[hi].split(del).map(function (h) { return h.trim().replace(/"/g, ''); });
      rawRows = lines.slice(hi + 1).map(function (l) { return l.split(del).map(function (v) { return v.trim().replace(/"/g, ''); }); });
      var sels = ['cDepth', 'cHL', 'cTQ', 'cWOB', 'cRPM'];
      sels.forEach(function (id) {
        document.getElementById(id).innerHTML = rawHdrs.map(function (h, i) {
          return '<option value="' + i + '">' + h + '</option>';
        }).join('');
      });
      var am = {
        cDepth: ['bit depth', 'md', 'depth', 'measured'], cHL: ['hook load', 'hookload', 'hl', 'hook'],
        cTQ: ['torque', 'surface torque'], cWOB: ['wob', 'weight on bit'], cRPM: ['rpm', 'rotary']
      };
      Object.keys(am).forEach(function (sid) {
        var idx = rawHdrs.findIndex(function (h) { return am[sid].some(function (k) { return h.toLowerCase().includes(k); }); });
        if (idx >= 0) document.getElementById(sid).value = idx;
      });
      document.getElementById('colMap').style.display = 'grid';
      document.getElementById('edrBtns').style.display = 'flex';
      document.getElementById('edrSt').textContent = rawRows.length + ' rows loaded — verify columns and apply';
      document.getElementById('edrSt').style.display = 'block';
      applyColMap();
    }

    function applyColMap() {
      var di = +document.getElementById('cDepth').value;
      var hi = +document.getElementById('cHL').value;
      var ti = +document.getElementById('cTQ').value;
      var du = document.getElementById('edrDepthU').value;
      edrData = rawRows.map(function (r) {
        var md = parseFloat(r[di]);
        return { md_m: du === 'ft' ? md * FT : md, hl_kN: parseFloat(r[hi]), tq_Nm: parseFloat(r[ti]) };
      }).filter(function (r) { return !isNaN(r.md_m) && !isNaN(r.hl_kN) && r.md_m > 0; })
        .sort(function (a, b) { return a.md_m - b.md_m; });
      document.getElementById('edrSt').textContent = edrData.length + ' valid EDR records mapped';
    }

    function clearEDR() {
      edrData = null; rawHdrs = []; rawRows = [];
      document.getElementById('edrSt').style.display = 'none';
      document.getElementById('colMap').style.display = 'none';
      document.getElementById('edrBtns').style.display = 'none';
    }

    function loadExEDR() {
      var pts = [];
      for (var md = 100; md <= 3488; md += 60) {
        var f = md / 3488;
        var hl = md < 730 ? 350 - f * 310 : md < 1554 ? 150 + Math.sin(f * 3) * 20 - f * 200 : 180 - f * 160;
        pts.push({
          md_m: md, hl_kN: Math.max(0, hl) + (Math.random() - 0.5) * 5,
          tq_Nm: f * 12000 + Math.random() * 500
        });
      }
      edrData = pts;
      document.getElementById('edrSt').textContent = pts.length + ' synthetic EDR records loaded';
      document.getElementById('edrSt').style.display = 'block';
      setStatus('ok', 'Example EDR loaded — run model to overlay');
    }

    // =============================================================
    // CALIBRATION
    // =============================================================
    var cachedSurv = null, cachedCas = null, cachedBHA = null, cachedPar = null;
    // Captures everything needed to re-render the 5 non-3D charts read-only
    // elsewhere (job.ejs) — populated at the end of a successful runModel().
    var lastChartData = null;

    function calcRMSE(f1, f2, f3) {
      if (!cachedSurv || !edrData || !edrData.length) return null;
      var hlRes = TDModelCore.computeHookload(cachedSurv, cachedCas, cachedBHA, cachedPar, { ff1: f1, ff2: f2, ffOH: f3 });
      var mdArr = hlRes.map(function (r) { return r.md; });
      var hlArr = hlRes.map(function (r) { return r.hl_rotOB; });
      var s = 0, n = 0;
      edrData.forEach(function (ed) {
        var bi = 0, bd = 1e9;
        mdArr.forEach(function (m, i) { var d = Math.abs(m - ed.md_m); if (d < bd) { bd = d; bi = i; } });
        if (bd < 200) { s += Math.pow(hlArr[bi] - ed.hl_kN, 2); n++; }
      });
      return n > 0 ? Math.sqrt(s / n) : null;
    }

    function onSlider() {
      var f1 = +document.getElementById('sl1').value;
      var f2 = +document.getElementById('sl2').value;
      var f3 = +document.getElementById('sl3').value;
      document.getElementById('v1').textContent = f1.toFixed(2);
      document.getElementById('v2').textContent = f2.toFixed(2);
      document.getElementById('v3').textContent = f3.toFixed(2);
      if (cachedSurv && edrData) showRMSE(f1, f2, f3);
    }

    function showRMSE(f1, f2, f3) {
      var rmse = calcRMSE(f1, f2, f3);
      if (rmse === null) { document.getElementById('rmseBox').style.display = 'none'; return; }
      var mean = edrData.reduce(function (s, r) { return s + r.hl_kN; }, 0) / edrData.length;
      var pct = rmse / mean * 100;
      var cls = pct < 5 ? 'color:var(--accent3)' : pct < 10 ? 'color:var(--yellow)' : 'color:var(--red)';
      var disp = UNIT === 'metric' ? (rmse * 0.1).toFixed(2) + ' kDaN' : (rmse * KN2KLBF).toFixed(2) + ' klbf';
      var qual = pct < 5 ? '<span style="color:var(--accent3)">Excellent fit</span>'
        : pct < 10 ? '<span style="color:var(--yellow)">Acceptable — refine FF</span>'
          : '<span style="color:var(--red)">Poor fit — adjust FF</span>';
      document.getElementById('rmseBox').style.display = 'block';
      document.getElementById('rmseBox').innerHTML =
        'RMSE: <span style="' + cls + '">' + disp + ' (' + pct.toFixed(1) + '%)</span><br>'
        + 'FF1=' + f1.toFixed(2) + '  FF2=' + f2.toFixed(2) + '  FFOH=' + f3.toFixed(2) + '<br>' + qual;
    }

    function applySliders() {
      document.getElementById('ff1').value = document.getElementById('sl1').value;
      document.getElementById('ff2').value = document.getElementById('sl2').value;
      document.getElementById('ffOH').value = document.getElementById('sl3').value;
      runModel();
    }

    function autoCalib() {
      if (!cachedSurv) { showErr('Run model first.'); return; }
      if (!edrData || !edrData.length) { showErr('Load EDR data first.'); return; }
      setStatus('run', 'Auto-calibrating FF — scanning 400 combinations...');
      setTimeout(function () {
        var range = [0.08, 0.10, 0.12, 0.15, 0.17, 0.20, 0.22, 0.25, 0.28, 0.30, 0.32, 0.35, 0.38, 0.40, 0.45, 0.50, 0.55, 0.60, 0.65, 0.70];
        var best = Infinity, bf1 = 0.25, bf2 = 0.20, bf3 = 0.32;
        for (var i = 0; i < range.length; i++)
          for (var j = 0; j < range.length; j++)
            for (var k = 0; k < range.length; k++) {
              var rm = calcRMSE(range[i], range[j], range[k]);
              if (rm !== null && rm < best) { best = rm; bf1 = range[i]; bf2 = range[j]; bf3 = range[k]; }
            }
        document.getElementById('sl1').value = bf1;
        document.getElementById('sl2').value = bf2;
        document.getElementById('sl3').value = bf3;
        document.getElementById('v1').textContent = bf1.toFixed(2);
        document.getElementById('v2').textContent = bf2.toFixed(2);
        document.getElementById('v3').textContent = bf3.toFixed(2);
        showRMSE(bf1, bf2, bf3);
        setStatus('ok', 'Auto-calibrated: FF1=' + bf1.toFixed(2) + ' FF2=' + bf2.toFixed(2) + ' FFOH=' + bf3.toFixed(2) + '  RMSE=' + (best * 0.1).toFixed(2) + ' kDaN');
      }, 50);
    }

    // =============================================================
    // RUN MODEL — orchestrates everything
    // =============================================================
    function runModel() {
      setStatus('run', 'Computing effective tension and trajectory...');
      hideErr();
      try {
        var surv = getSurvey();
        if (surv.length < 2) throw new Error('Need at least 2 survey stations.');
        var cas = getCasings();
        var bha = getBHA();
        var par = getParams();
        if (par.td <= 0) throw new Error('Total Depth must be > 0.');
        if (par.mudDens <= 0) throw new Error('Mud weight must be > 0.');

        // Extend survey to TD if needed
        if (surv[surv.length - 1].md < par.td) {
          var last = surv[surv.length - 1];
          surv.push({ md: par.td, inc: last.inc, az: last.az });
        }

        cachedSurv = surv.slice(); cachedCas = cas.slice(); cachedBHA = bha.slice(); cachedPar = Object.assign({}, par);

        // ET model (fast — runs once at full TD)
        var res = TDModelCore.computeModel(surv, cas, bha, par);
        // Trajectory at survey stations (for 3D plot)
        var traj = TDModelCore.minCurvature(surv);

        // Display unit factors
        var M = (UNIT === 'metric');
        var df = M ? 1 : 1 / FT;
        var dkN = M ? 0.1 : KN2KLBF;
        var dNm = M ? 1 : NM2FTLBF / 1000;  // N.m -> kft.lbf
        var depU = dU('depth'), forU = dU('force'), tqU = dU('torque');

        // ET arrays (display units)
        var mds = res.map(function (r) { return r.md * df; });
        var etROB = res.map(function (r) { return r.etRotOB * dkN; });
        var etSLD = res.map(function (r) { return r.etSlide * dkN; });
        var etROff = res.map(function (r) { return r.etRotOff * dkN; });
        var etTO = res.map(function (r) { return r.etTripOut * dkN; });
        var etTI = res.map(function (r) { return r.etTripIn * dkN; });
        var tqROB = res.map(function (r) { return r.torqRotOB * dNm; });
        var tqSLD = res.map(function (r) { return r.torqSlide * dNm; });
        var tqTI = res.map(function (r) { return r.torqTripIn * dNm; });
        var tqTO = res.map(function (r) { return r.torqTripOut * dNm; });
        var tqROff = res.map(function (r) { return r.torqRotOff * dNm; });
        // Side force: physics core returns kgf/m; display convention is
        // kgf per normalization length (WellPlan-compatible, default 9.45 m
        // = one Range 2 DP joint), same in both unit systems.
        var NL = par.normLen || 9.45;
        var sfROB = res.map(function (r) { return r.sfRotOB * NL; });
        var sfSLD = res.map(function (r) { return r.sfSlide * NL; });
        var sfROff = res.map(function (r) { return r.sfRotOff * NL; });
        var sfTO = res.map(function (r) { return r.sfTripOut * NL; });
        var sfTI = res.map(function (r) { return r.sfTripIn * NL; });
        var incArr = res.map(function (r) { return r.inc; });
        var dlsArr = res.map(function (r) { return r.dls; });

        // EDR overlay (display units)
        var edrMD = null, edrHL = null, edrTQ = null;
        if (edrData && edrData.length) {
          edrMD = edrData.map(function (r) { return r.md_m * df; });
          edrHL = edrData.map(function (r) { return r.hl_kN * dkN; });
          edrTQ = edrData.map(function (r) { return r.tq_Nm * dNm; });
        }

        // Summary chips
        var tdR = res[res.length - 1];
        document.getElementById('chips').innerHTML =
          '<span class="chip cb">ROT OB @ TD: ' + (tdR.etRotOB * dkN).toFixed(1) + ' ' + forU + '</span>' +
          '<span class="chip co">SLIDE @ TD: ' + (tdR.etSlide * dkN).toFixed(1) + ' ' + forU + '</span>' +
          '<span class="chip cg">TRIP OUT @ TD: ' + (tdR.etTripOut * dkN).toFixed(1) + ' ' + forU + '</span>' +
          '<span class="chip cr">TRIP IN @ TD: ' + (tdR.etTripIn * dkN).toFixed(1) + ' ' + forU + '</span>' +
          '<span class="chip cp">TORQUE OB: ' + (tdR.torqRotOB * dNm).toFixed(0) + ' ' + tqU + '</span>';

        // -------- Buckling & lock-up summary (Dawson-Paslay / Lubinski /
        // Chen-Cheatham or Wu / Mitchell — see Model References panel) ----
        (function () {
          var bw = par.blockW / 1000; // kN
          var cases = [
            { k: 'bkRotOB', et: 'etRotOB', lbl: 'Rotating On Bottom', slack: false },
            { k: 'bkSlide', et: 'etSlide', lbl: 'Slide Drilling', slack: true },
            { k: 'bkTripIn', et: 'etTripIn', lbl: 'Tripping In', slack: true },
            { k: 'bkTripOut', et: 'etTripOut', lbl: 'Tripping Out', slack: false },
            { k: 'bkRotOff', et: 'etRotOff', lbl: 'Rotating Off Bottom', slack: false }
          ];
          var html = '<div style="color:var(--text-bright);letter-spacing:.5px;margin-bottom:4px">BUCKLING &amp; LOCK-UP CHECK'
            + ' <span style="opacity:.55">(measured weight = surface effective tension minus block; lock-up when it goes negative in a slack-off case)</span></div>';
          var any = false;
          cases.forEach(function (c) {
            var mw = res[0][c.et] - bw; // kN at surface
            var sinFrom = null, helFrom = null, lockFrom = null, sinLen = 0, helLen = 0;
            for (var i = 0; i < res.length - 1; i++) {
              var st = res[i][c.k], dmd = res[i + 1].md - res[i].md;
              if (st >= 1) { sinLen += dmd; if (sinFrom === null) sinFrom = res[i].md; }
              if (st >= 2) { helLen += dmd; if (helFrom === null) helFrom = res[i].md; }
              if (st === 3 && lockFrom === null) lockFrom = res[i].md;
            }
            var lock = (lockFrom !== null) || (c.slack && mw < 0);
            if (!(sinLen || helLen || lock)) return;
            any = true;
            html += '<div>' + c.lbl + ': MW ' + (mw * dkN).toFixed(1) + ' ' + forU;
            if (sinLen) html += ' | sinusoidal from ' + (sinFrom * df).toFixed(0) + ' ' + depU + ' (' + (sinLen * df).toFixed(0) + ' ' + depU + ')';
            if (helLen) html += ' | <span style="color:var(--red)">HELICAL</span> from ' + (helFrom * df).toFixed(0) + ' ' + depU + ' (' + (helLen * df).toFixed(0) + ' ' + depU + ')';
            if (lock) html += ' | <span style="color:var(--red);font-weight:bold">LOCK-UP' + (lockFrom !== null ? ' at ' + (lockFrom * df).toFixed(0) + ' ' + depU : '') + ' — weight transfer stalls; loads above are lower-bound estimates</span>';
            html += '</div>';
          });
          var bp = document.getElementById('buckPanel');
          if (any) { bp.innerHTML = html; bp.style.display = 'block'; }
          else { bp.innerHTML = html + '<div style="opacity:.6">No buckling detected in any case.</div>'; bp.style.display = 'block'; }
        })();

        // Render ET plots and 3D (fast)
        renderAllCharts(mds, etROB, etSLD, etROff, etTO, etTI,
          tqROB, tqROff, tqSLD, tqTI, tqTO, sfROB, sfSLD, sfROff, sfTO, sfTI,
          incArr, dlsArr, edrMD, edrHL, edrTQ,
          par.torqLim * dNm, depU, forU, tqU, res, traj, df);

        lastChartData = {
          mds: mds, etROB: etROB, etSLD: etSLD, etROff: etROff, etTO: etTO, etTI: etTI,
          tqROB: tqROB, tqROff: tqROff, tqSLD: tqSLD, tqTI: tqTI, tqTO: tqTO, sfROB: sfROB, sfSLD: sfSLD, sfROff: sfROff, sfTO: sfTO, sfTI: sfTI,
          incArr: incArr, dlsArr: dlsArr,
          torqLimDisp: par.torqLim * dNm, depU: depU, forU: forU, tqU: tqU,
          hlMDs: null, hlTO: null, hlROB: null, hlSLD: null,
        };

        setStatus('run', 'Computing hookload vs bit depth (may take a few seconds)...');

        // Hookload (expensive — run deferred so UI can paint first)
        setTimeout(function () {
          try {
            var hlRes = TDModelCore.computeHookload(surv, cas, bha, par);
            var hlMDs = hlRes.map(function (r) { return r.md * df; });
            var hlTO = hlRes.map(function (r) { return r.hl_tripOut * dkN; });
            var hlTI = hlRes.map(function (r) { return r.hl_tripIn * dkN; });
            var hlROB = hlRes.map(function (r) { return r.hl_rotOB * dkN; });
            var hlSLD = hlRes.map(function (r) { return r.hl_slide * dkN; });
            var hlROff = hlRes.map(function (r) { return r.hl_rotOff * dkN; });
            renderHookloadChart(hlMDs, hlTO, hlTI, hlROB, hlSLD, hlROff, edrMD, edrHL, depU, forU);
            renderHookloadTable(hlMDs, hlTO, hlTI, hlROB, hlSLD, hlROff, depU, forU);
            if(lastChartData){
              lastChartData.hlMDs = hlMDs; lastChartData.hlTO = hlTO; lastChartData.hlTI = hlTI;
              lastChartData.hlROB = hlROB; lastChartData.hlSLD = hlSLD; lastChartData.hlROff = hlROff;
            }
            setStatus('ok', 'Model complete — ' + res.length + ' ET stations, ' + hlRes.length + ' hookload steps. TD=' + (par.td * df).toFixed(0) + ' ' + depU);
          } catch (e2) {
            showErr('Hookload error: ' + e2.message);
            setStatus('err', 'Hookload error: ' + e2.message);
          }
        }, 40);

      } catch (e) {
        showErr(e.message);
        setStatus('err', 'Error: ' + e.message);
      }
    }

    // =============================================================
    // CHART INFRASTRUCTURE
    // =============================================================
    var charts = {};
    function destroyCharts() {
      Object.keys(charts).forEach(function (k) { try { charts[k].destroy(); } catch (e) { } });
      charts = {};
      if (typeof Plotly !== 'undefined') {
        var el = document.getElementById('plotly3d');
        if (el) Plotly.purge(el);
      }
    }

    function buildCO() {
      var isLight = document.body.classList.contains('light-mode');
      var textColor = isLight ? '#000000' : '#ffffff';
      var tickColor = isLight ? '#495057' : '#ffffff';
      var gridColor = isLight ? 'rgba(0,0,0,.15)' : 'rgba(30,45,61,.6)';
      var tooltipBg = isLight ? '#ffffff' : '#161e28';
      var tooltipBorder = isLight ? '#c8d4de' : '#1e2d3d';
      return {
        responsive: true,
        maintainAspectRatio: false,
        animation: { duration: 400 },
        plugins: {
          legend: { labels: { color: textColor, font: { family: 'Share Tech Mono', size: 13 }, boxWidth: 14, padding: 10 } },
          tooltip: {
            bodyFont: { family: 'Share Tech Mono', size: 13 }, titleFont: { family: 'Share Tech Mono', size: 13 },
            backgroundColor: tooltipBg, borderColor: tooltipBorder, borderWidth: 1, padding: 7,
            bodyColor: textColor, titleColor: textColor
          }
        },
        scales: {
          x: { type: 'linear', ticks: { color: tickColor, font: { family: 'Share Tech Mono', size: 12 }, maxTicksLimit: 8 }, grid: { color: gridColor } },
          y: { ticks: { color: tickColor, font: { family: 'Share Tech Mono', size: 12 } }, grid: { color: gridColor } }
        }
      };
    }
    var CO = buildCO();

    function axT(txt) {
      var isLight = document.body.classList.contains('light-mode');
      return { display: true, text: txt, color: isLight ? '#000000' : '#ffffff', font: { family: 'Share Tech Mono', size: 13 } };
    }

    function mkLine(lbl, data, xdata, color, dash, fillIt) {
      return {
        label: lbl,
        data: xdata.map(function (x, i) { return { x: x, y: data[i] }; }),
        borderColor: color,
        backgroundColor: fillIt ? color.replace(')', ',0.1)').replace('rgb', 'rgba') : undefined,
        borderWidth: 1.8, pointRadius: 0, fill: fillIt ? 'origin' : false,
        tension: 0.3, borderDash: dash || [], parsing: false, type: 'line'
      };
    }

    function mkScatter(lbl, xdata, ydata, color) {
      return {
        label: lbl,
        data: xdata.map(function (x, i) { return { x: x, y: ydata[i] }; }),
        borderColor: 'transparent', backgroundColor: color,
        pointRadius: 3, showLine: false, type: 'scatter', parsing: false
      };
    }

    // decimate array to at most n rows for tables
    function decimate(arr, n) {
      var step = Math.max(1, Math.floor(arr.length / n));
      return arr.filter(function (_, i) { return i % step === 0 || i === arr.length - 1; });
    }

    // Build a results table inside a container element
    function buildPanelTable(containerId, headers, rowData, cellFn, colors) {
      var el = document.getElementById(containerId);
      if (!el) return;
      var thead = '<thead><tr>' + headers.map(function (h) { return '<th>' + h + '</th>'; }).join('') + '</tr></thead>';
      var tbody = '<tbody>' + rowData.map(function (row) {
        var cells = cellFn(row);
        return '<tr>' + cells.map(function (c, i) {
          var style = (colors && colors[i]) ? ' style="color:' + colors[i] + '"' : '';
          return '<td' + style + '>' + c + '</td>';
        }).join('') + '</tr>';
      }).join('') + '</tbody>';
      el.innerHTML = '<table class="ptbl">' + thead + tbody + '</table>';
    }

    // Builds one plot-panel div with chart canvas and table placeholder
    function makePanelHTML(ppClass, ttl, chartId, tblId, chartClass) {
      return '<div class="pp ' + ppClass + '">'
        + '<div class="pp-hdr"><span class="pp-ttl">' + ttl + '</span></div>'
        + '<div class="pp-body has-tbl">'
        + '<div class="pp-chart ' + (chartClass || '') + '"><canvas id="' + chartId + '"></canvas></div>'
        + '<div class="pp-tbl ' + (chartClass || '') + '" id="' + tblId + '"></div>'
        + '</div></div>';
    }

    function make3dPanelHTML(ttl, plotlyId, tblId) {
      return '<div class="pp c-wh">'
        + '<div class="pp-hdr"><span class="pp-ttl">' + ttl + '</span></div>'
        + '<div class="pp-body wide3d">'
        + '<div class="pp-chart h3d"><div id="' + plotlyId + '" class="pp-plotly" style="width:100%;height:100%"></div></div>'
        + '<div class="pp-tbl h3d" id="' + tblId + '"></div>'
        + '</div></div>';
    }

    // =============================================================
    // RENDER ALL CHARTS
    // =============================================================
    function renderAllCharts(mds, etROB, etSLD, etROff, etTO, etTI,
      tqROB, tqROff, tqSLD, tqTI, tqTO, sfROB, sfSLD, sfROff, sfTO, sfTI,
      incArr, dlsArr, edrMD, edrHL, edrTQ,
      torqLimDisp, depU, forU, tqU, results, traj, df) {

      destroyCharts();
      CO = buildCO();
      var phEl = document.getElementById('ph');
      if(phEl) phEl.style.display = 'none';

      var area = document.getElementById('chartsArea');
      area.innerHTML =
        make3dPanelHTML(
          '3D Well Trajectory — Minimum Curvature | Local East x North x TVD | Coloured by DLS',
          'plotly3d', 'tbl_traj')
        + makePanelHTML('c-bl',
          'Effective Tension vs Measured Depth (' + forU + ') — 5 WellPlan Cases',
          'c_et', 'tbl_et', 'tall')
        + '<div id="hl_panel">'
        + makePanelHTML('c-or',
          'Hook Load vs Bit Depth (' + forU + ') — Surface Weight Indicator | Re-computed at each depth step',
          'c_hl', 'tbl_hl', 'tall')
        + '</div>'
        + makePanelHTML('c-te',
          'Side Force vs Measured Depth (kgf per ' + ((cachedPar && cachedPar.normLen) || 9.45) + ' m) — Normal Contact Force incl. Helical-Buckling Wall Contact | 5 Cases',
          'c_sf', 'tbl_sf', 'tall')
        + makePanelHTML('c-pu',
          'Surface Torque vs Measured Depth (' + tqU + ') — Rotating Cases + Limit',
          'c_tq', 'tbl_tq', '')
        + makePanelHTML('c-gr',
          'Inclination and DLS vs Measured Depth',
          'c_inc', 'tbl_inc', '');

      var M = (UNIT === 'metric');

      // ---- 1. PLOTLY 3D TRAJECTORY ----
      var t_ew = traj.map(function (s) { return s.ew * df; });
      var t_ns = traj.map(function (s) { return s.ns * df; });
      var t_tvd = traj.map(function (s) { return s.tvd * df; });
      var t_md = traj.map(function (s) { return s.md * df; });
      var t_dls = traj.map(function (s) { return s.dls; });
      var t_inc = traj.map(function (s) { return s.inc; });
      var t_az = traj.map(function (s) { return s.az; });

      var hoverTxt = traj.map(function (s, i) {
        return 'MD: ' + (s.md * df).toFixed(1) + ' ' + depU
          + '<br>TVD: ' + (s.tvd * df).toFixed(1) + ' ' + depU
          + '<br>NS: ' + (s.ns * df).toFixed(1) + ' ' + depU
          + '<br>EW: ' + (s.ew * df).toFixed(1) + ' ' + depU
          + '<br>Inc: ' + s.inc.toFixed(2) + 'deg'
          + '<br>Az: ' + s.az.toFixed(2) + 'deg'
          + '<br>DLS: ' + s.dls.toFixed(3) + ' deg/30m';
      });

      Plotly.newPlot('plotly3d', [
        {
          type: 'scatter3d', mode: 'lines+markers',
          x: t_ew, y: t_ns, z: t_tvd,
          line: {
            color: t_dls, colorscale: 'Viridis', width: 6,
            colorbar: {
              title: { text: 'DLS (deg/30m)', font: { size: 9, color: '#c8d8e8' } },
              tickfont: { size: 8, color: '#c8d8e8' }, thickness: 10, len: 0.5,
              bgcolor: 'rgba(0,0,0,0)', bordercolor: '#1e2d3d'
            }
          },
          marker: { size: 3, color: t_dls, colorscale: 'Viridis' },
          text: hoverTxt, hoverinfo: 'text', name: 'Wellbore'
        },
        {
          type: 'scatter3d', mode: 'markers',
          x: [t_ew[0]], y: [t_ns[0]], z: [0],
          marker: { size: 10, color: '#39ff14', symbol: 'diamond' },
          name: 'Surface', hoverinfo: 'skip'
        },
        {
          type: 'scatter3d', mode: 'markers',
          x: [t_ew[t_ew.length - 1]], y: [t_ns[t_ns.length - 1]], z: [t_tvd[t_tvd.length - 1]],
          marker: { size: 10, color: '#ff4060', symbol: 'x' },
          name: 'TD ' + t_md[t_md.length - 1].toFixed(0) + ' ' + depU, hoverinfo: 'skip'
        }
      ], {
        paper_bgcolor: 'rgba(0,0,0,0)', plot_bgcolor: 'rgba(0,0,0,0)',
        scene: {
          xaxis: { title: { text: 'Local East (' + depU + ')', font: { color: '#5a7080', size: 9 } }, gridcolor: '#1e2d3d', zerolinecolor: '#1e2d3d', tickfont: { color: '#5a7080', size: 8 }, backgroundcolor: 'rgba(10,14,20,.85)' },
          yaxis: { title: { text: 'Local North (' + depU + ')', font: { color: '#5a7080', size: 9 } }, gridcolor: '#1e2d3d', zerolinecolor: '#1e2d3d', tickfont: { color: '#5a7080', size: 8 }, backgroundcolor: 'rgba(10,14,20,.85)' },
          zaxis: { title: { text: 'TVD (' + depU + ')', font: { color: '#5a7080', size: 9 } }, gridcolor: '#1e2d3d', zerolinecolor: '#1e2d3d', tickfont: { color: '#5a7080', size: 8 }, backgroundcolor: 'rgba(10,14,20,.85)', autorange: 'reversed' },
          bgcolor: 'rgba(10,14,20,.9)',
          camera: { eye: { x: 1.5, y: 1.4, z: 0.7 } },
          aspectmode: 'manual', aspectratio: { x: 1, y: 1, z: 0.6 }
        },
        legend: { font: { color: '#c8d8e8', size: 9 }, bgcolor: 'rgba(0,0,0,0)', bordercolor: '#1e2d3d', borderwidth: 1, x: 0, y: 1 },
        margin: { l: 0, r: 0, t: 10, b: 0 },
        font: { family: 'Share Tech Mono' }
      }, { responsive: true });

      // 3D table — trajectory data
      buildPanelTable('tbl_traj',
        ['MD (' + depU + ')', 'TVD (' + depU + ')', 'N+ (' + depU + ')', 'E+ (' + depU + ')', 'Inc (deg)', 'Az (deg)', 'DLS (d/30m)'],
        decimate(traj, 80),
        function (s) {
          return [
            (s.md * df).toFixed(1), (s.tvd * df).toFixed(2),
            (s.ns * df).toFixed(2), (s.ew * df).toFixed(2),
            s.inc.toFixed(2), s.az.toFixed(2), s.dls.toFixed(3)
          ];
        },
        [null, 'var(--accent)', 'var(--accent3)', 'var(--accent2)', null, null, 'var(--yellow)']
      );

      // Display factor closures — available to all table callbacks below
      function dkN() { return M ? 0.1 : KN2KLBF; }
      function dNm() { return M ? 1 : NM2FTLBF / 1000; }

      // ---- 2. EFFECTIVE TENSION ----
      var etDS = [
        mkLine('Tripping In', etTI, mds, '#ff4060', []),
        mkLine('Tripping Out', etTO, mds, '#39ff14', []),
        mkLine('Rotating OB', etROB, mds, '#00c8ff', []),
        mkLine('Slide Drilling', etSLD, mds, '#ff6b35', [4, 3]),
        mkLine('Rotating Off', etROff, mds, '#c084fc', [2, 4]),
        {
          label: 'Zero', data: mds.map(function (x) { return { x: x, y: 0 }; }), borderColor: 'rgba(255,255,255,.2)',
          borderWidth: 1, borderDash: [2, 5], pointRadius: 0, fill: false, tension: 0, parsing: false, type: 'line'
        }
      ];
      // Buckling onset shown on the same basis as the ET curves (which
      // include block weight): string buckles when ET drops below
      // (blockW - Fcrit). Sinusoidal: Dawson & Paslay (1984) / Lubinski
      // (1950) near-vertical. Helical: Chen-Cheatham (1990) or
      // Wu-Juvkam-Wold (1993) per the Helical Criterion setting.
      // Inside stiff BHA/collar sections Fcrit is enormous and the limit
      // sits kilometres below the plot — clip those points to NaN (line
      // gap) so the y-axis autoscale stays on the ET curves themselves.
      (function () {
        var allET = [];
        [etTI, etTO, etROB, etSLD, etROff].forEach(function (a) {
          a.forEach(function (v) { if (isFinite(v)) allET.push(v); });
        });
        var etMin = Math.min.apply(null, allET), etMax = Math.max.apply(null, allET);
        var floor = etMin - 0.15 * Math.max(etMax - etMin, 1);
        function limLine(lbl, key, color, dash) {
          return {
            label: lbl, parsing: false, type: 'line', fill: false, tension: 0,
            pointRadius: 0, borderWidth: 1.5, borderColor: color, borderDash: dash,
            spanGaps: false,
            data: results.map(function (r, i) {
              var v = (cachedPar.blockW / 1000 - r[key]) * dkN();
              return { x: mds[i], y: (v >= floor ? v : NaN) };
            })
          };
        }
        etDS.push(limLine('Sinusoidal Limit', 'fsin_kN', '#ffd166', [6, 4]));
        etDS.push(limLine('Helical Limit', 'fhel_kN', '#ff2d55', [2, 3]));
      })();
      charts.et = new Chart(document.getElementById('c_et').getContext('2d'), {
        type: 'line', data: { datasets: etDS },
        options: Object.assign({}, CO, {
          scales: {
            x: Object.assign({}, CO.scales.x, { title: axT('Measured Depth (' + depU + ')') }),
            y: Object.assign({}, CO.scales.y, { title: axT('Effective Tension (' + forU + ')') })
          }
        })
      });

      buildPanelTable('tbl_et',
        ['MD', 'TVD', 'Trip In', 'Trip Out', 'Rot OB', 'Slide', 'Rot Off'],
        decimate(results, 80),
        function (r) {
          return [(r.md * df).toFixed(0), (r.tvd * df).toFixed(0),
          (r.etTripIn * dkN()).toFixed(1), (r.etTripOut * dkN()).toFixed(1),
          (r.etRotOB * dkN()).toFixed(1), (r.etSlide * dkN()).toFixed(1),
          (r.etRotOff * dkN()).toFixed(1)];
        },
        [null, null, 'var(--red)', 'var(--accent3)', 'var(--accent)', 'var(--accent2)', 'var(--purple)']
      );

      // ---- 3. HOOKLOAD placeholder (filled async) ----
      document.getElementById('c_hl').getContext('2d'); // just ensure canvas exists

      // ---- 4. SIDE FORCE ----
      var sfDS = [
        mkLine('Tripping In', sfTI, mds, '#ff4060', []),
        mkLine('Tripping Out', sfTO, mds, '#39ff14', []),
        mkLine('Rotating OB', sfROB, mds, '#00c8ff', []),
        mkLine('Slide Drilling', sfSLD, mds, '#ff6b35', [4, 3]),
        mkLine('Rotating Off', sfROff, mds, '#c084fc', [2, 4])
      ];
      charts.sf = new Chart(document.getElementById('c_sf').getContext('2d'), {
        type: 'line', data: { datasets: sfDS },
        options: Object.assign({}, CO, {
          scales: {
            x: Object.assign({}, CO.scales.x, { title: axT('Measured Depth (' + depU + ')') }),
            y: Object.assign({}, CO.scales.y, { min: 0, title: axT('Side Force (kgf/' + ((cachedPar && cachedPar.normLen) || 9.45) + ' m)') })
          }
        })
      });

      buildPanelTable('tbl_sf',
        ['MD', 'Trip In', 'Trip Out', 'Rot OB', 'Slide', 'Rot Off'],
        decimate(results, 80),
        function (r) {
          var sf = (cachedPar && cachedPar.normLen) || 9.45; // kgf per norm. length
          return [(r.md * df).toFixed(0),
          (r.sfTripIn * sf).toFixed(1), (r.sfTripOut * sf).toFixed(1),
          (r.sfRotOB * sf).toFixed(1), (r.sfSlide * sf).toFixed(1),
          (r.sfRotOff * sf).toFixed(1)];
        },
        [null, 'var(--red)', 'var(--accent3)', 'var(--accent)', 'var(--accent2)', 'var(--purple)']
      );

      // ---- 5. TORQUE ----
      // Torque profile along the string at TD for all 5 operations.
      // Slide Drilling carries bit torque to surface unchanged (no
      // rotation -> no tangential friction); Trip In/Out show torque only
      // when their RPM > 0 (velocity-resolved friction, refs [8],[10]).
      var tqDS = [
        mkLine('Rotating OB', tqROB, mds, '#ff6b35', [], true),
        mkLine('Rotating Off', tqROff, mds, '#c084fc', [2, 3]),
        mkLine('Slide Drilling', tqSLD, mds, '#ffd060', [4, 3]),
        mkLine('Tripping In', tqTI, mds, '#ff5e7a', []),
        mkLine('Tripping Out', tqTO, mds, '#39ff14', [6, 3]),
        {
          label: 'Limit', data: mds.map(function (x) { return { x: x, y: torqLimDisp }; }),
          borderColor: '#ff4060', borderWidth: 1, borderDash: [4, 3], pointRadius: 0, fill: false, tension: 0, parsing: false, type: 'line'
        }
      ];
      if (edrMD && edrTQ) tqDS.push(mkScatter('EDR Torque', edrMD, edrTQ, 'rgba(255,208,96,.7)'));
      charts.tq = new Chart(document.getElementById('c_tq').getContext('2d'), {
        type: 'line', data: { datasets: tqDS },
        options: Object.assign({}, CO, {
          scales: {
            x: Object.assign({}, CO.scales.x, { title: axT('MD (' + depU + ')') }),
            y: Object.assign({}, CO.scales.y, { title: axT('Torque (' + tqU + ')') })
          }
        })
      });

      buildPanelTable('tbl_tq',
        ['MD', 'TVD', 'Rot OB', 'Rot Off', 'Slide', 'Trip In', 'Trip Out'],
        decimate(results, 80),
        function (r) {
          return [(r.md * df).toFixed(0), (r.tvd * df).toFixed(0),
          (r.torqRotOB * dNm()).toFixed(0), (r.torqRotOff * dNm()).toFixed(0),
          (r.torqSlide * dNm()).toFixed(0), (r.torqTripIn * dNm()).toFixed(0),
          (r.torqTripOut * dNm()).toFixed(0)];
        },
        [null, null, 'var(--accent2)', 'var(--purple)', 'var(--gold)', 'var(--red)', 'var(--accent3)']
      );

      // ---- 6. INCLINATION + DLS ----
      charts.inc = new Chart(document.getElementById('c_inc').getContext('2d'), {
        type: 'line',
        data: {
          datasets: [
            mkLine('Inclination (deg)', incArr, mds, '#39ff14', [], true),
            mkLine('DLS (deg/30m)', dlsArr, mds, '#ffd060', [3, 2])
          ]
        },
        options: Object.assign({}, CO, {
          scales: {
            x: Object.assign({}, CO.scales.x, { title: axT('MD (' + depU + ')') }),
            y: Object.assign({}, CO.scales.y, { min: 0, title: axT('Inc (deg) / DLS (deg/30m)') })
          }
        })
      });

      buildPanelTable('tbl_inc',
        ['MD', 'TVD', 'Inc (deg)', 'Az (deg)', 'DLS (d/30m)', 'Zone'],
        decimate(results, 80),
        function (r) {
          return [(r.md * df).toFixed(0), (r.tvd * df).toFixed(0),
          r.inc.toFixed(2), r.az.toFixed(2), r.dls.toFixed(3),
          r.inCasing ? 'Cas' + r.ffidx : 'OH'];
        },
        [null, null, 'var(--accent3)', null, 'var(--yellow)', 'var(--text-dim)']
      );

    }

    // Render hookload chart (called async after ET charts are shown)
    function renderHookloadChart(hlMDs, hlTO, hlTI, hlROB, hlSLD, hlROff, edrMD, edrHL, depU, forU) {
      CO = buildCO();
      var hlDS = [
        mkLine('Tripping In', hlTI, hlMDs, '#ff5e7a', []),
        mkLine('Tripping Out', hlTO, hlMDs, '#39ff14', []),
        mkLine('Rotating OB', hlROB, hlMDs, '#00c8ff', []),
        mkLine('Slide Drilling', hlSLD, hlMDs, '#ff6b35', [4, 3]),
        mkLine('Rotating Off', hlROff, hlMDs, '#c084fc', [2, 4])
      ];
      if (edrMD && edrHL) hlDS.push(mkScatter('EDR Measured', edrMD, edrHL, 'rgba(255,208,96,.7)'));
      if (charts.hl) { try { charts.hl.destroy(); } catch (e) { } }
      charts.hl = new Chart(document.getElementById('c_hl').getContext('2d'), {
        type: 'line', data: { datasets: hlDS },
        options: Object.assign({}, CO, {
          scales: {
            x: Object.assign({}, CO.scales.x, { title: axT('Bit Depth (' + depU + ') — surface hookload as string is built') }),
            y: Object.assign({}, CO.scales.y, { title: axT('Surface Hook Load (' + forU + ')') })
          }
        })
      });
    }

    function renderHookloadTable(hlMDs, hlTO, hlTI, hlROB, hlSLD, hlROff, depU, forU) {
      var step = Math.max(1, Math.floor(hlMDs.length / 80));
      var rows = hlMDs.map(function (md, i) {
        return { md: md, ti: hlTI[i], to: hlTO[i], rob: hlROB[i], sl: hlSLD[i], roff: hlROff[i] };
      }).filter(function (_, i) { return i % step === 0 || i === hlMDs.length - 1; });

      buildPanelTable('tbl_hl',
        ['Bit Depth (' + depU + ')', 'Trip In (' + forU + ')', 'Trip Out (' + forU + ')',
         'Rot OB (' + forU + ')', 'Slide (' + forU + ')', 'Rot Off (' + forU + ')'],
        rows,
        function (r) {
          return [r.md.toFixed(0), r.ti.toFixed(1), r.to.toFixed(1),
                  r.rob.toFixed(1), r.sl.toFixed(1), r.roff.toFixed(1)];
        },
        [null, 'var(--red)', 'var(--accent3)', 'var(--accent)', 'var(--accent2)', 'var(--purple)']
      );
    }

    // =============================================================
    // UI HELPERS
    // =============================================================
    function toggleSec(hdr) {
      var body = hdr.nextElementSibling;
      var tog = hdr.querySelector('.sec-tog');
      var open = body.classList.toggle('open');
      tog.classList.toggle('open', open);
    }
    function setStatus(t, m) {
      document.getElementById('sdot').className = 'sdot ' + t;
      document.getElementById('smsg').textContent = m;
    }
    function showErr(m) { var b = document.getElementById('errbox'); b.textContent = 'Error: ' + m; b.style.display = 'block'; }
    function hideErr() { document.getElementById('errbox').style.display = 'none'; }

    // Drag-and-drop on EDR zone
    var dz = document.getElementById('dropZ');
    dz.addEventListener('dragover', function (e) { e.preventDefault(); dz.classList.add('over'); });
    dz.addEventListener('dragleave', function () { dz.classList.remove('over'); });
    dz.addEventListener('drop', function (e) {
      e.preventDefault(); dz.classList.remove('over');
      if (e.dataTransfer.files[0]) handleEDR(e.dataTransfer.files[0]);
    });

    // =============================================================
    // INIT
    // =============================================================
    (function init() {
      var savedTheme = localStorage.getItem(TD_THEME_KEY);
      if(savedTheme === 'light') setTheme('light');

      updateLabels();
      loadCNRL();
      loadCNRLCas();
      loadCNRLBHA();
      document.getElementById('sl1').value = 0.25;
      document.getElementById('sl2').value = 0.20;
      document.getElementById('sl3').value = 0.32;
      document.getElementById('v1').textContent = '0.25';
      document.getElementById('v2').textContent = '0.20';
      document.getElementById('v3').textContent = '0.32';

      // Deep-link support: /uploadTorqueAndDrag?mtxJobId=1953 auto-loads that job
      var urlParams = new URLSearchParams(window.location.search);
      var deepLinkJobId = urlParams.get('mtxJobId');
      if (deepLinkJobId) {
        document.getElementById('tdMtxJobId').value = deepLinkJobId;
        loadJobByMtxId();
      }
    })();
  </script>
</body>

</html>

