async function loadCase(){
  var id = $('caseList').value; if(!id) return;
  var d = await (await fetch('/notes/pipeStretch/case/' + id)).json(); if(!d.ok){ alert(d.error); return; }
  var c = d.case.inputData || {};
  $('unitSel').value = 'metric'; setUnit('metric');
  $('bhaLimit').value = c.bhaLimit_m || 60; $('dpOD').value = c.dpOD || 114.3; $('dpID').value = c.dpID || 71.4;
  $('modelSel').value = c.model === 'TD' ? 'TD' : 'SurQC'; onModelChange(); if(c.loadCase) $('loadCase').value = c.loadCase;
  $('mud').value = c.mud_kgm3 || 1200; $('grad').value = c.grad != null ? c.grad : 25; $('tSurf').value = c.tSurf != null ? c.tSurf : 10; $('tCal').value = c.tCal != null ? c.tCal : 10;
  $('alpha').value = c.alpha || 12; $('youngE').value = c.youngE || 206.8; $('sensorOff').value = c.sensorOff_m != null ? c.sensorOff_m : 15;
  tdSet = c.tdSet || null; $('strBody').innerHTML = ''; (c.rows || []).forEach(addRow); $('runsOn').checked = !!c.runsOn;
  survey = d.case.survey || []; surveySource = (c.source && c.source.surveySource) || null; result = null; renderSurvey(); $('btnSaveVer').disabled = true;
  $('caseName').value = d.case.name; if(c.unit === 'imperial'){ $('unitSel').value = 'imperial'; setUnit('imperial'); }
  $('svyInfo').textContent = survey.length ? survey.length + ' stations (from case)' : ''; runsRender(); $('btnReport').disabled = true;
}
async function deleteCase(){
  var id = $('caseList').value; if(!id || !confirm('Delete this case?')) return;
  var d = await (await fetch('/notes/pipeStretch/case/' + id, {method:'DELETE'})).json(); if(!d.ok){ alert(d.error); return; } refreshCases();
}

