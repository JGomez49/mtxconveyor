// ---------------- calculation
function mudKgm3(){ return UNIT === 'metric' ? +$('mud').value : +$('mud').value * PPG; }
function runStretch(){
  if(survey.length < 2){ alert('Load or import a survey first (at least 2 stations).'); return; }
  var rows = readString(); if(!rows.length){ alert('Enter the drill string first.'); return; }
  var model = $('modelSel').value, lc = $('loadCase').value, t0 = Date.now(), G = +$('grad').value / 1000;
  try{
    var corr;
    if(model === 'SurQC'){
      var lim = Lm(+$('bhaLimit').value || 0), cum = 0, bha = [];
      rows.forEach(function(r){ if(cum + r.len_m <= lim + 1e-9 && bha.length === rows.indexOf(r)) bha.push({od:r.od_mm / 1000, id:r.id_mm / 1000, len:r.len_m}); cum += r.len_m; });
      var res = StretchModel.surqc({ survey: survey, dpOD: +$('dpOD').value / 1000, dpID: +$('dpID').value / 1000, bha: bha, mudDensity: mudKgm3(), gradient: G, loadCase: lc });
      corr = survey.map(function(s){ return { md: s.md, mech: StretchModel.correctionAt(res.points, s.md, 'mech'), thermal: StretchModel.correctionAt(res.points, s.md, 'thermal') }; });
      result = { model: model, loadCase: lc, profile: res.points };
    } else {
      var p = Object.assign({ mudDens: mudKgm3(), steelDens: 7700, blockW: 0, wobRot: 0, wobSlid: 0, ff1: 0.25, ff2: 0.25, ffOH: 0.3, ohDiam_m: rows[0].od_mm / 1000, ohTop: 0 },
        tdSet ? tdSet.params : {}, { mudDens: mudKgm3(), plan: null });
      // FIX 2026-11-12: plan: null — since the T&D modeler saves hole sections + runs (params.plan, 2026-11-08), passing
      // its params made tdModel switch to its plan "snapshot" (bit at the end of a run) instead of the bit at each survey,
      // so the single-string T&D stretch ignored the station depth. Without "Use T&D runs" the table above is the string.
      var bhaTD = rows.map(function(r){ var A = Math.PI / 4 * (Math.pow(r.od_mm / 1000, 2) - Math.pow(r.id_mm / 1000, 2));
        return { name:r.name, od_m:r.od_mm / 1000, id_m:r.id_mm / 1000, len:r.len_m, wt: r.wt_kgm === '' ? 7700 * A : +r.wt_kgm }; });
      var inp = { survey: survey, casings: tdSet ? tdSet.casings : [], bha: bhaTD, params: p, loadCase: lc, E: +$('youngE').value * 1e9,
        alpha: +$('alpha').value * 1e-6, Tsurf: +$('tSurf').value, Tcal: +$('tCal').value, gradient: G, sensorOffset: Lm(+$('sensorOff').value) };
      var runs = $('runsOn').checked ? planRuns() : [];
      if(runs.length){
        // 2026-11-12: one T&D string per station = the run drilling at its bit depth (see runsRender).
        // same defaults as the single-string path for anything the saved T&D params lack
        var off = Lm(+$('sensorOff').value), base = Object.assign({ mudDens: mudKgm3(), steelDens: 7700, blockW: 0, wobRot: 0, wobSlid: 0, ff1: 0.25, ff2: 0.25, ffOH: 0.3, ohDiam_m: rows[0].od_mm / 1000, ohTop: 0 }, tdSet.params);
        var setups = {};
        corr = survey.map(function(s){
          var r = runForBit(runs, tallyMd(s) + off);
          if(!r) return { md: s.md, mech: 0, thermal: 0, run: null };
          var su = setups[r.id] || (setups[r.id] = TDModelCore.planRunSetup(base, tdSet.casings || [], r));
          var x = StretchModel.tdStretchAtStation(Object.assign({}, inp, { bha: su.string, params: su.p, casings: tdSet.casings || [] }), s.md);
          return { md: s.md, mech: x.mech, thermal: x.thermal, surf: x.surfaceTension, run: r.name || r.id };
        });
      } else {
        var st = StretchModel.tdStretch(inp);
        corr = st.map(function(s){ return { md: s.md, mech: s.mech, thermal: s.thermal, surf: s.surfaceTension, run: null }; });
      }
      result = { model: model, loadCase: lc, profile: null, runs: runs.length ? runs.map(function(r){ return { name: r.name || r.id, from: r.from, to: r.to }; }) : null };
    }
    var cs = StretchModel.correctSurvey(survey, corr.map(function(c){ return c.mech + c.thermal; }));
    result.stations = cs.map(function(s, i){ return Object.assign({}, s, { mech: corr[i].mech, thermal: corr[i].thermal, total: corr[i].mech + corr[i].thermal, run: corr[i].run || null, tally: tallyMd(survey[i]) }); });
    renderSurvey(); plotResult();
    var last = result.stations[result.stations.length - 1];
    $('runStatus').innerHTML = model + ' · ' + $('loadCase').selectedOptions[0].text + ' · ' + ((Date.now() - t0) / 1000).toFixed(2) + ' s · at TD: mechanical ' +
      fmt(L(last.mech), 3) + uLen() + ', thermal ' + fmt(L(last.thermal), 3) + uLen() + ', total ' + fmt(L(last.total), 3) + uLen() + ' · ΔTVD ' + fmt(L(last.dTvd), 3) + uLen();
    $('btnSaveVer').disabled = !surveySource || USER_ROLE === 'viewer' || (surveySource.chain || []).some(function(c){ return c.type === 'stretch'; });
    $('btnReport').disabled = false;
  }catch(err){ $('runStatus').innerHTML = '<span class="bad">' + err.message + '</span>'; }
}
// ADDED 2026-11-11 (John): dark / light mode. Choice kept in localStorage (per browser, optional) and the plot redrawn.
