function reportInputs(){
  var m = $('modelSel').value;
  var o = { model: m === 'TD' ? 'T&D' : 'SurQC', loadCase: $('loadCase').selectedOptions[0].text, gradient_CperKm: +$('grad').value };
  if(m === 'TD'){ Object.assign(o, { Tsurf_C: +$('tSurf').value, Tcal_C: +$('tCal').value, alpha_1e6perC: +$('alpha').value, E_GPa: +$('youngE').value, sensorOffset_m: +Lm(+$('sensorOff').value).toFixed(3),
      runs: result && result.runs ? result.runs : null, mud_kgm3: result && result.runs ? 'per T&D hole section' : mudKgm3() }); }
  else Object.assign(o, { mud_kgm3: mudKgm3(), bhaLength_m: Lm(+$('bhaLimit').value), dpOD_mm: +$('dpOD').value, dpID_mm: +$('dpID').value });
  return o;
}
async function openReport(){
  if(!result){ alert('Calculate the stretch first.'); return; }
  var w = window.open('', '_blank'); if(!w){ alert('Allow pop-ups for MTX to open the report.'); return; }
  w.document.write('<p style="font-family:sans-serif">Building report…</p>');
  var esc = function(t){ return String(t == null ? '' : t).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); };
  var u = uLen().trim(), st = result.stations, inp = reportInputs();
  var last = (result.runs ? st.filter(function(s){ return s.run; }) : st).slice(-1)[0] || st[st.length - 1];   // deepest CORRECTED station
  var img = '';
  try{
    var x = st.map(function(s){ return L(s.mdRaw); }), tr = function(k, n, c){ return { x: x, y: st.map(function(s){ return L(s[k]); }), name: n, mode: 'lines', line: { color: c, width: 2 } }; };
    img = await Plotly.toImage({ data: [tr('mech', 'Mechanical', '#1f77b4'), tr('thermal', 'Thermal', '#d98200'), tr('total', 'Total', '#2e8b57')],
      layout: { paper_bgcolor: '#fff', plot_bgcolor: '#fff', font: { color: '#111', size: 13 }, margin: { l: 70, r: 20, t: 20, b: 50 },
        xaxis: { title: 'Measured depth (' + u + ')', gridcolor: '#ddd' }, yaxis: { title: 'Stretch (' + u + ')', gridcolor: '#ddd' } } }, { format: 'png', width: 1100, height: 420, scale: 2 });
  }catch(e){}
  var kv = function(rows){ return '<table class="kv">' + rows.map(function(r){ return '<tr><th>' + r[0] + '</th><td>' + r[1] + '</td></tr>'; }).join('') + '</table>'; };
  var chain = (surveySource && surveySource.chain) || [];
  var chainHtml = chain.length ? '<table><tr><th>#</th><th>Correction</th><th>Model</th><th>Details</th><th>Date</th><th>By</th></tr>' + chain.map(function(c, i){
      var mx = function(a){ return a && a.length ? Math.max.apply(null, a.map(Math.abs)) : null; };
      var det = [c.label || '', mx(c.dMd) ? 'max |ΔMD| ' + fmt(L(mx(c.dMd)), 3) + ' ' + u : '', mx(c.dInc) ? 'max |ΔInc| ' + fmt(mx(c.dInc), 3) + '°' : '', mx(c.dAz) ? 'max |ΔAz| ' + fmt(mx(c.dAz), 3) + '°' : ''].filter(Boolean).join(' · ');
      return '<tr><td>' + (i + 1) + '</td><td>' + esc(TAGNAME[c.type] || c.tag) + '</td><td>' + esc(c.model || '—') + '</td><td>' + esc(det) + '</td><td>' + (c.date ? new Date(c.date).toISOString().slice(0, 10) : '—') + '</td><td>' + esc(c.userName || '—') + '</td></tr>'; }).join('') + '</table>'
    : '<p>None — this correction is applied to the original (uploaded) survey.</p>';
  var runsHtml = result.runs ? '<table><tr><th>Run</th><th>Bit MD in (' + u + ')</th><th>Bit MD out (' + u + ')</th><th>Stations</th></tr>' + result.runs.map(function(r){
      return '<tr><td>' + esc(r.name) + '</td><td>' + fmt(L(r.from), 1) + '</td><td>' + fmt(L(r.to), 1) + '</td><td>' + st.filter(function(s){ return s.run === r.name; }).length + '</td></tr>'; }).join('') + '</table>' +
      '<p class="small">Each station uses the T&amp;D run whose bit-MD range contains its original (tally) MD + sensor offset; string, hole sections, casing set by then, mud weight and friction factors as modelled in the T&amp;D module (same rule as its Hookload calculation).</p>'
    : '<p>One drill string for all stations (panel 2).</p>';
  var M = result.model === 'TD';
  var method = M ? '<p><b>T&amp;D model.</b> Tension from MTX\'s Torque &amp; Drag soft-string model (Johancsik, Friesen &amp; Dawson 1984, SPE-11380), solved for each survey with the bit at station MD + sensor offset, for the selected load case. Mechanical stretch above the station = ∫F/(E·A) dMD (effective tension, A from each component\'s OD/ID). Thermal = α·∫(T − T<sub>cal</sub>) dMD with T = T<sub>surface</sub> + gradient × TVD (ISCWSA eBook ch.15).</p>'
    : '<p><b>SurQC model.</b> Port of SurQC\'s stretch correction: 1 m elements, inclination-only soft string, μ = 0.25, E = 210 GPa, steel 7700 kg/m³, α = 12×10⁻⁶ /°C, thermal = α × gradient × TVD. As SurQC, one tension profile with the bit at the last survey MD is used for every station.</p>';
  method += '<p>Corrected MD = measured MD + total stretch (mechanical + thermal). Inc and Az unchanged; TVD/N/E recomputed by minimum curvature (Bourgoyne et al., Applied Drilling Engineering, Ch. 8).</p>';
  var rows = st.map(function(s){ return '<tr><td>' + fmt(L(s.mdRaw), 2) + '</td><td>' + esc(s.run || (result.runs ? 'none' : '—')) + '</td><td>' + fmt(s.inc, 2) + '</td><td>' + fmt(s.az, 2) + '</td><td>' + fmt(L(s.mech), 3) + '</td><td>' + fmt(L(s.thermal), 3) + '</td><td>' + fmt(L(s.total), 3) + '</td><td>' + fmt(L(s.md), 2) + '</td><td>' + fmt(L(s.dTvd), 3) + '</td><td>' + fmt(L(s.dN), 3) + '</td><td>' + fmt(L(s.dE), 3) + '</td></tr>'; }).join('');
  var well = surveySource ? surveySource.wellKey : '(imported survey)', today = new Date().toISOString().slice(0, 10);
  var css = 'body{font-family:Segoe UI,Arial,sans-serif;color:#111;margin:24px 32px;font-size:12.5px}h1{color:' + RP_COLOR + ';font-size:22px;margin:0}h2{color:' + RP_COLOR + ';font-size:16px;border-bottom:2px solid ' + RP_COLOR + ';padding-bottom:3px;margin-top:22px}' +
    'table{border-collapse:collapse;width:100%;margin:6px 0}th,td{border:1px solid #ccc;padding:4px 6px;text-align:right}th{background:#eef3f9}td:first-child,th:first-child{text-align:left}.kv th{width:32%;text-align:left}.kv td{text-align:left}' +
    '.hdr{display:flex;justify-content:space-between;align-items:center;border-bottom:4px solid ' + RP_COLOR + ';padding-bottom:8px}.small{font-size:11px;color:#444}@media print{.np{display:none}h2{break-after:avoid}}';
  var h = '<!doctype html><html><head><meta charset="utf-8"><title>PipeStretch report — ' + esc(well) + '</title><style>' + css + '</style></head><body>' +
    '<div class="np" style="margin-bottom:10px"><button onclick="print()">🖨 Print / Save as PDF</button></div>' +
    '<div class="hdr"><div><h1>Pipe Stretch MD Correction</h1><div>' + esc(well) + (job.mtxJobId ? ' · MTX ' + esc(job.mtxJobId) + (job.title ? ' — ' + esc(job.title) : '') : '') + '</div></div><img src="' + RP_LOGO + '" style="height:54px"></div>' +
    '<h2>1 · Summary</h2>' + kv([['Starting survey version', esc(surveySource ? surveySource.versionName : '(imported survey)')], ['Model', esc(inp.model)], ['Load case', esc(inp.loadCase)],
      ['Stations', st.length + (result.runs ? ' (' + st.filter(function(s){ return !s.run; }).length + ' outside every run, uncorrected)' : '')],
      ['At deepest corrected station (' + fmt(L(last.mdRaw), 1) + ' ' + u + ')', 'mechanical ' + fmt(L(last.mech), 3) + ' ' + u + ' · thermal ' + fmt(L(last.thermal), 3) + ' ' + u + ' · <b>total ' + fmt(L(last.total), 3) + ' ' + u + '</b> · ΔTVD ' + fmt(L(last.dTvd), 3) + ' ' + u],
      ['Date', today]]) +
    '<h2>2 · Corrections applied before this one</h2>' + chainHtml +
    '<h2>3 · Inputs</h2>' + kv(Object.keys(inp).filter(function(k){ return k !== 'runs'; }).map(function(k){ return [esc(k), esc(inp[k])]; })) +
    '<h3>BHA runs</h3>' + runsHtml +
    '<h2>4 · Method</h2>' + method +
    '<h2>5 · Stretch along the well</h2>' + (img ? '<img src="' + img + '" style="width:100%">' : '<p>(plot unavailable)</p>') +
    '<h2>6 · Corrected survey</h2><table><tr><th>MD meas (' + u + ')</th><th>Run</th><th>Inc (°)</th><th>Az (°)</th><th>Mech (' + u + ')</th><th>Thermal (' + u + ')</th><th>Total ΔMD (' + u + ')</th><th>MD corr (' + u + ')</th><th>ΔTVD</th><th>ΔN</th><th>ΔE</th></tr>' + rows + '</table>' +
    '<h2>7 · Sign-off</h2><table><tr><th></th><th>Name</th><th>Signature</th><th>Date</th></tr><tr><td>Prepared by</td><td></td><td></td><td>' + today + '</td></tr><tr><td>Checked by</td><td></td><td></td><td></td></tr></table>' +
    '</body></html>';
  w.document.open(); w.document.write(h); w.document.close();
}

