<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PipeStretch — MTX</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/plotly.js/2.32.0/plotly.min.js"></script>
<script src="/js/tdModel.js"></script>
<script src="/js/stretchModel.js"></script>
<script src="/js/chainReport.js"></script>
<style>
  /*
    PipeStretch (added 2026-10-25). Standalone tool, same layout/theme as
    sagCorrection.ejs. MD correction for drill-pipe stretch: mechanical
    (tension) + thermal (temperature), shown separately and as total.
    Engine = public/js/stretchModel.js:
      "SurQC" model = port of SurQC's stretch correction (core verified
        element-by-element against the original C#, identical);
      "T&D" model  = tension from MTX's Torque & Drag soft-string code
        (public/js/tdModel.js) per survey station + thermal per ISCWSA eBook ch.15.
  */
  :root{ --bg:#0f1216; --panel:#171b21; --panel2:#1e232b; --border:#2a313c; --text:#e6e9ef; --muted:#8a93a3; --accent:#4da3ff; --good:#2ecc71; --bad:#ff5c5c; --warn:#f5a623; }
  *{box-sizing:border-box;}
  body{margin:0;font-family:-apple-system,Segoe UI,Roboto,Arial,sans-serif;background:var(--bg);color:var(--text);}
  header{padding:14px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;}
  header h1{font-size:16px;margin:0;font-weight:600;} header .sub{color:var(--muted);font-size:12px;}
  .wrap{max-width:1500px;margin:0 auto;padding:16px;}
  .panel{background:var(--panel);border:1px solid var(--border);border-radius:8px;padding:12px 14px;margin-bottom:16px;}
  .panel h2{font-size:13px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);margin:0 0 10px;}
  table{width:100%;border-collapse:collapse;font-size:12px;}
  th,td{border-bottom:1px solid var(--border);padding:4px 6px;text-align:right;white-space:nowrap;}
  th{color:var(--muted);font-weight:600;position:sticky;top:0;background:var(--panel2);} td:first-child,th:first-child{text-align:left;}
  input,select,button{background:var(--panel2);color:var(--text);border:1px solid var(--border);border-radius:5px;padding:5px 8px;font-size:12px;}
  input[type=number]{width:90px;} td input{width:100%;min-width:60px;padding:3px 5px;}
  button{cursor:pointer;} button.primary{background:var(--accent);border-color:var(--accent);color:#061325;font-weight:600;} button:disabled{opacity:.5;cursor:not-allowed;}
  .row{display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;margin-bottom:8px;}
  .field{display:flex;flex-direction:column;justify-content:flex-end;gap:3px;font-size:11px;color:var(--muted);white-space:nowrap;}
  .muted{color:var(--muted);font-size:12px;} .ok{color:var(--good);} .bad{color:var(--bad);} .warn{color:var(--warn);}
  .scroll{max-height:420px;overflow:auto;border:1px solid var(--border);border-radius:6px;}
  .note{background:var(--panel2);border-left:3px solid var(--accent);padding:6px 10px;font-size:12px;color:var(--muted);margin:6px 0;}
  .note.warnbox{border-left-color:var(--warn);}
  .plot{height:380px;}
  .pp-help{ padding:0 !important; min-height:0 !important; width:28px !important; height:28px !important; font-size:15px !important; border-radius:50% !important; }   /* 2026-11-12: page-wide button padding made it oval */
  /* "?" help button + floating window — PipeStretch copy added 2026-11-12 (same as SAGcorrection, from the T&D page (uploadTorqueAndDrag.ejs, 2026-11-08 round 3).
     The T&D page defines --cond/--mono/--sans/--text-dim/--text-bright; this page does not, so they are mapped here. */
  .pp-help, .hp-modal { --cond: inherit; --sans: inherit; --mono: ui-monospace, Consolas, monospace; --text-dim: var(--muted); --text-bright: #fff; }
    .pp-help {
      margin-left: auto;
      width: 30px;
      height: 30px;
      border-radius: 50%;
      border: 1px solid var(--accent);
      background: transparent;
      color: var(--accent);
      font-family: var(--cond);
      font-size: 17px;
      font-weight: 700;
      cursor: pointer;
      flex-shrink: 0
    }

    .pp-help:hover {
      background: var(--accent);
      color: var(--bg)
    }

    .hp-modal {
      position: fixed;
      inset: 0;
      z-index: 200;
      background: rgba(0, 0, 0, .55);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 16px
    }

    .hp-modal.open {
      display: flex
    }

    .hp-win {
      background: var(--panel);
      border: 1px solid var(--accent);
      border-radius: 6px;
      width: 100%;
      max-width: 860px;
      max-height: 88vh;
      display: flex;
      flex-direction: column;
      box-shadow: 0 10px 40px rgba(0, 0, 0, .5)
    }

    .hp-hdr {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 16px;
      border-bottom: 1px solid var(--border);
      background: var(--panel2)
    }

    .hp-hdr h3 {
      flex: 1;
      font-family: var(--cond);
      font-size: 20px;
      letter-spacing: 1px;
      color: var(--text-bright);
      text-transform: uppercase
    }

    .hp-x {
      background: none;
      border: 1px solid var(--border);
      color: var(--text);
      font-size: 18px;
      width: 34px;
      height: 34px;
      border-radius: 4px;
      cursor: pointer
    }

    .hp-body {
      padding: 6px 18px 18px;
      overflow-y: auto;
      font-family: var(--sans);
      font-size: 16px;
      line-height: 1.55;
      color: var(--text)
    }

    .hp-body h4 {
      font-family: var(--cond);
      font-size: 15px;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--accent);
      margin: 16px 0 6px
    }

    .hp-body p {
      margin: 6px 0
    }

    .hp-eq {
      font-family: var(--mono);
      font-size: 15px;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 8px 12px;
      line-height: 1.8;
      overflow-x: auto
    }

    .hp-eq-in {
      font-family: var(--mono);
      white-space: nowrap
    }

    .hp-src {
      font-size: 13px;
      padding-left: 20px;
      color: var(--text-dim)
    }

    .hp-src li {
      margin: 4px 0
    }

  .pp-help { width: 22px; height: 22px; font-size: 13px; padding: 0; margin-left: auto; text-transform: none; }
  .pp-help-plot { position: absolute; top: 4px; right: 4px; z-index: 5; margin: 0; }
  .hp-tbl { border-collapse: collapse; width: 100%; font-size: 12px; margin: 6px 0; }
  .hp-tbl th, .hp-tbl td { border: 1px solid var(--border); padding: 4px 6px; text-align: left; vertical-align: top; }
  .hp-tbl th { position: static; }
  .hp-tbl { table-layout: fixed; } .hp-tbl th, .hp-tbl td { white-space: normal; word-wrap: break-word; } .hp-tbl th:first-child { width: 120px; }

  /* ── CHANGED 2026-11-11 (John): bigger, easier-to-read UI, less left/right padding (presentations + phones), and a
        light mode (🌓 Theme button in the header; choice remembered per browser). Overrides only — ids/JS unchanged. ── */
  body.light-mode{ --bg:#f0f4f8; --panel:#ffffff; --panel2:#f6f8fa; --border:#c8d4de; --text:#0a0d10; --muted:#454e57; --accent:#0a6fd6; --good:#14843f; --bad:#c62828; --warn:#a86400; }
  body.light-mode button.primary{ color:#ffffff; }
  header{ padding:12px 18px; }
  header h1{ font-size:22px; } header .sub{ font-size:13.5px; }
  .wrap{ max-width:none; padding:14px 18px 40px; }
  .panel{ padding:16px 18px; }
  .panel h2{ font-size:17px; margin-bottom:14px; }
  table{ font-size:14px; }
  th,td{ padding:7px 9px; }
  input,select,button{ font-size:15px; padding:8px 11px; min-height:40px; }
  input[type=number]{ width:120px; } td input{ min-height:34px; padding:5px 7px; font-size:14px; min-width:80px; }
  .row{ gap:12px; margin-bottom:12px; }
  .field{ font-size:13.5px; color:var(--text); gap:5px; }
  .muted, .note{ font-size:14px; }
  .note{ padding:9px 12px; line-height:1.5; }
  .scroll{ max-height:520px; }
  .plot{ height:480px; }
  [style*="font-size:11px"], [style*="font-size: 11px"]{ font-size:14px !important; }
  [style*="font-size:12px"], [style*="font-size: 12px"]{ font-size:14px !important; }
  @media (max-width:768px){
    header{ padding:10px; }
    header > .row{ width:100%; }
    header > .row > *{ flex:1 1 45%; width:auto !important; }
    .wrap{ padding:8px 8px 30px; }
    .panel{ padding:12px; }
    .row > .field{ flex:1 1 45%; }
    .row > .field input, .row > .field select{ width:100% !important; }
    .plot{ height:340px; }
  }
</style>
</head>
<body>
<header>
  <div><h1>🌡 PipeStretch</h1><div class="sub">Measured-depth correction for drill-pipe stretch — mechanical + thermal</div></div>
  <div class="row" style="margin:0">
    <select id="unitSel" onchange="setUnit(this.value)"><option value="metric">Metric (m, kg/m³)</option><option value="imperial">Imperial (ft, ppg)</option></select>
    <input id="caseName" placeholder="Case name" style="width:160px">
    <button onclick="saveCase()" id="btnSaveCase">💾 Save case</button>
    <select id="caseList" style="width:220px"><option value="">— saved cases —</option></select>
    <button onclick="loadCase()">Load</button><button onclick="deleteCase()" id="btnDelCase">Delete</button>
    <button type="button" id="themeToggleBtn" title="Dark / light mode">🌓 Theme</button>   <!-- 2026-11-11 light mode -->
  </div>
</header>
<div class="wrap">

  <div class="panel">
    <h2>1 · Connect to an MTX job (optional)</h2>
    <div class="row">
      <div class="field"><span>MTX Job ID</span><input id="mtxId" placeholder="e.g. 2423" style="width:120px"></div>
      <button onclick="loadJob()">Load job</button>
      <div class="field"><span>Well / leg</span><select id="wellSel" style="width:260px" onchange="onWellChange()"></select></div>
      <div class="field"><span>T&amp;D scenario</span><select id="scenSel" style="width:180px"></select></div>
      <button onclick="loadStringFromTD()">⬇ Use saved T&amp;D string + parameters</button>
      <div class="field"><span>Survey version (start from)</span><select id="verSel" style="width:320px"></select></div>
      <button onclick="loadSurveyFromJob()">⬇ Use well survey</button>
      <button onclick="chainQc()" title="Combined QC report of the selected corrected version (all corrections, per-station ΔMD/ΔInc/ΔAz, final positions)">📄 Chain QC report</button>
    </div>
    <div id="chainInfo" class="note" style="display:none"></div>
    <div id="jobStatus" class="muted"></div>
  </div>

  <div class="panel">
    <h2>2 · Drill string (bit first)</h2>
    <div class="note">Same table format as the Torque &amp; Drag modeler. <b>SurQC model:</b> the consecutive rows from the bit that end within the BHA length are the BHA (steel, averaged
      over its length); everything above is drill pipe with the single DP OD/ID below (as SurQC). <b>T&amp;D model:</b> the whole table is the string, exactly as the
      T&amp;D modeler uses it (Wt column, beyond the last row its default 4½" DP), plus the casing program and friction factors loaded from the job.</div>
    <div class="row">
      <div class="field"><span>BHA length for SurQC (<span class="uL">m</span>)</span><input type="number" id="bhaLimit" value="60" step="1" oninput="refreshString()"></div>
      <div class="field"><span>DP OD (mm) — SurQC</span><input type="number" id="dpOD" value="114.3" step="0.1"></div>
      <div class="field"><span>DP ID (mm) — SurQC</span><input type="number" id="dpID" value="71.4" step="0.1"></div>
      <button onclick="addRow()">+ Component</button>
      <button onclick="exportString()">⬇ Export to Excel</button>
      <label><button onclick="document.getElementById('strFile').click()">⬆ Import from Excel</button>
        <input type="file" id="strFile" accept=".xlsx,.xls,.csv" style="display:none" onchange="importString(event)"></label>
      <span id="strInfo" class="muted"></span>
    </div>
    <div class="scroll" style="max-height:300px"><table>
      <thead><tr><th>Component</th><th>OD (mm)</th><th>ID (mm)</th><th>Length (<span class="uL">m</span>)</th><th>Wt (<span class="uW">kg/m</span>)</th><th>From bit (<span class="uL">m</span>)</th><th>SurQC role</th><th></th></tr></thead>
      <tbody id="strBody"></tbody></table></div>
    <div id="tdParamsInfo" class="muted" style="margin-top:6px"></div>
    <!-- ADDED 2026-11-12 (John): BHA runs from the T&D modeler (T&D is the master source of BHAs / runs / sections). -->
    <div style="margin-top:10px">
      <label class="field" style="flex-direction:row;align-items:center;gap:8px;font-size:15px"><input type="checkbox" id="runsOn" onchange="runsRender()" style="min-height:0;width:auto">
        <b>Use T&amp;D runs</b> (each survey uses the run drilling at its bit depth — T&amp;D model only)</label>
      <div id="runsInfo" class="muted"></div>
      <div class="scroll" style="max-height:240px;margin-top:6px"><table>
        <thead><tr><th>Run</th><th>Bit MD in (<span class="uL">m</span>)</th><th>Bit MD out (<span class="uL">m</span>)</th><th>Components</th><th>Top DP</th><th>Hole section</th><th>Mud (<span class="uM">kg/m³</span>)</th><th>Casing set</th><th>Stations</th></tr></thead>
        <tbody id="runsBody"></tbody></table></div>
    </div>
  </div>

  <div class="panel">
    <h2>3 · Stretch analysis</h2>
    <div class="row">
      <div class="field"><span>Model</span><select id="modelSel" onchange="onModelChange()" style="width:110px"><option value="SurQC">SurQC</option><option value="TD">T&amp;D</option></select></div>
      <div class="field"><span>Load case</span><select id="loadCase" style="width:250px"></select></div>
      <div class="field"><span>Mud weight (<span class="uM">kg/m³</span>)</span><input type="number" id="mud" value="1200" step="1"></div>
      <div class="field"><span>Geothermal gradient (°C/km TVD)</span><input type="number" id="grad" value="25" step="0.1"></div>
      <div class="field tdOnly"><span>Surface temp (°C)</span><input type="number" id="tSurf" value="10" step="0.5"></div>
      <div class="field tdOnly"><span>Pipe calibration temp (°C)</span><input type="number" id="tCal" value="10" step="0.5"></div>
      <div class="field tdOnly"><span>Thermal coeff (×10⁻⁶ /°C)</span><input type="number" id="alpha" value="12" step="0.1"></div>
      <div class="field tdOnly"><span>Young's modulus (GPa)</span><input type="number" id="youngE" value="206.8" step="0.1"></div>
      <div class="field tdOnly"><span>Sensor offset from bit (<span class="uL">m</span>)</span><input type="number" id="sensorOff" value="15" step="0.1"></div>
    </div>
    <div class="note" id="modelNote"></div>
    <div class="row">
      <button class="primary" onclick="runStretch()">Calculate stretch</button>
      <span id="runStatus" class="muted"></span>
    </div>
    <div id="plot" class="plot"></div>
  </div>

  <div class="panel">
    <h2>4 · Stretch-corrected survey</h2>
    <div class="row">
      <label><button onclick="document.getElementById('svyFile').click()">⬆ Import survey (MD, INC, AZ)</button>
        <input type="file" id="svyFile" accept=".xlsx,.xls,.csv" style="display:none" onchange="importSurvey(event)"></label>
      <button onclick="exportSurvey()">⬇ Export corrected survey</button>
      <button onclick="saveVersion()" id="btnSaveVer" disabled title="Available when the survey came from an MTX job well">💾 Save as new version in job</button>
      <button onclick="openReport()" id="btnReport" disabled>📄 Report</button>
      <span id="svyInfo" class="muted"></span>
    </div>
    <div class="note">Corrected MD = measured MD + total stretch of the pipe above that depth (mechanical + thermal). Inc and Az are unchanged; TVD/N/E are
      recomputed by minimum curvature. "Save as new version" creates a new well (<i>&lt;well&gt; [earlier corrections+]STRETCH &lt;date&gt;</i>, source PipeStretch) with the
      correction history; the version it started from is never modified. The next module (e.g. SAG) can start from it.</div>
    <div class="scroll"><table>
      <thead><tr><th>MD meas</th><th>Run</th><th>Inc (°)</th><th>Az (°)</th><th>Mechanical</th><th>Thermal</th><th>Total ΔMD</th><th>MD corr</th><th>TVD meas*</th><th>TVD corr*</th><th>ΔTVD</th><th>ΔN</th><th>ΔE</th></tr></thead>
      <tbody id="svyBody"></tbody></table></div>
    <div class="muted">*TVD relative to the first station.</div>
  </div>
</div>

<script>
var UNIT = 'metric', FT = 0.3048, PPG = 119.826427, KGM2LBFT = 0.671968975;
var USER_ROLE = <%- JSON.stringify(user && user.role || '') %>;
var job = { noteId:null, title:'', mtxJobId:'', wells:[], td:null };
var tdSet = null;            // {casings, params} loaded from the job's saved T&D model
var survey = [], surveySource = null, result = null;
function $(id){ return document.getElementById(id); }
function L(v){ return UNIT === 'metric' ? v : v / FT; }
function Lm(v){ return UNIT === 'metric' ? v : v * FT; }
function fmt(v, d){ return (v == null || !isFinite(v)) ? '—' : (+v).toFixed(d); }
var uLen = function(){ return UNIT === 'metric' ? ' m' : ' ft'; };

var LOAD_CASES = {
  SurQC: [['pullOut','Pulling out (SurQC: drag added, μ 0.25)'], ['static','Static — no drag'], ['runIn','Running in (drag subtracted)']],
  TD: [['static','Off bottom, no axial friction'], ['tripOut','Tripping out'], ['tripIn','Tripping in'], ['rotOB','Rotating on bottom (T&D WOB)'], ['slide','Slide drilling (T&D WOB)']]
};
var MODEL_NOTES = {
  SurQC: '<b>SurQC</b> — port of SurQC\'s stretch correction (element core identical to the original C#): 1 m elements, inclination-only soft string, μ = 0.25, ' +
    'E = 210 GPa, steel 7700 kg/m³, α = 12×10⁻⁶ /°C, thermal = α × gradient × TVD (pipe calibrated at surface temperature). As SurQC: one tension profile with the bit at the ' +
    'last survey MD is used for every station, and the BHA bottom is placed at the last survey MD.',
  TD: '<b>T&amp;D</b> — tension from MTX\'s Torque &amp; Drag soft-string model (Johancsik 1984; azimuth, casing/open-hole friction, the full string), solved for each survey ' +
    'with the bit at station MD + sensor offset. Mechanical = ∫F/(EA) along the pipe above the station (effective tension, as the T&amp;D modeler). Thermal = α ∫(T − T<sub>cal</sub>) ' +
    'with T = T<sub>surface</sub> + gradient × TVD (ISCWSA eBook ch.15).'
};
function onModelChange(){
  var m = $('modelSel').value;
  $('loadCase').innerHTML = LOAD_CASES[m].map(function(o){ return '<option value="' + o[0] + '">' + o[1] + '</option>'; }).join('');
  document.querySelectorAll('.tdOnly').forEach(function(e){ e.style.display = m === 'TD' ? '' : 'none'; });
  $('modelNote').innerHTML = MODEL_NOTES[m];
  refreshString(); if(typeof runsRender === 'function' && $('runsBody')) runsRender();
}
function setUnit(u){
  if(u === UNIT) return;
  var rows = readString(), lim = Lm(+$('bhaLimit').value), off = Lm(+$('sensorOff').value);
  var mud = UNIT === 'metric' ? +$('mud').value : +$('mud').value * PPG;
  UNIT = u;
  document.querySelectorAll('.uL').forEach(function(e){ e.textContent = u === 'metric' ? 'm' : 'ft'; });
  document.querySelectorAll('.uW').forEach(function(e){ e.textContent = u === 'metric' ? 'kg/m' : 'lb/ft'; });
  document.querySelectorAll('.uM').forEach(function(e){ e.textContent = u === 'metric' ? 'kg/m³' : 'ppg'; });
  $('bhaLimit').value = +L(lim).toFixed(1); $('sensorOff').value = +L(off).toFixed(2);
  $('mud').value = u === 'metric' ? +mud.toFixed(1) : +(mud / PPG).toFixed(3);
  $('strBody').innerHTML = ''; rows.forEach(addRow); renderSurvey();
}

// ---------------- string table (SI internally)
function addRow(r){
  r = r || {name:'', od_mm:'', id_mm:'', len_m:'', wt_kgm:''};
  var tr = document.createElement('tr');
  tr.innerHTML = '<td><input value="' + String(r.name || '').replace(/"/g, '&quot;') + '" style="min-width:150px"></td>' +
    '<td><input type="number" step="0.01" value="' + r.od_mm + '" oninput="refreshString()"></td>' +
    '<td><input type="number" step="0.01" value="' + r.id_mm + '" oninput="refreshString()"></td>' +
    '<td><input type="number" step="0.001" value="' + (r.len_m === '' ? '' : +L(+r.len_m).toFixed(3)) + '" oninput="refreshString()"></td>' +
    '<td><input type="number" step="0.001" value="' + (r.wt_kgm === '' || r.wt_kgm == null ? '' : +(UNIT === 'metric' ? +r.wt_kgm : +r.wt_kgm * KGM2LBFT).toFixed(3)) + '"></td>' +
    '<td class="fromBit">—</td><td class="role muted">—</td><td><button onclick="this.closest(\'tr\').remove();refreshString()">✕</button></td>';
  $('strBody').appendChild(tr); refreshString();
}
function readString(){
  return Array.from(document.querySelectorAll('#strBody tr')).map(function(tr){
    var ins = tr.querySelectorAll('input');
    return { name: ins[0].value, od_mm: +ins[1].value, id_mm: +ins[2].value, len_m: Lm(+ins[3].value || 0),
             wt_kgm: ins[4].value === '' ? '' : (UNIT === 'metric' ? +ins[4].value : +ins[4].value / KGM2LBFT) };
  }).filter(function(r){ return r.od_mm > 0 && r.len_m > 0 && r.id_mm >= 0 && r.id_mm < r.od_mm; });
}
function refreshString(){
  var cum = 0, lim = Lm(+$('bhaLimit').value || 0), bhaLen = 0;
  document.querySelectorAll('#strBody tr').forEach(function(tr){
    var ins = tr.querySelectorAll('input'), len = Lm(+ins[3].value || 0);
    tr.querySelector('.fromBit').textContent = fmt(L(cum), 2);
    // SurQC BHA = rows that END within the BHA length (a long DP row that merely
    // starts inside it is drill pipe, not BHA)
    var inBha = cum + len <= lim + 1e-9 && (bhaLen === cum); if(inBha) bhaLen += len;
    tr.querySelector('.role').textContent = inBha ? 'BHA' : 'DP (uses DP OD/ID)';
    cum += len;
  });
  $('strInfo').textContent = 'String rows total ' + fmt(L(cum), 1) + uLen() + ' · SurQC BHA = ' + fmt(L(bhaLen), 2) + uLen();
}
function exportString(){
  var rows = readString(); if(!rows.length){ alert('Table is empty.'); return; }
  var M = UNIT === 'metric';
