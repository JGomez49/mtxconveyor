      '<td>' + (c ? fmt(L(s.mech), 3) : '') + '</td><td>' + (c ? fmt(L(s.thermal), 3) : '') + '</td><td>' + (c ? fmt(L(s.total), 3) : '') + '</td>' +
      '<td>' + (c ? fmt(L(s.md), 2) : '') + '</td><td>' + (c ? fmt(L(s.tvdRaw), 2) : '') + '</td><td>' + (c ? fmt(L(s.tvd), 2) : '') + '</td>' +
      '<td>' + (c ? fmt(L(s.dTvd), 3) : '') + '</td><td>' + (c ? fmt(L(s.dN), 3) : '') + '</td><td>' + (c ? fmt(L(s.dE), 3) : '') + '</td></tr>';
  }).join('');
}
function exportSurvey(){
  if(!result){ alert('Calculate the stretch first.'); return; }
  var u = UNIT === 'metric' ? 'm' : 'ft';
  var data = result.stations.map(function(s){ var o = {};
    o['MD measured (' + u + ')'] = +L(s.mdRaw).toFixed(3); o['Inc (deg)'] = s.inc; o['Az (deg)'] = s.az;
    o['Mechanical stretch (' + u + ')'] = +L(s.mech).toFixed(4); o['Thermal stretch (' + u + ')'] = +L(s.thermal).toFixed(4); o['Total stretch (' + u + ')'] = +L(s.total).toFixed(4);
    o['MD corrected (' + u + ')'] = +L(s.md).toFixed(3); o['TVD measured (' + u + ')'] = +L(s.tvdRaw).toFixed(3); o['TVD corrected (' + u + ')'] = +L(s.tvd).toFixed(3);
    o['dTVD (' + u + ')'] = +L(s.dTvd).toFixed(4); o['dN (' + u + ')'] = +L(s.dN).toFixed(4); o['dE (' + u + ')'] = +L(s.dE).toFixed(4); return o; });
  var wb = XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(data), 'Stretch corrected');
  XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet([{ Model: result.model, 'Load case': result.loadCase, 'Mud (kg/m3)': mudKgm3(), 'Gradient (degC/km)': +$('grad').value,
    'T surface (degC)': +$('tSurf').value, 'T calibration (degC)': +$('tCal').value, 'alpha (1e-6/degC)': +$('alpha').value, 'E (GPa)': +$('youngE').value }]), 'Inputs');
  XLSX.writeFile(wb, 'PipeStretch_' + result.model + (surveySource ? '_' + surveySource.wellKey.replace(/[^a-z0-9\-_ ]/gi, '_') : '') + '.xlsx');
}
async function saveVersion(){
  if(!surveySource || !result) return;
  var tags = (surveySource.chain || []).map(function(c){ return c.tag; }).concat(['STRETCH']).join('+');
  if(!confirm('Create a NEW well "' + surveySource.wellKey + ' ' + tags + ' <today>" in this job with the stretch-corrected MDs?\nStarting version: ' + surveySource.versionName + ' (not changed).')) return;
  try{
    var r = await fetch('/notes/pipeStretch/saveVersion', { method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ noteId: surveySource.noteId, wellKey: surveySource.wellKey, versionId: surveySource.versionId || null, model: result.model, loadCase: result.loadCase,
        label: $('loadCase').selectedOptions[0].text + (result.runs ? ' · ' + result.runs.length + ' T&D run(s)' : ''), inputs: reportInputs(),
        corrections: result.stations.map(function(s){ return { md: s.mdRaw, dMd: s.total }; }) }) });
    var d = await r.json(); if(!d.ok) throw new Error(d.error);
    alert('Saved as "' + d.wellName + '". The starting version was not changed.'); refreshVersions();
  }catch(err){ alert('Save failed: ' + err.message); }
}

