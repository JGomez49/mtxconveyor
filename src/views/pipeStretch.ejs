async function saveCase(){
  var name = $('caseName').value.trim(); if(!name){ alert('Enter a case name.'); return; }
  var d = await (await fetch('/notes/pipeStretch/case', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({name:name, inputData:caseInput(), survey:survey})})).json();
  if(!d.ok){ alert(d.error); return; } refreshCases(); alert('Case saved.');
