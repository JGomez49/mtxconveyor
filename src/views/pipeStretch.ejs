function planRuns(){ var pl = tdSet && tdSet.params && tdSet.params.plan; return (pl && window.TDModelCore && TDModelCore.planActiveRuns) ? TDModelCore.planActiveRuns(pl) : []; }
function runForBit(runs, bit){
  var c = runs.filter(function(r){ return r.from <= bit && bit <= r.to; });
  return c.length ? c[c.length - 1] : (runs.length && bit < runs[0].from ? runs[0] : null);
}
// ADDED 2026-11-12 (John, correction chain phase 5): combined QC report of the version selected in "Survey version"
