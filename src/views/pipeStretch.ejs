async function refreshCases(){
  try{ var d = await (await fetch('/notes/pipeStretch/cases')).json();
    $('caseList').innerHTML = '<option value="">— saved cases —</option>' + d.cases.map(function(c){ return '<option value="' + c._id + '">' + c.name + ' · ' + c.createdByName + ' · ' + new Date(c.createdAt).toLocaleDateString() + '</option>'; }).join('');
  }catch(e){}
