function importSurvey(evt){
  var f = evt.target.files[0]; if(!f) return;
  var rd = new FileReader();
  rd.onload = function(e){
    try{
      var wb = XLSX.read(new Uint8Array(e.target.result), {type:'array'});
      var rows = XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]], {header:1, defval:''});
      var hdr = rows.find(function(r){ return r.some(function(c){ return /md|depth/i.test(String(c)); }); }) || [];
      var mdFt = hdr.some(function(c){ return /md|depth/i.test(String(c)) && /ft|feet/i.test(String(c)); });
      survey = rows.filter(function(r){ return r.length >= 3 && [0,1,2].every(function(i){ return r[i] !== '' && isFinite(+r[i]); }); })
        .map(function(r){ return {md:+r[0] * (mdFt ? FT : 1), inc:+r[1], az:+r[2]}; }).sort(function(a, b){ return a.md - b.md; });
      if(!survey.length) throw new Error('No numeric MD / INC / AZ rows found (columns A, B, C).');
      surveySource = null; result = null; $('btnSaveVer').disabled = true;
      $('svyInfo').textContent = survey.length + ' stations imported from ' + f.name + (mdFt ? ' (MD in ft, converted)' : ' (MD assumed m)'); renderSurvey();
    }catch(err){ alert('Import failed: ' + err.message); }
    evt.target.value = '';
  };
  rd.readAsArrayBuffer(f);
