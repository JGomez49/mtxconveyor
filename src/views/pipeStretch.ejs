    loadCase: $('loadCase').value, mud_kgm3: mudKgm3(), grad: +$('grad').value, tSurf: +$('tSurf').value, tCal: +$('tCal').value, alpha: +$('alpha').value,
    youngE: +$('youngE').value, sensorOff_m: Lm(+$('sensorOff').value), tdSet: tdSet, runsOn: $('runsOn').checked, source: { mtxJobId: job.mtxJobId, surveySource: surveySource } };
