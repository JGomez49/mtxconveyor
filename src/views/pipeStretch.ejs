  if(!M){ $('runsInfo').innerHTML = 'Runs are modelled with the <b>T&amp;D</b> model (pick it in panel 3).'; }
  var cnt = {}; survey.forEach(function(s){ var r = runForBit(runs, tallyMd(s) + off); var k = r ? r.id : '-'; cnt[k] = (cnt[k] || 0) + 1; });
  var pl = tdSet.params.plan, cas = tdSet.casings || [];
  $('runsBody').innerHTML = runs.map(function(r){
    var su = TDModelCore.planRunSetup(tdSet.params, cas, r), dp = su.p._pipeTop, sec = TDModelCore.planSectionAt(pl, (r.from + r.to) / 2) || {};
    var set = cas.filter(function(c){ return c.shoe <= r.from + 1; }).map(function(c){ return fmt(c.id_m * 1000, 0) + ' mm @ ' + fmt(L(c.shoe), 0); }).join(', ');
    return '<tr><td>' + String(r.name || r.id).replace(/</g, '&lt;') + '</td><td>' + fmt(L(r.from), 1) + '</td><td>' + fmt(L(r.to), 1) + '</td><td>' + su.string.length + '</td>' +
      '<td>' + (dp ? fmt(dp.od_m * 1000, 1) + ' × ' + fmt(dp.id_m * 1000, 1) + ' mm' : 'default 4½"') + '</td><td>' + (sec.name ? String(sec.name).replace(/</g, '&lt;') + ' · ' + fmt((sec.hole_m || 0) * 1000, 0) + ' mm' : '—') + '</td>' +
      '<td>' + fmt(UNIT === 'metric' ? su.p.mudDens : su.p.mudDens / PPG, UNIT === 'metric' ? 0 : 2) + '</td><td>' + (set || '—') + '</td><td>' + (cnt[r.id] || 0) + '</td></tr>';
  }).join('');
  if(M) $('runsInfo').innerHTML = on ? runs.length + ' run(s) · ' + (survey.length - (cnt['-'] || 0)) + ' / ' + survey.length + ' stations covered' + (cnt['-'] ? ' · <span class="warn">' + cnt['-'] + ' below every run (left uncorrected)</span>' : '') +
    ' · stations assigned by original (tally) MD + sensor offset' : 'Tick to correct each station with the run drilling at its bit depth.';
