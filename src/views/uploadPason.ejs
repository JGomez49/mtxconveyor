      const short=t=>String(t||'').replace(/Measured Depth/i,'MD').replace(/Time \(days from start\)/i,'Days').replace(/Total drilled depth, all legs/i,'Total depth').replace(/Hole Depth/i,'Depth');
      ['x','y'].forEach(k=>{ const a=opt.scales&&opt.scales[k]; if(!a) return;
        a.ticks=Object.assign({}, a.ticks, { font:{ size:10 }, maxTicksLimit: k==='x'?6:8, callback:(v)=>Number.isFinite(v) ? (Math.abs(v)>=100 ? Math.round(v).toString() : (+v).toFixed(Math.abs(v)>=10?1:2)) : v });
