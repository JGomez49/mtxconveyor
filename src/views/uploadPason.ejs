    document.getElementById('exportMinCsv').addEventListener('click', ()=>{ const p=currentPlotDef(); if(!p.supportsSpecial) return alert('No Min for this plot.'); downloadCsv(lastCurvesSpecial.min, `${p.id.toUpperCase()}_MinCurve.csv`); });

    document.getElementById('exportVisibleCsv').addEventListener('click', ()=>{ if(!chartMain) return; const ds=chartMain.data.datasets.filter(d=>!d.hidden && d.data && d.data.length); if(!ds.length) return alert('No visible data to export.'); const lines=['Series,X,Y']; ds.forEach(d=>{ d.data.forEach(pt=>lines.push(`${d.label},${pt.x},${pt.y}`)); }); const blob=new Blob([lines.join('\n')],{type:'text/csv;charset=utf-8;'}); const url=URL.createObjectURL(blob); const a=document.createElement('a'); const p=currentPlotDef(); a.href=url; a.download=`${p.id}_visible.csv`; a.click(); setTimeout(()=>URL.revokeObjectURL(url),1000); });

    // ── Export All Plots to Excel (1 tab per plot) ──────────────────────────
    // Computes Average/Max/Min curves for EVERY plot in plotRegistry, using
    // the same buildAverageSeries/buildPercentileSeries functions already
    // used on-screen — regardless of which plot is currently selected or
    // which Show Avg/Max/Min checkboxes are toggled (export always includes
    // all three curves for every plot).
    function computeCurvesForPlot(plotId){
      if(plotId === 'tds') return snowCurves();   // 2026-11-22: time at each total depth (see snowCurves)
      const seriesGetters = { hl:getAllProcessedSeriesHL, tq:getAllProcessedSeriesTQ, wob:getAllProcessedSeriesWOB, rop:()=>getAllProcessedSeriesROP('all'), tds:getAllProcessedSeriesTDS, my:()=>getAllProcessedSeriesMY(), mys:()=>getAllProcessedSeriesMY('slide'), myr:()=>getAllProcessedSeriesMY('rot'), myc:()=>getAllProcessedSeriesMY('corr'), myb:()=>getAllProcessedSeriesMY('rb'), myw:()=>getAllProcessedSeriesMY('rw'), rops:()=>getAllProcessedSeriesROP('slide'), ropr:()=>getAllProcessedSeriesROP('rot'), mse:getAllProcessedSeriesMSE, flow:getAllProcessedSeriesFLOW, td:getAllProcessedSeriesTD };
      const getter = seriesGetters[plotId];
      if(!getter) return { avg:[], max:[], min:[] };
      const seriesForGrid = getter();

      // 2026-11-14 (John): Time vs Depth is never smoothed (smoothing rounded the flat/drilling corners); other plots as set
      const smoothOn = plotId !== 'td' && plotId !== 'tds' && !/^my/.test(plotId) && document.getElementById('applySmoothing').checked;
      const win = (plotId === 'td' || plotId === 'tds' || /^my/.test(plotId)) ? 1 : (parseInt(document.getElementById('smoothWindow').value,10) || 1);
      const maxPctVal = Math.min(100, Math.max(50, parseFloat(document.getElementById('maxPct').value)||90)) / 100;
      const minPctVal = Math.min(50,  Math.max(0,  parseFloat(document.getElementById('minPct').value)||10)) / 100;

      let step, minSeries;
      if(plotId === 'td' || plotId === 'tds'){
        step = computeAdaptiveStepTD(seriesForGrid);
        minSeries = 1;
      } else {
        const userStep = parseFloat(document.getElementById('avgStep').value) || 5;
        const userMinSeries = parseInt(document.getElementById('avgMinSeries').value,10) || 2;
        step = Math.max(0.0001, userStep);
        // 2026-11-14 (John): clamp "min series per point" to the number of wells actually loaded. With ONE well and
        // the default 2, no grid point qualified, so every MD-based plot (HL, Torque, WOB, ROP, MSE, Flow) had empty
        // Avg/Max/Min and was silently left out of "Export All Plots" — only Hole Depth vs Time (fixed at 1) was
        // exported, and the job page's Drilling Mechanics then had no ROP for "Calculate Time vs Depth".
        const nSeries = seriesForGrid.filter(a => Array.isArray(a) && a.length > 0).length;
        minSeries = Math.max(1, Math.min(userMinSeries, nSeries || 1));
      }

      const isMy = /^my/.test(plotId);
      if(isMy){ step = myBinLen(); }   // 2026-11-21: MY on its own bin, never smoothed
      const isRop = /^rop/.test(plotId) || isMy, X = isRop ? ropMaxTD() : NaN;   // 2026-11-21: ROP continued to max TD (see extendTo)
      if(isRop && ropExtMethod() === 'ms1') minSeries = 1;
      const ex = (pts, kind, q) => Number.isFinite(X) ? extendTo(pts, X, step, seriesForGrid, kind, q) : pts;
      return {
        avg: ex(buildAverageSeries(seriesForGrid, step, minSeries, smoothOn, win), 'avg'),
        max: ex(buildPercentileSeries(seriesForGrid, step, minSeries, maxPctVal, win), 'max', maxPctVal),
        min: ex(buildPercentileSeries(seriesForGrid, step, minSeries, minPctVal, win), 'min', minPctVal),
      };
    }

    const SHEET_NAMES = { tds:'Snowball', myb:'MY Rot Build', myw:'MY Rot Walk', mys:'MY Slide', myr:'MY Rotary DLS', myc:'MY Corrected', rops:'ROP Slide', ropr:'ROP Rotate', hl:'Hook Load', tq:'Torque', wob:'WOB', rop:'ROP', mse:'MSE', flow:'Flow', td:'Hole Depth vs Time' };

    document.getElementById('exportAllPlotsXlsx').addEventListener('click', ()=>{
      if(typeof XLSX === 'undefined'){ alert('Excel library not loaded.'); return; }

      const wb = XLSX.utils.book_new();
      let anySheet = false;

      // 2026-11-21: + 'ROP Slide' / 'ROP Rotate' tabs (same Avg / Max / Min layout), skipped when no well has Rotary RPM rows
      plotRegistry.filter(p => p.id !== 'my').concat([{ id:'rops' }, { id:'ropr' }, { id:'mys' }, { id:'myr' }, { id:'myc' }, { id:'myb' }, { id:'myw' }]).forEach(p => {   // 2026-11-21: + 3 MY tabs
        const { avg, max, min } = computeCurvesForPlot(p.id);
        if(p.id === 'tds'){   // 2026-11-22: snowball tab by total depth (time to reach it): TotalDepth_m, Avg_days, Max(fastest)_days, Min(slowest)_days
          if(!avg.length) return; const aoa = [['TotalDepth_m', 'Avg_days', 'Max_fastest_days', 'Min_slowest_days']].concat(avg.map((q, i) => [+q.y.toFixed(2), +q.x.toFixed(4), max[i] ? +max[i].x.toFixed(4) : '', min[i] ? +min[i].x.toFixed(4) : '']));
          XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(aoa), 'Snowball'); anySheet = true; return; }
        if(!avg.length && !max.length && !min.length) return; // no data for this plot — skip its sheet

        // Merge avg/max/min by X value (grids match since built with the
        // same step/minSeries, but merging by key is more defensive than a
        // blind positional zip).
        const rowsMap = new Map();
        const put = (arr, col) => arr.forEach(pt => {
          const key = pt.x.toFixed(6);
          if(!rowsMap.has(key)) rowsMap.set(key, { x: pt.x });
          rowsMap.get(key)[col] = pt.y;
        });
        put(avg, 'avg'); put(max, 'max'); put(min, 'min');

        const xHeader = (p.id === 'td' || p.id === 'tds') ? 'Time_days' : 'MeasuredDepth_m';
        const rows = [...rowsMap.values()]
          .sort((a,b) => a.x - b.x)
          .map(r => [r.x, r.avg ?? '', r.max ?? '', r.min ?? '']);

        const aoa = [[xHeader, 'Avg', 'Max', 'Min'], ...rows];
        const ws = XLSX.utils.aoa_to_sheet(aoa);
        ws['!cols'] = [{wch:16},{wch:12},{wch:12},{wch:12}];

        const sheetName = (SHEET_NAMES[p.id] || p.id).slice(0,31);
        XLSX.utils.book_append_sheet(wb, ws, sheetName);
        anySheet = true;
      });

      // 2026-11-21 (John): LAS wells add two tabs used by the job page time model (Drilling Mechanics): time per 100 m and stops
      // (public/js/slideSheetModel.js lasTimeStats). Wells from CSV / Excel have no such data — the tabs are simply absent.
      const lasW = (typeof window.mtxLasWells === 'function' ? window.mtxLasWells() : []).filter(w => w.stats);
      if(lasW.length){
        const tb = [['Well', 'From_m', 'To_m', 'Drilled_m', 'OnBottom_h', 'Slide_m', 'Slide_h', 'Rotate_m', 'Rotate_h', 'Other_h', 'Elapsed_h']];
        lasW.forEach(w => w.stats.bins.forEach(b => tb.push([w.name, b.from, b.to, +b.m.toFixed(2), +b.onbH.toFixed(4), +b.slideM.toFixed(2), +b.slideH.toFixed(4), +b.rotM.toFixed(2), +b.rotH.toFixed(4), +b.otherH.toFixed(4), +b.elapsedH.toFixed(4)])));
        XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(tb), 'LAS time per 100 m');
        const ts = [['Well', 'Depth_m', 'StartDay', 'Hours', 'EndsWithDrop', 'NextDepth_m']];
        lasW.forEach(w => w.stats.stops.forEach(x => ts.push([w.name, +x.depth.toFixed(2), +x.startDay.toFixed(4), +x.hours.toFixed(3), x.endsWithDrop ? 'Y' : 'N', x.nextDepth == null ? '' : +x.nextDepth.toFixed(2)])));
        XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(ts), 'LAS stops');
        anySheet = true;
      }
      // 2026-11-21: 'Flat times' tab (mtxFlatStats per CSV well) for the planned time vs depth on the job page
      { const ft=[['Well','Type','Section','Depth_m','Hours','Metres']]; (state.ropSeries||[]).forEach(s=>{ const r=mtxFlatStats(s); if(r) r.forEach(x=>ft.push([s.name, x[0], x[1], x[2]===''?'':+(+x[2]).toFixed(2), +(+x[3]).toFixed(3), x[4]===''?'':+(+x[4]).toFixed(2)])); });
        if(ft.length>1){ XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(ft), 'Flat times'); anySheet=true; } }
      if(!anySheet){ alert('No Average/Max/Min curve data available to export for any plot.'); return; }

      XLSX.writeFile(wb, 'pason_all_plots.xlsx');
    });

    function updateStatus(){ const f1txt=state.file1 ? `Loaded \"${state.file1.name}\" • Rows: ${state.file1.rows} • Replaced: B=${state.file1.replacedB}, C=${state.file1.replacedC}` : ''; document.getElementById('status1').textContent=f1txt; const pasonCount=state.pasonSeries.length; const totalRows=state.pasonSeries.reduce((acc,s)=>acc+(s.rows||0),0); const totalRepl=state.pasonSeries.reduce((acc,s)=>acc+(s.replaced||0),0); const f2txt=pasonCount?`Loaded HL series: ${pasonCount} • Total rows: ${totalRows} • Replaced: ${totalRepl}`:''; document.getElementById('status2').textContent=f2txt; }

    const _renderMain=renderMain; renderMain=function(){ _renderMain(); updateStatus(); }

    buildPlotDropdownUI();
    renderMain();
  </script>
