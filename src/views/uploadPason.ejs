    function makeDatasetFor(plotId,label,data,baseColor){ const grayMode=document.getElementById('paletteMode').value==='gray'; const style=getStyleOptionsFor(plotId); const {radius:dotRadius,alpha:dotAlpha}=dotParams(); const showPts=document.getElementById('showPoints').checked; const lineColor=grayMode?'#b0b0b0':baseColor; const pointColor=colorToRgba(lineColor,dotAlpha); return { label, data, borderColor:lineColor, backgroundColor:lineColor, showLine:style.showLine, borderDash:style.borderDash, borderWidth:style.borderWidth, fill:false, tension:0.2, pointRadius: showPts?dotRadius:0, pointBackgroundColor:pointColor, pointBorderColor:pointColor, order:10, hidden: !!style.hide }; }

    function getAllProcessedSeriesHL(){ const out=[]; if(state.file1?.rawB?.length && isSeriesEnabled('hl','file1:B')) out.push(prepareForPlot(state.file1.rawB)); if(state.file1?.rawC?.length && isSeriesEnabled('hl','file1:C')) out.push(prepareForPlot(state.file1.rawC)); state.pasonSeries.forEach(s=>{ if(s.raw?.length && isSeriesEnabled('hl', `hl:${s.name}`)) out.push(prepareForPlot(s.raw)); }); return out; }
    function getAllProcessedSeriesTQ(){ const out=[]; state.torqueSeries.forEach(s=>{ if(s.raw?.length && isSeriesEnabled('tq', `tq:${s.name}`)) out.push(prepareForPlot(s.raw)); }); return out; }
    function getAllProcessedSeriesWOB(){ const out=[]; state.wobSeries.forEach(s=>{ if(s.raw?.length && isSeriesEnabled('wob', `wob:${s.name}`)) out.push(prepareForPlot(s.raw)); }); return out; }
    // 2026-11-21 (John): points of one ROP series for the selected mode. 'all' = the file's ROP column as before (zeros included).
    // 'slide' / 'rot' = drilling rows only (ROP > 0) classified by the row's average Rotary RPM against the two thresholds.
    // Wells without RPM rows (LAS / older uploads) have no slide / rotate points and are skipped in those modes.
    function ropMode(){ const m=document.getElementById('ropMode'); return m ? m.value : 'all'; }
    // 2026-11-21 (John): minimum ROP for a row to count as drilling (default 2 m/h, user-editable), applied in all three modes.
    // Was: 'all' kept every ROP ≥ 0, so off-bottom / circulating rows (ROP = 0) pulled Min and Avg down.
    function ropMinDrill(){ const v=parseFloat((document.getElementById('ropMinDrill')||{}).value); return Number.isFinite(v)&&v>=0 ? v : 2; }
    function ropPts(s, mode){ mode=mode||ropMode(); const mn=ropMinDrill(); if(mode==='all') return (s.raw||[]).filter(p=>p.y>=mn); if(!s.modeRows) return [];
      const lo=parseFloat(document.getElementById('ropSlideRpm').value), hi=parseFloat(document.getElementById('ropRotRpm').value);
      return s.modeRows.filter(r=> r[1]>=mn && (mode==='slide' ? r[2]<=(Number.isFinite(lo)?lo:5) : r[2]>=(Number.isFinite(hi)?hi:20))).map(r=>({x:r[0],y:r[1]})); }
    function getAllProcessedSeriesROP(mode){ const out=[]; state.ropSeries.forEach(s=>{ const pts=ropPts(s,mode); if(pts.length && isSeriesEnabled('rop', `rop:${s.name}`)) out.push(prepareForPlot(pts)); }); return out; }
    function getAllProcessedSeriesMSE(){ const out=[]; state.mseSeries.forEach(s=>{ if(s.raw?.length && isSeriesEnabled('mse', `mse:${s.name}`)) out.push(prepareForPlot(s.raw)); }); return out; }
    function getAllProcessedSeriesFLOW(){ const out=[]; state.flowSeries.forEach(s=>{ if(s.raw?.length && isSeriesEnabled('flow', `flow:${s.name}`)) out.push(prepareForPlot(s.raw)); }); return out; }
    /* 2026-11-22 (John): SNOWBALL — total drilled metres of all legs vs days, per offset well (same conversion as the job page,
     * views/job.ejs snowSeries): a new leg starts when the hole depth drops > 10 m below the leg's deepest point; until drilling
     * resumes (depth more than 0.5 m below the leg's shallowest point) nothing is added, so tripping / reaming adds nothing;
     * afterwards only depth below the leg's deepest point counts. Min / Avg / Max across wells at each time are
     * meaningful here (every curve only goes down), unlike on the saw-teeth plot. MTX choice (display). */
    function snowPts(pts){ const out=[]; let cum=0, ref=null, seek=false, peak=null;
      (pts||[]).forEach(p=>{ const t=+p.x, d=+p.y; if(!Number.isFinite(t)||!Number.isFinite(d)) return;
        if(ref===null){ ref=d; peak=d; }
        else if(d<peak-10){ seek=true; ref=d; peak=d; }
        else if(seek){ if(d<ref) ref=d; else if(d>ref+0.5){ seek=false; cum+=d-ref; ref=d; peak=d; } peak=Math.max(peak,ref); }
        else if(d>ref){ cum+=d-ref; ref=d; peak=d; }
        out.push({x:t,y:cum}); }); return out; }
    // 2026-11-22 (John): for the Min / Avg / Max curves each well is HELD at its final total until the last day of the longest
    // record. Was: a finished well dropped out of the average / percentiles, so the curves jumped back up each time a well ended
    // (saw-teeth again). Holding keeps them monotonic: a pointwise mean or percentile of non-decreasing curves never decreases.
    // 2026-11-22 (John): DATA GAPS REMOVED on the snowball. Some offsets have days / weeks with no rows (e.g. surface hole drilled,
    // rig moved away, then the rest of the well), which pushed their curve far right. Any jump in time between two consecutive rows
    // longer than 'Close gaps >' hours (box, default 12 h) is cut out: later times move back by the gap minus one 10-min row.
    // Only gaps WITHOUT data are cut — flats with the recorder running (casing, waiting) stay. MTX choice (display).
    function snowGapH(){ const v=parseFloat((document.getElementById('snowGapH')||{}).value); return Number.isFinite(v)&&v>0 ? v : 12; }
    function snowClose(pts){ const g=snowGapH()/24, out=[]; let shift=0;
      for(let i=0;i<pts.length;i++){ if(i>0){ const dt=pts[i].x-pts[i-1].x; if(dt>g) shift+=dt-10/1440; } out.push({x:pts[i].x-shift, y:pts[i].y}); } return out; }
    function snowSrc(s){ return snowClose(s.raw.slice().sort((a,b)=>a.x-b.x)); }
    function snowTmax(){ let m=-Infinity; state.timeDepthSeries.forEach(s=>{ if(!s.raw?.length) return; const c=snowSrc(s); if(c.length && c[c.length-1].x>m) m=c[c.length-1].x; }); return m; }
    function snowHold(pts, tmax){ if(!pts.length || !Number.isFinite(tmax)) return pts; const l=pts[pts.length-1]; return l.x<tmax ? pts.concat([{x:tmax, y:l.y}]) : pts; }
    /* 2026-11-22 (John, revised): SNOWBALL Min / Avg / Max are built as TIME AT EACH TOTAL DEPTH, not depth at each time.
     * Was: depth averaged across wells at each day; wells that had finished were held at their (smaller) final total, so the
     * curves flattened out once the shorter wells ended. Now, on a grid of total depth D from 0 to the deepest final total of all
     * wells (400 steps):
     *  - t_w(D) = first time well w reaches D (its snowball curve, data gaps closed);
     *  - beyond its final total, a well continues its own TREND: t = t_end + (D - D_end) / rate, rate = metres per day over the
     *    last 30 % of its total (MTX choice);
     *  - Avg = mean of t_w(D); Min (slowest) = the 'Max %' percentile of t_w(D); Max (fastest) = the 'Min %' percentile.
     * Every curve is then monotonic and ends at the deepest total. Points where more than half the wells are extrapolated are
     * drawn dashed. */
    function snowCurves(){
      const W=[]; state.timeDepthSeries.forEach(s=>{ if(!(s.raw?.length && isSeriesEnabled('tds', `tds:${s.name}`))) return; const p=snowPts(snowSrc(s)); if(p.length<2) return;
        const e=p[p.length-1]; if(!(e.y>0)) return; const D7=0.7*e.y; let i7=p.findIndex(q=>q.y>=D7); const q7=p[Math.max(0,i7)];
        const rate = (e.x>q7.x && e.y>q7.y) ? (e.y-q7.y)/(e.x-q7.x) : (e.x>0 ? e.y/e.x : NaN); W.push({ p, e, rate }); });
      if(!W.length) return { avg:[], max:[], min:[] };
      const Dmax=Math.max(...W.map(w=>w.e.y)), n=400, maxQ=Math.min(100,Math.max(50,parseFloat(document.getElementById('maxPct').value)||90))/100, minQ=Math.min(50,Math.max(0,parseFloat(document.getElementById('minPct').value)||10))/100;
      const tAt=(w,D)=>{ const p=w.p; if(D<=p[0].y) return p[0].x; if(D>w.e.y) return w.rate>0 ? w.e.x+(D-w.e.y)/w.rate : NaN;
        let lo=0, hi=p.length-1; while(hi-lo>1){ const m=(lo+hi)>>1; if(p[m].y>=D) hi=m; else lo=m; } const a=p[lo], b=p[hi]; return b.y>a.y ? a.x+(b.x-a.x)*(D-a.y)/(b.y-a.y) : b.x; };
      const out={ avg:[], max:[], min:[] };
      for(let k=0;k<=n;k++){ const D=Dmax*k/n, ts=W.map(w=>tAt(w,D)).filter(Number.isFinite).sort((a,b)=>a-b); if(!ts.length) continue;
        const ext=W.filter(w=>D>w.e.y).length>W.length/2;
        out.avg.push({ x: ts.reduce((a,b)=>a+b,0)/ts.length, y: D, ext });
        out.min.push({ x: percentileOfSorted(ts,maxQ), y: D, ext });   // slowest
        out.max.push({ x: percentileOfSorted(ts,minQ), y: D, ext }); } // fastest
      return out;
    }
    function getAllProcessedSeriesTDS(){ const out=[], T=snowTmax(); state.timeDepthSeries.forEach(s=>{ if(s.raw?.length && isSeriesEnabled('tds', `tds:${s.name}`)) out.push(snowHold(snowPts(snowSrc(s)), T)); }); return out; }
    function getAllProcessedSeriesTD(){ const out=[]; state.timeDepthSeries.forEach(s=>{ if(s.raw?.length && isSeriesEnabled('td', `td:${s.name}`)) out.push(prepareForPlot(s.raw, true)); }); return out; }

    function computeAdaptiveStepTD(seriesList){ const {minX,maxX}=xRange(seriesList); if(!(Number.isFinite(minX)&&Number.isFinite(maxX)&&maxX>minX)) return 0.05; const range=maxX-minX; const target=800; let step=range/target; step=Math.max(0.001, Math.min(step, Math.max(0.5, range/50)) ); return step; }

    function renderMain(){ const plot=currentPlotDef(); const ctx=document.getElementById('chartMain').getContext('2d'); if(chartMain){ chartMain.destroy(); chartMain=null; }
      const enableZoom=document.getElementById('enableZoom').checked; const showLegend=document.getElementById('showLegend').checked; const datasets=[]; lastCurvesSpecial={avg:[],max:[],min:[]};

      if(plot.id==='hl'){
