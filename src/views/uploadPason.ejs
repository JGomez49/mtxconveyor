      const flatsOf=g=>{ const f=[]; let a=0; for(let i=1;i<=g.length;i++){ const gap = i<g.length && (g[i][0]-g[i-1][0])*24>1; if(i===g.length || Math.abs(g[i][1]-g[a][1])>0.5 || gap){ const h=(g[i-1][0]-g[a][0])*24; if(h>=minH) f.push({ i0:a, i1:i-1, depth:g[a][1], hours:h }); a=i; } } return f; };
