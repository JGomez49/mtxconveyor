    function buildSpecialCurves(datasets, seriesForGrid, labelPrefix, opts){ const showAvg=document.getElementById('showAverage').checked; const showMax=document.getElementById('showMax').checked; const showMin=document.getElementById('showMin').checked; const userStep=parseFloat(document.getElementById('avgStep').value)||5; const step=(opts && Number.isFinite(opts.stepOverride))?opts.stepOverride:Math.max(0.0001, userStep); const userMinSeries=parseInt(document.getElementById('avgMinSeries').value,10)||2; const nSeries=(seriesForGrid||[]).filter(a=>Array.isArray(a)&&a.length>0).length; const minSeries=(opts && Number.isFinite(opts.minSeriesOverride))?opts.minSeriesOverride:Math.max(1,Math.min(userMinSeries, nSeries||1)); /* 2026-11-14: clamp to the number of loaded wells (see computeCurvesForPlot) */ const noSm=!!(opts && opts.noSmooth); const smoothOn=!noSm && document.getElementById('applySmoothing').checked; const win=noSm ? 1 : (parseInt(document.getElementById('smoothWindow').value,10)||1); const maxPctVal=Math.min(100,Math.max(50, parseFloat(document.getElementById('maxPct').value)||90))/100; const minPctVal=Math.min(50,Math.max(0,  parseFloat(document.getElementById('minPct').value)||10))/100; lastCurvesSpecial={avg:[],max:[],min:[]}; if(showMin){ let pts=buildPercentileSeries(seriesForGrid, step, minSeries, minPctVal, win); if(opts&&opts.extendX) pts=extendTo(pts, opts.extendX, step, seriesForGrid, 'min', minPctVal); lastCurvesSpecial.min=pts; if(pts.length){ datasets.push({ label:`Min ${labelPrefix} (glow)`, data:pts, borderColor:'rgba(255,0,0,0.20)', backgroundColor:'rgba(255,0,0,0.20)', showLine:true, borderDash:[], borderWidth:10, pointRadius:0, fill:false, tension:0.25, segment:{ borderDash: c => (c.p1 && c.p1.raw && c.p1.raw.ext) ? [6,4] : undefined }, order:993 }); datasets.push({ label:`Min ${labelPrefix}`, data:pts, borderColor:'#ff0000', backgroundColor:'#ff0000', showLine:true, borderDash:[], borderWidth:3, pointRadius:0, fill:false, tension:0.25, segment:{ borderDash: c => (c.p1 && c.p1.raw && c.p1.raw.ext) ? [6,4] : undefined }, order:994 }); } } if(showMax){ let pts=buildPercentileSeries(seriesForGrid, step, minSeries, maxPctVal, win); if(opts&&opts.extendX) pts=extendTo(pts, opts.extendX, step, seriesForGrid, 'max', maxPctVal); lastCurvesSpecial.max=pts; if(pts.length){ datasets.push({ label:`Max ${labelPrefix} (glow)`, data:pts, borderColor:'rgba(0,255,0,0.20)', backgroundColor:'rgba(0,255,0,0.20)', showLine:true, borderDash:[], borderWidth:10, pointRadius:0, fill:false, tension:0.25, segment:{ borderDash: c => (c.p1 && c.p1.raw && c.p1.raw.ext) ? [6,4] : undefined }, order:995 }); datasets.push({ label:`Max ${labelPrefix}`, data:pts, borderColor:'#00ff00', backgroundColor:'#00ff00', showLine:true, borderDash:[], borderWidth:3, pointRadius:0, fill:false, tension:0.25, segment:{ borderDash: c => (c.p1 && c.p1.raw && c.p1.raw.ext) ? [6,4] : undefined }, order:996 }); } } if(showAvg){ let pts=buildAverageSeries(seriesForGrid, step, minSeries, smoothOn, win); if(opts&&opts.extendX) pts=extendTo(pts, opts.extendX, step, seriesForGrid, 'avg'); lastCurvesSpecial.avg=pts; if(pts.length){ datasets.push({ label:`Average ${labelPrefix} (glow)`, data:pts, borderColor:'rgba(0,229,255,0.20)', backgroundColor:'rgba(0,229,255,0.20)', showLine:true, borderDash:[], borderWidth:10, pointRadius:0, fill:false, tension:0.25, segment:{ borderDash: c => (c.p1 && c.p1.raw && c.p1.raw.ext) ? [6,4] : undefined }, order:997 }); datasets.push({ label:`Average ${labelPrefix}`, data:pts, borderColor:'#00e5ff', backgroundColor:'#00e5ff', showLine:true, borderDash:[], borderWidth:3, pointRadius:0, fill:false, tension:0.25, segment:{ borderDash: c => (c.p1 && c.p1.raw && c.p1.raw.ext) ? [6,4] : undefined }, order:998 }); } } }

    async function processFile1(file, hasHeader){ const buf=await file.arrayBuffer(); const wb=XLSX.read(buf,{type:'array'}); if(!wb.SheetNames.length) throw new Error('No sheets'); const sheet=wb.Sheets[wb.SheetNames[0]]; const rows=XLSX.utils.sheet_to_json(sheet,{header:1,defval:null}); if(!rows.length) throw new Error('Empty sheet'); const start=hasHeader?1:0; const A=[],B=[],C=[]; for(let r=start;r<rows.length;r++){ const row=rows[r]||[]; A.push(row[0]); B.push(row[1]); C.push(row[2]); } const {pts:rawB,replaced:replacedB}=cleanAndBuildXY(A,B); const {pts:rawC,replaced:replacedC}=cleanAndBuildXY(A,C); state.file1={name:file.name, rawB, rawC, rows:rows.length-start, replacedB, replacedC}; }

    async function parsePasonCsvFile(file,hasHeader,manualMseCol1Based){ const text=await file.text(); const parsed=Papa.parse(text,{ delimiter:"", newline:"", quoteChar:'"', escapeChar:'"', header:false, skipEmptyLines:true }); const rows=parsed.data||[]; if(!rows.length) return null; let headerRow=null; let start=0; if(hasHeader && rows.length){ headerRow=rows[0]; start=1; } let mseIdx=null; const manualIdx=parseInt(manualMseCol1Based,10); if(Number.isFinite(manualIdx)&&manualIdx>=1){ mseIdx=manualIdx-1; } else if(headerRow){ for(let i=0;i<headerRow.length;i++){ const h=String(headerRow[i]??'').toLowerCase(); if(!h) continue; if((h.includes('mechanical specific energy')||h.includes('mse')) && (h.includes('ksi') || !h.includes('kpa'))){ mseIdx=i; break; } } }
      const Xmd=[], Ywob=[], Yhl=[], Ytq=[], Yflow=[], Yrop=[], Ymse=[]; const tsArr=[], mdArr=[]; const ropRows=[], myRows=[];   // 2026-11-21: myRows = [holeDepth, inc, az, rpm, rop] in file order (Motor Yield);: [md, rop, rpm] of drilling rows (slide / rotate split)
      for(let r=start;r<rows.length;r++){ const row=rows[r]||[]; Xmd.push(row[2]); Yrop.push(row[4]); Ywob.push(row[5]); Yhl.push(row[8]); Ytq.push(row[10]); Yflow.push(row[11]); { const md_=toNumber(row[2]), rp_=toNumber(row[4]), rpm_=toNumber(row[6]); if(Number.isFinite(md_) && Number.isFinite(rp_) && rp_>0 && Number.isFinite(rpm_)) ropRows.push([md_, rp_, rpm_]); const inc_=toNumber(row[12]), az_=toNumber(row[13]); if(Number.isFinite(md_) && Number.isFinite(inc_) && Number.isFinite(az_) && inc_>=0 && inc_<=180) myRows.push([md_, inc_, az_, Number.isFinite(rpm_)?rpm_:NaN, Number.isFinite(rp_)?rp_:0]); } if(mseIdx!==null && row.length>mseIdx){ Ymse.push(row[mseIdx]); } else { Ymse.push(null); } const d=row[0], t=row[1]; const ts=parseDateTimeUTC(d,t); const md=toNumber(row[2]); tsArr.push(Number.isFinite(ts)?ts:NaN); mdArr.push(Number.isFinite(md)?md:NaN); }
