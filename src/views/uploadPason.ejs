    }

    async function processPasonFolder(fileList,hasHeader){ const csvFiles=Array.from(fileList).filter(f=>f.name.toLowerCase().endsWith('.csv')); csvFiles.sort((a,b)=>(a.webkitRelativePath||a.name).localeCompare(b.webkitRelativePath||b.name)); const manualMseCol1Based=document.getElementById('mseColInput').value; const seriesHL=[],seriesTQ=[],seriesWOB=[],seriesROP=[],seriesMSE=[],seriesFLOW=[],seriesTD=[]; for(const f of csvFiles){ try{ const s=await parsePasonCsvFile(f,hasHeader,manualMseCol1Based); if(!s) continue; if(s.wob.raw.length) seriesWOB.push({name:s.name,raw:s.wob.raw,rows:s.wob.rows}); if(s.hl.raw.length) seriesHL.push({name:s.name,raw:s.hl.raw,rows:s.hl.rows,replaced:s.hl.replaced}); if(s.tq.raw.length) seriesTQ.push({name:s.name,raw:s.tq.raw,rows:s.tq.rows,replaced:s.tq.replaced}); if(s.rop.raw.length) seriesROP.push({name:s.name,raw:s.rop.raw,rows:s.rop.rows,modeRows:s.rop.modeRows,myRows:s.rop.myRows,tRows:s.rop.tRows}); if(s.mse.raw.length) seriesMSE.push({name:s.name,raw:s.mse.raw,rows:s.mse.rows,mseCol:s.mse.mseCol}); if(s.flow.raw.length) seriesFLOW.push({name:s.name,raw:s.flow.raw,rows:s.flow.rows}); if(s.td.raw.length) seriesTD.push({name:s.name,raw:s.td.raw,rows:s.td.rows}); } catch(err){ console.warn('Failed to parse CSV:', f.name, err); } }
