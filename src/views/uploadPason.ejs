    function pctOf(v, q){ const a=v.slice().sort((x,y)=>x-y); if(!a.length) return NaN; const i=(a.length-1)*q, lo=Math.floor(i), hi=Math.ceil(i); return a[lo]+(a[hi]-a[lo])*(i-lo); }
    function extendTo(pts, xmax, step, series, kind, q){ if(!pts||!pts.length||!Number.isFinite(xmax)) return pts; const last=pts[pts.length-1]; if(last.x>=xmax) return pts;
      let y=last.y; if(series){ const v=[]; series.forEach(a=>(a||[]).forEach(p=>{ if(p.x>last.x && Number.isFinite(p.y)) v.push(p.y); }));
        if(v.length){ const yy = kind==='avg' ? v.reduce((a,b)=>a+b,0)/v.length : pctOf(v, q); if(Number.isFinite(yy)) y=yy; } }
      const out=pts.slice(); for(let x=last.x+step; x<xmax; x+=step) out.push({x, y, ext:true}); out.push({x:xmax, y, ext:true}); return out; }
    /* 2026-11-22 (John): PHONE CHART (<= 576 px wide). Was: the chart kept the desktop 2:1 shape, so on a phone it was a short strip
