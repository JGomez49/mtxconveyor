      // 2026-11-21: time rows for flat / other time per offset well (see mtxFlatStats): [days, holeDepth, rop, rpm]
      const tRows=[]; { const t0=tsArr.find(v=>Number.isFinite(v)); for(let r=start;r<rows.length;r++){ const i=r-start, row=rows[r]||[]; if(!Number.isFinite(tsArr[i])||!Number.isFinite(mdArr[i])) continue; tRows.push([(tsArr[i]-t0)/86400000, mdArr[i], toNumber(row[4]), toNumber(row[6])]); } }
      let tdPts=[]; const firstIdx=tsArr.findIndex(v=>Number.isFinite(v)); if(firstIdx!==-1){ const t0=tsArr[firstIdx]; const days=tsArr.map(v=>Number.isFinite(v)?((v-t0)/86400000):NaN); const {pts}=cleanAndBuildXY(days, mdArr); tdPts=pts; }
