
<!doctype html>

<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>Drilling Plots</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/png" sizes="32x64"
    href="https://res.cloudinary.com/metacortexjohn/image/upload/v1658373747/Icono_Metacortex_ahblhc.png">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5/dist/slate/bootstrap.min.css">
  <style>
    body { padding: 2rem 0; }
    .chart-wrap { background: #1b1e21; border-radius: .5rem; padding: 1rem; }
    .small-note { font-size: 0.95rem; opacity: 0.9; }
    input[type="file"] { color-scheme: dark; }
    canvas { max-height: 70vh; }
    .file-title { font-weight: 600; }
    .form-range { width: 220px; }
    .num-input { width: 120px; }
    .num-input-wide { width: 180px; }
    .num-input-axis { width: 120px; }
    .controls-block { gap: .75rem; }
    hr.subtle { border-top: 1px solid rgba(255,255,255,0.08); }
    .vis-hidden { display: none !important; }
    .flex-gap { gap: .5rem; }
    .dropdown-menu-checklist { max-height: 40vh; overflow: auto; min-width: 260px; }
  </style>
</head>

<body>
  <div class="container">

    <header class="mb-3">
      <img src="https://res.cloudinary.com/metacortexjohn/image/upload/v1711167914/Canadian_Natural_logo_ygbbox.png"
        alt="Canadian Natural Resources Logo" width="250" height="100">
      <h1 class="h4 mb-1">Pason Plots</h1>
    </header>

    <div class="d-grid gap-2">
      <a href="/notes" class="btn btn-primary btn-block my-2">Back</a>
    </div>

    <div class="card mb-4">
      <div class="card-body">
        <div class="row g-4">
          <div class="col-lg-6">
            <div class="file-title mb-2">File 1 (Generic Excel): B & C vs A</div>
            <label for="file1" class="form-label">Excel file (.xlsx or .xls)</label>
            <input id="file1" class="form-control" type="file" accept=".xlsx,.xls" />
            <div class="form-check mt-2">
              <input class="form-check-input" type="checkbox" id="file1Headers" checked />
              <label class="form-check-label" for="file1Headers">First row contains headers</label>
            </div>
            <div id="status1" class="form-text mt-2"></div>
          </div>
          <div class="col-lg-6">
            <div class="file-title mb-2">Pason CSVs Folder</div>
            <label for="pasonFolder" class="form-label">Select folder with Pason CSV files</label>
            <input id="pasonFolder" class="form-control" type="file" accept=".csv" webkitdirectory multiple />
            <div class="form-check mt-2">
              <input class="form-check-input" type="checkbox" id="pasonHeaders" checked />
              <label class="form-check-label" for="pasonHeaders">First row contains headers (applies to all CSVs)</label>
            </div>
            <div class="input-group input-group-sm mt-2" style="max-width: 360px;">
              <span class="input-group-text">MSE column (1‑based)</span>
              <input type="number" class="form-control" id="mseColInput" min="1" step="1" placeholder="Leave blank to auto-detect" />
            </div>
            <div id="status2" class="form-text mt-2"></div>
          </div>
          <%# 2026-11-21 (John): LAS (1 s EDR, same files as the Slide Sheet) as a third input — each file = one well, converted
               to the same per-well series as a Pason CSV (public/js/slideSheetModel.js lasToSeries), so averages, percentiles,
               plots and "Export All Plots to Excel" work unchanged. CSV and LAS wells can be mixed. %>
          <div class="col-lg-12">
            <div class="file-title mb-2">Pason LAS files (EDR, 1 s) — one file per well</div>
            <div class="d-flex flex-wrap gap-2 align-items-center">
              <input id="lasFiles" class="form-control" type="file" accept=".las,.LAS,.txt" multiple style="max-width:420px" />
              <div class="input-group input-group-sm" style="max-width:230px;">
                <span class="input-group-text" title="Depth bin for HL / torque / WOB / MSE / flow (median of the on-bottom rows) and ROP (metres / on-bottom time)">Bin size (m)</span>
                <input type="number" class="form-control" id="lasBin" min="0.1" step="0.1" value="1" />
              </div>
              <button type="button" class="btn btn-sm btn-outline-danger" id="lasClear">Remove LAS wells</button>
            </div>
            <div class="form-text">Per depth bin: median of hook load, torque, WOB, MSE and flow over the rows with the bit on bottom; ROP = metres drilled ÷ on-bottom time in the bin. Hole depth vs time: one point every 10 min. Changing the bin size re-reads the files.</div>
            <div id="status3" class="form-text mt-2"></div>
          </div>
        </div>

        <hr class="my-4 subtle"/>

        <%# 2026-11-22 (John): CONTROLS RE-ARRANGED into labelled cards (Plot / Display / Filtering / Curves / Time analysis / Axes /
             Export) on a responsive grid: 3-4 columns on a PC, 1 column on a phone. Every control keeps its id, so no script changed.
             Was: one long wrapped line of mixed controls. %>
        <style>
          .pc-plotbar{ display:flex; flex-wrap:wrap; align-items:center; gap:8px; margin-bottom:10px; }
          .pc-plotbar label{ margin:0; font-weight:600; }
          .pc-plotbar select{ flex:1 1 260px; max-width:520px; }
          .pc-grid{ display:grid; grid-template-columns:repeat(auto-fill, minmax(290px, 1fr)); gap:10px; align-items:start; }
          .pc-card{ border:1px solid rgba(255,255,255,.12); border-radius:8px; padding:8px 10px 10px; background:rgba(255,255,255,.03); min-width:0; }
          .pc-card h6{ font-size:12px; text-transform:uppercase; letter-spacing:.05em; opacity:.75; margin:0 0 8px; }
          .pc-row{ display:flex; align-items:center; gap:8px; margin-bottom:6px; min-height:30px; }
          .pc-row > label, .pc-row > .pc-l{ flex:0 0 46%; margin:0; font-size:13px; }
          .pc-row > input[type=number], .pc-row > select{ flex:1 1 auto; width:auto!important; min-width:0!important; height:30px; padding:2px 8px; font-size:13px; }
          .pc-row > input[type=range]{ flex:1 1 auto; min-width:0; }
          .pc-row .form-check{ margin:0; }
          .pc-checks{ display:flex; flex-wrap:wrap; gap:4px 16px; margin-bottom:6px; font-size:13px; }
          .pc-btns{ display:flex; flex-wrap:wrap; gap:6px; }
          .pc-btns .btn{ flex:1 1 auto; }
          .pc-axes{ display:grid; grid-template-columns:1fr 1fr; gap:6px; margin-bottom:6px; }
          .pc-axes .input-group{ width:auto!important; min-width:0; flex-wrap:nowrap; }
          .pc-axes .input-group .form-control{ min-width:0; width:1%; }
          #ropModeBox{ flex-direction:column; }
          #ropModeBox .rm-row{ display:flex; align-items:center; gap:8px; margin-bottom:6px; }
          #ropModeBox .rm-row label{ flex:0 0 46%; margin:0; font-size:13px; }
          #ropModeBox .rm-row input, #ropModeBox .rm-row select{ flex:1 1 auto; width:auto!important; min-width:0!important; height:30px; padding:2px 8px; font-size:13px; }
          @media (max-width:576px){ .pc-grid{ grid-template-columns:1fr; } .pc-plotbar select{ max-width:none; } }
        </style>

        <div class="pc-plotbar">
          <label for="plotSelect">Plot</label>
          <select id="plotSelect" class="form-select form-select-sm"></select>
          <button type="button" class="mtx-help-btn ms-auto" title="What these plots are and what they feed" aria-label="Help" onclick="mtxHelp('pason')">?</button><%# 2026-11-22 help %>
        </div>

        <div class="pc-grid mb-3">
          <%# ROP / Motor Yield options (shown only with those plots; see ropBoxVis) %>
          <div class="pc-card" id="ropModeBox" style="display:none!important">
            <h6>ROP / Motor Yield options</h6>
            <div class="rm-row"><label for="ropMode">ROP mode</label><select id="ropMode" class="form-select form-select-sm"><option value="all">All rows (as before)</option><option value="slide">Slide only</option><option value="rot">Rotate only</option></select></div>
            <div class="rm-row" title="A row counts as drilling only when its ROP is at or above this (all three modes)"><label for="ropMinDrill">Min drilling ROP (m/h)</label><input type="number" class="form-control form-control-sm" id="ropMinDrill" value="2" min="0" step="0.5"></div>
            <div class="rm-row" title="Drilling row with average Rotary RPM at or below this = slide"><label for="ropSlideRpm">Slide ≤ RPM</label><input type="number" class="form-control form-control-sm" id="ropSlideRpm" value="5" min="0" step="1"></div>
            <div class="rm-row" title="Drilling row with average Rotary RPM at or above this = rotate"><label for="ropRotRpm">Rotate ≥ RPM</label><input type="number" class="form-control form-control-sm" id="ropRotRpm" value="20" min="0" step="1"></div>
            <div class="rm-row" title="How the Min / Avg / Max ROP curves continue where fewer than 'min series per point' wells have data, down to the deepest MD of all files"><label for="ropExt">Beyond curve end</label><select id="ropExt" class="form-select form-select-sm"><option value="pool">Pooled rows (default)</option><option value="ms1">Min series = 1</option></select></div>
            <div class="rm-row rm-my" title="Slide MY = interval dogleg / slid metres x 30. Rotary tendency = DLS of intervals with slid < 10 %. Corrected = slide MY after removing the well's rotary build / walk (MTX choice, as on the Slide Sheet)"><label for="myType">MY type</label><select id="myType" class="form-select form-select-sm"><option value="slide">Slide MY</option><option value="rot">Rotary tendency (DLS)</option><option value="corr">Slide MY, rotation-corrected</option></select></div>
            <div class="rm-row rm-my" title="Survey MD = hole depth when the new Inc / Azi first shows while drilling, minus this"><label for="myOffset">Bit-to-survey offset (m)</label><input type="number" class="form-control form-control-sm" id="myOffset" value="15" min="0" step="0.5"></div>
            <div class="rm-row rm-my" title="Survey values giving a higher DLS than this to the previous good survey are treated as bad data"><label for="myMaxDls">Max plausible DLS (°/30 m)</label><input type="number" class="form-control form-control-sm" id="myMaxDls" value="25" min="1" step="1"></div>
            <div class="rm-row rm-my" title="Grid of the Min / Avg / Max curves across wells"><label for="myBin">MY bin length (m)</label><input type="number" class="form-control form-control-sm" id="myBin" value="30" min="5" step="1"></div>
            <span id="ropModeInfo" class="form-text"></span>
          </div>

          <div class="pc-card">
            <h6>Display</h6>
            <div class="pc-row"><label for="paletteMode">Palette</label><select class="form-select form-select-sm" id="paletteMode"><option value="colors">Colors</option><option value="gray">Gray</option></select></div>
            <div class="pc-row"><label for="lineStyle">Line style</label><select class="form-select form-select-sm" id="lineStyle"><option value="solid">Solid line</option><option value="dotted">Dotted line</option><option value="points" selected>Points only</option><option value="hide">Hide regular curves</option></select></div>
            <div class="pc-row"><label for="dotStyle">Dot size &amp; opacity</label><input type="range" id="dotStyle" class="form-range" min="0" max="100" step="1" value="10" /></div>
            <div class="pc-checks">
              <div class="form-check"><input class="form-check-input" type="checkbox" id="showPoints" /><label class="form-check-label" for="showPoints">Show points</label></div>
              <div class="form-check"><input class="form-check-input" type="checkbox" id="showLegend" /><label class="form-check-label" for="showLegend">Show legend</label></div>
            </div>
            <div class="dropdown">
              <button class="btn btn-outline-light btn-sm dropdown-toggle w-100" type="button" data-bs-toggle="dropdown" aria-expanded="false">Series (current plot)</button>
              <div class="dropdown-menu dropdown-menu-checklist p-2" id="seriesToggleMenu"></div>
            </div>
          </div>

          <div class="pc-card">
            <h6>Filtering &amp; smoothing</h6>
            <div class="pc-row"><div class="form-check pc-l"><input class="form-check-input" type="checkbox" id="rejectSpikes" /><label class="form-check-label" for="rejectSpikes">Reject spikes Δ &gt;</label></div><input type="number" class="form-control form-control-sm" id="spikeThreshold" value="5" step="0.1" min="0" /></div>
            <div class="pc-checks"><div class="form-check"><input class="form-check-input" type="checkbox" id="useIqrReject" checked /><label class="form-check-label" for="useIqrReject">Robust spike filter (IQR)</label></div></div>
            <div class="pc-row"><div class="form-check pc-l"><input class="form-check-input" type="checkbox" id="applySmoothing" checked /><label class="form-check-label" for="applySmoothing">Smooth, window</label></div><input type="range" id="smoothWindow" class="form-range" min="1" max="25" step="2" value="5" /><span id="smoothValue" class="small-note">5</span></div>
            <%# 2026-11-14 (John): Hole Depth vs Time drawn with sharp corners or rounded; saved per user (userPrefs.js) %>
            <div class="pc-row" title="Hole Depth vs Time only: Sharp = straight lines between points (true depth/time record); Rounded = smoothed curve. Saved for your user."><label for="tdCurveStyle">Time vs Depth curve</label><select id="tdCurveStyle" class="form-select form-select-sm"><option value="sharp">Sharp</option><option value="round">Rounded</option></select></div>
            <div class="pc-row" title="Sharp: a point is dropped when it lies within this % of the plot size from the straight line through its neighbours. Smaller = more points; larger = fewer, longer straight segments. Saved for your user."><label for="tdSharpTol">Sharp tolerance (%)</label><input type="number" id="tdSharpTol" class="form-control form-control-sm" value="1" min="0.05" max="20" step="0.1"></div>
          </div>

          <div class="pc-card" id="specialControls">
            <h6>Min / Avg / Max curves</h6>
            <div class="pc-row"><div class="form-check pc-l"><input class="form-check-input" type="checkbox" id="showAverage" checked /><label class="form-check-label" for="showAverage">Average</label></div><span class="small-note">step</span><input type="number" class="form-control form-control-sm" id="avgStep" value="5" step="1" min="0.0001" /><span class="small-note">m / days</span></div>
            <div class="pc-row"><div class="form-check pc-l"><input class="form-check-input" type="checkbox" id="showMax" checked /><label class="form-check-label" for="showMax">Max, percentile %</label></div><input type="number" class="form-control form-control-sm" id="maxPct" value="90" step="1" min="50" max="100" /></div>
            <div class="pc-row"><div class="form-check pc-l"><input class="form-check-input" type="checkbox" id="showMin" checked /><label class="form-check-label" for="showMin">Min, percentile %</label></div><input type="number" class="form-control form-control-sm" id="minPct" value="10" step="1" min="0" max="50" /></div>
            <div class="pc-row"><label for="avgMinSeries">Min wells per point</label><input type="number" class="form-control form-control-sm" id="avgMinSeries" value="2" step="1" min="1" /></div>
          </div>

          <div class="pc-card">
            <h6>Time analysis</h6>
            <div class="pc-row" title="Snowball plot: time jumps between rows longer than this (no data: rig away, recorder off) are cut out"><label for="snowGapH">Close data gaps &gt; (h)</label><input type="number" class="form-control form-control-sm" id="snowGapH" value="12" min="1" step="1"></div>
            <div class="pc-row" title="Flat time = hole depth unchanged (±0.5 m) for at least this long; used for the 'Flat times' tab of the export"><label for="minFlatH">Min flat (h)</label><input type="number" class="form-control form-control-sm" id="minFlatH" value="2" min="0.5" step="0.5"></div>
          </div>

          <div class="pc-card">
            <h6>Axes (<span id="axesPlotName">Hook Load vs Measured Depth</span>)</h6>
            <div class="pc-axes">
              <div class="input-group input-group-sm"><span class="input-group-text">X min</span><input type="number" class="form-control" id="xMin" /></div>
              <div class="input-group input-group-sm"><span class="input-group-text">X max</span><input type="number" class="form-control" id="xMax" /></div>
              <div class="input-group input-group-sm"><span class="input-group-text">Y min</span><input type="number" class="form-control" id="yMin" /></div>
              <div class="input-group input-group-sm"><span class="input-group-text">Y max</span><input type="number" class="form-control" id="yMax" /></div>
            </div>
            <div class="pc-btns mb-2"><button id="applyAxes" class="btn btn-outline-light btn-sm">Apply</button><button id="autoAxes" class="btn btn-outline-light btn-sm">Auto</button><button id="resetZoom" class="btn btn-outline-warning btn-sm">Reset zoom</button></div>
            <div class="pc-checks"><div class="form-check"><input class="form-check-input" type="checkbox" id="enableZoom" /><label class="form-check-label" for="enableZoom">Enable zoom / pan</label></div></div>
          </div>

          <div class="pc-card">
            <h6>Export</h6>
            <div class="pc-btns mb-2"><button id="exportAllPlotsXlsx" class="btn btn-outline-warning btn-sm">📊 All plots to Excel (1 tab per plot)</button></div>
            <div class="pc-btns mb-2"><button id="exportAvgCsv" class="btn btn-outline-success btn-sm">Average CSV</button><button id="exportMaxCsv" class="btn btn-outline-success btn-sm">Max CSV</button><button id="exportMinCsv" class="btn btn-outline-success btn-sm">Min CSV</button></div>
            <div class="pc-btns"><button id="exportPng" class="btn btn-outline-info btn-sm">Download PNG</button><button id="exportVisibleCsv" class="btn btn-outline-info btn-sm">Visible data CSV</button></div>
          </div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-body">
        <%# 2026-11-22 (John): phone layout — chart in a tall box (Chart.js maintainAspectRatio off), see pcPhoneOpts %>
        <style>
          .chart-box{ position:relative; }
          @media (max-width:576px){
            .card-body:has(> .chart-wrap){ padding:.35rem; }
            .chart-wrap{ padding:.35rem; }
            .chart-box{ height:75vh; min-height:360px; }
          }
        </style>
        <div class="chart-wrap">
          <div class="chart-box"><canvas id="chartMain"></canvas></div>
        </div>
      </div>
    </div>

    <div class="text-muted small-note mt-3">
      <p class="mb-1"><strong>Data rules</strong></p>
      <ul class="mb-2">
        <li>Excel (File 1): A = Measured Depth (m), B & C = numeric series for HL plot.</li>
        <li>Pason CSVs:
          <ul>
            <li><strong>Date</strong> = column 1 (day, month, year), <strong>Time</strong> = column 2 (HH:MM:SS)</li>
            <li><strong>MD / Hole Depth</strong> = column 3 (m)</li>
            <li><strong>WOB</strong> = column 6 “Weight on Bit (kDaN)”</li>
            <li><strong>Hook Load</strong> = column 9 (kDaN)</li>
            <li><strong>Torque</strong> = column 11 (kN·m)</li>
            <li><strong>Flow</strong> = column 12 “Total Pump Output (m³/min)”</li>
            <li><strong>ROP</strong> = column 5 (m/h). <em>Negative values are discarded.</em></li>
            <li><strong>MSE</strong> = “Mechanical Specific Energy (ksi)” column (auto‑detect header or manual index)</li>
          </ul>
        </li>
        <li>Time axis uses <em>days from series start</em> (Day 0 at each file’s first valid timestamp). Depth axis is <strong>inverted</strong> on the Time–Depth plot.</li>
      </ul>
    </div>
  </div>

  <!-- Libraries -->
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/papaparse@5.4.1/papaparse.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom@2.0.1/dist/chartjs-plugin-zoom.umd.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    (function() { const zp = window['chartjs-plugin-zoom']; if (zp && window.Chart) { Chart.register(zp); }})();

    const plotRegistry = [
      { id: 'hl',  name: 'Hook Load vs Measured Depth',   xTitle: 'Measured Depth (m)', yTitle: 'Hook Load (kDaN)', supportsSpecial: true,  reversedY: false, defaultSolid: false },
      { id: 'tq',  name: 'Torque vs Measured Depth',      xTitle: 'Measured Depth (m)', yTitle: 'Torque (kN·m)',     supportsSpecial: true,  reversedY: false, defaultSolid: false },
      { id: 'wob', name: 'WOB vs Measured Depth',         xTitle: 'Measured Depth (m)', yTitle: 'WOB (kDaN)',        supportsSpecial: true,  reversedY: false, defaultSolid: false },
      { id: 'rop', name: 'ROP vs Measured Depth',         xTitle: 'Measured Depth (m)', yTitle: 'ROP (m/h)',         supportsSpecial: true,  reversedY: false, defaultSolid: false },
      { id: 'mse', name: 'MSE vs Measured Depth',         xTitle: 'Measured Depth (m)', yTitle: 'MSE (ksi)',         supportsSpecial: true,  reversedY: false, defaultSolid: false },
      { id: 'flow',name: 'Flow vs Measured Depth',        xTitle: 'Measured Depth (m)', yTitle: 'Flow (m³/min)',     supportsSpecial: true,  reversedY: false, defaultSolid: false },
      { id: 'my',  name: 'Motor Yield vs Measured Depth', xTitle: 'Measured Depth (m)', yTitle: 'MY / DLS (°/30 m)', supportsSpecial: true,  reversedY: false, defaultSolid: false },   // 2026-11-21
      { id: 'tds', name: 'Total Depth vs Time (snowball)', xTitle: 'Time (days from start)', yTitle: 'Total drilled depth, all legs (m)', supportsSpecial: true, reversedY: true, defaultSolid: true },   // 2026-11-22
      { id: 'td',  name: 'Hole Depth vs Time (days)',     xTitle: 'Time (days from start)', yTitle: 'Hole Depth (m)', supportsSpecial: true,  reversedY: true,  defaultSolid: true }
    ];

    function buildPlotDropdownUI() {
      const sel = document.getElementById('plotSelect'); sel.innerHTML = '';
      plotRegistry.forEach(p => { const opt = document.createElement('option'); opt.value = p.id; opt.textContent = p.name; sel.appendChild(opt); });
      sel.value = 'hl'; updateSpecialControlsVisibility(); updateAxesLabels();
    }
    function currentPlotDef() { const id = document.getElementById('plotSelect').value; return plotRegistry.find(p => p.id === id) || plotRegistry[0]; }
    function updateSpecialControlsVisibility(){ const p = currentPlotDef(); document.getElementById('specialControls').classList.toggle('vis-hidden', !p.supportsSpecial); }
    function updateAxesLabels(){ const p = currentPlotDef(); document.getElementById('axesPlotName').textContent = p.name; document.getElementById('xMin').placeholder = p.xTitle+' min'; document.getElementById('xMax').placeholder = p.xTitle+' max'; document.getElementById('yMin').placeholder = p.yTitle+' min'; document.getElementById('yMax').placeholder = p.yTitle+' max'; }

    function toNumber(v){ if (typeof v==='number') return Number.isFinite(v)?v:NaN; if(v==null) return NaN; const s=String(v).trim(); if(!s) return NaN; const normalized=s.replace(/\s/g,'').replace(/,/g,''); const n=Number(normalized); return Number.isFinite(n)?n:NaN; }

    function cleanAndBuildXY(xArr,yArr){ const xs=[],ys=[]; let runSum=0,runCount=0,replaced=0; for(let i=0;i<Math.min(xArr.length,yArr.length);i++){ const x=toNumber(xArr[i]); let y=toNumber(yArr[i]); if(!Number.isFinite(x)) continue; if(Number.isFinite(y)){ if(y===-999.25){ y=(runCount>0)?(runSum/runCount):null; replaced++; } } else { y=(runCount>0)?(runSum/runCount):null; replaced++; } xs.push(x); ys.push(y); if(y!==null && Number.isFinite(y)){ runSum+=y; runCount+=1; } } const firstIdx=ys.findIndex(v=>v!==null && Number.isFinite(v)); if(firstIdx>0){ const firstVal=ys[firstIdx]; for(let i=0;i<firstIdx;i++) ys[i]=firstVal; } const pts=[]; for(let i=0;i<xs.length;i++){ const y=ys[i]; if(y!==null && Number.isFinite(y)) pts.push({x:xs[i], y}); } pts.sort((a,b)=>a.x-b.x); return {pts, replaced}; }

