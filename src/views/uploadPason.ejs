    function selectedAxes(){ const p=currentPlotDef(); return p.id==='hl'?state.axesHL: p.id==='tq'?state.axesTQ: p.id==='wob'?state.axesWOB: p.id==='rop'?state.axesROP: p.id==='mse'?state.axesMSE: p.id==='flow'?state.axesFLOW: p.id==='my'?(state.axesMY||(state.axesMY={xMin:null,xMax:null,yMin:null,yMax:null})): p.id==='tds'?(state.axesTDS||(state.axesTDS={xMin:null,xMax:null,yMin:null,yMax:null})): state.axesTD; }
    function setSelectedAxes(ax){ const p=currentPlotDef(); if(p.id==='hl') state.axesHL=ax; else if(p.id==='tq') state.axesTQ=ax; else if(p.id==='wob') state.axesWOB=ax; else if(p.id==='rop') state.axesROP=ax; else if(p.id==='mse') state.axesMSE=ax; else if(p.id==='flow') state.axesFLOW=ax; else if(p.id==='my') state.axesMY=ax; else if(p.id==='tds') state.axesTDS=ax; else state.axesTD=ax; }

