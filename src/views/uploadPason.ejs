<!-- 2026-11-14: per-user preference for the Time vs Depth curve style -->
<script>
// 2026-11-14 (John): "Sharp" Time vs Depth = the curve reduced to straight segments between its break points
// (flat = rig not making hole, slope = drilling), like a hand-drawn time/depth chart. Method: Ramer-Douglas-Peucker
// line simplification, with time and depth each scaled to 0-1 so the tolerance (1 % of the plot) is unit-free.
// Only the drawing changes; the stored data are untouched. (Just setting Chart.js tension 0 was not enough: the
// Pason Average is itself a smoothed, densely sampled curve, so it still looked rounded.)
function tdTolFrac(){ var t = document.getElementById('tdSharpTol'); var v = t ? parseFloat(t.value) : 1; return (isFinite(v) && v > 0 ? v : 1) / 100; }
function mtxSharpenTD(pts, tolFrac){
  if(!pts || pts.length < 3) return pts;
  var xs = pts.map(function(p){ return p.x; }), ys = pts.map(function(p){ return p.y; });
  var x0 = Math.min.apply(null, xs), x1 = Math.max.apply(null, xs), y0 = Math.min.apply(null, ys), y1 = Math.max.apply(null, ys);
  var sx = (x1 - x0) || 1, sy = (y1 - y0) || 1, tol = tolFrac == null ? 0.01 : tolFrac;
  var keep = new Array(pts.length); keep[0] = keep[pts.length - 1] = true;
  var stack = [[0, pts.length - 1]];
  while(stack.length){
    var seg = stack.pop(), a = seg[0], b = seg[1];
    var ax = (pts[a].x - x0) / sx, ay = (pts[a].y - y0) / sy, bx = (pts[b].x - x0) / sx, by = (pts[b].y - y0) / sy;
    var dx = bx - ax, dy = by - ay, len = Math.sqrt(dx*dx + dy*dy) || 1e-12, best = -1, bi = -1;
    for(var i = a + 1; i < b; i++){
      var px = (pts[i].x - x0) / sx, py = (pts[i].y - y0) / sy;
      var d = Math.abs(dy*px - dx*py + bx*ay - by*ax) / len;
      if(d > best){ best = d; bi = i; }
    }
    if(best > tol){ keep[bi] = true; stack.push([a, bi], [bi, b]); }
  }
  return pts.filter(function(_, i){ return keep[i]; });
}
</script>
<script src="/js/slideSheetModel.js"></script>
<script>
// 2026-11-21 (John): LAS wells (see the panel note). Kept apart from the CSV wells and merged into the same state arrays.
(function(){
  var LAS_WELLS = [];   // [{ name, series: {hl, tq, wob, rop, mse, flow, td} }]
  var KEYS = { wob:'wobSeries', hl:'pasonSeries', tq:'torqueSeries', rop:'ropSeries', mse:'mseSeries', flow:'flowSeries', td:'timeDepthSeries' };
  window.mtxMergeLas = function(){
    var csv = state.csvSets || { wob:[], hl:[], tq:[], rop:[], mse:[], flow:[], td:[] };
    Object.keys(KEYS).forEach(function(k){
      var arr = (csv[k] || []).slice();
      LAS_WELLS.forEach(function(w){ var r = w.series[k]; if(r && r.length) arr.push({ name: w.name + ' (LAS)', raw: r, rows: r.length }); });
      arr.forEach(function(s2, i){ s2.color = colorByIndex(i, arr.length); });
      state[KEYS[k]] = arr;
    });
  };
  var files = [];
  window.mtxLasWells = function(){ return LAS_WELLS; };   // 2026-11-21: used by Export All Plots (LAS time statistics tabs)
  async function readAll(){
    var st = document.getElementById('status3'), bin = parseFloat(document.getElementById('lasBin').value) || 1; LAS_WELLS = [];
    for(var i = 0; i < files.length; i++){ var f = files[i];
      try{ var p = new SlideSheetModel.LasParser(), dec = new TextDecoder(), CH = 8 << 20;
        for(var off = 0; off < f.size; off += CH){ var buf = await f.slice(off, Math.min(off + CH, f.size)).arrayBuffer(); p.push(dec.decode(buf, { stream: off + CH < f.size }));
          st.textContent = 'Reading ' + f.name + ' ' + Math.min(100, Math.round(100 * (off + CH) / f.size)) + ' %…'; await new Promise(function(r){ setTimeout(r, 0); }); }
        var L = p.finish(), ser = SlideSheetModel.lasToSeries(L, { bin: bin });
        st.textContent = f.name + ': time statistics…'; await new Promise(function(r){ setTimeout(r, 0); });
        var det = null, tst = null; try{ det = SlideSheetModel.detect(L, {}); tst = SlideSheetModel.lasTimeStats(L, det, {}); }catch(e2){ tst = null; }   // 2026-11-21: time model stats
        LAS_WELLS.push({ name: (L.well && L.well.WELL) || f.name.replace(/\.[^.]+$/, ''), series: ser, stats: tst });
        st.textContent = f.name + ': ' + L.n.toLocaleString() + ' rows → ' + ser.rop.length + ' depth bins';
      }catch(err){ st.textContent = f.name + ': ' + err.message; }
    }
    if(!state.csvSets) state.csvSets = { wob: state.wobSeries.slice(), hl: state.pasonSeries.slice(), tq: state.torqueSeries.slice(), rop: state.ropSeries.slice(), mse: state.mseSeries.slice(), flow: state.flowSeries.slice(), td: state.timeDepthSeries.slice() };
    mtxMergeLas(); buildSeriesToggleMenu(); if(typeof updateStatus === 'function') updateStatus(); renderMain();
    st.textContent = LAS_WELLS.length + ' LAS well(s) added (bin ' + bin + ' m): ' + LAS_WELLS.map(function(w){ return w.name; }).join(', ');
  }
  document.getElementById('lasFiles').addEventListener('change', function(e){ files = Array.from(e.target.files || []); if(files.length) readAll(); });
  document.getElementById('lasBin').addEventListener('change', function(){ if(files.length) readAll(); });
  document.getElementById('lasClear').addEventListener('click', function(){ files = []; LAS_WELLS = []; document.getElementById('lasFiles').value = ''; if(state.csvSets){ mtxMergeLas(); buildSeriesToggleMenu(); renderMain(); } document.getElementById('status3').textContent = 'LAS wells removed.'; });
})();
</script>
