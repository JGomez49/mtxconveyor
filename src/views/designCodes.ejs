<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Design Codes — MTX</title>
<style>
  /*
    Design Codes (added 2026-10-28, John). CNRL directional trajectory design
    guidelines, one per code (T-001, E-002, ...). Data: models/DesignCode.js,
    seeded once from CNRL_Design_Codes.xlsx (see notes.controller.js
    seedDesignCodes). Everyone reads; admin edits on this page (Edit / New
    code). Deep link: /notes/designCodes?code=T-002 (used by the job page's
    Design Code field). Same dark theme as dsi.ejs / pipeStretch.ejs.
    2026-10-28 (John, round 2): "Always" block is a closed-by-default accordion;
    Compare mode (tick 2–4 codes, rows aligned by section + parameter, differing
    rows highlighted, "Only differences" filter); Print / PDF button (browser
    print dialog, print CSS expands all sections and hides menus).
  */
  :root{ --bg:#0f1216; --panel:#171b21; --panel2:#1e232b; --border:#2a313c; --text:#e6e9ef; --muted:#8a93a3; --accent:#4da3ff; --good:#2ecc71; --bad:#ff5c5c; --warn:#f5a623; }
  *{box-sizing:border-box;}
  body{margin:0;font-family:-apple-system,Segoe UI,Roboto,Arial,sans-serif;background:var(--bg);color:var(--text);font-size:13px;}
  header{padding:12px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;}
  header h1{font-size:16px;margin:0;font-weight:600;} header .sub{color:var(--muted);font-size:12px;}
  a{color:var(--accent);}
  .layout{display:flex;min-height:calc(100vh - 54px);}
  .side{width:310px;flex:0 0 310px;border-right:1px solid var(--border);padding:10px;overflow-y:auto;max-height:calc(100vh - 54px);position:sticky;top:0;}
  .main{flex:1;padding:12px 18px;min-width:0;}
  input,textarea,select{background:var(--panel2);color:var(--text);border:1px solid var(--border);border-radius:5px;padding:5px 7px;font:inherit;}
  textarea{resize:vertical;width:100%;}
  .search{width:100%;margin-bottom:8px;}
  .grp{color:var(--muted);text-transform:uppercase;font-size:11px;letter-spacing:.05em;margin:12px 4px 4px;}
  .item{padding:6px 8px;border-radius:6px;cursor:pointer;border:1px solid transparent;}
  .item:hover{background:var(--panel2);} .item.sel{background:#1e2d3d;border-color:#2f4a66;}
  .item b{color:var(--accent);} .item .f{color:var(--muted);font-size:11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .panel{background:var(--panel);border:1px solid var(--border);border-radius:8px;padding:10px 14px;margin-bottom:12px;}
  .panel h2{font-size:13px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);margin:0;cursor:pointer;display:flex;justify-content:space-between;}
  .panel.closed .body{display:none;}
  .body{margin-top:8px;}
  .hdr{display:flex;gap:14px;align-items:baseline;flex-wrap:wrap;margin-bottom:10px;}
  .hdr .code{font-size:22px;font-weight:700;color:var(--accent);} .hdr .area{font-size:16px;font-weight:600;}
  .badge{display:inline-block;padding:2px 8px;border-radius:10px;font-size:11px;background:var(--panel2);border:1px solid var(--border);color:var(--muted);}
  table{width:100%;border-collapse:collapse;}
  td{border-bottom:1px solid var(--border);padding:5px 7px;vertical-align:top;}
  td.p{width:34%;color:var(--muted);} td.v{white-space:pre-wrap;} td .n{color:var(--warn);font-size:11px;margin-top:2px;white-space:pre-wrap;}
  tr.sub td{color:var(--text);font-weight:600;background:var(--panel2);}
  .pics{display:flex;flex-wrap:wrap;gap:10px;margin-top:10px;}
  .pics figure{margin:0;background:#fff;border-radius:6px;padding:4px;max-width:420px;}
  .pics img{max-width:100%;max-height:320px;display:block;cursor:zoom-in;}
  .pics figcaption{color:#333;font-size:11px;padding:2px 4px;}
  .btn{background:var(--panel2);color:var(--text);border:1px solid var(--border);border-radius:5px;padding:5px 10px;cursor:pointer;font:inherit;}
  .btn:hover{border-color:var(--accent);} .btn.pri{background:#1f5fa8;border-color:#1f5fa8;} .btn.bad{border-color:#7a2b2b;color:#ff9b9b;} .btn.sm{padding:2px 7px;font-size:11px;}
  .muted{color:var(--muted);} .log{font-size:11px;color:var(--muted);}
  .ed-sec{border:1px dashed var(--border);border-radius:8px;padding:8px;margin-bottom:10px;}
  .ed-row{display:grid;grid-template-columns:30% 1fr 22% auto;gap:6px;margin-bottom:5px;align-items:start;}
  .ed-row input,.ed-row textarea{width:100%;}
  .tools{display:flex;gap:6px;flex-wrap:wrap;align-items:center;}
  .empty{color:var(--muted);padding:30px;text-align:center;}
  /* 2026-10-28 (John): compare mode + print/PDF */
  .item{display:flex;gap:7px;align-items:flex-start;} .item .txt{flex:1;min-width:0;} .item input{margin-top:3px;}
  .cmpbar{display:flex;gap:6px;align-items:center;margin-bottom:6px;font-size:12px;}
  .cmp{overflow-x:auto;} .cmp table{min-width:700px;} .cmp th{position:sticky;top:0;background:var(--panel2);text-align:left;padding:6px;border-bottom:1px solid var(--border);}
  .cmp td{white-space:pre-wrap;} .cmp tr.diff td.cv{background:rgba(245,166,35,.13);} .cmp tr.sec td{background:var(--panel2);font-weight:600;color:var(--accent);text-transform:uppercase;font-size:11px;letter-spacing:.04em;}
  .cmp td.miss{color:var(--muted);font-style:italic;}
  @media print{
    :root{ --bg:#fff; --panel:#fff; --panel2:#eee; --border:#bbb; --text:#000; --muted:#444; --accent:#0b4f9c; --warn:#8a5a00; }
    header .sub, header .tools, .side, .tools, #general, .log, .panel h2 span, .cmpbar button{display:none !important;}
    .layout{display:block;} .main{padding:0;} .panel{break-inside:avoid;} .panel.closed .body{display:block;}
    .pics figure{border:1px solid #bbb;} body{font-size:11px;}
  }
</style>
</head>
<body>
<header>
  <div><h1>📏 Design Codes</h1><div class="sub">CNRL directional drilling basic trajectory design guidelines<%= isAdmin ? ' — admin: you can edit' : ' — read only' %></div></div>
  <div class="tools"><% if (isAdmin) { %><button class="btn" id="newBtn">+ New code</button><% } %><a href="/notes">← Back to MTX</a></div>
</header>
<div class="layout">
  <aside class="side">
    <input class="search" id="q" placeholder="Search code, area, formation, text…">
    <div class="cmpbar"><button class="btn sm" id="cmpBtn" disabled>⇄ Compare (0)</button><button class="btn sm" id="cmpClr">Clear</button><span class="muted">tick 2–4 codes</span></div>
    <div id="list"></div>
  </aside>
  <main class="main">
    <div id="general"></div>
    <div id="detail"></div>
  </main>
</div>
<script type="application/json" id="dcData"><%- JSON.stringify(codes).replace(/</g, '\\u003c') %></script>
<script>
(function(){
  const IS_ADMIN = <%- isAdmin ? 'true' : 'false' %>;
  const codes = JSON.parse(document.getElementById('dcData').textContent);
  const general = codes.find(c => c.code === 'GENERAL');
  const list = codes.filter(c => c.code !== 'GENERAL');
  const GROUPS = ['Thermal','East','Central','West'];
  const esc = t => String(t == null ? '' : t).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
  const $ = id => document.getElementById(id);
  let selId = null, editing = false;

  // ---------- list ----------
  const hay = c => [c.code, c.area, c.group, c.formations].concat((c.sections||[]).flatMap(s => [s.title].concat((s.rows||[]).flatMap(r => [r.param, r.value, r.note])))).join(' ').toLowerCase();
  function renderList(){
    const q = $('q').value.trim().toLowerCase();
    const shown = list.filter(c => !q || q.split(/\s+/).every(w => hay(c).includes(w)));
    const groups = GROUPS.concat([...new Set(shown.map(c => c.group).filter(g => !GROUPS.includes(g)))]);
    $('list').innerHTML = groups.map(g => {
      const items = shown.filter(c => (c.group || '') === g); if(!items.length) return '';
      return '<div class="grp">' + esc(g || 'No group') + ' (' + items.length + ')</div>' + items.map(c =>
        '<div class="item' + (String(c._id) === selId ? ' sel' : '') + '" data-id="' + c._id + '"><input type="checkbox" class="ck" title="Add to compare"' + (cmpSel.includes(String(c._id)) ? ' checked' : '') + '>' +
        '<div class="txt"><b>' + esc(c.code) + '</b> · ' + esc(c.area) +
        '<div class="f" title="' + esc(c.formations) + '">' + esc(c.formations || '—') + '</div></div></div>').join('');
    }).join('') || '<div class="empty">No code matches.</div>';
    $('list').querySelectorAll('.item').forEach(el => el.addEventListener('click', e => { if(e.target.classList.contains('ck')) return; select(el.dataset.id); }));
    $('list').querySelectorAll('.ck').forEach(ck => ck.addEventListener('change', () => {
      const id = ck.closest('.item').dataset.id;
      if(ck.checked){ if(cmpSel.length >= 4){ ck.checked = false; return alert('Compare up to 4 codes.'); } cmpSel.push(id); } else cmpSel = cmpSel.filter(x => x !== id);
      updCmp();
    }));
    updCmp();
  }
  // ---------- compare (2026-10-28, John) ----------
  // Rows are aligned by section title + parameter text (case/space-insensitive);
  // a row is highlighted when the codes' values differ. Sub-headings and rows
  // missing in a code are shown as "—".
  let cmpSel = [], cmpOnlyDiff = false;
  function updCmp(){ $('cmpBtn').disabled = cmpSel.length < 2; $('cmpBtn').textContent = '⇄ Compare (' + cmpSel.length + ')'; }
  $('cmpClr').addEventListener('click', () => { cmpSel = []; renderList(); });
  $('cmpBtn').addEventListener('click', () => { if(editing && !confirm('Discard unsaved changes?')) return; editing = false; renderCompare(); });
  const nk = t => String(t || '').toLowerCase().replace(/\s+/g, ' ').trim();
  function renderCompare(){
    const cs = cmpSel.map(id => codes.find(c => String(c._id) === id)).filter(Boolean);
    const secs = [];  // [{key,title,params:[{key,label}]}]
    cs.forEach(c => (c.sections || []).forEach(s => {
      let S = secs.find(x => x.key === nk(s.title)); if(!S){ S = { key: nk(s.title), title: s.title, params: [] }; secs.push(S); }
      (s.rows || []).forEach(r => { const k = nk(r.param) || ('#' + nk(r.value).slice(0, 40)); if(!S.params.find(p => p.key === k)) S.params.push({ key: k, label: r.param || '' }); });
    }));
    const cell = (c, S, P) => { const s = (c.sections || []).find(x => nk(x.title) === S.key); if(!s) return null;
      const r = (s.rows || []).find(r => (nk(r.param) || ('#' + nk(r.value).slice(0, 40))) === P.key); return r ? (r.value + (r.note ? '\n[' + r.note + ']' : '')) : null; };
    let nDiff = 0;
    const body = [{ t: 'Formation(s)', v: cs.map(c => c.formations) }, { t: 'Updated', v: cs.map(c => c.updatedDate) }].map(x => {
      const d = new Set(x.v.map(nk)).size > 1; return '<tr class="' + (d ? 'diff' : '') + '"><td class="p">' + x.t + '</td>' + x.v.map(v => '<td class="cv">' + esc(v || '—') + '</td>').join('') + '</tr>'; }).join('') +
      secs.map(S => {
        const rows = S.params.map(P => {
          const vals = cs.map(c => cell(c, S, P)), d = new Set(vals.map(v => v == null ? '\u0000' : nk(v))).size > 1; if(d) nDiff++;
          if(cmpOnlyDiff && !d) return '';
          return '<tr class="' + (d ? 'diff' : '') + '"><td class="p">' + esc(P.label) + '</td>' + vals.map(v => v == null ? '<td class="cv miss">—</td>' : '<td class="cv">' + esc(v) + '</td>').join('') + '</tr>';
        }).join('');
        return rows ? '<tr class="sec"><td colspan="' + (cs.length + 1) + '">' + esc(S.title) + '</td></tr>' + rows : '';
      }).join('');
    $('detail').innerHTML = '<div class="hdr"><span class="code">Compare</span><span class="area">' + cs.map(c => esc(c.code)).join(' · ') + '</span>' +
      '<span class="tools" style="margin-left:auto"><label><input type="checkbox" id="onlyDiff"' + (cmpOnlyDiff ? ' checked' : '') + '> Only differences</label>' +
      '<button class="btn" id="cmpPrint">🖨 Print / PDF</button><button class="btn" id="cmpExit">Close compare</button></span></div>' +
      '<div class="muted" style="margin-bottom:6px">Highlighted rows differ (' + nDiff + '). Rows are matched by section and parameter name. Pictures are not compared.</div>' +
      '<div class="cmp panel"><table><thead><tr><th style="width:24%">Parameter</th>' + cs.map(c => '<th>' + esc(c.code) + ' · ' + esc(c.area) + '</th>').join('') + '</tr></thead><tbody>' + body + '</tbody></table></div>';
    $('onlyDiff').addEventListener('change', e => { cmpOnlyDiff = e.target.checked; renderCompare(); });
    $('cmpPrint').addEventListener('click', () => window.print());
    $('cmpExit').addEventListener('click', () => renderDetail());
    window.scrollTo(0, 0);
  }
  $('q').addEventListener('input', renderList);

  // ---------- read view ----------
  function rowsHtml(rows){
    return '<table>' + (rows||[]).map(r => (r.param && !r.value)
      ? '<tr class="sub"><td colspan="2">' + esc(r.param) + (r.note ? '<div class="n">' + esc(r.note) + '</div>' : '') + '</td></tr>'
      : '<tr><td class="p">' + esc(r.param) + '</td><td class="v">' + esc(r.value) + (r.note ? '<div class="n">' + esc(r.note) + '</div>' : '') + '</td></tr>').join('') + '</table>';
  }
  const picsHtml = ims => ims.length ? '<div class="pics">' + ims.map(i => '<figure><a href="' + esc(i.url) + '" target="_blank"><img src="' + esc(i.url) + '" alt=""></a>' + (i.caption ? '<figcaption>' + esc(i.caption) + '</figcaption>' : '') + '</figure>').join('') + '</div>' : '';
  function sectionsHtml(c){
    const titles = (c.sections||[]).map(s => s.title);
    const out = (c.sections||[]).map(s => {
      const ims = (c.images||[]).filter(i => i.section === s.title);
      if(!(s.rows||[]).length && !ims.length) return '';
      return '<div class="panel"><h2>' + esc(s.title) + ' <span>▾</span></h2><div class="body">' + ((s.rows||[]).length ? rowsHtml(s.rows) : '') + picsHtml(ims) + '</div></div>';
    }).join('');
    const loose = (c.images||[]).filter(i => !titles.includes(i.section));
    return out + (loose.length ? '<div class="panel"><h2>Pictures <span>▾</span></h2><div class="body">' + picsHtml(loose) + '</div></div>' : '');
  }
  function bindCollapse(root){ root.querySelectorAll('.panel > h2').forEach(h => h.addEventListener('click', () => h.parentElement.classList.toggle('closed'))); }
  function renderGeneral(){
    if(!general){ $('general').innerHTML = ''; return; }
    $('general').innerHTML = '<div class="panel closed" id="genPanel"><h2>Always — set backs, sponsor approval &amp; authors <span>▾</span></h2><div class="body">' +
      (general.sections||[]).map(s => '<div style="margin-bottom:8px"><div class="muted" style="margin-bottom:3px">' + esc(s.title) + '</div>' + rowsHtml(s.rows) + picsHtml((general.images||[]).filter(i => i.section === s.title)) + '</div>').join('') +
      (IS_ADMIN ? '<button class="btn sm" id="genEdit">Edit this block</button>' : '') + '</div></div>';
    $('genPanel').querySelector('h2').addEventListener('click', () => $('genPanel').classList.toggle('closed'));
    if(IS_ADMIN) $('genEdit').addEventListener('click', () => { selId = String(general._id); editing = true; renderDetail(); });
  }
  function renderDetail(){
    const c = codes.find(x => String(x._id) === selId);
    if(!c){ $('detail').innerHTML = '<div class="empty">Select a Design Code on the left.</div>'; return; }
    if(editing) return renderEditor(c);
    const log = (c.log||[]).slice(-5).reverse().map(l => esc(l.user) + ' — ' + esc(String(l.at||'').slice(0,10)) + ' — ' + esc(l.what)).join('<br>');
    $('detail').innerHTML = '<div class="hdr"><span class="code">' + esc(c.code) + '</span><span class="area">' + esc(c.area) + '</span>' +
      (c.group ? '<span class="badge">' + esc(c.group) + '</span>' : '') + '<span class="muted">Updated: ' + esc(c.updatedDate || '—') + '</span>' +
      '<span class="tools" style="margin-left:auto"><button class="btn" id="prBtn">🖨 Print / PDF</button>' +
      (IS_ADMIN ? '<button class="btn" id="edBtn">✎ Edit</button><button class="btn bad" id="delBtn">Delete</button>' : '') + '</span></div>' +
      '<div class="panel"><b>Formation(s):</b> ' + esc(c.formations || '—') + '</div>' + sectionsHtml(c) +
      (log ? '<div class="log">Change log (last 5):<br>' + log + '</div>' : '');
    bindCollapse($('detail'));
    // 2026-10-28 (John): print / save as PDF — browser print dialog ("Save as PDF"); print CSS hides the list and menus and opens every section.
    $('prBtn').addEventListener('click', () => { const t = document.title; document.title = c.code + ' ' + c.area + ' — Design Code'; window.print(); document.title = t; });
    if(IS_ADMIN){
      $('edBtn').addEventListener('click', () => { editing = true; renderDetail(); });
      $('delBtn').addEventListener('click', async () => {
        if(!confirm('Delete Design Code ' + c.code + '? This cannot be undone.')) return;
        const r = await fetch('/notes/designCodes/' + c._id, { method: 'DELETE' }); const d = await r.json();
        if(!d.ok) return alert('Delete failed: ' + d.error); location.href = '/notes/designCodes';
      });
    }
  }
  function select(id){
    if(editing && !confirm('Discard unsaved changes?')) return;
    editing = false; selId = String(id); renderList(); renderDetail();
    const c = codes.find(x => String(x._id) === selId);
    if(c) history.replaceState(null, '', '/notes/designCodes?code=' + encodeURIComponent(c.code));
    window.scrollTo(0, 0);
  }

  // ---------- editor (admin) ----------
  let draft = null;
  function renderEditor(c){
    if(!draft || draft._src !== c) draft = { _src: c, id: c._id || null, code: c.code || '', group: c.group || '', area: c.area || '', formations: c.formations || '',
      sections: JSON.parse(JSON.stringify(c.sections || [])), images: JSON.parse(JSON.stringify(c.images || [])) };
    const isGen = draft.code === 'GENERAL';
    const secOpts = sel => '<option value="">(end of page)</option>' + draft.sections.map(s => '<option' + (s.title === sel ? ' selected' : '') + '>' + esc(s.title) + '</option>').join('');
    $('detail').innerHTML =
      '<div class="hdr"><span class="code">' + (draft.id ? 'Edit ' + esc(draft.code) : 'New Design Code') + '</span><span class="tools" style="margin-left:auto">' +
      '<button class="btn pri" id="svBtn">💾 Save</button><button class="btn" id="cxBtn">Cancel</button></span></div>' +
      '<div class="panel"><div class="tools">' +
      (isGen ? '' : '<label>Code <input id="e_code" value="' + esc(draft.code) + '" style="width:90px" placeholder="T-007"></label>' +
        '<label>Group <select id="e_group">' + GROUPS.map(g => '<option' + (g === draft.group ? ' selected' : '') + '>' + g + '</option>').join('') + '</select></label>') +
      '<label style="flex:1">' + (isGen ? 'Title' : 'Area') + ' <input id="e_area" value="' + esc(draft.area) + '" style="width:100%"></label></div>' +
      (isGen ? '' : '<div style="margin-top:6px"><label>Formation(s) <input id="e_form" value="' + esc(draft.formations) + '" style="width:100%"></label></div>') +
      '<div class="muted" style="margin-top:6px">Updated date is set automatically when you save. A row with a parameter and no value shows as a sub-heading.</div></div>' +
      draft.sections.map((s, si) => '<div class="ed-sec" data-si="' + si + '"><div class="tools" style="margin-bottom:6px"><input class="s-title" value="' + esc(s.title) + '" style="flex:1;font-weight:600" placeholder="Section title">' +
        '<button class="btn sm" data-a="sup">↑</button><button class="btn sm" data-a="sdn">↓</button><button class="btn sm bad" data-a="sdel">Delete section</button></div>' +
        '<div class="ed-row muted"><span>Parameter</span><span>Value</span><span>Note</span><span></span></div>' +
        (s.rows||[]).map((r, ri) => '<div class="ed-row" data-ri="' + ri + '"><input class="r-p" value="' + esc(r.param) + '"><textarea class="r-v" rows="' + Math.min(6, Math.max(1, String(r.value||'').split('\n').length)) + '">' + esc(r.value) + '</textarea><input class="r-n" value="' + esc(r.note || '') + '">' +
          '<span class="tools"><button class="btn sm" data-a="rup">↑</button><button class="btn sm" data-a="rdn">↓</button><button class="btn sm bad" data-a="rdel">✕</button></span></div>').join('') +
        '<button class="btn sm" data-a="radd">+ Row</button></div>').join('') +
      '<button class="btn" id="secAdd">+ Section</button>' +
      '<div class="panel" style="margin-top:12px"><h2 style="cursor:default">Pictures</h2><div class="body">' +
      (draft.id ? '' : '<div class="muted">Save the new code first, then add pictures.</div>') +
      draft.images.map((im, ii) => '<div class="tools" style="margin-bottom:6px" data-ii="' + ii + '"><img src="' + esc(im.url) + '" style="height:60px;background:#fff;border-radius:4px">' +
        '<label>Section <select class="i-sec">' + secOpts(im.section) + '</select></label><input class="i-cap" value="' + esc(im.caption || '') + '" placeholder="Caption" style="width:220px">' +
        '<button class="btn sm bad" data-a="idel">Remove</button></div>').join('') +
      (draft.id ? '<div class="tools" style="margin-top:8px"><input type="file" id="i_file" accept="image/*"><label>Section <select id="i_sec">' + secOpts('') + '</select></label><input id="i_cap" placeholder="Caption" style="width:200px"><button class="btn" id="i_up">Upload picture</button></div>' +
        '<div class="muted" style="margin-top:4px">Uploading or removing a picture saves immediately — save your text edits first.</div>' : '') + '</div></div>';
    bindEditor();
  }
  function pull(){ // copy inputs into draft
    const d = $('detail');
    if($('e_code')) draft.code = $('e_code').value; if($('e_group')) draft.group = $('e_group').value;
    draft.area = $('e_area').value; if($('e_form')) draft.formations = $('e_form').value;
    d.querySelectorAll('.ed-sec').forEach(sec => { const s = draft.sections[+sec.dataset.si]; s.title = sec.querySelector('.s-title').value;
      sec.querySelectorAll('.ed-row[data-ri]').forEach(row => { const r = s.rows[+row.dataset.ri]; r.param = row.querySelector('.r-p').value; r.value = row.querySelector('.r-v').value; r.note = row.querySelector('.r-n').value; }); });
    d.querySelectorAll('[data-ii]').forEach(el => { const im = draft.images[+el.dataset.ii]; im.section = el.querySelector('.i-sec').value; im.caption = el.querySelector('.i-cap').value; });
  }
  const move = (arr, i, d) => { const j = i + d; if(j < 0 || j >= arr.length) return; [arr[i], arr[j]] = [arr[j], arr[i]]; };
  function bindEditor(){
    const d = $('detail');
    d.querySelectorAll('button[data-a]').forEach(b => b.addEventListener('click', async () => {
      pull(); const a = b.dataset.a, sec = b.closest('.ed-sec'), si = sec ? +sec.dataset.si : -1, row = b.closest('.ed-row'), ri = row ? +row.dataset.ri : -1;
      const s = draft.sections[si];
      if(a === 'sup') move(draft.sections, si, -1); else if(a === 'sdn') move(draft.sections, si, 1);
      else if(a === 'sdel'){ if(!confirm('Delete section "' + s.title + '"?')) return; draft.sections.splice(si, 1); }
      else if(a === 'radd') s.rows.push({ param: '', value: '', note: '' });
      else if(a === 'rup') move(s.rows, ri, -1); else if(a === 'rdn') move(s.rows, ri, 1); else if(a === 'rdel') s.rows.splice(ri, 1);
      else if(a === 'idel'){
        const im = draft.images[+b.closest('[data-ii]').dataset.ii];
        if(!confirm('Remove this picture now?')) return;
        const r = await fetch('/notes/designCodes/' + draft.id + '/image/' + im._id, { method: 'DELETE' }); const x = await r.json();
        if(!x.ok) return alert('Remove failed: ' + x.error); return reloadAt(draft.code, true);
      }
      renderEditor(draft._src);
    }));
    $('secAdd').addEventListener('click', () => { pull(); draft.sections.push({ title: 'New section', rows: [{ param: '', value: '', note: '' }] }); renderEditor(draft._src); });
    $('cxBtn').addEventListener('click', () => { editing = false; draft = null; if(!selId || selId === 'new') { selId = null; } renderList(); renderDetail(); });
    $('svBtn').addEventListener('click', async () => {
      pull();
      const body = { id: draft.id, code: draft.code, group: draft.group, area: draft.area, formations: draft.formations, sections: draft.sections, images: draft.images.map(i => ({ _id: i._id, section: i.section, caption: i.caption })) };
      const r = await fetch('/notes/designCodes', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }); const x = await r.json();
      if(!x.ok) return alert('Save failed: ' + x.error); reloadAt(x.code, false);
    });
    if($('i_up')) $('i_up').addEventListener('click', async () => {
      const f = $('i_file').files[0]; if(!f) return alert('Choose a picture first.');
      const fd = new FormData(); fd.append('image', f); fd.append('section', $('i_sec').value); fd.append('caption', $('i_cap').value);
      $('i_up').disabled = true; $('i_up').textContent = 'Uploading…';
      const r = await fetch('/notes/designCodes/' + draft.id + '/image', { method: 'POST', body: fd }); const x = await r.json();
      if(!x.ok){ $('i_up').disabled = false; $('i_up').textContent = 'Upload picture'; return alert('Upload failed: ' + x.error); }
      reloadAt(draft.code, true);
    });
  }
  function reloadAt(code, edit){ location.href = '/notes/designCodes?code=' + encodeURIComponent(code) + (edit ? '&edit=1' : ''); }
  if(IS_ADMIN && $('newBtn')) $('newBtn').addEventListener('click', () => {
    if(editing && !confirm('Discard unsaved changes?')) return;
    const blank = { code: '', group: 'Thermal', area: '', formations: '', sections: ['Surface Slot Layout','Surface Casing','AC Nudges','Build Section','Lateral Section','For PlanIT use only','AC Guidelines Default','Additional notes'].map(t => ({ title: t, rows: [] })), images: [] };
    selId = 'new'; editing = true; draft = null; codes.push(Object.assign(blank, { _id: 'new' })); renderList(); renderEditor(blank);
  });

  // ---------- start ----------
  const qs = new URLSearchParams(location.search), want = (qs.get('code') || '').trim().toUpperCase();
  const start = (want === 'GENERAL' && qs.get('edit') !== '1') ? list[0] : (codes.find(c => c.code.toUpperCase() === want) || list[0]);
  renderGeneral();
  if(want && !codes.find(c => c.code.toUpperCase() === want)) $('detail').insertAdjacentHTML('beforebegin', '<div class="panel" style="border-color:var(--warn)">Design Code "' + esc(want) + '" was not found.</div>');
  if(start){ selId = String(start._id); editing = IS_ADMIN && qs.get('edit') === '1'; }
  renderList(); renderDetail();
})();
</script>
</body>
</html>
