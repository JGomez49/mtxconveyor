}
function scApplySettings(o){
  Object.keys(o).forEach(function(k){ var e = scEl(k); if(!e) return; if(k === 'scSkipExcl' || k === 'scCompare') e.checked = !!o[k]; else if(e.tagName) e.value = o[k]; });
  if(o.scExMode == null && o.scAutoEx != null) scEl('scExMode').value = o.scAutoEx ? 'tol' : 'none'; // cases saved before 2026-10-25 MSA update
