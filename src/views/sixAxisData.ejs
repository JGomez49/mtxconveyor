function scComputeWmm(){
  var lat = +scEl('scLat').value, lon = +scEl('scLon').value, h = +scEl('scHgt').value || 0, yr = +scEl('scYear').value;
  if(!isFinite(lat) || !isFinite(lon) || scEl('scLat').value === '' || scEl('scLon').value === ''){ alert('Enter latitude and longitude.'); return; }
  if(!(yr >= 2025 && yr < 2030)) { if(!confirm('WMM2025 is valid 2025.0–2030.0. Compute anyway?')) return; }
  var f = WMMModel.computeField(lat, lon, h / 1000, yr);
