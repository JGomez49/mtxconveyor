          <tr class="scWmm"><td></td><td><button type="button" class="secondary" id="scWmmBtn">Compute WMM2025</button></td></tr>
          <tr><td>Reference BT (&micro;T)</td><td><input type="number" id="scBT" value="${scEsc(refBT)}" step="any"></td></tr>
          <tr><td>Reference Dip (°)</td><td><input type="number" id="scDip" value="${scEsc(refDip)}" step="any"></td></tr>
          <tr><td>Declination (°)</td><td><input type="number" id="scDec" value="${scEsc(refDec)}" step="any"></td></tr>
          <tr><td>Magnetometer unit of data</td><td><select id="scBUnit"><option value="auto">Auto-detect</option><option value="ut">&micro;T</option><option value="nt">nT</option></select></td></tr>
          <tr><td>BT uncertainty &plusmn; (nT) / Dip uncertainty &plusmn; (°)</td><td style="display:flex;gap:4px;"><input type="number" id="scUBT" value="250" step="any"><input type="number" id="scUDip" value="0.15" step="any"></td></tr>
          <tr id="scApplyRow"><td>Correction applied (Short Collar)</td><td><select id="scApply"><option value="station">Per-station Z-bias (SurQC)</option><option value="average">Average Z-bias (all stations)</option></select></td></tr>
        </table>
        <div class="note" id="scRefNote">Manual reference pre-filled from Input Data (Reference BT / DIP / DEC).</div>
      </div>
      <div>
        <table>
          <tr><td>Automatic exclusion</td><td><select id="scExMode"><option value="none">None (manual ticks only)</option><option value="tol" selected>Tolerance (SurQC BasicQc)</option><option value="trend">Trend (SurQC AutoQc)</option></select></td></tr>
          <tr><td>BT tolerance (nT) / Dip tolerance (°)</td><td style="display:flex;gap:4px;"><input type="number" id="scTolBT" value="300" step="any"><input type="number" id="scTolDip" value="0.3" step="any"></td></tr>
          <tr class="scTrendRow"><td>GT tolerance (G) / Bz-bias tolerance (nT)</td><td style="display:flex;gap:4px;"><input type="number" id="scTolGT" value="0.0015" step="any"><input type="number" id="scTolBz" value="300" step="any"></td></tr>
          <tr><td>Highlight Az uncertainty above (°)</td><td><input type="number" id="scHiU" value="0.5" step="any"></td></tr>
