    var bz = rows.map(function(r){ return r.bzCorr; }), bt = rows.map(function(r){ return r.btCorr; }), dip = rows.map(function(r){ return r.dipCorr; });
    var az = rows.map(function(r, i){ return scNorm360(R.pageAz[i] + r.dAz); });
    var xy = { plot6: [md, bz], plot8: [md, bt], plot11: [md, dip], plot18: [tf, bz], plot21: [tf, dip], plot22: [tf, bt], plot24: [md, az] };
    ids.forEach(function(id){
      var d = document.getElementById(id); if(!d || !d.data) return;
      Plotly.addTraces(id, { x: xy[id][0], y: xy[id][1], type: 'scatter', mode: mode, name: SC_MODEL_NAME[S.res.model] + ' corrected',
