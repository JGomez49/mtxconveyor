    { Item: 'Automatic exclusion', Value: scEl('scExMode').options[scEl('scExMode').selectedIndex].text } ];
  [R.main, R.cmp].filter(Boolean).forEach(function(S){
    if(S.model === 'sc'){ meta.push({ Item: 'Short Collar correction applied', Value: scEl('scApply').value === 'average' ? 'Average Z-bias' : 'Per-station Z-bias' });
      meta.push({ Item: 'Short Collar average Z-bias (nT)', Value: +(S.sc.averageZBias / p.k * 1000).toFixed(2) }); }
    else { var c = S.msa.corr; meta.push({ Item: 'MSA X bias (nT) / SF', Value: c.x.b + ' / ' + c.x.sf.toFixed(6) }, { Item: 'MSA Y bias (nT, page frame) / SF', Value: (-c.y.b) + ' / ' + c.y.sf.toFixed(6) },
      { Item: 'MSA Z bias (nT) / SF', Value: c.z.b + ' / ' + c.z.sf.toFixed(6) }, { Item: 'MSA stations fitted', Value: S.msa.nUsed }); }
  });
  XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(meta), 'Settings');
  XLSX.writeFile(wb, (R.main.model === 'msa' ? 'MSA' : 'ShortCollar') + '_corrected_survey.xlsx');
}

// ---- Save as new version (same pattern as SAGcorrection) -------------
async function scLoadJob(){
  var id = scEl('scMtxId').value.trim(); if(!id){ scEl('scJobStatus').textContent = 'Enter an MTX ID first.'; return; }
  scEl('scJobStatus').textContent = 'Loading…';
  try{
    var r = await fetch('/notes/tdModel/lookupByMtxId/' + encodeURIComponent(id)); var d = await r.json();
    if(!r.ok) throw new Error(d.error || r.status);
    SC_STATE.job = { noteId: d.noteId, title: d.title, wells: d.subjectWells || [] };
    scEl('scWellSel').innerHTML = SC_STATE.job.wells.map(function(w, i){ return '<option value="' + i + '">' + scEsc(w.wellKey) + '</option>'; }).join('');
    scEl('scJobStatus').innerHTML = '✔ ' + scEsc(d.title) + ' · ' + SC_STATE.job.wells.length + ' subject well(s)' + (d.duplicateWarning ? ' <span style="color:var(--bad)">' + scEsc(d.duplicateWarning) + '</span>' : '');
    scMatchPreview();
  }catch(err){ scEl('scJobStatus').innerHTML = '<span style="color:var(--bad)">' + scEsc(err.message) + '</span>'; SC_STATE.job = null; }
}
function scMdM(md){ return scEl('scMdUnit').value === 'ft' ? md * 0.3048 : md; }
// Optional "Skip excluded stations": a job station whose nearest raw station
// is excluded (auto or manual) is copied unchanged. Off = SurQC behaviour.
function scMatches(){
  var R = SC_STATE.result, J = SC_STATE.job; if(!R || !J || !J.wells.length) return null;
  var w = J.wells[+scEl('scWellSel').value]; if(!w) return null;
  var tol = +scEl('scMdTol').value || 0;
  var skip = scEl('scSkipExcl') && scEl('scSkipExcl').checked;
  var raw = R.main.rows.map(function(r){ return { md: scMdM(r.md), dAz: r.dAz, excluded: !!(skip && r.excluded) }; });
  var n = 0, nSkip = 0;
  w.survey.forEach(function(s){
    var best = null; raw.forEach(function(c){ var d = Math.abs(c.md - s.md); if(d <= tol && (!best || d < best.d)) best = { d: d, c: c }; });
    if(best){ n++; if(best.c.excluded) nSkip++; } });
  return { well: w, raw: raw, tol: tol, matched: n, skipped: nSkip, skip: skip };
}
function scMatchPreview(){
  var m = scMatches(), b = scEl('scSaveBtn'); if(!b) return;
  if(!m){ b.disabled = true; return; }
  b.disabled = (m.matched - m.skipped) === 0;
  scEl('scJobStatus').innerHTML = scEl('scJobStatus').innerHTML.split('<br>')[0] + '<br>' + m.matched + ' of ' + m.well.survey.length +
    ' station(s) of ' + scEsc(m.well.wellKey) + ' match a corrected station within ' + m.tol + ' m' +
    (m.skip ? ' (' + m.skipped + ' of them excluded → copied unchanged, ' + (m.matched - m.skipped) + ' corrected)' : '') +
    '. Corrected stations get Az += ΔAz (' + SC_MODEL_NAME[SC_STATE.result.main.model] + ', SurQC corrected − measured); unmatched stations are copied unchanged.';
}
// Toolcode suggestion: Short Collar -> "+AX", MSA -> "+MS" (same rule as
// SAGcorrection's "+SAG": same tokens plus the suffix, respecting _Fl).
// Expected differences, taken from the official ISCWSA Rev5 toolcode set in
// iscwsaToolcodes.json and identical for every pair checked 2026-10-25:
//  AX: standard sensor terms + AMIL removed; AX sensor terms (ABI*/ASI*/
//      MBI*/MSI*) and MDI*/MFI* (dip/field-strength) added.
//  MS: magnitudes of the magnetometer terms (MBXY-TI1S/2S, MBZ, MSXY-TI1S/2S/3S,
//      MSZ) and AMIL change; nothing added or removed.
// Any other difference (e.g. MWD+HRGM's XYM3/XYM4/SAG from Compass's .ipm) is
// listed as a warning and the suggestion is not preselected.
var SC_AX_REMOVED = ['ABXY-TI1S','ABXY-TI2S','ABZ','ASXY-TI1S','ASXY-TI2S','ASXY-TI3S','ASZ','MBXY-TI1S','MBXY-TI2S','MBZ','MSXY-TI1S','MSXY-TI2S','MSXY-TI3S','MSZ','AMIL'];
var SC_MS_CHANGED = ['MBXY-TI1S','MBXY-TI2S','MBZ','MSXY-TI1S','MSXY-TI2S','MSXY-TI3S','MSZ','AMIL'];
function scIsAxAdded(c){ return /^(ABIXY|ASIXY|MBIXY|MSIXY)-TI\dS$|^(ABIZ|ASIZ)$|^(MDI|MFI)(R|-)/.test(c); }
function scHasTok(code, tok){ return new RegExp('(^|\\+)' + tok + '(\\+|_|$)').test(code); }
function scTokens(code){ return { fl: /_Fl$/.test(code), set: code.replace(/_Fl$/, '').split('+').sort().join('+') }; }
function scSuffix(){ return SC_STATE.result && SC_STATE.result.main.model === 'msa' ? 'MS' : 'AX'; }
function scCounterpart(code, tok){
  if(!code || scHasTok(code, tok)) return null;
  var t = scTokens(code), want = code.replace(/_Fl$/, '').split('+').concat([tok]).sort().join('+');
  return Object.keys(SC_TOOLCODES).find(function(k){ var u = scTokens(k); return u.fl === t.fl && u.set === want; }) || null;
}
function scOtherDiff(a, b, tok){
  var A = {}, B = {}, out = [];
  (SC_TOOLCODES[a] || []).forEach(function(t){ A[t.code] = JSON.stringify(t); });
  (SC_TOOLCODES[b] || []).forEach(function(t){ B[t.code] = JSON.stringify(t); });
  var adds = scHasTok(b, tok) && !scHasTok(a, tok);
  Object.keys(Object.assign({}, A, B)).forEach(function(k){
    if(!(k in B)){ if(!(adds && tok === 'AX' && SC_AX_REMOVED.indexOf(k) >= 0)) out.push(k + ' missing in ' + b); }
    else if(!(k in A)){ if(!(adds && tok === 'AX' && scIsAxAdded(k))) out.push(k + ' only in ' + b); }
    else if(A[k] !== B[k]){ if(!(adds && tok === 'MS' && SC_MS_CHANGED.indexOf(k) >= 0)) out.push(k + ' differs'); }
  });
  return out;
}
async function scOpenSave(){
  var m = scMatches(); if(!m) return;
  try{
    if(!SC_TOOLCODES) SC_TOOLCODES = await (await fetch('/data/iscwsaToolcodes.json')).json();
    var lst = await (await fetch('/notes/wellboreTrajectory/list/' + SC_STATE.job.noteId)).json();
    var t = (lst.trajectories || []).find(function(x){ return x.wellName === m.well.wellKey; });
    SC_ORIG_CODE = t ? (t.toolcode || '') : '';
  }catch(err){ alert('Could not load toolcodes: ' + err.message); return; }
  var tok = scSuffix(), base = SC_ORIG_CODE || 'MWD+SRGM', sug = scCounterpart(base, tok);
  var pre = (sug && !scOtherDiff(base, sug, tok).length) ? sug : base;
  scEl('scOrigCode').textContent = (SC_ORIG_CODE || '(default MWD+SRGM)') + (sug ? (pre === sug ? ' — suggested ' + sug : ' — suggested ' + sug + ' NOT preselected (differences beyond the ' + tok + ' change)')
    : ' — no "+' + tok + '" counterpart of this toolcode in the ISCWSA set (original kept)');
  scEl('scCode').innerHTML = Object.keys(SC_TOOLCODES).map(function(k){ return '<option' + (k === pre ? ' selected' : '') + '>' + scEsc(k) + '</option>'; }).join('');
  scEl('scSavePanel').style.display = '';
  scCheckCode();
}
function scCheckCode(){
  var tok = scSuffix(), code = scEl('scCode').value, base = SC_ORIG_CODE || 'MWD+SRGM', html = '';
  if(code !== base){
    var d = scOtherDiff(base, code, tok);
    if(d.length) html += '<div style="color:var(--bad)">⚠ ' + scEsc(code) + ' differs from ' + scEsc(base) + ' beyond the ' + tok + ' change: ' + scEsc(d.join(', ')) + '. Saving with it changes the AC ellipses beyond this correction.</div>';
    else if(scHasTok(code, tok)) html += '<div>' + (tok === 'AX' ? 'AX swap only (ISCWSA Rev5.13 §6.2.1 short-collar-corrected sensor terms).' : 'MS change only (ISCWSA Rev5 multi-station-corrected magnetometer terms).') + '</div>';
  }
  if(/HRGM/.test(code) && scHasTok(code, tok))
    html += '<div style="color:var(--bad)">⚠ ' + scEsc(code) + ' has not been checked against a Compass .ipm (only MWD+HRGM has).</div>';
  scEl('scCodeWarn').innerHTML = html;
}
async function scConfirmSave(){
  var m = scMatches(); if(!m) return;
  try{
    var r = await fetch('/notes/shortCollar/saveVersion', { method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ noteId: SC_STATE.job.noteId, wellKey: m.well.wellKey, toolcode: scEl('scCode').value, mdTol: m.tol,
        model: SC_STATE.result.main.model, apply: scEl('scApply').value, skipExcluded: m.skip, corrections: m.raw }) });
    var d = await r.json(); if(!d.ok) throw new Error(d.error);
    scEl('scSavePanel').style.display = 'none';
    alert('Saved as "' + d.wellName + '" with toolcode ' + d.toolcode + ' (' + d.matched + ' station(s) corrected' + (d.skipped ? ', ' + d.skipped + ' excluded station(s) copied unchanged' : '') + '). The original survey was not changed.');
  }catch(err){ alert('Save failed: ' + err.message); }
}
</script>
