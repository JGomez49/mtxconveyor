var SC_SETTING_IDS = ['scModel','scRefSrc','scLat','scLon','scHgt','scYear','scBT','scDip','scDec','scBUnit','scUBT','scUDip','scApply','scExMode','scTolBT','scTolDip','scTolGT','scTolBz','scHiU','scMdUnit','scMtxId','scMdTol'];
function scCollectSettings(){
