    var f = 1000 / k, stN = st.map(function(s){ return { md: s.md, gx: s.gx, gy: s.gy, gz: s.gz, bx: s.bx * f, by: s.by * f, bz: s.bz * f }; });
    var q = MsaModel.autoQc(stN, { bt: refBT * f, dipDeg: refDip }, { bt: +scEl('scTolBT').value, dipDeg: tolDip, gt: +scEl('scTolGT').value, bz: +scEl('scTolBz').value });
    auto = q.rows.map(function(r){ return r.fail ? 'trend: ' + r.fail : null; });
  } else auto = st.map(function(){ return null; });
  scCompute(st, manual, auto, { k: k, refBT: refBT, refDip: refDip, dec: dec, uBT: uBT, uDip: uDip });
}
// Runs one model and returns rows in a common shape (B values in the DATA unit).
function scRunModel(model, st, excl, p){
  if(model === 'msa'){
    var f = 1000 / p.k;   // -> nT
    var stN = st.map(function(s){ return { md: s.md, gx: s.gx, gy: s.gy, gz: s.gz, bx: s.bx * f, by: s.by * f, bz: s.bz * f }; });
    var r = MsaModel.run({ stations: stN, ref: { bt: p.refBT * f, dipDeg: p.refDip, decDeg: p.dec }, unc: { bt: p.uBT * f, dipDeg: p.uDip }, exclude: excl, wrapSafe: true });
    r.rows.forEach(function(x, i){ x.bzCorr /= f; x.btMeas /= f; x.btCorr /= f; x.bzMeas = st[i].bz; });
    return { model: 'msa', rows: r.rows, msa: r };
