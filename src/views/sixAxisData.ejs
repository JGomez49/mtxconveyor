  container.querySelectorAll(".qrsRow").forEach((tr) => {
    tr.addEventListener("click", () => {
      const row = rows[parseInt(tr.dataset.rowIndex, 10)];
      const [md, gx, gy, gz, bx, by, bz] = row;

      document.getElementById("mdInput").value = md;
      document.getElementById("gx").value = gx;
      document.getElementById("gy").value = gy;
      document.getElementById("gz").value = gz;
      document.getElementById("bx").value = bx;
      document.getElementById("by").value = by;
      document.getElementById("bz").value = bz;

      document.getElementById("gxUnit").value = "g";
      document.getElementById("gyUnit").value = "g";
      document.getElementById("gzUnit").value = "g";
      document.getElementById("bxUnit").value = "nt";
      document.getElementById("byUnit").value = "nt";
      document.getElementById("bzUnit").value = "nt";

      // Fixed defaults per the person's direction (2026-08-23) — not
      // derived from this row, just kept consistent on every click.
      document.getElementById("refBT").value = "56.7785";
      document.getElementById("refGT").value = "1.0000";
      document.getElementById("refDip").value = "76.12";
      document.getElementById("refDec").value = "11.82";
      document.getElementById("incError").value = "5";
      document.getElementById("dipError").value = "5";
      document.getElementById("azError").value = "5";

      // Added 2026-08-23: the imported file has no Reference INC/AZ column,
      // so a stale value from a previously-selected station (or the page's
      // original demo defaults) would otherwise silently carry over and
      // produce a misleading "zero matches" result. Blank + highlight both
