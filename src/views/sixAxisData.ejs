          <tr><td>Compare Short Collar vs MSA</td><td style="text-align:left;"><label><input type="checkbox" id="scCompare" style="width:auto;"> show both side by side</label></td></tr>
        </table>
        <div class="note" id="scExNote"></div>
      </div>
    </div>
    <button type="button" id="scRunBtn">Run</button>
    <label style="font-size:12px;margin-left:10px;"><input type="checkbox" id="scShowOnPlots" style="width:auto;" checked> Show corrected on QC plots</label>
    <div id="scSummary" class="note"></div>
    <div id="scTableWrap" style="overflow-x:auto;max-height:420px;overflow-y:auto;"></div>
    <div id="scCmpWrap" style="overflow-x:auto;max-height:420px;overflow-y:auto;margin-top:10px;"></div>
    <div id="scActions" style="display:none;margin-top:8px;">
      <button type="button" class="secondary" id="scExportBtn">Export corrected surveys (Excel)</button>
      <div class="panel" style="margin-top:10px;background:var(--panel2);">
        <h3>Save as new version in a job <span id="scSaveModel" style="text-transform:none;"></span></h3>
        <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;">
          <input type="text" id="scMtxId" placeholder="MTX ID" style="width:160px;">
          <button type="button" class="secondary" id="scLoadJobBtn">Load job</button>
