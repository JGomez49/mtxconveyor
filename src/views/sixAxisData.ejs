}
function scRunNow(){
  var rows = SC_STATE.rows;
  var k = scBScale(rows);                         // data B-unit per µT (1 or 1000)
  var refBT = +scEl('scBT').value * k, refDip = +scEl('scDip').value, dec = +scEl('scDec').value;
  if(!(refBT > 0) || !isFinite(refDip)){ alert('Enter the reference BT and Dip.'); return; }
  var uBT = (+scEl('scUBT').value || 0) / 1000 * k, uDip = +scEl('scUDip').value || 0;
  // Y-axis flip into SurQC's frame (see FRAME NOTE above)
  var st = rows.map(function(r){ return { md: +r[0], gx: +r[3], gy: -(+r[2]), gz: +r[1], bx: +r[6], by: -(+r[5]), bz: +r[4] }; });
  var prevManual = SC_STATE.result ? SC_STATE.result.manual : (SC_STATE.pendingManual || []);
  var manual = st.map(function(s){ return prevManual.indexOf(s.md) >= 0; });
  var mode = scEl('scExMode').value, auto;
  var tolBT = (+scEl('scTolBT').value) / 1000 * k, tolDip = +scEl('scTolDip').value;
  if(mode === 'tol'){
    auto = st.map(function(s){ var f = ShortCollarModel.basicQc(s, { bt: refBT, dip: refDip * Math.PI / 180 }, { bt: tolBT, dipRad: tolDip * Math.PI / 180 });
      return f ? 'tol: ' + (f === 'dip' ? 'Dip' : 'BT') : null; });
