    o['Az calc (deg)'] = +scNorm360(R.pageAz[i]).toFixed(4);
    o['Az measured SurQC (deg)'] = +r.azTrue.toFixed(4); o['Az corrected (deg)'] = +r.azTrueCorr.toFixed(4); o['dAz (deg)'] = +r.dAz.toFixed(4);
    o['Az uncertainty +/- (deg)'] = +r.azUnc.toFixed(4);
