        '<td>' + scFmt(s.azTrueCorr, 3) + '</td><td>' + scFmt(a.azTrueCorr, 3) + '</td><td>' + scFmt(s.dAz, 3) + '</td><td>' + scFmt(a.dAz, 3) + '</td><td>' + scFmt(d, 3) + '</td>' +
        '<td' + (s.azUnc > hi ? ' style="color:var(--bad)"' : '') + '>' + scFmt(s.azUnc, 3) + '</td><td' + (a.azUnc > hi ? ' style="color:var(--bad)"' : '') + '>' + scFmt(a.azUnc, 3) + '</td>' +
