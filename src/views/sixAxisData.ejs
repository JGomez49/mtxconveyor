  var model = scEl('scModel').value, other = model === 'msa' ? 'sc' : 'msa';
  var main = scRunModel(model, st, excl, p);
  var cmp = scEl('scCompare').checked ? scRunModel(other, st, excl, p) : null;
  var pageAz = SC_STATE.rows.map(function(r){ return +r[10]; });
  SC_STATE.result = { st: st, main: main, cmp: cmp, res: main, p: p, auto: auto, manualFlags: manual, pageAz: pageAz,
    manual: st.filter(function(s, i){ return manual[i]; }).map(function(s){ return s.md; }) };
