// Unit handling: the page's BT column is µT; auto-detect nT if the median
// measured |B| is > 1000 (no real geomagnetic field exceeds ~70 µT).
function scBScale(rows){
  var u = scEl('scBUnit').value;
  if(u === 'ut') return 1; if(u === 'nt') return 1000;
  var bt = rows.map(function(r){ return Math.hypot(+r[6], +r[5], +r[4]); }).sort(function(a, b){ return a - b; });
  return bt[Math.floor(bt.length / 2)] > 1000 ? 1000 : 1;
