// Renders the imported rows (MD, Gx, Gy, Gz, Bx, By, Bz) as a plain
// clickable table under the Find button — clicking a row fills MD and the
// six raw sensor textboxes above (resetting their unit dropdowns to G/nT,
// the units the imported file's numbers are assumed to already be in,
// same as this tool's own default selects). Magnetic Field/Reference
// DIP/Reference DEC/Gravity Field/the three error margins are left at
// their fixed page defaults — per the person's direction (2026-08-23),
// this page does not compute those per-row (no WMM/lat-long lookup here).
function renderQuickSelectTable(data) {
  const container = document.getElementById("qrsTableContainer");
  const rows = data.slice(1);
  container.innerHTML = `
    <table id="qrsTable">
      <thead><tr><th>MD</th><th>Gx</th><th>Gy</th><th>Gz</th><th>Bx</th><th>By</th><th>Bz</th></tr></thead>
      <tbody>
        ${rows.map((row, i) => `
          <tr class="qrsRow" data-row-index="${i}" style="cursor:pointer;">
            ${row.map((cell, ci) => `<td>${typeof cell === 'number' ? cell.toFixed(ci === 0 ? 2 : 5) : cell}</td>`).join("")}
          </tr>
        `).join("")}
      </tbody>
    </table>
  `;

  container.querySelectorAll(".qrsRow").forEach((tr) => {
    tr.addEventListener("click", () => {
      const row = rows[parseInt(tr.dataset.rowIndex, 10)];
      const [md, gx, gy, gz, bx, by, bz] = row;

      document.getElementById("mdInput").value = md;
      document.getElementById("gx").value = gx;
      document.getElementById("gy").value = gy;
      document.getElementById("gz").value = gz;
      document.getElementById("bx").value = bx;
      document.getElementById("by").value = by;
      document.getElementById("bz").value = bz;

      document.getElementById("gxUnit").value = "g";
      document.getElementById("gyUnit").value = "g";
      document.getElementById("gzUnit").value = "g";
      document.getElementById("bxUnit").value = "nt";
      document.getElementById("byUnit").value = "nt";
      document.getElementById("bzUnit").value = "nt";

      // Fixed defaults per the person's direction (2026-08-23) — not
      // derived from this row, just kept consistent on every click.
      document.getElementById("refBT").value = "56.7785";
      document.getElementById("refGT").value = "1.0000";
      document.getElementById("refDip").value = "76.12";
      document.getElementById("refDec").value = "11.82";
      document.getElementById("incError").value = "5";
      document.getElementById("dipError").value = "5";
      document.getElementById("azError").value = "5";

      // Added 2026-08-23: the imported file has no Reference INC/AZ column,
      // so a stale value from a previously-selected station (or the page's
      // original demo defaults) would otherwise silently carry over and
      // produce a misleading "zero matches" result. Blank + highlight both
      // fields so it's obvious they need the person's own input for this
      // station before clicking Find.
      const refIncEl = document.getElementById("refInc");
      const refAzEl = document.getElementById("refAz");
      refIncEl.value = "";
      refAzEl.value = "";
      refIncEl.classList.add("needs-input");
      refAzEl.classList.add("needs-input");

      container.querySelectorAll(".qrsRow").forEach((r) => r.style.background = "");
      tr.style.background = "var(--panel2)";
    });
  });
}

// Added 2026-08-23: clear the needs-input highlight on Reference INC/AZ
// once the person types a value, so the flag doesn't linger after it's
// been addressed.
["refInc", "refAz"].forEach((id) => {
  const el = document.getElementById(id);
  if (el) {
    el.addEventListener("input", () => el.classList.remove("needs-input"));
  }
});

// Render Imported Data Table with Proper Formatting
function renderImportedTable(data) {
  const container = document.getElementById("importedDataContainer");
  container.innerHTML = `
    <h3>Imported Data</h3>
    <div style="overflow-x:auto;">
    <table id="importedTable">
      <thead>
        <tr>
          ${data[0].map((header) => `<th>${header}</th>`).join("")}
        </tr>
      </thead>
      <tbody>
        ${data.slice(1).map((row) => `
          <tr>
            ${row.map((cell, index) => {
              let num = parseFloat(cell);
              if (isNaN(num)) {
                num = parseFloat(String(cell).replace(/[^0-9.-]/g, ""));
              }
              if (!isNaN(num)) {
                return `<td>${index === 0 ? num.toFixed(2) : num.toFixed(5)}</td>`;
              } else {
                return `<td>${cell}</td>`;
              }
            }).join("")}
          </tr>
        `).join("")}
      </tbody>
    </table>
    </div>
    <br>
    <button id="rearrangeBtn" class="secondary">Rearrange Sensors</button>
    <div id="rearrangedDataContainer"></div>
  `;

  document.getElementById("rearrangeBtn").addEventListener("click", () => {
    rearrangeSensors(data);
  });
}

// Rearrange Sensors Columns and Add New Table with DIP Calculation
function rearrangeSensors(data) {
  const headers = data[0];
  const reorderedHeaders = ["MD", "Gz", "Gy", "Gx", "Bz", "By", "Bx"];

  if (!headers || headers.length === 0) {
    console.error("Headers are not defined or invalid:", headers);
    return;
  }

  const reorderedData = [reorderedHeaders, ...data.slice(1).map((row) => {
    return reorderedHeaders.map((header) => {
      const value = row[headers.indexOf(header)];
      let num = parseFloat(value);
      if (isNaN(num)) {
        num = parseFloat(String(value).replace(/[^0-9.-]/g, ""));
      }
      return !isNaN(num) ? num.toFixed(5) : value;
    });
  })];

  if (!reorderedData || reorderedData.length === 0) {
    console.error("reorderedData is not defined or invalid:", reorderedData);
    return;
  }

  reorderedData[0].push("DIP (deg)", "ToolFace (deg)", "INC (deg)", "AZ (deg)",
                        "GT (G)", "BT (uT)", "Tg", "Th",
                        "Nx", "Ex", "Vx", "Ny", "Ey", "Vy", "Nz", "Ez", "Vz",
                        "tBx", "tBy", "tBz", "tBT", "tdip");

  reorderedData.slice(1).forEach((row) => {
    const gx = parseFloat(row[3]);
    const gy = parseFloat(row[2]);
    const gz = parseFloat(row[1]);
    const bx = parseFloat(row[6]);
    const by = parseFloat(row[5]);
    const bz = parseFloat(row[4]);
    const md = parseFloat(row[0]);

    const gt = Math.sqrt(gx ** 2 + gy ** 2 + gz ** 2);
    const bt = Math.sqrt(bx ** 2 + by ** 2 + bz ** 2);
    const dip = Math.asin((gx * bx + gy * by + gz * bz) / (gt * bt)) * (180 / Math.PI);
    const toolFace = Math.atan2(-gx, -gy) * (180 / Math.PI);
    const inc = Math.acos(gz / gt) * (180 / Math.PI);

    const refDec = parseFloat(document.getElementById("refDec").value);
    const az = refDec + Math.atan2(
      (bx * gy - by * gx),
      (bz * (gx ** 2 + gy ** 2) - gz * (gx * bx + gy * by))
    ) * (180 / Math.PI);

    const tg = Math.sqrt(gy ** 2 + gz ** 2);
    const th = Math.sqrt(by ** 2 + bz ** 2);

    row[0] = md.toFixed(2);
    // 2026-10-25 (John): azimuth shown 0-360 (atan2 gave -180..180 + refDec).
    // Display/normalisation only - same direction, so the unit vectors and
    // theoretical-field columns below (sin/cos of az) are unchanged.
    const az360 = ((az % 360) + 360) % 360;
    row.push(
      dip.toFixed(5),
      toolFace.toFixed(5),
      inc.toFixed(2),
      az360.toFixed(2),
      gt.toFixed(5),
      bt.toFixed(5),
      tg.toFixed(5),
      th.toFixed(5)
    );
  });

  reorderedData.slice(1).forEach((row) => {
    const inc = parseFloat(row[9]) * (Math.PI / 180);
    const az = parseFloat(row[10]) * (Math.PI / 180);
    const tf = parseFloat(row[8]) * (Math.PI / 180);
    const gx = parseFloat(row[3]) * (Math.PI / 180);
    const gy = parseFloat(row[2]) * (Math.PI / 180);
    const gz = parseFloat(row[1]) * (Math.PI / 180);
    const gt = Math.sqrt(gx ** 2 + gy ** 2 + gz ** 2);

    const Nx = Math.cos(inc) * Math.cos(az) * Math.sin(tf) + Math.sin(az) * Math.cos(tf);
    const Ex = Math.cos(inc) * Math.sin(az) * Math.sin(tf) - Math.cos(az) * Math.cos(tf);
    const Vx = -Math.sin(inc) * Math.sin(tf);

    const Ny = Math.cos(inc) * Math.cos(az) * Math.cos(tf) - Math.sin(az) * Math.sin(tf);
    const Ey = Math.cos(inc) * Math.sin(az) * Math.cos(tf) + Math.cos(az) * Math.sin(tf);
    const Vy = -Math.sin(inc) * Math.cos(tf);

    const Nz = Math.sin(inc) * Math.cos(az);
    const Ez = Math.sin(inc) * Math.sin(az);
    const Vz = Math.cos(inc);

    const cosI = Math.cos(inc);
    const sinI = Math.sin(inc);
    const cosA = Math.cos(az);
    const sinA = Math.sin(az);
    const cosT = Math.cos(tf);
    const sinT = Math.sin(tf);

    const MagN = parseFloat(document.getElementById("MagNValue").innerHTML);
    const MagE = parseFloat(document.getElementById("MagEValue").innerHTML);
    const MagV = parseFloat(document.getElementById("MagVValue").innerHTML);

    const tBx = (cosI * cosA * sinT + sinA * cosT) * MagN
              + (cosI * sinA * sinT - cosA * cosT) * MagE
              - sinI * sinT * MagV;
    const tBy = (cosI * cosA * cosT - sinA * sinT) * MagN
              + (cosI * sinA * cosT + cosA * sinT) * MagE
              - sinI * cosT * MagV;
    const tBz = (sinI * cosA) * MagN
              + (sinI * sinA) * MagE
              + cosI * MagV;

    const tBT = Math.sqrt(tBx ** 2 + tBy ** 2 + tBz ** 2);
    const tdip = Math.asin((gx * tBx + gy * tBy + gz * tBz) / (gt * tBT)) * (180 / Math.PI);

    row.push(
      Nx.toFixed(5), Ex.toFixed(5), Vx.toFixed(5),
      Ny.toFixed(5), Ey.toFixed(5), Vy.toFixed(5),
      Nz.toFixed(5), Ez.toFixed(5), Vz.toFixed(5),
      tBx.toFixed(5), tBy.toFixed(5), tBz.toFixed(5),
      tBT.toFixed(5), tdip.toFixed(5)
    );
  });

  const rearrangedContainer = document.getElementById("rearrangedDataContainer");
  rearrangedContainer.innerHTML = `
    <h3>Rearranged Data with Unit Vectors</h3>
    <div style="overflow-x:auto;">
    <table id="rearrangedTable">
      <thead>
        <tr>${reorderedData[0].map((header) => `<th>${header}</th>`).join("")}</tr>
      </thead>
      <tbody>
        ${reorderedData.slice(1).map((row) => `<tr>${row.map((cell) => `<td>${cell}</td>`).join("")}</tr>`).join("")}
      </tbody>
    </table>
    </div>
    <br>
    <!-- Added 2026-10-25: Short Collar Correction accordion sits between the
         rearranged table and Show Plots, so the QC plots can overlay the
         corrected points (see scMountPanel / scOverlay below). -->
    <div id="scMount"></div>
    <button id="showPlotsBtn" class="secondary">Show Plots</button>
  `;

  scMountPanel(reorderedData.slice(1));
  document.getElementById("showPlotsBtn").addEventListener("click", () => {
    generatePlots(reorderedData.slice(1));
  });
}

// Display Results in Table
function displayResults(results, originalSet) {
  const resultsTableBody = document.querySelector("#resultsTable tbody");
  resultsTableBody.innerHTML = "";

  const comparisonTableBody = document.querySelector("#comparisonTable tbody");
  comparisonTableBody.innerHTML = "";

  function fillComparisonTable(result) {
    const originalRow = document.createElement("tr");
    originalRow.innerHTML = originalSet.map((value) =>
      `<td>${value.toFixed(5)}</td>`
    ).join("");

    const newRow = document.createElement("tr");
    const newValues = [result.gx, result.gy, result.gz, result.bx, result.by, result.bz];
    newRow.innerHTML = newValues.map((value) =>
      `<td>${value.toFixed(5)}</td>`
    ).join("");

    const indexRow = document.createElement("tr");
    const indices = newValues.map(value =>
      originalSet.findIndex(origValue => Math.abs(Math.abs(origValue) - Math.abs(value)) < 0.00001) + 1
    );
    indexRow.innerHTML = indices.map(index => `<td>${index || "N/A"}</td>`).join("");

    const divisionRow = document.createElement("tr");
    divisionRow.innerHTML = indices.map((index, col) =>
      index ? `<td>${(newValues[col] / originalSet[index - 1]).toFixed(0)}</td>` : "<td>N/A</td>"
    ).join("");

    comparisonTableBody.append(originalRow, newRow, indexRow, divisionRow);
  }

  results.forEach((result) => {
    const row = document.createElement("tr");
    row.innerHTML = `
      <td>${result.gx.toFixed(5)}</td>
      <td>${result.gy.toFixed(5)}</td>
      <td>${result.gz.toFixed(5)}</td>
      <td>${result.bx.toFixed(5)}</td>
      <td>${result.by.toFixed(5)}</td>
      <td>${result.bz.toFixed(5)}</td>
      <td>${result.inc.toFixed(5)}</td>
      <td>${result.az.toFixed(5)}</td>
      <td>${result.dip.toFixed(5)}</td>
    `;
    resultsTableBody.appendChild(row);

    if (comparisonTableBody.children.length === 0) {
      fillComparisonTable(result);
    }
  });

  // Added 2026-08-23: when nothing is within tolerance, show the single
  // closest-scoring combination anyway (labeled "outside tolerance", with
  // its Delta Dip/Inc/Az) instead of leaving all tables blank with no
  // explanation — per the person's approved fix for the empty-results
  // report on 2026-08-23.
  if (results.length === 0 && results.closest) {
    const c = results.closest;
    const row = document.createElement("tr");
    row.style.color = "var(--bad)";
    row.title = "Outside tolerance — closest combination found across all 48 permutations.";
    row.innerHTML = `
      <td>${c.gx.toFixed(5)}</td>
      <td>${c.gy.toFixed(5)}</td>
      <td>${c.gz.toFixed(5)}</td>
      <td>${c.bx.toFixed(5)}</td>
      <td>${c.by.toFixed(5)}</td>
      <td>${c.bz.toFixed(5)}</td>
      <td>${c.inc.toFixed(5)}</td>
      <td>${c.az.toFixed(5)}</td>
      <td>${c.dip.toFixed(5)}</td>
    `;
    resultsTableBody.appendChild(row);

    const noteRow = document.createElement("tr");
    noteRow.style.color = "var(--muted)";
    noteRow.innerHTML = `<td colspan="9" style="font-size:11px;">Outside tolerance (closest match shown above) — &Delta;Dip=${c.dDip.toFixed(3)}&deg;, &Delta;Inc=${c.dInc.toFixed(3)}&deg;, &Delta;Az=${c.dAz.toFixed(3)}&deg;. Widen the error tolerances or check Reference INC/AZ/DIP.</td>`;
    resultsTableBody.appendChild(noteRow);

    fillComparisonTable(c);
  }
}

// Function to generate plots
function generatePlots(data) {
  const md = data.map(row => parseFloat(row[0]));
  const gx = data.map(row => parseFloat(row[3]));
  const gy = data.map(row => parseFloat(row[2]));
  const gz = data.map(row => parseFloat(row[1]));
  const bx = data.map(row => parseFloat(row[6]));
  const by = data.map(row => parseFloat(row[5]));
  const bz = data.map(row => parseFloat(row[4]));
  const gt = data.map(row => parseFloat(row[11]));
  const bt = data.map(row => parseFloat(row[12]));
  const Tg = data.map(row => parseFloat(row[13]));
  const Th = data.map(row => parseFloat(row[14]));
  const Dip = data.map(row => parseFloat(row[7]));
  const TF = data.map(row => parseFloat(row[8]));
  const inc = data.map(row => parseFloat(row[9]));
  const az = data.map(row => parseFloat(row[10]));

  // Added 2026-08-23: remove the whole QC Plots panel (not just the inner
  // container) before rebuilding, so re-running Show Plots doesn't stack
  // duplicate "QC Plots" headers/toggles.
  let existingPlotsPanel = document.getElementById("qcPlotsPanel");
  if (existingPlotsPanel) {
    existingPlotsPanel.remove();
  }

  const plotsPanel = document.createElement("div");
  plotsPanel.className = "panel";
  plotsPanel.id = "qcPlotsPanel";
  plotsPanel.innerHTML = `
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;">
      <h2 style="margin:0;">QC Plots</h2>
      <label style="display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text);cursor:pointer;">
        <input type="checkbox" id="qcPlotLinesToggle" style="width:auto;">
        Lines + Dots (uncheck for Dots only)
      </label>
    </div>
  `;
  const plotsContainer = document.createElement("div");
  plotsContainer.id = "plotsContainer";
  plotsPanel.appendChild(plotsContainer);
  document.querySelector(".wrap").appendChild(plotsPanel);

  // Added 2026-08-23: dots-only vs lines+dots toggle for every QC plot,
  // defaulting to Dots only per the person's direction. Uses Plotly's
  // own restyle (no data refetch/re-import, no TF re-optimization) so
  // toggling is instant and doesn't disturb anything else on the page.
  document.getElementById("qcPlotLinesToggle").addEventListener("change", (e) => {
    const mode = e.target.checked ? "lines+markers" : "markers";
    QC_PLOT_IDS.forEach((id) => {
      if (document.getElementById(id)) {
        Plotly.restyle(id, { mode: [mode] });
      }
    });
  });

  const plotLayout = {
    paper_bgcolor: "#1e232b", plot_bgcolor: "#1e232b",
    font: { color: "#e6e9ef", size: 10 },
    margin: { l: 40, r: 10, t: 30, b: 30 }
  };

  // Added 2026-08-23, per the person's direction: on the three "vs MD" QC
  // plots for which a physical tolerance exists (GT, BT, Dip), draw a
  // reference line at the live Reference value plus a green tolerance band
  // (ref +/- 1x tolerance shaded, dashed lines at +/- 1x) and fix the
  // y-axis range to ref +/- 3x tolerance so the plot is centered on the
  // reference regardless of the data spread. Tolerances are fixed
  // QC-plot-specific constants (person's own instrument-spec numbers, not
  // tied to the Find-tab incError/dipError/azError fields, which are for a
  // different comparison): GT +/-0.0025 G, BT +/-300 nT (=0.3 uT, since
  // this page's BT column is in uT), DIP +/-0.3 deg. Reference values are
  // read live from the refGT/refBT/refDip Input Data fields at plot-build
  // time (per the person's choice), so they track whatever the person has
  // entered rather than a hardcoded constant.
  const refGTLive = parseFloat(document.getElementById("refGT").value);
  const refBTLive = parseFloat(document.getElementById("refBT").value);
  const refDipLive = parseFloat(document.getElementById("refDip").value);

  const TOL_GT = 0.0025;   // G
  const TOL_BT = 0.3;      // uT (300 nT)
  const TOL_DIP = 0.3;     // deg

  const plotData = [
    { y: gx, x: md, title: "Gx vs MD", id: "plot1" },
    { y: bx, x: md, title: "Bx vs MD", id: "plot2" },
    { y: gy, x: md, title: "Gy vs MD", id: "plot3" },
    { y: by, x: md, title: "By vs MD", id: "plot4" },
    { y: gz, x: md, title: "Gz vs MD", id: "plot5" },
    { y: bz, x: md, title: "Bz vs MD", id: "plot6" },
    { y: gt, x: md, title: "GT vs MD", id: "plot7", ref: refGTLive, tol: TOL_GT },
    { y: bt, x: md, title: "BT vs MD", id: "plot8", ref: refBTLive, tol: TOL_BT },
    { y: Tg, x: md, title: "Tg vs MD", id: "plot9" },
    { y: Th, x: md, title: "Th vs MD", id: "plot10" },
    { y: Dip, x: md, title: "Dip vs MD", id: "plot11", ref: refDipLive, tol: TOL_DIP },
    { y: TF, x: md, title: "TF vs MD", id: "plot12" },
    { y: gx, x: TF, title: "Gx vs TF", id: "plot13" },
    { y: bx, x: TF, title: "Bx vs TF", id: "plot14" },
    { y: gy, x: TF, title: "Gy vs TF", id: "plot15" },
    { y: by, x: TF, title: "By vs TF", id: "plot16" },
    { y: gz, x: TF, title: "Gz vs TF", id: "plot17" },
    { y: bz, x: TF, title: "Bz vs TF", id: "plot18" },
    { y: gx, x: gy, title: "Gx vs Gy", id: "plot19" },
    { y: bx, x: by, title: "Bx vs By", id: "plot20" },
    { y: Dip, x: TF, title: "TF vs Dip", id: "plot21", ref: refDipLive, tol: TOL_DIP },
    { y: bt, x: TF, title: "TF vs BT", id: "plot22", ref: refBTLive, tol: TOL_BT },
    { y: inc, x: md, title: "INC vs MD", id: "plot23" },
    { y: az, x: md, title: "AZ vs MD", id: "plot24" },
  ];

  QC_PLOT_IDS = plotData.map((plot) => plot.id);

  plotData.forEach((plot) => {
    const plotDiv = document.createElement("div");
    plotDiv.id = plot.id;
    plotDiv.style.height = "260px";
    plotsContainer.appendChild(plotDiv);

    const layout = Object.assign({}, plotLayout, {
      title: { text: plot.title, font: { size: 11 } },
      yaxis: { title: plot.title.split(" vs ")[0] }
    });

    if (typeof plot.ref === "number" && !isNaN(plot.ref) && typeof plot.tol === "number") {
      const ref = plot.ref;
      const tol = plot.tol;
      layout.yaxis = Object.assign({}, layout.yaxis, { range: [ref - 3 * tol, ref + 3 * tol] });
      layout.shapes = [
        // Green tolerance band: ref +/- 1x tolerance
        {
          type: "rect", xref: "paper", x0: 0, x1: 1,
          yref: "y", y0: ref - tol, y1: ref + tol,
          fillcolor: "rgba(46,204,113,0.15)", line: { width: 0 }, layer: "below"
        },
        // Reference line
        {
          type: "line", xref: "paper", x0: 0, x1: 1,
          yref: "y", y0: ref, y1: ref,
          line: { color: "#4da3ff", width: 1.5, dash: "solid" }
        },
        // Tolerance boundary dashed lines
        {
          type: "line", xref: "paper", x0: 0, x1: 1,
          yref: "y", y0: ref - tol, y1: ref - tol,
          line: { color: "#2ecc71", width: 1, dash: "dash" }
        },
        {
          type: "line", xref: "paper", x0: 0, x1: 1,
          yref: "y", y0: ref + tol, y1: ref + tol,
          line: { color: "#2ecc71", width: 1, dash: "dash" }
        }
      ];
    }

    Plotly.newPlot(plot.id, [{
      x: plot.x,
      y: plot.y,
      type: "scatter",
      // Added 2026-08-23: default to lines+markers per the person's
      // direction; defaults to Dots only (2026-08-23 change) — the
      // qcPlotLinesToggle checkbox above restyles this in place afterward.
      mode: "markers",
      line: { color: "#4da3ff", width: 1 },
      marker: { color: "#4da3ff", size: 5 },
      name: plot.title
    }], layout);
  });

  // Added 2026-10-25: overlay Short Collar corrected points (if computed
  // and the accordion's "Show corrected on QC plots" box is ticked).
  scOverlay();

  optimizeBiasAndScaleWithTF();
}

// Function to extract all data from the rearranged table
function getTableData() {
  const table = document.getElementById("rearrangedTable");
  if (!table) {
    console.error("Table with id 'rearrangedTable' not found.");
    return [];
  }

  const headers = Array.from(table.querySelectorAll("thead th")).map(th => th.innerText.trim());
  const rows = Array.from(table.querySelectorAll("tbody tr"));

  const data = rows.map(row => {
    const cells = row.querySelectorAll("td");
    let rowData = {};

    cells.forEach((cell, index) => {
      rowData[headers[index]] = parseFloat(cell.innerText) || cell.innerText.trim();
    });

    return rowData;
  });

  return data;
}

async function optimizeBiasAndScaleWithTF() {
  const tableData = getTableData();
  if (tableData.length === 0) {
    console.error("Table data is empty.");
    return;
  }

  const observedObjects = tableData.map(row => ({
    Bx: row["Bx"],
    By: row["By"],
    Bz: row["Bz"]
  }));

  const theoreticalObjects = tableData.map(row => ({
    tBx: row["tBx"],
    tBy: row["tBy"],
    tBz: row["tBz"]
  }));

  function trainModel(observedValues, theoreticalValues) {
    return new Promise((resolve) => {
      const xs = tf.tensor1d(observedValues);
      const ys = tf.tensor1d(theoreticalValues);

      const bias = tf.variable(tf.scalar(0, "float32"));
      const scale = tf.variable(tf.scalar(1, "float32"));

      function loss() {
        const predictions = xs.mul(scale).add(bias);
        return predictions.sub(ys).square().mean();
      }

      const optimizer = tf.train.sgd(0.0001);

      async function train() {
        for (let i = 0; i < 1000; i++) {
          optimizer.minimize(loss);
        }

        const bestBias = bias.dataSync()[0];
        const bestScale = scale.dataSync()[0];

        resolve({ bestBias, bestScale });
      }

      train();
    });
  }

  const observedBx = observedObjects.map(row => row.Bx);
  const observedBy = observedObjects.map(row => row.By);
  const observedBz = observedObjects.map(row => row.Bz);

  const theoreticalBx = theoreticalObjects.map(row => row.tBx);
  const theoreticalBy = theoreticalObjects.map(row => row.tBy);
  const theoreticalBz = theoreticalObjects.map(row => row.tBz);

  const [optimalBx, optimalBy, optimalBz] = await Promise.all([
    trainModel(observedBx, theoreticalBx),
    trainModel(observedBy, theoreticalBy),
    trainModel(observedBz, theoreticalBz)
  ]);

  console.log("Optimal Bias and Scale (TensorFlow.js):");
  console.log("Bx:", optimalBx);
  console.log("By:", optimalBy);
  console.log("Bz:", optimalBz);

  const correctedObservations = observedObjects.map(obs => ({
    Bx: (obs.Bx * optimalBx.bestScale) + optimalBx.bestBias,
    By: (obs.By * optimalBy.bestScale) + optimalBy.bestBias,
    Bz: (obs.Bz * optimalBz.bestScale) + optimalBz.bestBias
  }));

  console.log("Corrected Observations (TensorFlow.js):", correctedObservations);
}
</script>
<script>
// =====================================================================
// Short Collar / MSA Correction accordion
// (Short Collar added 2026-10-25; MSA, trend exclusion and side-by-side
//  comparison added 2026-10-25 per John — strictly one model at a time.)
// ---------------------------------------------------------------------
// Engines (SurQC ports, validated against the real SurQC classes compiled
// headless — max diff 1e-13 deg; see claude/shortcollar-status.md):
//   public/js/shortCollarModel.js  ShortCollar / ShortCollarAnalysis /
//                                  AnalysisWithUncertainty / BasicQc
//   public/js/msaModel.js          MultiStationAnalysis / MSAWithUncertainty /
//                                  AutoQc (trend exclusion)
//
// FRAME NOTE (verified numerically 2026-10-25): SurQC's sensor frame is
// the mirror image of this page's mapped frame — on identical numbers
// SurQC's azimuth = -(this page's AZ formula). The page's mapped data are
// therefore fed to SurQC with Gy and By negated (a Y-axis flip). Inc,
// BT, dip and Bz are unaffected; the azimuth then matches the page's AZ
// column on clean data to 1e-13 deg. For MSA the fitted Y bias is reported
// back in the PAGE frame (sign flipped; scale factors are unaffected).
//
// Short Collar: each station gets its OWN Z-bias (SurQC); exclusions only
// drop stations out of the AVERAGE (optionally applied to all instead).
// MSA: one set of 6 magnetometer biases/scale factors fitted on the
// non-excluded stations (and Gx=Gy=0 stations, SurQC rule), applied to ALL.
// Units: MSA runs in nT (SurQC step sizes are nT) — µT data are converted.
// Exclusion modes (2026-10-25, John): manual ticks always; automatic =
// none / tolerance (SurQC BasicQc) / trend (SurQC AutoQc).
// =====================================================================
var SC_STATE = { rows: null, result: null, job: null };
var SC_PENDING_SETTINGS = (typeof SC_PENDING_SETTINGS !== 'undefined') ? SC_PENDING_SETTINGS : null;
var SC_TOOLCODES = null, SC_ORIG_CODE = '';
var SC_MODEL_NAME = { sc: 'Short Collar', msa: 'MSA' };
function scEl(id){ return document.getElementById(id); }
function scNorm360(a){ return ((a % 360) + 360) % 360; } // all displayed azimuths 0-360
function scFmt(v, d){ return (v == null || !isFinite(v)) ? '' : (+v).toFixed(d); }
function scEsc(t){ return String(t).replace(/[&<>"]/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]; }); }

function scMountPanel(rows){
  SC_STATE.rows = rows; SC_STATE.result = null;
  var m = scEl('scMount'); if(!m) return;
  var refBT = scEl('refBT').value, refDip = scEl('refDip').value, refDec = scEl('refDec').value;
  var today = new Date(), dy = today.getFullYear() + (today - new Date(today.getFullYear(),0,1)) / 864e5 / 365.25;
  m.innerHTML = `
  <details class="panel" id="scDetails" open style="margin-top:12px;">
    <summary style="cursor:pointer;font-size:13px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);">Survey Correction — Short Collar / MSA</summary>
    <div class="grid-2" style="margin-top:10px;">
      <div>
        <table>
          <tr><td>Model</td><td><select id="scModel"><option value="sc">Short Collar (SurQC)</option><option value="msa">MSA — Multi-Station Analysis (SurQC)</option></select></td></tr>
