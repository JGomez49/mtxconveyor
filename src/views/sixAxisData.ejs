// Added 2026-08-24: "Download Case PDF" — a single PDF covering the
// current on-page state (Input Data, the Sensor Mapping table, any
// Imported/Rearranged Data tables, and every QC plot), each part starting
// on its own page with a bookmark/outline entry so it reads like tabs in
// a PDF viewer. Per the person's direction, the "Valid Combinations
// (within tolerance)" and "MSA-Corrected (reserved)" tables are
// deliberately EXCLUDED from this export.
const INPUT_DATA_PDF_ROWS = [
  ["mdInput", "MD", "m"],
  ["gx", "Gx", "gxUnit"], ["gy", "Gy", "gyUnit"], ["gz", "Gz", "gzUnit"],
  ["bx", "Bx", "bxUnit"], ["by", "By", "byUnit"], ["bz", "Bz", "bzUnit"],
  ["refBT", "Magnetic Field (BT)", "uT"],
  ["refGT", "Gravity Field (GT)", "G"],
  ["refInc", "Reference INC", "deg"],
  ["refAz", "Reference AZ", "deg"],
  ["refDip", "Reference DIP", "deg"],
  ["refDec", "Reference DEC", "deg"],
  ["incError", "INC Error", "deg"],
  ["dipError", "DIP Error", "deg"],
  ["azError", "AZ Error", "deg"],
];

function buildInputDataPdfRows() {
  return INPUT_DATA_PDF_ROWS.map(([id, label, unitOrUnitId]) => {
    const el = document.getElementById(id);
    const value = el ? el.value : "";
    let unit = unitOrUnitId;
    const unitEl = document.getElementById(unitOrUnitId);
    if (unitEl) unit = unitEl.value;
    return [label, value, unit];
  });
}

document.getElementById("downloadCasePdfBtn").addEventListener("click", async () => {
  if (!window.jspdf || !window.jspdf.jsPDF) {
    alert("PDF library did not load — check your internet connection and try again.");
    return;
  }
  const { jsPDF } = window.jspdf;
  // Fixed 2026-08-24: Rearranged Data has ~28 columns (MD/Gx/Gy/Gz/Bx/By/Bz
  // + DIP/ToolFace/INC/AZ/GT/BT/Tg/Th + 9 unit-vector columns + 5
  // theoretical t-columns). On a portrait page autoTable was squeezing
  // every column to a sliver, wrapping headers/values into single
  // characters. Landscape gives ~30% more width, and horizontalPageBreak
  // (below) spills the rest onto continuation pages instead of forcing
  // an unreadable squeeze.
  const doc = new jsPDF({ unit: "pt", format: "letter", orientation: "landscape" });
  const outline = [];
  let pageStarted = false;

  function startSection(title) {
    if (pageStarted) doc.addPage();
    pageStarted = true;
    doc.setFontSize(16);
    doc.setTextColor(20, 20, 20);
    doc.text(title, 40, 50);
    outline.push({ title, page: doc.internal.getNumberOfPages() });
    return 70;
  }

  const caseSelectEl = document.getElementById("caseSelect");
  const selectedCaseLabel = caseSelectEl && caseSelectEl.value
    ? caseSelectEl.options[caseSelectEl.selectedIndex].textContent
    : "(unsaved / current page state)";

  // Section: Input Data
  let y = startSection("Input Data");
  doc.setFontSize(10);
  doc.setTextColor(100, 100, 100);
  doc.text(`Case: ${selectedCaseLabel}`, 40, 65);
  doc.autoTable({
    startY: y + 10,
    head: [["Field", "Value", "Unit"]],
    body: buildInputDataPdfRows(),
    styles: { fontSize: 9 },
    headStyles: { fillColor: [30, 35, 43] },
  });

  // Section: Sensor Mapping (renamed 2026-08-24 from "Comparison...") —
  // only if it actually has rows (i.e. Find has been run at least once).
  const comparisonBody = document.querySelector("#comparisonTable tbody");
  if (comparisonBody && comparisonBody.children.length) {
    startSection("Sensor Mapping");
    doc.autoTable({ startY: 70, html: "#comparisonTable", styles: { fontSize: 8 } });
  }

  // Section: Imported Data (raw uploaded rows, Multi-Station Import panel)
  const importedTable = document.getElementById("importedTable");
  if (importedTable) {
    startSection("Imported Data");
    doc.autoTable({ startY: 70, html: "#importedTable", styles: { fontSize: 7 } });
  }

  // Section: Rearranged Data with Unit Vectors — wide (~28 columns), so it
  // uses horizontalPageBreak to spill onto continuation pages at a
  // readable font size instead of being squeezed onto one page (the
  // "funky"/character-wrapped look reported 2026-08-24). Column 0 (MD) is
  // repeated on every continuation page for context.
  const rearrangedTable = document.getElementById("rearrangedTable");
  if (rearrangedTable) {
    startSection("Rearranged Data with Unit Vectors");
    doc.autoTable({
      startY: 70,
      html: "#rearrangedTable",
      styles: { fontSize: 7, cellPadding: 2, overflow: "linebreak" },
      headStyles: { fontSize: 7 },
      horizontalPageBreak: true,
      horizontalPageBreakRepeat: 0,
    });
  }

  // Section: every QC plot, one per page, as a PNG snapshot via Plotly.
  for (const plotId of QC_PLOT_IDS) {
    const plotEl = document.getElementById(plotId);
    if (!plotEl || !plotEl.data) continue; // not drawn (e.g. Plotly not loaded on this element)
    let imgData;
    try {
      imgData = await Plotly.toImage(plotEl, { format: "png", width: 900, height: 500 });
    } catch (err) {
      console.warn(`[Case PDF] could not snapshot plot ${plotId}`, err);
      continue;
    }
    const title = (plotEl.layout && plotEl.layout.title && plotEl.layout.title.text) || plotId;
    startSection(title);
    // Sized/positioned for the landscape page (792x612pt) added 2026-08-24;
    // keeps the plot's 900x500 (9:5) aspect ratio.
    doc.addImage(imgData, "PNG", 40, 75, 700, 389);
  }

  // Bookmark/outline entries so the PDF's own navigation panel jumps
  // straight to each section, like tabs. jsPDF's outline plugin is part
  // of the core UMD bundle as of 2.5.x; if a future/older build doesn't
  // have it, fail soft rather than blocking the download.
  try {
    if (doc.outline && typeof doc.outline.add === "function") {
      outline.forEach((sec) => {
        doc.outline.add(null, sec.title, { pageNumber: sec.page });
      });
    }
  } catch (err) {
    console.warn("[Case PDF] outline/bookmarks not supported in this jsPDF build", err);
  }

  const fileName = (caseSelectEl && caseSelectEl.value
    ? caseSelectEl.options[caseSelectEl.selectedIndex].textContent.split(" — ")[0]
    : "6-axis-case").replace(/[^\w\- ]+/g, "").trim() || "6-axis-case";
  doc.save(`${fileName}.pdf`);
});

function pickAndImportExcelFile(onData) {
  const input = document.createElement("input");
  input.type = "file";
  input.accept = ".xlsx, .xls";
  input.addEventListener("change", async (event) => {
    const file = event.target.files[0];
    if (!file) return;
    const data = await file.arrayBuffer();
    const workbook = XLSX.read(data, { type: "array" });
    const sheetName = workbook.SheetNames[0];
    const sheet = workbook.Sheets[sheetName];
    const json = XLSX.utils.sheet_to_json(sheet, { header: 1 });

    const headers = json[0];
    if (headers.join(",") !== "MD,Gx,Gy,Gz,Bx,By,Bz") {
      alert("The file must have these columns: MD, Gx, Gy, Gz, Bx, By, Bz.");
      return;
    }

    LAST_IMPORTED_ROWS = json;
    onData(json);
  });
  input.click();
}

function useAlreadyUploaded(onData) {
  if (!LAST_IMPORTED_ROWS) {
    alert("Nothing imported yet in this session — use an \"Import Excel File\" button first.");
    return;
  }
  onData(LAST_IMPORTED_ROWS);
}

