  var on = scEl('scShowOnPlots').checked, tf = SC_STATE.rows.map(function(r){ return +r[8]; });
  var sets = [{ res: R.main, color: R.main.model === 'sc' ? '#ffb84d' : '#c77dff' }];
  if(R.cmp) sets.push({ res: R.cmp, color: R.cmp.model === 'sc' ? '#ffb84d' : '#c77dff' });
  var ids = ['plot6', 'plot8', 'plot11', 'plot18', 'plot21', 'plot22', 'plot24'];
  ids.forEach(function(id){
    var d = document.getElementById(id); if(!d || !d.data) return;
