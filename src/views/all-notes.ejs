        [ 'Prospect Name',       'well'       ],   // shown as "Well" in tooltip
        [ 'DP Current Plan',     'dp'         ],
        [ 'DP Type',             'type'       ],
        [ 'Rig Duration',        'duration'   ],
        [ 'Exploration VP',      'vp'         ],
        [ 'Exploration Mgr',     'explMgr'    ],
        [ 'Est. Start Date',     'start'      ],
        [ 'DP Company Name',     'dpCompany'  ],
        [ 'DP Drill Approved',   'drillok'    ],
        [ 'DP Geol Approved',    'geook'      ],
        [ 'Expl. Cust. Group',   'group'      ],
        [ 'DP Request Date',     'dpReq'      ],
        [ 'Responsible Geology', 'geo'        ],
        [ 'DP Design',           'version'    ],
        [ 'DP Received Date',    'dpReceivedDate' ],
        [ 'Primary Zone',        'primaryZone' ],
        [ 'Rig',                 'rig'        ],   // exact-ish, exclude "Rig Duration"
        [ 'Surface Lat',         'surfaceLat' ],
        [ 'Surface Long',        'surfaceLon' ],
    ];

    function nsBuildColMap(headers){
        const colMap = {};
        headers.forEach((h, i) => {
            const hStr = String(h || '').trim();
            if(!hStr) return;
            for(const [substr, field] of NS_HEADER_MAP){
                if(colMap[field] !== undefined) continue;
                if(hStr.toLowerCase().includes(substr.toLowerCase())){
                    if(field === 'rig' && hStr.toLowerCase().includes('duration')) continue;
                    colMap[field] = i;
                }
            }
        });
        return colMap;
    }

    // Same normalisation the old Schedule upload applies client-side, so
    // downstream colour/glow logic (which checks exact "YES-Drill" etc.)
    // behaves identically for the New Schedule chart.
    function nsApprovalLabel(raw, suffix){
        const v = String(raw ?? '').trim();
        return v ? ('YES-' + suffix) : ('NO-' + suffix);
    }

    // Treats blank, whitespace-only, and common placeholder values
    // ("***", "N/A", "NA", "-", "--", "N.A.") as an empty date field.
    // Used for the FINAL + DP-Requested-but-not-Received orange rule below.
    function nsIsEmptyDateField(raw){
        const v = String(raw ?? '').trim().toUpperCase();
        if(v === '') return true;
        const placeholders = ['***', 'N/A', 'NA', '-', '--', 'N.A.'];
        return placeholders.includes(v);
    }

    function buildNewScheduleGanttBars(){
        ganttAllBars2 = [];
        const dataEl = document.getElementById('newScheduleGanttData');
        if(!dataEl) return;
        let parsed;
        try { parsed = JSON.parse(dataEl.textContent); } catch(e){ console.warn('newScheduleGanttData parse error:', e); return; }
        const headers = parsed.headers || [];
        const rows    = parsed.rows    || [];
        if(!headers.length || !rows.length) return;

        const colMap = nsBuildColMap(headers);
        const get = (row, field) => (colMap[field] !== undefined) ? row[colMap[field]] : '';

        rows.forEach(row => {
            const rig = String(get(row,'rig') || '').trim();
            if(!rig) return;
            const site = String(get(row,'site') || '').trim();
            const startRaw = get(row,'start');
            const start = startRaw ? new Date(startRaw) : null;

            ganttAllBars2.push({
                rig,
                drillok: nsApprovalLabel(get(row,'drillok'), 'Drill'),
                geook:   nsApprovalLabel(get(row,'geook'),   'Geo'),
                dp:      String(get(row,'dp') || ''),
                type:    String(get(row,'type') || ''),
                duration: Number(get(row,'duration')) || 0,
                vp:      String(get(row,'vp') || ''),
                year:    start ? String(start.getFullYear()) : '',
                explMgr: String(get(row,'explMgr') || ''),
                start,
                site,
                well:    String(get(row,'well') || ''),
                dpCompany: String(get(row,'dpCompany') || ''),
                ETS:     String(get(row,'ETS') || ''),
                group:   String(get(row,'group') || '').substring(0,2),
                dpReq:   get(row,'dpReq') ? String(get(row,'dpReq')).slice(0,10) : '',
                geo:     String(get(row,'geo') || ''),
                version: String(get(row,'version') || ''),
                dpReceivedDate: get(row,'dpReceivedDate') ? String(get(row,'dpReceivedDate')).slice(0,10) : '',
                primaryZone: String(get(row,'primaryZone') || ''),
                surfaceLat: get(row,'surfaceLat') !== '' ? Number(get(row,'surfaceLat')) : null,
                surfaceLon: get(row,'surfaceLon') !== '' ? Number(get(row,'surfaceLon')) : null,
                de: (ganttNotesMap[site.slice(0,14)] || {}).de || '',
            });
        });

        // Same Batch Days pre-bar logic as the original Gantt.
        (function applyBatchDaysStretch2(){
            const bySite = {};
            ganttAllBars2.forEach(function(bar, idx){
                if(!bar.site || !bar.start) return;
                const key = bar.site.slice(0,14);
                if(!bySite[key]) bySite[key] = [];
                bySite[key].push(idx);
            });
            const newBars = [];
            Object.keys(bySite).forEach(function(siteKey){
                const meta = ganttNotesMap[siteKey];
                const batchDays = meta ? Number(meta.batchDays) || 0 : 0;
                if(!batchDays) return;
                const idxs = bySite[siteKey];
                let earliestIdx = idxs[0];
                idxs.forEach(function(idx){
                    if(ganttAllBars2[idx].start < ganttAllBars2[earliestIdx].start) earliestIdx = idx;
                });
                const origBar = ganttAllBars2[earliestIdx];
                const newStart = new Date(origBar.start);
                newStart.setDate(newStart.getDate() - batchDays);
                newBars.push(Object.assign({}, origBar, {
                    start: newStart,
                    year: String(newStart.getFullYear()),
                    duration: batchDays,
                    isBatchDaysBar: true,
                }));
            });
            if(newBars.length) ganttAllBars2.push(...newBars);
        })();
    }

    function ganttBuildFilterGroup2(containerId, fieldKey, values, defaultFn){
        const el = document.getElementById(containerId);
        if(!el) return;
        el.innerHTML = '';

        const toggleWrap = document.createElement('div');
        toggleWrap.style.cssText = 'display:flex;gap:6px;margin-bottom:4px;';
        const makeToggle = (label, selectAll) => {
            const btn = document.createElement('span');
            btn.textContent = label;
            btn.style.cssText = 'font-size:9px;cursor:pointer;color:var(--an-accent,#00c8ff);letter-spacing:.5px;text-transform:uppercase;';
            btn.addEventListener('click', () => {
                el.querySelectorAll('input[type=checkbox]').forEach(cb => { cb.checked = selectAll; });
                ganttApplyAndRender2();
            });
            return btn;
        };
        toggleWrap.appendChild(makeToggle('All', true));
        const sep = document.createElement('span');
        sep.textContent = '·';
        sep.style.cssText = 'font-size:9px;color:var(--an-text-dim,#5a7080);';
        toggleWrap.appendChild(sep);
        toggleWrap.appendChild(makeToggle('None', false));
        el.appendChild(toggleWrap);

        [...values].sort().forEach(v => {
            const lbl = document.createElement('label');
            const cb  = document.createElement('input');
            cb.type = 'checkbox';
            cb.value = v;
            cb.dataset.gfield = fieldKey;
            cb.checked = defaultFn(v);
            cb.addEventListener('change', ganttApplyAndRender2);
            lbl.appendChild(cb);
            lbl.appendChild(document.createTextNode(v));
            el.appendChild(lbl);
        });
    }

    function ganttBuildAllFilters2(){
        const uniqWithBlank = f => {
            const vals = new Set(ganttAllBars2.map(b => b[f]).filter(Boolean));
            if(ganttAllBars2.some(b => !b[f] || String(b[f]).trim() === "")) vals.add("Blank");
            return [...vals];
        };
        const defaultAll = () => true;
        // defaultVP retained but unused as of 2026-09-14 (see GANTT_DEFAULTS
        // comment above) — VP filter now uses defaultAll so every VP is
        // checked by default, per user request.
        const defaultVP  = v => GANTT_DEFAULTS.gfVP.includes(v);
        const defaultGrp = v => GANTT_DEFAULTS.gfGroup.includes(v);

        ganttBuildFilterGroup2('gfVP2',        'vp',        uniqWithBlank('vp'),        defaultAll);
        ganttBuildFilterGroup2('gfYear2',      'year',      uniqWithBlank('year'),      defaultAll);
        ganttBuildFilterGroup2('gfExplMgr2',   'explMgr',   uniqWithBlank('explMgr'),   defaultAll);
        ganttBuildFilterGroup2('gfGroup2',     'group',     uniqWithBlank('group'),     defaultGrp);
        ganttBuildFilterGroup2('gfType2',      'type',      uniqWithBlank('type'),      defaultAll);
        ganttBuildFilterGroup2('gfDpCompany2', 'dpCompany', uniqWithBlank('dpCompany'), defaultAll);
        ganttBuildFilterGroup2('gfDrillOK2',   'drillok',   uniqWithBlank('drillok'),   defaultAll);
        ganttBuildFilterGroup2('gfGeoOK2',     'geook',     uniqWithBlank('geook'),     defaultAll);
        ganttBuildFilterGroup2('gfPrimaryZone2','primaryZone',uniqWithBlank('primaryZone'),defaultAll);
        ganttBuildFilterGroup2('gfRig2',       'rig',       uniqWithBlank('rig'),       defaultAll);
        ganttBuildFilterGroup2('gfDE2',        'de',        uniqWithBlank('de'),        defaultAll);

        ganttFiltersBuilt2 = true;

        const resetBtn = document.getElementById('ganttResetBtn2');
        if(resetBtn && !resetBtn.dataset.wired){
            resetBtn.dataset.wired = '1';
            resetBtn.addEventListener('click', () => {
                ganttBuildAllFilters2();
                ganttApplyAndRender2();
            });
        }
    }

    function ganttGetChecked2(fieldKey){
        return [...document.querySelectorAll(
            `#ganttSidebar2 input[type=checkbox][data-gfield="${fieldKey}"]:checked`
        )].map(cb => cb.value);
    }

    // ── Snapshot section (ADDED 2026-09-14) ──────────────────────────────
    // See task spec: per-ticked-year, per-Main-Area (East/Central/West/
    // Thermal) row of 4 pies + one combined summary table, under the
    // existing This-Year/Next-Year pies. classifySiteObj() below is a
    // DELIBERATE DUPLICATE of the 8-bucket switch(true) classification
    // inside ganttRenderChart2() (see that function, case block starting
    // "case (type === "FINAL" && ...)"), rather than a refactor of that
    // working block in place — this mirrors the project's own established
    // practice of not touching working Archived-table logic when adding a
    // new consumer of the same rule, to avoid any risk of regressing the
    // existing This Year/Next Year pies. If the classification rule ever
    // changes, both copies must be updated together.
    function classifySiteObj(siteObj, isInProgressTable, isInSetupQueueTable, isInDesignQueueTable, isInBlackOpsQueueTable){
        const dpValue = siteObj.dp || "";
        const type    = siteObj.type;
        const dpReq   = siteObj.dpReq;
        const rig     = siteObj.rig;
        const rigToAvoid = ["PRECISION 183","PRECISION183","PD183","PD 183"];
        const dpNo  = !dpValue || dpValue === "NO" || dpValue === "NO-DP" || dpValue === "";
        const dpYes = dpValue === "YES" || dpValue === "YES-DP" || dpValue !== "";
        const isForcedInProgress      = isInProgressTable === true;
        const isForcedInSetupQueue    = isInSetupQueueTable === true;
        const isForcedInDesignQueue   = isInDesignQueueTable === true;
        const isForcedInBlackOpsQueue = isInBlackOpsQueueTable === true;
        // ADDED 2026-09-25: same "fully approved" test that draws the green
        // upper-corner triangle on Gantt bars (isFullyApproved in
        // ganttRenderChart2): Drill OK = "YES-Drill" AND Geo OK = "YES-Geo".
        const isFullyApproved =
            String(siteObj.drillok).trim().toUpperCase() === "YES-DRILL" &&
            String(siteObj.geook).trim().toUpperCase() === "YES-GEO";

        switch(true){
            // CHANGED 2026-09-24: orange case now its own bucket (was "FINAL").
            case (type === "FINAL" && !nsIsEmptyDateField(dpReq) && nsIsEmptyDateField(siteObj.dpReceivedDate)):
                return "VENDOR ON IT";
            case type === "FINAL":
                // CHANGED 2026-09-25: approved green -> "FINAL DP".
                return isFullyApproved ? "FINAL DP" : "VENDOR DP";
            case isForcedInProgress:
                return "IN PROGRESS";
            case isForcedInSetupQueue:
            case isForcedInDesignQueue:
            case isForcedInBlackOpsQueue:
                return "IN QUEUE";
            case type === "PRELIM - IR":
                return "NEED INFO";
            case (dpNo && !rigToAvoid.includes(rig) && dpReq !== ""):
                return "IN QUEUE";
            case type === "EXEC":
                return "HANDED OVER";
            case dpYes:
                // CHANGED 2026-09-25: approved blue -> "APPROVED DP".
                return isFullyApproved ? "APPROVED DP" : "DP-YES";
            case dpReq === "" || dpReq === " ":
                return "NOT REQUESTED";
            default:
                return "ERRORS";
        }
    }

    // Snapshot-only duplicate of ganttBuildAllFilters2()'s local
    // uniqWithBlank('year') helper (that one is function-scoped and not
    // reusable from here) — same logic, restricted to the 'year' field,
    // with the "Blank" bucket dropped since a year tickbox for blank years
    // isn't meaningful for this section. 2026-09-14.
    function snapshotUniqYears(){
        const vals = new Set(ganttAllBars2.map(b => b.year).filter(Boolean));
        return [...vals].sort();
    }

    function buildSnapshotYearTicks(){
        const el = document.getElementById('snapshotYearTicks');
        if(!el) return;
        el.innerHTML = '';
        const years = snapshotUniqYears();
        const curYear  = String(new Date().getFullYear());
        const nextYear = String(new Date().getFullYear() + 1);
        years.forEach(y => {
            const label = document.createElement('label');
            label.className = 'snapshot-year-tick';
            label.style.cssText = 'margin-right:14px;cursor:pointer;';
            const cb = document.createElement('input');
            cb.type = 'checkbox';
            cb.value = y;
            cb.dataset.snapshotYear = '1';
            // CHANGED 2026-09-24: default is the current year only (was
            // current + next year), per user.
            cb.checked = (y === curYear);
            cb.addEventListener('change', renderSnapshotSection);
            label.appendChild(cb);
            label.appendChild(document.createTextNode(' ' + y));
            el.appendChild(label);
        });
        snapshotTicksBuilt = true;
    }

    // ADDED 2026-09-14: wires the #snapshotChartTypeToggle button-group
    // (Pie / Stacked Bars) built in the EJS markup above snapshotYearTicks.
    // Sets the module-scoped snapshotChartType and re-renders immediately
    // on click, per spec. Does not touch pieCanvas/pieCanvas3 (This-Year/
    // Next-Year pies), which have no such toggle and remain pies always.
    function wireSnapshotChartTypeToggle(){
        const pieBtn = document.getElementById('snapshotChartTypePie');
        const barBtn = document.getElementById('snapshotChartTypeBar');
        if(!pieBtn || !barBtn) return;
        const setType = (type) => {
            snapshotChartType = type;
            pieBtn.classList.toggle('active', type === 'pie');
            barBtn.classList.toggle('active', type === 'bar');
            renderSnapshotSection();
        };
        pieBtn.addEventListener('click', () => setType('pie'));
        barBtn.addEventListener('click', () => setType('bar'));
    }

    // Same 8-bucket labels/colors as the This Year / Next Year pies
    // (ganttRenderChart2, pieCanvas/pieCanvas3 below) — duplicated here
    // rather than shared across the two render paths since they run at
    // different times; MUST stay in sync with those literals if changed.
    // CHANGED 2026-09-24: added "VENDOR ON IT" (orange #ff8c00) bucket —
    // FINAL jobs with DP requested but no DP received date yet (same rule as
    // the orange Gantt bar). These were previously counted inside the green
    // FINAL bucket; they are now split out so green only counts FINAL jobs
    // whose DP is back. Green relabelled "VENDOR DP" per user; pie labels now
    // match the table headers (HANDED OVER / NEED INFO / ERRORS). Pie slice
    // colours for NEED INFO (#555555) and ERRORS (#FFFFFF) intentionally left
    // as-is (white = errors in the Gantt; red is reserved for IN QUEUE).
    // Labels double as the count keys returned by classifySiteObj().
    // CHANGED 2026-09-25: added "FINAL DP" (#1b5e20, approved VENDOR DP) and
    // "APPROVED DP" (#004d80, approved DP-YES) — "approved" = the green
    // corner rule (Drill OK YES-Drill AND Geo OK YES-Geo). Pie/bar order puts
    // each right after its parent; the table uses SNAPSHOT_TABLE_ORDER
    // below (user-specified column order). Approved jobs are no longer
    // counted in their parent bucket, so totals are unchanged.
    const SNAPSHOT_LABELS = ["VENDOR ON IT","VENDOR DP","FINAL DP","HANDED OVER","DP-YES","APPROVED DP","IN PROGRESS","IN QUEUE","NEED INFO","NOT REQUESTED","ERRORS"];
    const SNAPSHOT_COLORS = ["#ff8c00","#4caf50","#1b5e20","#B11FDF","#0084c7","#004d80","#ffff00","#ff4c4c","#555555","#C0C0C0","#FFFFFF"];
    // Table columns: [label, header bg, header fg, green approved corner?]
    const SNAPSHOT_TABLE_ORDER = [
        ["FINAL DP",      "#1b5e20", "#ffffff", true ],
        ["VENDOR ON IT",  "#ff8c00", "#020202", false],
        ["VENDOR DP",     "#4caf50", "#020202", false],
        ["HANDED OVER",   "#B11FDF", "#ffffff", false],
        ["APPROVED DP",   "#004d80", "#ffffff", true ],
        ["DP-YES",        "#0084c7", "#020202", false],
        ["IN PROGRESS",   "#ffff00", "#020202", false],
        ["IN QUEUE",      "#ff4c4c", "#ffffff", false],
        ["NEED INFO",     "#37474f", "#ffffff", false],
        ["NOT REQUESTED", "#C0C0C0", "#020202", false],
        ["ERRORS",        "#c0392b", "#ffffff", false],
    ];
    // Same green (#39ff14) triangle as anCornerTrianglePlugin on the Gantt.
    const SNAPSHOT_CORNER_HTML = '<span style="position:absolute;top:0;right:0;width:0;height:0;border-top:14px solid #39ff14;border-left:14px solid transparent;"></span>';
    const SNAPSHOT_AREAS  = ["East","Central","West","Thermal"];

    function snapshotEmptyCounts(){
        const o = {}; SNAPSHOT_LABELS.forEach(l => o[l] = 0); return o;
    }

    // ADDED 2026-09-25: "Download Excel" for the New Schedule Gantt. Exports
    // exactly the bars the Gantt is drawing: lastFilteredBars2 (sidebar
    // filters applied) with a valid start date, incl. Batch Days pre-bars
    // (flagged). Status = classifySiteObj() bucket (same as the Snapshot
    // pies/table), cell filled with that bucket's SNAPSHOT_COLORS colour.
    // "Approved (Drill+Geo)" = same rule as the green Gantt corner.
    // ExcelJS 4.4.0 is lazy-loaded from jsDelivr on first click so that
    // partials/footer.ejs (where the other CDN scripts live) is untouched.
    function ganttLoadExcelJS2(){
        if(typeof ExcelJS !== 'undefined') return Promise.resolve();
        return new Promise((resolve, reject) => {
            const sc = document.createElement('script');
            sc.src = 'https://cdn.jsdelivr.net/npm/exceljs@4.4.0/dist/exceljs.min.js';
            sc.onload = () => resolve();
            sc.onerror = () => reject(new Error('Could not load ExcelJS from cdn.jsdelivr.net'));
            document.head.appendChild(sc);
        });
    }
    function ganttExportMsg2(msg){ console.warn('[ganttExportExcel2] ' + msg); try{ alert(msg); }catch(e){} }

    async function ganttExportExcel2(){
        const bars = (lastFilteredBars2 || []).filter(b => b.start && !isNaN(b.start));
        if(!bars.length){ ganttExportMsg2('No Gantt rows to export with the current filters.'); return; }
        await ganttLoadExcelJS2();

        const fmtDate = d => {
            if(!d || isNaN(d)) return '';
            const x = new Date(d);
            return x.getFullYear() + '-' + String(x.getMonth()+1).padStart(2,'0') + '-' + String(x.getDate()).padStart(2,'0');
        };
        const colorOf = label => {
            const i = SNAPSHOT_LABELS.indexOf(label);
            return i >= 0 ? SNAPSHOT_COLORS[i] : '#FFFFFF';
        };
        const darkText = ['#ff8c00','#4caf50','#0084c7','#ffff00','#c0c0c0','#ffffff'];

        const cols = [
            ['Status',16],['Approved (Drill+Geo)',12],['Batch Days bar',10],
            ['Rig',16],['Site',20],['Well',20],['ETS',12],['VP',14],['Group',8],['Year',8],
            ['Exploration Mgr',18],['Type',14],['Start',12],['End',12],['Duration (days)',10],
            ['DP',12],['DP Company',16],['DP Requested',12],['DP Received',12],
            ['Drill OK',12],['Geo OK',12],['Geo',14],['Version',10],['Primary Zone',16],
            ['D.E',14],['Surface Lat',12],['Surface Lon',12],
        ];

        const wb = new ExcelJS.Workbook();
        const ws = wb.addWorksheet('Gantt');
        ws.columns = cols.map(([header,width]) => ({ header, width }));
        ws.getRow(1).font = { bold: true };
        ws.views = [{ state: 'frozen', ySplit: 1 }];
        ws.autoFilter = { from: { row: 1, column: 1 }, to: { row: 1, column: cols.length } };

        bars.slice().sort((a,b) => String(a.rig||'').localeCompare(String(b.rig||'')) || (a.start - b.start)).forEach(b => {
            const siteKey = String(b.site || '').slice(0,14);
            const status = classifySiteObj(b,
                inProgressSites.has(siteKey), inSetupQueueSites.has(siteKey),
                inDesignQueueSites.has(siteKey), inBlackOpsQueueSites.has(siteKey));
            const approved = String(b.drillok).trim().toUpperCase() === 'YES-DRILL' &&
                             String(b.geook).trim().toUpperCase() === 'YES-GEO';
            const end = new Date(b.start.getTime() + (Number(b.duration)||0) * 86400000);
            const row = ws.addRow([
                status, approved ? 'Yes' : 'No', b.isBatchDaysBar ? 'Yes' : 'No',
                b.rig, b.site, b.well, b.ETS, b.vp, b.group, b.year,
                b.explMgr, b.type, fmtDate(b.start), fmtDate(end), Number(b.duration)||0,
                b.dp, b.dpCompany, b.dpReq, b.dpReceivedDate,
                b.drillok, b.geook, b.geo, b.version, b.primaryZone,
                b.de || (ganttNotesMap[siteKey] || {}).de || '',
                (b.surfaceLat ?? ''), (b.surfaceLon ?? ''),
            ]);
            const hex = colorOf(status);
            const c = row.getCell(1);
            c.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF' + hex.replace('#','').toUpperCase() } };
            c.font = { bold: true, color: { argb: darkText.includes(hex.toLowerCase()) ? 'FF000000' : 'FFFFFFFF' } };
            if(approved){
                row.getCell(2).fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF39FF14' } };
            }
        });

        const buf = await wb.xlsx.writeBuffer();
        const blob = new Blob([buf], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'Gantt_filtered_' + fmtDate(new Date()) + '.xlsx';
        document.body.appendChild(a); a.click(); a.remove();
        setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    }
    document.addEventListener('DOMContentLoaded', () => {
        const btn = document.getElementById('ganttExportExcelBtn2');
        if(btn) btn.addEventListener('click', () => { ganttExportExcel2().catch(e => ganttExportMsg2('Export failed: ' + e.message)); });
    });

    function renderSnapshotSection(){
        // ADDED 2026-09-14: read the module-scoped toggle state at the top of
        // the render, per spec, so the branch below picks pies vs. one
        // stacked bar chart per year.
        const chartType = snapshotChartType;
        const container = document.getElementById('snapshotContainer');
        const ticksEl    = document.getElementById('snapshotYearTicks');
        if(!container || !ticksEl) return;

        snapshotChartInstances2.forEach(ch => { try{ ch.destroy(); }catch(e){} });
        snapshotChartInstances2 = [];
        container.innerHTML = '';

        const checkedYears = [...ticksEl.querySelectorAll('input[data-snapshot-year]:checked')]
            .map(cb => cb.value)
            .sort((a,b) => Number(a) - Number(b)); // ascending, per spec

        if(!checkedYears.length){
            container.innerHTML = '<p style="color:var(--an-text-dim,#5a7080);padding:10px;">No year selected.</p>';
            return;
        }

        const vpAreaMap = window.vpAreaMap || {};
        const sourceBars = lastFilteredBars2; // respects current sidebar filters

        const isLightMode = document.body.classList.contains("light-mode");

        // ADDED 2026-09-24: running sum of every checked year's counts,
        // used for the TOTAL pie rendered after the year blocks.
        const grandTotalCounts = snapshotEmptyCounts();

        checkedYears.forEach(year => {
            const yearBars = sourceBars.filter(b => String(b.year) === String(year));

            // countsByArea: East/Central/West/Thermal/Unassigned -> 8-bucket counts
            const countsByArea = {};
            [...SNAPSHOT_AREAS, 'Unassigned'].forEach(a => countsByArea[a] = snapshotEmptyCounts());

            yearBars.forEach(siteObj => {
                if(!siteObj.site) return;
                const siteKey = siteObj.site.slice(0, 14);
                const bucket = classifySiteObj(
                    siteObj,
                    inProgressSites.has(siteKey),
                    inSetupQueueSites.has(siteKey),
                    inDesignQueueSites.has(siteKey),
                    inBlackOpsQueueSites.has(siteKey)
                );
                // VP has no mapped Main Area -> visibly counted as
                // "Unassigned" rather than silently dropped, per spec.
                const area = vpAreaMap[siteObj.vp] || 'Unassigned';
                if(!countsByArea[area]) countsByArea[area] = snapshotEmptyCounts();
                countsByArea[area][bucket]++;
            });

            const yearBlock = document.createElement('div');
            yearBlock.className = 'snapshot-year-block';
            yearBlock.style.cssText = 'margin-bottom:22px;padding-top:8px;border-top:1px solid rgba(128,128,128,0.3);';

