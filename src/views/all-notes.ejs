<script type="application/json" id="actvData">
<%- JSON.stringify({ summaries: activityReport.summaries, heatmaps: activityReport.heatmaps, heatmapDays: activityReport.heatmapDays }) %>
</script>
<script src="/js/activityHeatmap.js"></script>
<script>
(function(){
    var DATA = JSON.parse(document.getElementById('actvData').textContent);
    var summaries = DATA.summaries || [];
    var heatmaps = DATA.heatmaps || {};

    function fmtDate(iso){
        if(!iso) return 'Never';
        var d = new Date(iso);
        var days = Math.floor((Date.now()-d.getTime())/86400000);
        if(days === 0) return 'Today';
        if(days === 1) return 'Yesterday';
        if(days < 7) return days + ' days ago';
        return d.toISOString().slice(0,10);
    }

    var tbody = document.getElementById('actvUserTableBody');
    summaries.forEach(function(s){
        var tr = document.createElement('tr');
        tr.className = 'actv-user-row';
        tr.dataset.userId = s.userId;
        tr.innerHTML =
            '<td>' + s.name + '</td>' +
            '<td><span class="actv-role-badge ' + s.role + '">' + s.role + '</span></td>' +
            '<td>' + s.daysActive + '</td>' +
            '<td>' + s.estHours.toFixed(1) + '</td>' +
            '<td>' + fmtDate(s.lastActive) + '</td>' +
            '<td>' + (s.topModule || '—') + '</td>';
        tr.addEventListener('click', function(){ selectUser(s.userId); });
        tbody.appendChild(tr);
    });

    function selectUser(userId){
        document.querySelectorAll('#actvUserTableBody tr').forEach(function(tr){
            tr.classList.toggle('selected', tr.dataset.userId === userId);
        });
        var s = summaries.find(function(x){ return x.userId === userId; });
        document.getElementById('actvHeatmapUserName').textContent = s ? s.name : '—';
        ActivityHeatmap.render(document.getElementById('actvHeatmapSvg'), heatmaps[userId] || {}, DATA.heatmapDays);
    }

    if(summaries.length) selectUser(summaries[0].userId);
})();
</script>
<% } %>


<script>
(function(){
    const LS_KEY = 'mtxThemePreference';
    const sw     = document.getElementById('anThemeSwitch');

    function applyTheme(light){
        document.body.classList.toggle('light-mode', light);
        sw.checked = light;
    }

    // Apply saved preference immediately (before paint to avoid flash)
    applyTheme(localStorage.getItem(LS_KEY) === 'light');

    sw.addEventListener('change', function(){
        localStorage.setItem(LS_KEY, sw.checked ? 'light' : 'dark');
        location.reload();
    });
})();
</script>

