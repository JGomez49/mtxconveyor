                                </form>
                            <% } %>
                            <table class="table table-hover table-striped table-dark table-sm">
                                <thead>
                                    <tr>
                                        <!-- Added 2026-09-14: "select all" checkbox for bulk delete. -->
                                        <% if (user.role == 'admin') { %>
                                            <th scope="col"><input type="checkbox" id="archivedSelectAll" title="Select all" onclick="archivedToggleAll(this)"></th>
                                        <% } %>
                                        <th scope="col">ID</th>
