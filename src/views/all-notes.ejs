            const unassignedTotal = SNAPSHOT_LABELS.reduce((s,l) => s + countsByArea['Unassigned'][l], 0);
            const unassignedNote = document.createElement('div');
            unassignedNote.className = 'badge';
            unassignedNote.style.cssText = isLightMode
                ? 'display:inline-block;margin-top:6px;background:#6c757d;color:#fff;padding:5px 10px;border-radius:4px;font-size:0.8rem;'
                : 'display:inline-block;margin-top:6px;background:#495057;color:#fff;padding:5px 10px;border-radius:4px;font-size:0.8rem;';
            unassignedNote.textContent = `Unassigned (VP not mapped to a Main Area): ${unassignedTotal} well(s)`;
            yearBlock.appendChild(unassignedNote);

            // Per-year summary table, all regions (East/Central/West/Thermal
            // + Unassigned) combined — same 9-column scheme as
            // renderCompiledSummary()/summaryTable2.
            const combined = snapshotEmptyCounts();
            [...SNAPSHOT_AREAS, 'Unassigned'].forEach(a => {
                SNAPSHOT_LABELS.forEach(l => combined[l] += countsByArea[a][l]);
            });
            const combinedTotal = SNAPSHOT_LABELS.reduce((s,l) => s + combined[l], 0);
            SNAPSHOT_LABELS.forEach(l => grandTotalCounts[l] += combined[l]);

            // CHANGED 2026-09-14: Snapshot table header ("title") font sizes
            // set to 2.5x their previous size (0.75rem->1.875rem) per spec;
            // data-row cell font size (tdStyle) left unchanged since the
            // request was specifically for the table's titles.
            // CHANGED 2026-09-14 (round 2): per user feedback ("column
            // headers are too small, make them 2.5x bigger") — another 2.5x
            // applied on top of the round-1 size (1.875rem -> 4.6875rem).
            // CHANGED 2026-09-14 (round 3): the two rounds above never
            // actually rendered bigger — root cause found: the global rule
            // `.table th[style*="background-color"] { font-size: 9px
            // !important; }` (see the <style> block near the top of this
            // file) matches every status-header <th> site-wide (not just
            // this table) and its !important was beating our plain inline
            // font-size the whole time, so the header text the user kept
            // seeing was always the original ~9px regardless of what the
            // JS set. Rather than touch that shared rule (it also governs
            // summaryTable2/renderCompiledSummary, out of scope here), each
            // font-size below is now itself !important so the inline style
            // — which has higher specificity than any stylesheet selector —
            // wins as intended. Since rounds 1 and 2 never visually applied,
            // this is treated as a single real 2.5x jump off the true
            // original size (0.75rem -> 1.875rem), not a further compound
            // of the (invisible) earlier attempts.
            // CHANGED 2026-09-14 (round 4): user asked for the Snapshot
            // table's cell (data row) font 2x bigger (0.8rem -> 1.6rem).
            // !important added defensively in case a global .table td rule
            // is added later — no such override exists today, unlike the
            // th case above, but this keeps the two styles consistent.
            const tdStyle = isLightMode
                ? 'style="text-align:center;font-size:1.6rem !important;padding:3px 6px;color:#212529;"'
                : 'style="text-align:center;font-size:1.6rem !important;padding:3px 6px;"';
            const thStyle = (bg, fg) => {
                let useFg = fg;
                if(isLightMode && (bg==="transparent"||bg==="#transparent")) useFg = "#212529";
                return `style="text-align:center;background-color:${bg};color:${useFg};font-size:1.875rem !important;padding:4px 6px;"`;
            };
            const totalHdr = isLightMode
                ? 'style="text-align:center;font-size:1.875rem !important;font-weight:bold;padding:4px 6px;background:#e9ecef;color:#212529;"'
                : 'style="text-align:center;font-size:1.875rem !important;font-weight:bold;padding:4px 6px;"';

            const table = document.createElement('table');
            table.className = 'table table-dark table-sm table-bordered table-hover mt-2';
            table.innerHTML = `
            <thead>
                <tr>
                    <th ${thStyle("transparent","white")}>YEAR</th>
                    ${SNAPSHOT_TABLE_ORDER.map(([l,bg,fg,corner]) => corner
                        ? `<th ${thStyle(bg,fg).replace('style="','style="position:relative;')}>${l}${SNAPSHOT_CORNER_HTML}</th>`
                        : `<th ${thStyle(bg,fg)}>${l}</th>`).join('')}
                    <th ${totalHdr}>TOTAL</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td ${tdStyle}>${year}</td>
                    ${SNAPSHOT_TABLE_ORDER.map(([l]) => `<td ${tdStyle}>${combined[l]}</td>`).join('')}
                    <td ${tdStyle}><b>${combinedTotal}</b></td>
                </tr>
            </tbody>`;
            yearBlock.appendChild(table);

            container.appendChild(yearBlock);
        });

        // ADDED 2026-09-24: TOTAL pie under the Snapshot table(s), replacing
        // the removed This Year / Next Year pies under the Gantt. Sums all
        // checked years (East/Central/West/Thermal + Unassigned), so it
        // follows the year tick-boxes and the sidebar filters. Uses the same
        // column + canvas classes/sizes and styling as the area pies above.
        // Shown in both Pie and Stacked Bars modes.
        const grandTotal = SNAPSHOT_LABELS.reduce((s,l) => s + grandTotalCounts[l], 0);
        const totalRow = document.createElement('div');
        totalRow.className = 'snapshot-pie-row';
        const totalCol = document.createElement('div');
        totalCol.className = 'snapshot-pie-col';
        totalCol.style.cssText = 'flex:1 1 0;min-width:320px;max-width:520px;';
        const totalCanvas = document.createElement('canvas');
        totalCanvas.className = 'snapshot-pie-chart';
        totalCol.appendChild(totalCanvas);
        totalRow.appendChild(totalCol);
        container.appendChild(totalRow);

        const yearsText = checkedYears.length === 1 ? checkedYears[0] : checkedYears.join(', ');
        snapshotChartInstances2.push(new Chart(totalCanvas.getContext('2d'), {
            type: 'pie',
            data: {
                labels: SNAPSHOT_LABELS,
                datasets: [{
                    data: SNAPSHOT_LABELS.map(l => grandTotalCounts[l]),
                    backgroundColor: SNAPSHOT_COLORS,
                    borderColor: '#333',
                    borderWidth: 1
                }]
            },
            plugins: [ChartDataLabels],
            options: {
                layout: { padding: 0 },
                plugins: {
                    title: { display:true, text:`TOTAL (${yearsText}): ${grandTotal} Wells`, color: anChartColor(), font:{size:30,weight:"normal"} },
                    legend: { display:false },
                    datalabels: {
                        color: (ctx) => {
                            const bg = ctx.dataset.backgroundColor[ctx.dataIndex] || "#000";
                            const lightBgs = ["#ffff00","#C0C0C0","#FFFFFF","#ffffff","#ff8c00"];
                            return lightBgs.some(col => bg.toLowerCase() === col.toLowerCase()) ? "#000" : "#fff";
                        },
                        font:{weight:"bold",size:22.5},
                        formatter:(v,ctx)=>{ const t=ctx.chart.data.datasets[0].data.reduce((a,b)=>a+b,0); return (v&&t)?Math.round(v/t*100)+"%":""; }
                    }
                }
            }
        }));
    }

    function ganttApplyAndRender2(){
        const fVP        = ganttGetChecked2('vp');
        const fYear      = ganttGetChecked2('year');
        const fExplMgr   = ganttGetChecked2('explMgr');
        const fGroup     = ganttGetChecked2('group');
        const fType      = ganttGetChecked2('type');
        const fDpCompany = ganttGetChecked2('dpCompany');
        const fDrillOK   = ganttGetChecked2('drillok');
        const fGeoOK     = ganttGetChecked2('geook');
        const fPrimaryZone = ganttGetChecked2('primaryZone');
        const fRig       = ganttGetChecked2('rig');
        const fDE        = ganttGetChecked2('de');

        const blanked = f => v => !v || String(v).trim() === '' ? 'Blank' : v;
        const filtered = ganttAllBars2.filter(b =>
            fVP.includes(blanked()(b.vp)) &&
            fYear.includes(blanked()(b.year)) &&
            fExplMgr.includes(blanked()(b.explMgr)) &&
            fGroup.includes(blanked()(b.group)) &&
            fType.includes(blanked()(b.type)) &&
            fDpCompany.includes(blanked()(b.dpCompany)) &&
            fDrillOK.includes(blanked()(b.drillok)) &&
            fGeoOK.includes(blanked()(b.geook)) &&
            fPrimaryZone.includes(blanked()(b.primaryZone)) &&
            fRig.includes(blanked()(b.rig)) &&
            fDE.includes(blanked()(b.de))
        );

        ganttRenderChart2(filtered);
        console.log('[newSchedGantt] filtered bars passed to chart:', filtered.length, 'of', ganttAllBars2.length, 'total');

        // ADDED 2026-09-14: keep the Snapshot section's data source in sync
        // with whatever the sidebar filters currently produce, and
        // re-render it here — the cleanest integration point since
        // `filtered` is already computed and this function already runs on
        // every filter change (see the .addEventListener(..., ganttApplyAndRender2)
        // wiring above).
        lastFilteredBars2 = filtered;
        if(snapshotTicksBuilt) renderSnapshotSection();
    }

        function ganttRenderChart2(bars){
            const chartDiv = document.getElementById("chartDiv2");
            console.log('[newSchedGantt] ganttRenderChart2() called with', bars.length, 'bars. chartDiv2 found:', !!chartDiv);
            if(!chartDiv) return;
            chartDiv.innerHTML = "";

            // Clear previous Chart.js instances
            chartInstances2.forEach(ch => { try{ ch.destroy(); }catch(e){} });
            chartInstances2 = [];

            if(!bars.length){
                console.warn('[newSchedGantt] 0 bars passed filters — showing "No data matches" message.');
                chartDiv.innerHTML = '<p style="color:var(--an-text-dim,#5a7080);padding:20px;">No data matches the selected filters.</p>';
                return;
            }

            const today = new Date();
            const sevenMonthsLater  = new Date(today.getFullYear(), today.getMonth() + 7,  today.getDate());
            const threeMonthsLater  = new Date(today.getFullYear(), today.getMonth() + 3,  today.getDate());
            const fiveMonthsLater   = new Date(today.getFullYear(), today.getMonth() + 5,  today.getDate());
            const oneYearLater      = new Date(today.getFullYear() + 1, today.getMonth(), today.getDate());
            const FixedEndOfLastYear= new Date("2025-12-31");
            const FixedEndOfThisYear= new Date("2026-12-31");
            const FixedEndOfNextYear= new Date("2027-12-31");
            const TargetDate        = new Date("2026-08-31");

            // Collect unique rigs from filtered bars, alphabetical
            const rigSet = [...new Set(bars.filter(b => b.start).map(b => b.rig))].sort();

            const datasets   = [];
            const colors     = [];
            const glowFlags  = [];
            const colorOfBorder = "#000000";
            const colorCounts = {
                // orange* keys ADDED 2026-09-24 (Vendor On It) — kept out of the
                // first 8-key block's positional logic by being appended last.
                blue:0, red:0, green:0, yellow:0, purple:0, white:0, black:0, silver:0,
                blueThisYear:0, redThisYear:0, greenThisYear:0, yellowThisYear:0,
                purpleThisYear:0, whiteThisYear:0, blackThisYear:0, silverThisYear:0,
                blueNextYear:0, redNextYear:0, greenNextYear:0, yellowNextYear:0,
                purpleNextYear:0, whiteNextYear:0, blackNextYear:0, silverNextYear:0,
                orange:0, orangeThisYear:0, orangeNextYear:0,
            };

            bars.forEach(siteObj => {
                if(!siteObj.start || isNaN(siteObj.start)) return;
                const start   = new Date(siteObj.start);
                const end     = new Date(siteObj.start.getTime() + siteObj.duration * 86400000);
                const dpValue = siteObj.dp || "";
                const type    = siteObj.type;
                const drillok = siteObj.drillok;
                const geook   = siteObj.geook;
                const rig     = siteObj.rig;
                const dpReq   = siteObj.dpReq;

                const siteKey = siteObj.site.slice(0, 14);
                const isInProgressTable    = inProgressSites.has(siteKey);
                const isInSetupQueueTable  = inSetupQueueSites.has(siteKey);
                const isInDesignQueueTable = inDesignQueueSites.has(siteKey);
                const isInBlackOpsQueueTable = inBlackOpsQueueSites.has(siteKey);

                datasets.push({
                    y: rig,
                    x: [siteObj.start, end],
                    site: siteObj.site.substring(0, 5),
                    details: {
                        Rig: rig, drillok, geook, VP: siteObj.vp,
                        Start: siteObj.start.toLocaleDateString(),
                        Duration: siteObj.duration, DP: dpValue,
                        Site: siteObj.site, Well: siteObj.well,
                        dpCompany: siteObj.dpCompany, ETS: siteObj.ETS,
                        type, group: siteObj.group, dpReq, geo: siteObj.geo,
                        version: siteObj.version,
                        dpReceivedDate: siteObj.dpReceivedDate,
                        DE: (ganttNotesMap[siteObj.site.slice(0,14)] || {}).de || '',
                        surfaceLat: siteObj.surfaceLat, surfaceLon: siteObj.surfaceLon,
                        primaryZone: siteObj.primaryZone,
                    }
                });

                const rigToAvoid = ["PRECISION 183","PRECISION183","PD183","PD 183"];
                const dpNo  = !dpValue || dpValue === "NO" || dpValue === "NO-DP" || dpValue === "";
                const dpYes = dpValue === "YES" || dpValue === "YES-DP" || dpValue !== "";

                const countable          = start >= today && start <= oneYearLater;
                const countableForThisYear = start > FixedEndOfLastYear && start <= FixedEndOfThisYear;
                const countableForNextYear = start > FixedEndOfThisYear && start <= FixedEndOfNextYear;

                const isForcedInProgress    = isInProgressTable === true;
                const isForcedInSetupQueue  = isInSetupQueueTable === true;
                const isForcedInDesignQueue = isInDesignQueueTable === true;
                const isForcedInBlackOpsQueue = isInBlackOpsQueueTable === true;

                // Build compiledRows for the VP summary table
                const vpKey = siteObj.vp + '|' + siteObj.group;

                switch(true){
                    // FINAL jobs that have been requested from the DP company but
                    // not yet received back — flagged orange, still counted in the
                    // "VENDOR ON IT" bucket (see 2026-09-24 note).
                    case (type === "FINAL" && !nsIsEmptyDateField(dpReq) && nsIsEmptyDateField(siteObj.dpReceivedDate)):
                        // CHANGED 2026-09-24: counted as its own "VENDOR ON IT"
                        // bucket (was added to green/FINAL).
                        colors.push("#ff8c00");
                        if(countable) colorCounts.orange++;
                        if(countableForThisYear) colorCounts.orangeThisYear++;
                        if(countableForNextYear) colorCounts.orangeNextYear++;
                        break;
                    case type === "FINAL":
                        colors.push("#4caf50");
                        if(countable) colorCounts.green++;
                        if(countableForThisYear) colorCounts.greenThisYear++;
                        if(countableForNextYear) colorCounts.greenNextYear++;
                        break;
                    case isForcedInProgress:
                        colors.push("#ffff00");
                        if(countable) colorCounts.yellow++;
                        if(countableForThisYear) colorCounts.yellowThisYear++;
                        if(countableForNextYear) colorCounts.yellowNextYear++;
                        break;
                    case isForcedInSetupQueue:
                    case isForcedInDesignQueue:
                    case isForcedInBlackOpsQueue:
                        colors.push("#ff4c4c");
                        if(countable) colorCounts.red++;
                        if(countableForThisYear) colorCounts.redThisYear++;
                        if(countableForNextYear) colorCounts.redNextYear++;
                        break;
                    case type === "PRELIM - IR":
                        colors.push("#000000");
                        if(countable) colorCounts.black++;
                        if(countableForThisYear) colorCounts.blackThisYear++;
                        if(countableForNextYear) colorCounts.blackNextYear++;
                        break;
                    case (dpNo && !rigToAvoid.includes(rig) && dpReq !== ""):
                        colors.push("#ff4c4c");
                        if(countable) colorCounts.red++;
                        if(countableForThisYear) colorCounts.redThisYear++;
                        if(countableForNextYear) colorCounts.redNextYear++;
                        break;
                    case type === "EXEC":
                        colors.push("#B11FDF");
                        if(countable) colorCounts.purple++;
                        if(countableForThisYear) colorCounts.purpleThisYear++;
                        if(countableForNextYear) colorCounts.purpleNextYear++;
                        break;
                    case dpYes:
                        colors.push("#0084c7");
                        if(countable) colorCounts.blue++;
                        if(countableForThisYear) colorCounts.blueThisYear++;
                        if(countableForNextYear) colorCounts.blueNextYear++;
                        break;
                    case dpReq === "" || dpReq === " ":
                        colors.push("#C0C0C0");
                        if(countable) colorCounts.silver++;
                        if(countableForThisYear) colorCounts.silverThisYear++;
                        if(countableForNextYear) colorCounts.silverNextYear++;
                        break;
                    default:
                        colors.push("#FFFFFF");
                        if(countable) colorCounts.white++;
                        if(countableForThisYear) colorCounts.whiteThisYear++;
                        if(countableForNextYear) colorCounts.whiteNextYear++;
                        break;
                }

                const isFullyApproved =
                    String(drillok).trim().toUpperCase() === "YES-DRILL" &&
                    String(geook).trim().toUpperCase() === "YES-GEO";
                glowFlags.push(isFullyApproved);
            });

            // ── Proximity conflict detection ────────────────────────────────────
            // Flags pairs of DIFFERENT sites that share the same Primary Zone,
            // have overlapping drilling date ranges (start → start+duration),
            // and whose surface locations are within 6km of each other.
            const borderColors = datasets.map(() => colorOfBorder);
            const borderWidths = datasets.map(() => 1);

            function haversineKm(lat1, lon1, lat2, lon2){
                const R = 6371;
                const dLat = (lat2 - lat1) * Math.PI / 180;
                const dLon = (lon2 - lon1) * Math.PI / 180;
                const a = Math.sin(dLat/2)**2 +
                          Math.cos(lat1*Math.PI/180) * Math.cos(lat2*Math.PI/180) *
                          Math.sin(dLon/2)**2;
                return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
            }

            const CONFLICT_KM = 3;
            const zoneGroups = {};
            datasets.forEach((d, idx) => {
                const zone = (d.details.primaryZone || '').trim();
                if(!zone) return; // blank zone — nothing meaningful to match against
                if(!zoneGroups[zone]) zoneGroups[zone] = [];
                zoneGroups[zone].push(idx);
            });

            Object.values(zoneGroups).forEach(idxs => {
                for(let a = 0; a < idxs.length; a++){
                    for(let b = a + 1; b < idxs.length; b++){
                        const i1 = idxs[a], i2 = idxs[b];
                        const d1 = datasets[i1], d2 = datasets[i2];
                        if(d1.details.Site === d2.details.Site) continue; // same pad — not a conflict
                        if(d1.details.Rig  === d2.details.Rig)  continue; // same rig — a rig drills one well at a time, so sequential jobs on it can never be a parallel-proximity conflict

                        const lat1 = d1.details.surfaceLat, lon1 = d1.details.surfaceLon;
                        const lat2 = d2.details.surfaceLat, lon2 = d2.details.surfaceLon;
                        if(lat1 == null || lon1 == null || lat2 == null || lon2 == null) continue;

                        const [s1, e1] = d1.x, [s2, e2] = d2.x;
                        const overlap = s1 < e2 && s2 < e1;
                        if(!overlap) continue;

                        const distKm = haversineKm(lat1, lon1, lat2, lon2);
                        if(distKm >= CONFLICT_KM) continue;

                        borderColors[i1] = '#ff0000'; borderWidths[i1] = 4;
                        borderColors[i2] = '#ff0000'; borderWidths[i2] = 4;

                        (d1.details.conflicts = d1.details.conflicts || []).push({ site: d2.details.Site, distKm: distKm.toFixed(2) });
                        (d2.details.conflicts = d2.details.conflicts || []).push({ site: d1.details.Site, distKm: distKm.toFixed(2) });
                    }
                }
            });

            // ── Gantt chart ──────────────────────────────────────────────────────
            const minDate     = new Date(today.getFullYear(), today.getMonth(), today.getDate() - 7);
            const defaultMax  = new Date(today.getFullYear(), today.getMonth() + 5, today.getDate()); // default visible window
            const absoluteMax = new Date(today.getFullYear() + 2, today.getMonth(), today.getDate()); // full range for zoom/pan

            const canvasH = Math.max(200, rigSet.length * 40);
            const canvasW = chartDiv.parentElement
                ? Math.max(600, chartDiv.parentElement.clientWidth - 20)
                : 1200;

            // Wrap in a fixed-size div so responsive:false + zoom don't cause
            // an infinite resize loop
            const canvasWrap = document.createElement("div");
            canvasWrap.style.cssText = `width:${canvasW}px;height:${canvasH}px;position:relative;overflow:hidden;`;
            chartDiv.appendChild(canvasWrap);

            const canvas = document.createElement("canvas");
            canvas.width  = canvasW;
            canvas.height = canvasH;
            // Explicit inline CSS size (not just the width/height attributes)
            // so Chart.js's internal sizing logic never falls back to
            // measuring the container's layout box — this is what makes the
            // chart render correctly even while its accordion is collapsed
            // (display:none), so it's ready instantly the moment it's opened.
            canvas.style.width  = canvasW + 'px';
            canvas.style.height = canvasH + 'px';
            canvasWrap.appendChild(canvas);
            console.log('[newSchedGantt] canvas created:', canvasW, 'x', canvasH, 'rigs:', rigSet.length);

            const ctx = canvas.getContext("2d");
            const chart = new Chart(ctx, {
                type: "bar",
                data: {
                    datasets: [{
                        label: "Schedule",
                        data: datasets,
                        backgroundColor: colors,
                        borderRadius: 6,
                        borderSkipped: false,
                        borderColor: borderColors,
                        borderWidth: borderWidths,
                        parsing: { xAxisKey: "x", yAxisKey: "y" },
                    }]
                },
                options: {
                    indexAxis: "y",
                    responsive: false,
                    maintainAspectRatio: false,
                    onClick: (e, elements) => {
                        if(!elements.length) return;
                        const bar = chart.data.datasets[0].data[elements[0].index];
                        if(!bar || !bar.details) return;
                        const siteKey  = bar.details.Site.slice(0, 14);
                        const noteData = ganttNotesMap[siteKey];
                        if(noteData) window.location.href = `/notes/job/${noteData.id}`;
                    },
                    onHover: (e, elements) => {
                        e.native.target.style.cursor = elements.length ? 'pointer' : 'default';
                    },
                    scales: {
                        x: {
                            type: "time",
                            time: { unit: "day", stepSize: 1, tooltipFormat: "dd-MMM-yyyy", displayFormats: { day: "dd-MMM-yy" } },
                            min: minDate, max: defaultMax,
                            ticks: { color: anChartColor() },
                            grid:  { color: anGridColor() }
                        },
                        y: {
                            type: "category",
                            labels: rigSet,
                            ticks: { color: anChartColor(), font: { weight: "bold" } },
                            grid:  { color: anGridColor() }
                        }
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: (ctx) => {
                                    const d = ctx.raw.details;
                                    return [
                                        `Site: ${d.Site}`, `Well: ${d.Well}`, `ETS: ${d.ETS}`,
                                        `Start: ${d.Start}`, `Type: ${d.type}`,
                                        `D.E: ${d.DE || '—'}`,
                                        `DrillOK: ${d.drillok}`, `GeoOK: ${d.geook}`,
                                        `DP Company: ${d.dpCompany}`,
                                        `Dp Requested: ${d.dpReq}`,
                                        `DP Received: ${d.dpReceivedDate || '—'}`,
                                        (() => {
                                            if(!d.dpReq || !d.dpReceivedDate) return 'DP Time: —';
                                            const req = new Date(d.dpReq);
                                            const rec = new Date(d.dpReceivedDate);
                                            if(isNaN(req)||isNaN(rec)) return 'DP Time: —';
                                            return 'DP Time: ' + Math.round((rec-req)/(1000*60*60*24)) + ' days';
                                        })(),
                                        (() => {
                                            if(!d.dpReceivedDate) return 'Approval Time: —';
                                            const rec = new Date(d.dpReceivedDate);
                                            if(isNaN(rec)) return 'Approval Time: —';
                                            return 'Approval Time: ' + Math.round((new Date()-rec)/(1000*60*60*24)) + ' days since received';
                                        })(),
                                        `Duration: ${d.Duration} days`,
                                        `Geo: ${d.geo}`, `Version: ${d.version}`,
                                        `Lat: ${d.surfaceLat || '—'}`, `Lon: ${d.surfaceLon || '—'}`,
                                        ...((d.conflicts && d.conflicts.length) ? [
                                            `⚠️ Proximity conflict (${d.primaryZone}, same dates, <3km):`,
                                            ...d.conflicts.map(c => `   → ${c.site} (${c.distKm} km)`)
                                        ] : []),
                                    ];
                                }
                            }
                        },
                        datalabels: {
                            color: (ctx) => {
                                const bg = ctx.dataset.backgroundColor[ctx.dataIndex] || "#000";
                                const lightBgs = ["#ffff00","#C0C0C0","#FFFFFF","#ffffff","#c0c0c0"];
                                return lightBgs.some(c => bg.toLowerCase() === c.toLowerCase()) ? "#000000" : "#ffffff";
                            },
                            font: { size: 10, weight: "bold" },
                            formatter: (value) => value.site || "",
                            anchor: "start", align: "end", clip: true,
                        },
                        annotation: {
                            annotations: {
                                redBand: {
                                    type: "box", xMin: today, xMax: threeMonthsLater,
                                    backgroundColor: "rgba(255,0,0,0.10)", borderWidth: 0,
                                    drawTime: "beforeDatasetsDraw",
                                },
                                yellowBand: {
                                    type: "box", xMin: threeMonthsLater, xMax: fiveMonthsLater,
                                    backgroundColor: "rgba(255,208,0,0.10)", borderWidth: 0,
                                    drawTime: "beforeDatasetsDraw",
                                },
                                todayLine: {
                                    type: "line", xMin: today, xMax: today,
                                    borderColor: "red", borderWidth: 2,
                                    label: { enabled: true, content: "Today", position: "start", color: "red" },
                                },
                                threeMonthLine: {
                                    type: "line", xMin: threeMonthsLater, xMax: threeMonthsLater,
                                    borderColor: "red", borderWidth: 3, borderDash: [],
                                    label: { enabled: true, content: "+3 Months", position: "start", color: "red" },
                                },
                                ...((['admin','leader','user'].includes(GANTT_USER_ROLE)) ? {
                                    fourMonthLine: {
                                        type: "line",
                                        xMin: new Date(today.getFullYear(), today.getMonth() + 4, today.getDate()),
                                        xMax: new Date(today.getFullYear(), today.getMonth() + 4, today.getDate()),
                                        borderColor: "#000000", borderWidth: 3, borderDash: [],
                                        label: { enabled: true, content: "+4 Months", position: "start", color: "#000000", font: { weight: "bold" } },
                                    },
                                } : {}),
                                // ADDED 2026-09-25: +9 months line, per user — green,
                                // dashed, glowing. Same date arithmetic as the
                                // +3/+4 month lines above. Glow uses the annotation
                                // plugin's own line options borderShadowColor +
                                // shadowBlur (chartjs-plugin-annotation 3.1.0, loaded
                                // in this file). Shown to all roles.
                                nineMonthLine: {
                                    type: "line",
                                    xMin: new Date(today.getFullYear(), today.getMonth() + 9, today.getDate()),
                                    xMax: new Date(today.getFullYear(), today.getMonth() + 9, today.getDate()),
                                    borderColor: "#39ff14", borderWidth: 3, borderDash: [8, 6],
                                    borderShadowColor: "#39ff14", shadowBlur: 12, shadowOffsetX: 0, shadowOffsetY: 0,
                                    label: { enabled: true, content: "+9 Months", position: "start", color: "#39ff14", font: { weight: "bold" } },
                                },
                                // Jan 1 lines — one per year from this year to absoluteMax year
                                ...Object.fromEntries(
                                    Array.from({ length: 3 }, (_, i) => {
                                        const yr = today.getFullYear() + i;
                                        const jan1 = new Date(yr, 0, 1);
                                        return [`jan1_${yr}`, {
                                            type: "line", xMin: jan1, xMax: jan1,
                                            borderColor: "#00c8ff", borderWidth: 1, borderDash: [],
                                            label: { enabled: true, content: `Jan ${yr}`, position: "start", color: "#00c8ff", font: { size: 10 } },
                                        }];
                                    })
                                ),
                            }
                        },
                        zoom: {
                            pan: {
                                enabled: true,
                                mode: "x",
                            },
                            zoom: {
                                wheel: { enabled: true },
                                pinch: { enabled: true },
                                mode: "x",
                            },
                            limits: {
                                x: {
                                    min: minDate.getTime(),
                                    max: absoluteMax.getTime(),
                                    minRange: 7 * 24 * 60 * 60 * 1000,
                                },
                            },
                        }
                    },
                },
                plugins: [ChartDataLabels, {
                    id: "anChartBgPlugin",
                    beforeDraw: (chart) => {
                        if(!anIsLight()) return;
                        const ctx2 = chart.canvas.getContext("2d");
                        ctx2.save();
                        ctx2.globalCompositeOperation = "destination-over";
                        ctx2.fillStyle = "#ffffff";
                        ctx2.fillRect(0, 0, chart.width, chart.height);
                        ctx2.restore();
                    }
                }, {
                    id: "anCornerTrianglePlugin",
                    afterDatasetsDraw: (chart) => {
                        const meta = chart.getDatasetMeta(0);
                        if(!meta || !meta.data) return;
                        const ctx2 = chart.ctx;
                        const TRI = 12;
                        meta.data.forEach((bar, i) => {
                            if(!glowFlags[i]) return;
                            const { x, y, base, height } = bar.getProps(["x","y","base","height"], true);
                            const barRight = Math.max(x, base);
                            const barTop   = y - (height || 16) / 2;
                            ctx2.save();
                            ctx2.beginPath();
                            ctx2.moveTo(barRight, barTop);
                            ctx2.lineTo(barRight - TRI, barTop);
                            ctx2.lineTo(barRight, barTop + TRI);
                            ctx2.closePath();
                            ctx2.fillStyle = "#39ff14";
                            ctx2.fill();
                            ctx2.restore();
                        });
                    }
                }]
            });

            chartInstances2.push(chart);


            // REMOVED 2026-09-24: the status summary table (summaryTable2) and
            // the This Year / Next Year pies that sat under the Gantt were
            // removed per user. Totals are now shown by the "TOTAL" pie in the
            // Snapshot section (renderSnapshotSection), which follows the
            // selected year tick-boxes. colorCounts is still computed above
            // (Gantt bar colours use the same switch) but no longer rendered.

            // Accumulate into compiledRows for the all-VP summary at the bottom
            // Note: compiledRows is accumulated globally across all filter renders
            // so we rebuild it fresh each time ganttApplyAndRender is called
            // by re-running renderChartsFromTable on every filter change.
            // compiledRows is reset in renderChartsFromTable above.

        }


    function renderNewScheduleGantt(){
        try {
            console.log('[newSchedGantt] renderNewScheduleGantt() starting…');
            const dataEl = document.getElementById('newScheduleGanttData');
            console.log('[newSchedGantt] newScheduleGanttData element found:', !!dataEl);
            if (dataEl) {
                const raw = JSON.parse(dataEl.textContent);
                console.log('[newSchedGantt] headers:', raw.headers ? raw.headers.length : 0, '| rows:', raw.rows ? raw.rows.length : 0);
            }
            buildNewScheduleGanttBars();
            console.log('[newSchedGantt] ganttAllBars2 built:', ganttAllBars2.length, 'bars');
            if (!ganttAllBars2.length) {
                console.warn('[newSchedGantt] No bars built — check that "Rig" and "Est. Start Date" columns exist and have values.');
            }
            const chartDiv2 = document.getElementById('chartDiv2');
            console.log('[newSchedGantt] chartDiv2 element found:', !!chartDiv2);
            if (!ganttFiltersBuilt2) ganttBuildAllFilters2();
            // ADDED 2026-09-14: build the Snapshot year tickboxes once, before
            // the first ganttApplyAndRender2() call, so its call to
            // renderSnapshotSection() (guarded by snapshotTicksBuilt above)
            // has ticks in the DOM to read on the initial render too.
            // ADDED 2026-09-14: wire the Pie/Stacked Bars toggle at the same
            // guarded init point as buildSnapshotYearTicks() below, so the
            // click handlers are attached exactly once even though
            // renderNewScheduleGantt() itself can run more than once.
            if (!snapshotTicksBuilt) { buildSnapshotYearTicks(); wireSnapshotChartTypeToggle(); }
            ganttApplyAndRender2();
            console.log('[newSchedGantt] renderNewScheduleGantt() complete.');
        } catch (err) {
            console.error('[newSchedGantt] ERROR in renderNewScheduleGantt:', err);
        }
    }

    window.renderNewScheduleGantt = renderNewScheduleGantt;

    document.addEventListener('DOMContentLoaded', function(){
        // Run after the original Gantt setup so shared globals (ganttNotesMap,
        // inProgressSites, etc.) and Chart.js/plugins are already available.
        renderNewScheduleGantt();
    });
})();
</script>























