                canvas.className = 'bar-chart';
                col.appendChild(canvas);
                pieRow.appendChild(col);

                const datasets = SNAPSHOT_LABELS.map((label, i) => ({
                    label,
                    data: SNAPSHOT_AREAS.map(area => countsByArea[area][label]),
                    backgroundColor: SNAPSHOT_COLORS[i]
                }));

                const chart = new Chart(canvas.getContext('2d'), {
                    type: 'bar',
                    data: {
                        labels: SNAPSHOT_AREAS,
                        datasets
                    },
                    options: {
                        scales: {
                            x: { stacked: true, ticks: { color: anChartColor() }, grid: { color: anGridColor() } },
                            y: { stacked: true, ticks: { color: anChartColor() }, grid: { color: anGridColor() } }
                        },
                        plugins: {
                            title: { display:true, text:`${year} — Wells by Region`, color: anChartColor(), font:{size:12,weight:"normal"} },
                            legend: { position:"bottom", labels:{ color: anChartColor(), font:{ size:8 }, boxWidth:10, padding:4 } }
                        }
                    }
                });
                snapshotChartInstances2.push(chart);
            } else {
                SNAPSHOT_AREAS.forEach(area => {
                    const counts = countsByArea[area];
                    const total  = SNAPSHOT_LABELS.reduce((s,l) => s + counts[l], 0);

                    // CHANGED 2026-09-14: tighter columns (was 'col-md-3' with
                    // a 180px min-width inside a Bootstrap .row — replaced by
                    // the flex 'snapshot-pie-row' above), no legend (removed
                    // per spec), title font and datalabel (%) font both 2.5x
                    // their previous size (12->30, 9->22.5) so the pies stay
                    // legible in a screenshot.
                    // CHANGED 2026-09-14 (round 2): chart size doubled per
                    // user feedback ("chart size is wrong, make it 2x
                    // bigger") — column min/max-width doubled (160/260 ->
                    // 320/520) and the canvas now uses the dedicated
                    // .snapshot-pie-chart class (900px cap) instead of the
                    // shared .pie-chart class, so the This Year/Next Year
                    // pies above are unaffected.
                    const col = document.createElement('div');
                    col.className = 'snapshot-pie-col';
                    col.style.cssText = 'flex:1 1 0;min-width:320px;max-width:520px;';
                    const canvas = document.createElement('canvas');
                    canvas.className = 'snapshot-pie-chart';
                    col.appendChild(canvas);
                    pieRow.appendChild(col);

                    const chart = new Chart(canvas.getContext('2d'), {
                        type: 'pie',
                        data: {
                            labels: SNAPSHOT_LABELS,
                            datasets: [{
                                data: SNAPSHOT_LABELS.map(l => counts[l]),
                                backgroundColor: SNAPSHOT_COLORS,
                                borderColor: '#333',
                                borderWidth: 1
                            }]
                        },
                        plugins: [ChartDataLabels],
                        options: {
                            layout: { padding: 0 },
                            plugins: {
                                title: { display:true, text:`${area}: ${total} Wells`, color: anChartColor(), font:{size:30,weight:"normal"} },
                                legend: { display:false },
                                datalabels: {
                                    color: (ctx) => {
                                        const bg = ctx.dataset.backgroundColor[ctx.dataIndex] || "#000";
                                        const lightBgs = ["#ffff00","#C0C0C0","#FFFFFF","#ffffff","#ff8c00"]; // #ff8c00 added 2026-09-24 (Vendor On It)
                                        return lightBgs.some(col => bg.toLowerCase() === col.toLowerCase()) ? "#000" : "#fff";
                                    },
                                    font:{weight:"bold",size:22.5},
                                    formatter:(v,ctx)=>{ const t=ctx.chart.data.datasets[0].data.reduce((a,b)=>a+b,0); return (v&&t)?Math.round(v/t*100)+"%":""; }
                                }
                            }
                        }
                    });
                    snapshotChartInstances2.push(chart);
                });
            }

            yearBlock.appendChild(pieRow);

            // Unassigned count — visible note under the 4-pie row rather than
            // a 5th pie, per spec ("your judgement on exact placement, but
