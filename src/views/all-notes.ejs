            pieRow.className = 'snapshot-pie-row';
            pieRow.style.cssText = 'display:flex;flex-wrap:wrap;gap:4px;';

            if(chartType === 'bar'){
                // ADDED 2026-09-14: "Stacked Bars" branch of the Snapshot
                // chart-type toggle. Replaces the 4-separate-pies-per-year
                // layout with ONE Chart.js stacked bar chart per year: one
                // bar per region (East/Central/West/Thermal) on the x-axis,
