                                                    <td><%= note.project %></td>
                                                    <td><%= note.area %></td>
                                                    <td><%= note.wells %></td>
                                                    <!-- <td><%= note.budget %></td> -->
                                                    <td><%= note.poc %></td>
                                                    <td><%= note.geologist %></td>
                                                    <td><%= note.rig %></td>
                                                    <!-- <td><%= note.responsible %></td> -->
                                                    <!-- <td><small><%= note.dueDate %></small></td> -->
                                                    <% if (user.role == 'admin') { %>
                                                        <td onclick="event.stopPropagation();">
                                                            <form action="/notes/delete/<%= note._id %>?_method=delete" method="post"
                                                                  class="m-0"
                                                                  onsubmit="return confirm('Delete job <%= note.mtxJobId %> (<%= note.title %>) permanently? This cannot be undone.');">
                                                                <input type="hidden" name="_method" value="delete">
                                                                <button type="submit" class="btn btn-danger btn-sm">🗑 Delete</button>
                                                            </form>
                                                        </td>
                                                    <% } %>
                                                </tr>
                                            <% } %>
                                        <% } %>
                                    <% }) %>
                                </tbody>
                            </table>
                            <% if (user.role == 'admin') { %>
                            <script>
                                // Added 2026-09-14: bulk-select/delete for the Archived table above.
                                // Range-select: click a row's checkbox, then Alt+click another row's
                                // checkbox to select every row in between (Explorer/Gmail-style
                                // shift-click, rebound to Alt per the person's request). Only a plain
                                // click moves the "anchor" row; Alt+click always extends/shrinks the
                                // range from the last plain-clicked row.
                                let archivedLastCheckedIdx = null;
                                function archivedRowCheckClick(e, cb){
                                    const checks = Array.from(document.querySelectorAll('.archived-row-check'));
                                    const idx = checks.indexOf(cb);
                                    if(e.altKey && archivedLastCheckedIdx !== null){
                                        const start = Math.min(archivedLastCheckedIdx, idx);
                                        const end = Math.max(archivedLastCheckedIdx, idx);
                                        for(let i = start; i <= end; i++){ checks[i].checked = true; }
                                    } else {
                                        archivedLastCheckedIdx = idx;
                                    }
                                    archivedUpdateSelectedCount();
                                }
                                function archivedUpdateSelectedCount(){
                                    const checks = document.querySelectorAll('.archived-row-check');
                                    const checked = Array.from(checks).filter(c => c.checked);
                                    document.getElementById('archivedSelectedCount').textContent = checked.length;
                                    document.getElementById('archivedBulkDeleteBtn').disabled = checked.length === 0;
                                    const allCb = document.getElementById('archivedSelectAll');
                                    if(allCb) allCb.checked = checks.length > 0 && checked.length === checks.length;
                                }
                                function archivedToggleAll(sourceCb){
                                    document.querySelectorAll('.archived-row-check').forEach(c => { c.checked = sourceCb.checked; });
                                    archivedUpdateSelectedCount();
                                }
                                function archivedBulkDeleteSubmit(e){
                                    const checked = Array.from(document.querySelectorAll('.archived-row-check')).filter(c => c.checked);
                                    if(checked.length === 0) return false; // button is disabled in this case anyway
                                    if(!confirm('Delete ' + checked.length + ' selected job(s) permanently? This cannot be undone.')) return false;
                                    const form = document.getElementById('archivedBulkDeleteForm');
                                    // remove any hidden ids[] inputs from a previous (cancelled/failed) attempt
                                    form.querySelectorAll('input[name="ids[]"]').forEach(el => el.remove());
                                    checked.forEach(cb => {
                                        const hidden = document.createElement('input');
                                        hidden.type = 'hidden';
                                        hidden.name = 'ids[]';
                                        hidden.value = cb.value;
                                        form.appendChild(hidden);
                                    });
                                    return true;
                                }
                            </script>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% } %>








