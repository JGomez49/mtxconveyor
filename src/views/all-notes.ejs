                                                <tr onclick="window.location.href='/notes/job/<%= note._id %>';">
                                                    <% if (user.role == 'admin') { %>
                                                        <td onclick="event.stopPropagation();">
                                                            <input type="checkbox" class="archived-row-check" value="<%= note._id %>" onclick="archivedRowCheckClick(event, this)">
                                                        </td>
                                                    <% } %>
