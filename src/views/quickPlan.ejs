          <option value="tvd_inc_az" ${kind==='tvd_inc_az'?'selected':''}>TVD, Inc, Az</option>
          <option value="dls_inc_az" ${kind==='dls_inc_az'?'selected':''}>DLS, Inc, Az</option>
          <option value="hold_tvd" ${kind==='hold_tvd'?'selected':''}>HOLD to TVD</option>
          <option value="build_turn_cl" ${kind==='build_turn_cl'?'selected':''}>Build + Turn + CL</option>
          <option value="tvd_dls_az" ${kind==='tvd_dls_az'?'selected':''}>TVD, DLS, Az</option>
        </select>
      </div>
