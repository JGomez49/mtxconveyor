    <div class="modal-field" style="display:flex;align-items:center;gap:8px;">
      <input type="checkbox" id="hbhbhChk_${f.key}" onchange="hbhbhOnCheckChange()" style="width:auto;flex-shrink:0;">
      <label style="flex:1;margin:0;">${f.label}</label>
      <input type="number" id="hbhbhVal_${f.key}" step="0.1" value="${f.def}" style="width:110px;">
    </div>`).join('');

  overlay.innerHTML = `
    <div class="modal" style="width:420px;">
      <h3>Build-Hold-Build-Hold to Target</h3>
      <div class="modal-sub">Check exactly 2 unknowns to solve; the other 5 boxes are used as-entered. Path:
        Hold &rarr; Build to Max Angle &rarr; Hold &rarr; Build to Final Inc (can be higher or lower than
        Max Angle) &rarr; Hold, ending at target. Requires the trajectory to be vertical (Inc = 0&deg;) where
        this design starts &mdash; appended sections go at the end of the current plan.</div>

      <div class="modal-field">
        <label>Target</label>
        <select id="hbhbhTarget" class="type-select" onchange="hbhbhRenderPreview()">${targetOptions}</select>
      </div>
      <div class="note" id="hbhbhPreview" style="margin-bottom:10px;"></div>

      ${fieldRows}
      <div class="note" id="hbhbhCheckCount" style="margin-top:4px;"></div>
      <div class="note" id="hbhbhError" style="color:var(--bad);"></div>

      <div class="modal-actions">
        <button class="secondary" onclick="closeHbhbhWizard()">Cancel</button>
        <button onclick="solveAndInsertHbhbh()">Solve &amp; Insert</button>
      </div>
    </div>`;
  document.body.appendChild(overlay);
  // Default: pre-check Max Angle + Final Inc as the unknowns to solve (a common
  // pairing — you fix both build rates and both hold lengths, solve the angles).
  document.getElementById('hbhbhChk_thetaMax').checked = true;
  document.getElementById('hbhbhChk_thetaFinal').checked = true;
  hbhbhRenderPreview();
