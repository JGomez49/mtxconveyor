// closeAfter=true -> "Save" (apply + close). closeAfter=false -> "Apply" (apply, stays open).
function saveSectionModal(index, closeAfter){
  const obj = readModalSectionObject();
  if (index >= sections.length) sections.push(obj); else sections[index] = obj;
  renderSections();
  recompute();
  if (closeAfter){ closeSectionModal(); }
  else {
    const overlay = document.getElementById('sectionModalOverlay');
    overlay.dataset.data = JSON.stringify(obj);
  }
}

/* ============================================================
   BUILD & HOLD TO TARGET — wizard: pick a target, check 2 of the
   4 knobs (1st Hold Len, 1st Build DLS, Max Angle, 2nd Hold Len),
   solve the other 2, and append the resulting Hold/Build/Hold
   sections. Requires the well to be vertical (Inc=0) entering the
   design — see solveBuildHoldToTarget() above for why.
   ============================================================ */
const BH_FIELDS = [
  {key:'D1',    label:'1st Hold Len (m)',   def:200},
  {key:'dls',   label:'1st Build (DLS, °/30m)', def:3},
  {key:'theta', label:'Max Angle (Inc, °)', def:45},
  {key:'L2',    label:'2nd Hold Len (m)',   def:200}
];

function r1FromDls(dls){ return (180*30)/(Math.PI*dls); } // meters
function dlsFromR1(r1){ return (180*30)/(Math.PI*r1); }   // deg/30m

function openBuildHoldWizard(){
  if (targets.length === 0){ alert('Add at least one target first.'); return; }
  const overlay = document.createElement('div');
  overlay.className = 'modal-overlay';
  overlay.id = 'bhModalOverlay';
  overlay.onclick = (e)=>{ if (e.target===overlay) closeBuildHoldWizard(); };

  const targetOptions = targets.map((t,i)=>`<option value="${i}">${t.name}</option>`).join('');
  const fieldRows = BH_FIELDS.map(f => `
    <div class="modal-field" style="display:flex;align-items:center;gap:8px;">
      <input type="checkbox" id="bhChk_${f.key}" onchange="bhOnCheckChange('${f.key}')" style="width:auto;flex-shrink:0;">
      <label style="flex:1;margin:0;">${f.label}</label>
      <input type="number" id="bhVal_${f.key}" step="0.1" value="${f.def}" style="width:110px;">
    </div>`).join('');

  overlay.innerHTML = `
    <div class="modal" style="width:400px;">
      <h3>Build &amp; Hold to Target</h3>
      <div class="modal-sub">Check exactly 2 knowns; the other 2 are solved. Requires the trajectory to be
        vertical (Inc = 0°) where this design starts — appended sections go at the end of the current plan.</div>

      <div class="modal-field">
        <label>Target</label>
        <select id="bhTarget" class="type-select" onchange="bhRenderPreview()">${targetOptions}</select>
      </div>
      <div class="note" id="bhPreview" style="margin-bottom:10px;"></div>

      ${fieldRows}
      <div class="note" id="bhCheckCount" style="margin-top:4px;"></div>
      <div class="note" id="bhError" style="color:var(--bad);"></div>

      <div class="modal-actions">
        <button class="secondary" onclick="closeBuildHoldWizard()">Cancel</button>
        <button onclick="solveAndInsertBuildHold()">Solve &amp; Insert</button>
      </div>
    </div>`;
  document.body.appendChild(overlay);
  // Default: pre-check DLS + Max Angle (a common starting pair), like the
  // reference tool's own default of two checked boxes.
  document.getElementById('bhChk_dls').checked = true;
  document.getElementById('bhChk_theta').checked = true;
  bhRenderPreview();
  bhOnCheckChange();
}

function bhRenderPreview(){
  const t = targets[document.getElementById('bhTarget').value];
  document.getElementById('bhPreview').textContent =
    `TVD ${t.tvd.toFixed(1)} m · N ${t.n.toFixed(1)} m · E ${t.e.toFixed(1)} m · R ${t.r} m`;
}

function bhOnCheckChange(){
  const checked = BH_FIELDS.filter(f => document.getElementById('bhChk_'+f.key).checked);
  const countEl = document.getElementById('bhCheckCount');
  countEl.textContent = `${checked.length} of 4 checked (need exactly 2).`;
  countEl.style.color = checked.length===2 ? 'var(--muted)' : 'var(--bad)';
  BH_FIELDS.forEach(f => {
    const isChecked = document.getElementById('bhChk_'+f.key).checked;
    document.getElementById('bhVal_'+f.key).disabled = !isChecked;
  });
}

function closeBuildHoldWizard(){
  const overlay = document.getElementById('bhModalOverlay');
  if (overlay) overlay.remove();
}

function solveAndInsertBuildHold(){
  const errEl = document.getElementById('bhError');
  errEl.textContent = '';

  const checkedKeys = BH_FIELDS.filter(f => document.getElementById('bhChk_'+f.key).checked).map(f=>f.key);
  if (checkedKeys.length !== 2){
    errEl.textContent = 'Check exactly 2 knowns (you have ' + checkedKeys.length + ').';
    return;
  }

  const end = getTrajectoryEndState();
  if (Math.abs(end.inc) > 0.05){
    errEl.textContent = `This design requires the well to be vertical (Inc=0°) where it starts — ` +
      `current trajectory ends at Inc ${end.inc.toFixed(2)}°. Remove/adjust trailing sections first.`;
    return;
  }

  const t = targets[document.getElementById('bhTarget').value];
  const X = Math.hypot(t.n - end.n, t.e - end.e);
  const D3 = t.tvd - end.tvd;
  let targetAz = Math.atan2(t.e - end.e, t.n - end.n) * R2D;
  if (targetAz < 0) targetAz += 360;

  // Map UI keys (dls) to solver keys (r1) — solve in r1-space, convert at the boundary.
  const known = {};
  const unknownsSolver = [];
  BH_FIELDS.forEach(f => {
    const solverKey = f.key === 'dls' ? 'r1' : f.key;
    if (checkedKeys.includes(f.key)){
      const raw = parseFloat(document.getElementById('bhVal_'+f.key).value) || 0;
      known[solverKey] = (f.key==='dls') ? r1FromDls(raw) : raw;
    } else {
      unknownsSolver.push(solverKey);
    }
  });

  const result = solveBuildHoldToTarget(unknownsSolver, known, X, D3);
  if (!result || !isFinite(result.D1) || !isFinite(result.r1) || !isFinite(result.theta) || !isFinite(result.L2) ||
      result.theta <= 0 || result.theta >= 180 || result.r1 <= 0){
    errEl.textContent = 'No physically valid solution found for this combination of knowns and this target — try a different pair of checkboxes or values.';
    return;
  }

  const { D1, r1, theta, L2 } = result;
  const dls = dlsFromR1(r1);
  const buildCL = theta * 30 / dls;

  if (D1 > 1e-6) sections.push({ kind:'hold', cl: D1 });
  if (buildCL > 1e-6) sections.push({ kind:'direct', inc: theta, az: targetAz, cl: buildCL });
  if (L2 > 1e-6) sections.push({ kind:'hold', cl: L2 });

  closeBuildHoldWizard();
  renderSections();
  recompute();
}

/* ============================================================
   BUILD-HOLD-BUILD-HOLD TO TARGET — the 5-segment generalization
   of the wizard above: Hold(D1) -> Build(r1) to Max Angle (thetaMax)
   -> Hold(D2) at thetaMax -> Build(r2) to Final Inc (thetaFinal,
   which may be above OR below thetaMax - a true build-then-drop
   S-shape is allowed) -> Hold(L3) at thetaFinal, ending at target.
   Same governing planar geometry as solveBuildHoldToTarget above
   (each build leg is the same verified circular-arc relation,
   ΔTVD=R(sinα2-sinα1), ΔX=R(cosα1-cosα2), which is Bourgoyne Eqs.
   8.9/8.12 generalized from a zero start angle to an arbitrary
   one); azimuth stays fixed toward the target and requires
   Inc≈0° entering the design, exactly like the 4-parameter wizard.
   Any 2 of the 7 parameters {D1, r1, thetaMax, D2, r2, thetaFinal,
   L3} may be picked as knowns; the system
     X   = r1(1-cos thetaMax) + D2 sin thetaMax
           + r2(cos thetaMax - cos thetaFinal) + L3 sin thetaFinal
     TVD = D1 + r1 sin thetaMax + D2 cos thetaMax
           + r2(sin thetaFinal - sin thetaMax) + L3 cos thetaFinal
   is linear in {D1,r1,D2,r2,L3} and nonlinear (trig) only in
   {thetaMax, thetaFinal}, so unlike the 4-parameter case (6
   combinations, each hand-solved in closed form) there are 21
   combinations here — instead of hand-deriving each one, this
   solves the 2x2 system with damped Newton-Raphson (numeric
   Jacobian) and a small multi-start grid for robustness, since
   Newton's method converges in 1-2 steps whenever both unknowns
   are linear and reliably converges for the trig cases too. All
   21 combinations were verified in isolation against known ground
   truth (recovered to <1e-3, effectively machine precision) before
   this was wired in.
   ============================================================ */
const HBHBH_KEYS = ['D1','r1','thetaMax','D2','r2','thetaFinal','L3'];
const HBHBH_ANGLE_KEYS = new Set(['thetaMax','thetaFinal']);

function hbhbhTotals(p){
  const th1 = p.thetaMax*D2R, th2 = p.thetaFinal*D2R;
  const s1=Math.sin(th1), c1=Math.cos(th1), s2=Math.sin(th2), c2=Math.cos(th2);
  const X = p.r1*(1-c1) + p.D2*s1 + p.r2*(c1-c2) + p.L3*s2;
  const TVD = p.D1 + p.r1*s1 + p.D2*c1 + p.r2*(s2-s1) + p.L3*c2;
  return { X, TVD };
}

function hbhbhResidual(u1key, u1val, u2key, u2val, known, Xt, Dt){
  const p = Object.assign({}, known, { [u1key]: u1val, [u2key]: u2val });
  const t = hbhbhTotals(p);
  return [t.X - Xt, t.TVD - Dt];
}

function hbhbhClamp(key, v){
  if (HBHBH_ANGLE_KEYS.has(key)) return Math.min(179.9, Math.max(0.1, v));
  return Math.max(0, v);
}

function hbhbhNewton(u1key, u2key, known, Xt, Dt, g1, g2){
  let u1 = g1, u2 = g2;
  for (let it = 0; it < 150; it++){
    const h1 = HBHBH_ANGLE_KEYS.has(u1key) ? 1e-4 : Math.max(1e-4, Math.abs(u1)*1e-6 + 1e-4);
    const h2 = HBHBH_ANGLE_KEYS.has(u2key) ? 1e-4 : Math.max(1e-4, Math.abs(u2)*1e-6 + 1e-4);
    const f0 = hbhbhResidual(u1key, u1, u2key, u2, known, Xt, Dt);
    const fp1 = hbhbhResidual(u1key, u1+h1, u2key, u2, known, Xt, Dt);
    const fp2 = hbhbhResidual(u1key, u1, u2key, u2+h2, known, Xt, Dt);
    const J = [[(fp1[0]-f0[0])/h1, (fp2[0]-f0[0])/h2],
               [(fp1[1]-f0[1])/h1, (fp2[1]-f0[1])/h2]];
    const det = J[0][0]*J[1][1] - J[0][1]*J[1][0];
    if (!isFinite(det) || Math.abs(det) < 1e-12) return null;
    let d1 = (-f0[0]*J[1][1] + f0[1]*J[0][1]) / det;
    let d2 = (-J[0][0]*f0[1] + J[1][0]*f0[0]) / det;
    const maxAngleStep = 15, maxLenStep = Math.max(200, Math.abs(u1) + Math.abs(u2));
    d1 = HBHBH_ANGLE_KEYS.has(u1key) ? Math.max(-maxAngleStep, Math.min(maxAngleStep, d1))
                                      : Math.max(-maxLenStep, Math.min(maxLenStep, d1));
    d2 = HBHBH_ANGLE_KEYS.has(u2key) ? Math.max(-maxAngleStep, Math.min(maxAngleStep, d2))
                                      : Math.max(-maxLenStep, Math.min(maxLenStep, d2));
    const nu1 = hbhbhClamp(u1key, u1+d1), nu2 = hbhbhClamp(u2key, u2+d2);
    if (!isFinite(nu1) || !isFinite(nu2)) return null;
    const converged = Math.abs(nu1-u1) < 1e-9 && Math.abs(nu2-u2) < 1e-9;
    u1 = nu1; u2 = nu2;
    if (converged){
      const chk = hbhbhResidual(u1key, u1, u2key, u2, known, Xt, Dt);
      return (Math.hypot(chk[0], chk[1]) < 1e-6) ? { [u1key]: u1, [u2key]: u2 } : null;
    }
  }
  const chk = hbhbhResidual(u1key, u1, u2key, u2, known, Xt, Dt);
  return (Math.hypot(chk[0], chk[1]) < 1e-4) ? { [u1key]: u1, [u2key]: u2 } : null;
}

function hbhbhInitGuesses(key){
  if (HBHBH_ANGLE_KEYS.has(key)) return [10, 30, 60, 90, 120, 150];
  if (key === 'r1' || key === 'r2') return [300, 573, 1000, 150];
  return [100, 300, 600, 50];
}

function solveHBHBHToTarget(unknowns, known, X, Dt){
  const [u1key, u2key] = unknowns;
  for (const g1 of hbhbhInitGuesses(u1key)){
    for (const g2 of hbhbhInitGuesses(u2key)){
      const res = hbhbhNewton(u1key, u2key, known, X, Dt, g1, g2);
      if (!res) continue;
      const full = Object.assign({}, known, res);
      if (full.thetaMax < 0 || full.thetaMax > 179.9) continue;
      if (full.thetaFinal < 0 || full.thetaFinal > 179.9) continue;
      if (full.D1 < 0 || full.D2 < 0 || full.L3 < 0 || full.r1 <= 0 || full.r2 <= 0) continue;
      return full;
    }
  }
  return null;
}

const HBHBH_FIELDS = [
  {key:'D1',         label:'1st Hold Len (m)',       def:200},
  {key:'dls1',       label:'1st Build (DLS, °/30m)', def:3},
  {key:'thetaMax',   label:'Max Angle (Inc, °)',     def:60},
  {key:'D2',         label:'2nd Hold Len (m)',       def:200},
  {key:'dls2',       label:'2nd Build (DLS, °/30m)', def:2},
  {key:'thetaFinal', label:'Final Inc (°)',          def:35},
  {key:'L3',         label:'Final Hold (m)',         def:300}
];

function openHbhbhWizard(){
  if (targets.length === 0){ alert('Add at least one target first.'); return; }
  const overlay = document.createElement('div');
  overlay.className = 'modal-overlay';
  overlay.id = 'hbhbhModalOverlay';
