  const countEl = document.getElementById('hbhbhCheckCount');
  countEl.textContent = `${checked.length} of 7 marked unknown (need exactly 2). Unchecked boxes are used as knowns.`;
  countEl.style.color = checked.length===2 ? 'var(--muted)' : 'var(--bad)';
  HBHBH_FIELDS.forEach(f => {
