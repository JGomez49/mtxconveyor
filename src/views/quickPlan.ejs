          <option value="dlstf_az" ${kind==='dlstf_az'?'selected':''}>DLS + Toolface + until Az</option>
          <option value="dlstf_tvd" ${kind==='dlstf_tvd'?'selected':''}>DLS + Toolface + until TVD</option>
