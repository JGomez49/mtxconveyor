let targets = []; // {name, n, e, tvd, r}
let sections = []; // {kind:'direct'|'hold'|'dlstf'|'dlstf_inc'|'dlstf_az', ...}
let stations = []; // computed: {md, inc, az, tvd, n, e, dls30}
let wellStart = {inc:0, az:0}; // orientation at surface/MD=0 — not always vertical (e.g. sidetracks)

/* ============================================================
   TARGETS UI
   ============================================================ */
function addTargetRow(n=0,e=0,tvd=1000,r=15){
  targets.push({name:'T'+(targets.length+1), n, e, tvd, r});
  renderTargets();
  recompute();
}
function removeTarget(i){ targets.splice(i,1); renderTargets(); recompute(); }
function renderTargets(){
  const tbody = document.querySelector('#targetsTable tbody');
  tbody.innerHTML = '';
  targets.forEach((t,i)=>{
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td><input type="text" value="${t.name}" onchange="targets[${i}].name=this.value"></td>
      <td><input type="number" step="0.1" value="${t.n}" onchange="targets[${i}].n=parseFloat(this.value)||0;recompute()"></td>
      <td><input type="number" step="0.1" value="${t.e}" onchange="targets[${i}].e=parseFloat(this.value)||0;recompute()"></td>
      <td><input type="number" step="0.1" value="${t.tvd}" onchange="targets[${i}].tvd=parseFloat(this.value)||0;recompute()"></td>
      <td><input type="number" step="0.1" value="${t.r}" onchange="targets[${i}].r=parseFloat(this.value)||0;recompute()"></td>
      <td><button class="danger small-btn" onclick="removeTarget(${i})">x</button></td>`;
    tbody.appendChild(tr);
  });
}

/* ============================================================
   SECTIONS UI — compact summary cards + a modal for data entry
   ============================================================ */
function removeSection(i){ sections.splice(i,1); renderSections(); recompute(); }
function clearSections(){ sections=[]; renderSections(); recompute(); }

const KIND_LABEL = {
  direct:'Direct Inc/Az + CL',
  hold:'HOLD (DLS = 0)',
  dlstf:'DLS + Toolface + CL',
  dlstf_inc:'DLS + Toolface + until Inc',
  dlstf_az:'DLS + Toolface + until Az',
  dlstf_tvd:'DLS + Toolface + until TVD',
  md_inc_az:'MD, Inc, Az',
  tvd_inc_az:'TVD, Inc, Az',
  dls_inc_az:'DLS, Inc, Az',
  hold_tvd:'HOLD to TVD',
  build_turn_cl:'Build + Turn + CL',
  tvd_dls_az:'TVD, DLS, Az'
};

function renderSections(){
  const list = document.getElementById('sectionsList');
  list.innerHTML = '';
  if (sections.length===0){
    list.innerHTML = '<div class="note">No sections yet. Click "+ Add Section" to define the well path from surface.</div>';
    return;
  }
  let curInc=wellStart.inc, curAz=wellStart.az, curTvd=0, curMd=0;
  sections.forEach((s,i)=>{
    const card = document.createElement('div');
    card.className = 'section-card';
    const res = resolveSectionEndpoint(curInc, curAz, curTvd, curMd, s);
    let paramsLine;

    if (s.kind==='direct'){
      paramsLine = `Inc &rarr; ${s.inc.toFixed(1)}&deg; &middot; Az &rarr; ${s.az.toFixed(1)}&deg; &middot; CL ${s.cl.toFixed(0)} m`;
    } else if (s.kind==='hold'){
      paramsLine = `CL ${s.cl.toFixed(0)} m &middot; DLS 0&deg;/30m`;
    } else if (s.kind==='dlstf'){
      paramsLine = `DLS ${s.dls.toFixed(1)}&deg;/30m &middot; TF ${s.tf.toFixed(0)}&deg; &middot; CL ${s.cl.toFixed(0)} m`;
    } else if (s.kind==='dlstf_inc'){
      paramsLine = `DLS ${s.dls.toFixed(1)}&deg;/30m &middot; TF ${s.tf.toFixed(0)}&deg; &middot; until Inc ${s.targetInc.toFixed(1)}&deg;
        <br>CL (auto): ${res.cl>0 ? res.cl.toFixed(1)+' m' : '—'}`;
    } else if (s.kind==='dlstf_az'){
      paramsLine = `DLS ${s.dls.toFixed(1)}&deg;/30m &middot; TF ${s.tf.toFixed(0)}&deg; &middot; until Az ${s.targetAz.toFixed(1)}&deg;
        <br>CL (auto): ${res.cl>0 ? res.cl.toFixed(1)+' m' : '—'}`;
    } else if (s.kind==='dlstf_tvd'){
      paramsLine = `DLS ${s.dls.toFixed(1)}&deg;/30m &middot; TF ${s.tf.toFixed(0)}&deg; &middot; until TVD ${s.targetTvd.toFixed(1)} m
        <br>CL (auto): ${res.cl>0 ? res.cl.toFixed(1)+' m' : '—'}`;
    } else if (s.kind==='md_inc_az'){
      paramsLine = `Target MD ${s.targetMd.toFixed(0)} m &middot; Inc &rarr; ${s.inc.toFixed(1)}&deg; &middot; Az &rarr; ${s.az.toFixed(1)}&deg;`;
    } else if (s.kind==='tvd_inc_az'){
      paramsLine = `Target TVD ${s.targetTvd.toFixed(1)} m &middot; Inc &rarr; ${s.inc.toFixed(1)}&deg; &middot; Az &rarr; ${s.az.toFixed(1)}&deg;
        <br>CL (auto): ${res.cl>0 ? res.cl.toFixed(1)+' m' : '—'}`;
    } else if (s.kind==='dls_inc_az'){
      paramsLine = `DLS ${s.dls.toFixed(1)}&deg;/30m &middot; Inc &rarr; ${s.inc.toFixed(1)}&deg; &middot; Az &rarr; ${s.az.toFixed(1)}&deg;
        <br>CL (auto): ${res.cl>0 ? res.cl.toFixed(1)+' m' : '—'}`;
    } else if (s.kind==='hold_tvd'){
      paramsLine = `HOLD until TVD ${s.targetTvd.toFixed(1)} m
        <br>CL (auto): ${res.cl>0 ? res.cl.toFixed(1)+' m' : '—'}`;
    } else if (s.kind==='build_turn_cl'){
      paramsLine = `Build ${s.buildRate.toFixed(1)}&deg;/30m &middot; Turn ${s.turnRate.toFixed(1)}&deg;/30m &middot; CL ${s.cl.toFixed(0)} m`;
    } else if (s.kind==='tvd_dls_az'){
      paramsLine = `DLS ${s.dls.toFixed(1)}&deg;/30m &middot; until Az ${s.targetAz.toFixed(1)}&deg; &amp; TVD ${s.targetTvd.toFixed(1)} m
        <br>Toolface (auto): ${(!res.warning && res.tf!==undefined) ? res.tf.toFixed(1)+'°' : '—'} &middot; CL (auto): ${res.cl>0 ? res.cl.toFixed(1)+' m' : '—'}`;
    }

    const resultLine = res.warning
      ? `<span class="badge bad">${res.warning}</span>`
      : `&rarr; Inc ${res.endInc.toFixed(1)}&deg; / Az ${res.endAz.toFixed(1)}&deg; / TVD ${(curTvd+res.dTvd).toFixed(1)} m`;

    card.innerHTML = `
      <div class="top">
        <div>
          <div class="title"><span class="idx">#${i+1}</span>${KIND_LABEL[s.kind]}</div>
          <div class="params">${paramsLine}</div>
          <div class="result">${resultLine}</div>
        </div>
        <div class="card-actions">
          <button class="secondary icon-btn" onclick="openSectionModal(${i})">Edit</button>
          <button class="danger icon-btn" onclick="removeSection(${i})">x</button>
        </div>
      </div>`;
    list.appendChild(card);
    curInc = res.endInc; curAz = res.endAz; curTvd = curTvd + res.dTvd; curMd = curMd + res.cl;
  });
}

