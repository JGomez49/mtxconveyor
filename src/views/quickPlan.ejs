  const isNew = index >= sections.length;
  const existing = isNew ? null : sections[index];
  const kind = existing ? existing.kind : (index===0 ? 'direct' : 'hold');

  const overlay = document.createElement('div');
  overlay.className = 'modal-overlay';
  overlay.id = 'sectionModalOverlay';
  overlay.onclick = (e)=>{ if (e.target===overlay) closeSectionModal(); };

  const d = existing || {};
  overlay.innerHTML = `
    <div class="modal">
      <h3>${isNew ? 'Add Section' : 'Edit Section'} #${index+1}</h3>

      <div class="modal-field">
        <label>Section type</label>
        <select id="mKind" class="type-select" onchange="renderModalFields()">
          <option value="direct" ${kind==='direct'?'selected':''}>Direct Inc/Az + CL</option>
