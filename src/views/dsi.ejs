  return (r.bha || []).map(function(c){ var k = String(c.name || '').trim().toLowerCase();
    return { name: c.name, od: c.od_m / 0.0254, id: c.id_m / 0.0254, len: +c.len, material: c.material || mm[k] || (NM_RE.test(c.name || '') ? 'Non-mag' : 'Steel') }; }).filter(function(x){ return x.len > 0; });   // saved T&D Material first
}
