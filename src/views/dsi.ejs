  var w = job.wells[+$('wellSel').value], sc = $('scenSel').value;
  var e = w && sc && job.td.scenarios[sc] && job.td.scenarios[sc].resultsByWell ? job.td.scenarios[sc].resultsByWell[w.wellKey] : null;
  if(!e || !e.params || !e.params.plan || !window.TDModelCore) return [];
