    var key = String(r.id != null ? r.id : r.name), s = RUN_SENSOR[key] != null ? RUN_SENSOR[key] : (r.sensor != null && isFinite(r.sensor) ? +r.sensor : s0), /* T&D-saved sensor (2026-11-14) */ o = { run: r, key: key, rows: rows, s: s };
    try{ o.ev = dsiFor(rows, s); }catch(err){ o.error = err.message;
      if(/non-mag/.test(err.message)){ var x = 0, at = null; rows.forEach(function(c){ var x0 = x; x += c.len; if(s > x0 && s <= x) at = c; });
        o.error = at ? 'sensor (' + fmt(L(s), 2) + ') is in "' + at.name + '" = ' + at.material + ' — if it is non-magnetic set it Non-mag (⬇ loads this BHA into the table)' : 'sensor beyond the BHA length'; } }
