// 2026-11-14 (John): 3D trajectory coloured by interference. Positions by minimum curvature
// (ISCWSA eBook ch.7; Bourgoyne et al., Applied Drilling Engineering, Ch. 8): dogleg β from Eq. 8.33,
// ratio factor RF = (2/β)·tan(β/2) (RF = 1 when β = 0). North/East follow the survey azimuth reference.
function minCurv(sv){
  var d = Math.PI / 180, out = [{ n: 0, e: 0, v: 0 }];
  for(var i = 1; i < sv.length; i++){
    var a = sv[i - 1], b = sv[i], dm = b.md - a.md, i1 = a.inc * d, i2 = b.inc * d, a1 = a.az * d, a2 = b.az * d;
    var cb = Math.cos(i2 - i1) - Math.sin(i1) * Math.sin(i2) * (1 - Math.cos(a2 - a1)), be = Math.acos(Math.max(-1, Math.min(1, cb)));
    var rf = be > 1e-9 ? 2 / be * Math.tan(be / 2) : 1, p = out[i - 1];
    out.push({ n: p.n + dm / 2 * (Math.sin(i1) * Math.cos(a1) + Math.sin(i2) * Math.cos(a2)) * rf,
               e: p.e + dm / 2 * (Math.sin(i1) * Math.sin(a1) + Math.sin(i2) * Math.sin(a2)) * rf,
               v: p.v + dm / 2 * (Math.cos(i1) + Math.cos(i2)) * rf });
  }
  return out;
}
// run-start markers: position at each run's start MD interpolated between stations (linear in MD — display only)
function runStartTrace(ev, sv, pos){
