}
// run drilling at a depth: same rule as the T&D Hookload / Slide Sheet (deepest start wins)
function runAtMd(runs, md){ var c = runs.filter(function(r){ return r.from <= md && md <= r.to; }); return c.length ? c[c.length - 1] : null; }
// 2026-11-14 (John) FIX: run BHAs used ONLY the name pattern for Material, so parts the user had set Non-mag
// by hand in the BHA table (XO sub, centralizer, gap sub…) were Steel in the runs -> "sensor not in a non-mag
// component". Now the Material chosen in the BHA table is reused for any run part with the same name; other
// parts fall back to the name pattern. Each run can also be loaded into the BHA table (⬇) to check / edit.
function matMap(){ var m = {}; readBha().forEach(function(r){ if(r.name) m[r.name.trim().toLowerCase()] = r.material; }); return m; }
function runRows(r){
