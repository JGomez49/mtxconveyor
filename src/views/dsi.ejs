}
// ---- 2026-11-14 (John): what-if sliders and per-BHA-run DSI ----------------------------------------
// Extra NMDC (what-if): added to the top non-mag row of the run holding the sensor, so the steel above
// moves up by that length (sensor distance from the bit unchanged). Slider value in display units.
var XNM = 0;
function withExtraNM(rows, s){
  if(!(XNM > 0)) return rows;
  var run = DsiModel.sensorRun(rows, s); if(!run) return rows;
  var x = 0, k = -1; rows.forEach(function(r, i){ x += +r.len; if(DsiModel.isNM(r) && Math.abs(x - run.top) < 1e-6) k = i; });
  if(k < 0) return rows;
  return rows.map(function(r, i){ return i === k ? Object.assign({}, r, { len: +r.len + XNM }) : r; });
}
var _wiT = null;
function whatIf(){
  var sd = +$('sdR').value, xn = +$('xnR').value;
  $('sensor').value = sd; $('sdV').textContent = fmt(sd, 1); $('xnV').textContent = fmt(xn, 1); XNM = Lm(xn);
  if(_wiT) cancelAnimationFrame(_wiT);
  _wiT = requestAnimationFrame(function(){ last = null; refreshPoles(); calculate(); });
}
function syncSliders(){   // slider range = current BHA length, value = sensor input
  var tot = readBha().reduce(function(a, r){ return a + (+r.len || 0); }, 0);
  $('sdR').max = Math.max(1, +L(tot).toFixed(1)); $('sdR').value = +$('sensor').value; $('sdV').textContent = fmt(+$('sensor').value, 1);
}
// one DSI evaluation for a given BHA (rows: od/id in, len m) and sensor (m) with the page's method settings
function dsiFor(rows, s){
  var bt = +$('bt').value, dip = +$('dip').value, m = $('method').value;
  if(m === 'sniper'){ var sn = DsiModel.sniper(rows, s); return { dBz: sn.dBzNT, err: function(inc, az){ return DsiModel.sniperAzError(sn.bmSum, inc, magAz(az), 0, bt, dip); } }; }
  if(m === 'induced'){ var mu = $('muR').value === '' ? null : +$('muR').value, ind = DsiModel.inducedSections(rows, mu);
    if(!DsiModel.sensorRun(rows, s)) throw new Error('sensor not in a non-mag component');
    var k = DsiModel.fieldAt(ind.poles, s);
    return { k: k, dBz: null, err: function(inc, az){ return DsiModel.azError(k * DsiModel.axialField(bt, dip, inc, magAz(az)), inc, magAz(az), bt, dip); } }; }
  var d = DsiModel.defaultPoles(rows, s, { pUpper: +$('pU').value, pLower: +$('pL').value, bitDipole: $('bitDip').checked }), b = DsiModel.fieldAt(d.poles, s);
  return { dBz: b, err: function(inc, az){ return DsiModel.azError(b, inc, magAz(az), bt, dip); } };
}
var RUN_SENSOR = {};   // per-run sensor distance edits (m), keyed by run id
function jobRuns(){
