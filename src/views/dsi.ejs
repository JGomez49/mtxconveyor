    var i = 1; while(i < sv.length - 1 && sv[i].md < md) i++; var f = (md - sv[i - 1].md) / ((sv[i].md - sv[i - 1].md) || 1), a = pos[i - 1], b = pos[i];
    x.push(L(a.e + f * (b.e - a.e))); y.push(L(a.n + f * (b.n - a.n))); z.push(L(a.v + f * (b.v - a.v))); t.push(o.run.name || o.key); });
  return [{ type: 'scatter3d', mode: 'markers+text', x: x, y: y, z: z, text: t, textposition: 'middle right', textfont: { color: '#4da3ff', size: 11 },
    marker: { size: 6, color: '#4da3ff', symbol: 'diamond', line: { color: '#ffffff', width: 1 } }, name: 'BHA run start', hovertemplate: 'Run %{text} starts<extra></extra>' }];
}
