  rows.forEach(function(c){ addRow({ name: c.name, od: +c.od.toFixed(3), id: +c.id.toFixed(3), len: +c.len, material: c.material }); });
  if(RUN_SENSOR[key] != null) $('sensor').value = +L(RUN_SENSOR[key]).toFixed(2);
