      '<td><input type="number" step="any" data-k="' + esc(o.key) + '" value="' + fmt(L(o.s), 2) + '" style="width:90px"> <button type="button" title="Load this run\'s BHA into the BHA table" onclick="loadRunBha(\'' + esc(o.key).replace(/'/g, '') + '\')">⬇</button></td><td>' + bAt + '</td><td' + (o.error ? ' class="bad"' : ' class="ok"') + '>' + esc(o.error || 'ok') + '</td></tr>'; }).join('');
