  var inp; try { inp = engineInput(); } catch(e){ $('sdStatus').innerHTML = '<span class="bad">' + e.message + '</span>'; return; }
  var i = +$('sdSlider').value, s = survey[i], inc = s.inc > 90 ? 180 - s.inc : s.inc;   // SurQC mirrors 90-180 onto 0-90
