<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SAGcorrection — MTX</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/plotly.js/2.32.0/plotly.min.js"></script>
<script src="/js/sagModel.js"></script>
<script src="/js/sagKinetic.js"></script>
<style>
  /*
    SAGcorrection (added 2026-10-24). Standalone tool, same dark theme as
    sixAxisData.ejs / quickPlan.ejs. Engine = public/js/sagModel.js, a
    line-by-line port of SurQC's BHA sag solver (validated against the
    original C# — see that file's header), run in public/js/sagWorker.js
    so the page cannot freeze. Workflow follows the SurQC manual
    ("Viewing the Sag Analysis" + "Corrections"): BHA -> Sag analysis
    (Shear / Bending Moment / Sag / Drop at one Inc, correction table every
    3 deg at the sensor) -> corrected survey (Inc + correction; MD, Az
    unchanged; TVD/N/E by minimum curvature).
  */
  :root{
    --bg:#0f1216; --panel:#171b21; --panel2:#1e232b; --border:#2a313c;
    --text:#e6e9ef; --muted:#8a93a3; --accent:#4da3ff; --good:#2ecc71; --bad:#ff5c5c; --warn:#f5a623;
  }
  *{box-sizing:border-box;}
  body{margin:0;font-family:-apple-system,Segoe UI,Roboto,Arial,sans-serif;background:var(--bg);color:var(--text);}
  header{padding:14px 20px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;}
  header h1{font-size:16px;margin:0;font-weight:600;}
  header .sub{color:var(--muted);font-size:12px;}
  .wrap{max-width:1500px;margin:0 auto;padding:16px;}
  .panel{background:var(--panel);border:1px solid var(--border);border-radius:8px;padding:12px 14px;margin-bottom:16px;}
  .panel h2{font-size:13px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);margin:0 0 10px;}
  table{width:100%;border-collapse:collapse;font-size:12px;}
  th,td{border-bottom:1px solid var(--border);padding:4px 6px;text-align:right;white-space:nowrap;}
  th{color:var(--muted);font-weight:600;position:sticky;top:0;background:var(--panel2);}
  td:first-child,th:first-child{text-align:left;}
  input,select,button{background:var(--panel2);color:var(--text);border:1px solid var(--border);border-radius:5px;padding:5px 8px;font-size:12px;}
  input[type=number]{width:90px;}
  td input{width:100%;min-width:60px;padding:3px 5px;}
  button{cursor:pointer;}
  button.primary{background:var(--accent);border-color:var(--accent);color:#061325;font-weight:600;}
  button:disabled{opacity:.5;cursor:not-allowed;}
  /* 2026-10-24: align-items:flex-end + nowrap labels fix the misaligned inputs (labels with units were wrapping to 2-3 lines). */
  .row{display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;margin-bottom:8px;}
  .field{display:flex;flex-direction:column;justify-content:flex-end;gap:3px;font-size:11px;color:var(--muted);white-space:nowrap;}
  .muted{color:var(--muted);font-size:12px;}
  .ok{color:var(--good);} .bad{color:var(--bad);} .warn{color:var(--warn);}
  .scroll{max-height:420px;overflow:auto;border:1px solid var(--border);border-radius:6px;}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
  @media (max-width:1000px){.grid2{grid-template-columns:1fr;}}
  .plot{height:230px;}
  .note{background:var(--panel2);border-left:3px solid var(--accent);padding:6px 10px;font-size:12px;color:var(--muted);margin:6px 0;}
  .note.warnbox{border-left-color:var(--warn);}
  #progress{height:6px;background:var(--panel2);border-radius:3px;overflow:hidden;width:200px;display:inline-block;vertical-align:middle;}
  #progress div{height:100%;width:0;background:var(--accent);}
</style>
</head>
<body>
<header>
  <div>
    <h1>📐 SAGcorrection</h1>
    <div class="sub">BHA sag inclination correction — port of SurQC's sag solver</div>
  </div>
  <div class="row" style="margin:0">
    <select id="unitSel" onchange="setUnit(this.value)">
      <option value="metric">Metric (m, kg/m³)</option>
      <option value="imperial">Imperial (ft, ppg)</option>
    </select>
    <input id="caseName" placeholder="Case name" style="width:160px">
    <button onclick="saveCase()" id="btnSaveCase">💾 Save case</button>
    <select id="caseList" style="width:220px"><option value="">— saved cases —</option></select>
    <button onclick="loadCase()">Load</button>
    <button onclick="deleteCase()" id="btnDelCase">Delete</button>
  </div>
</header>

<div class="wrap">

  <!-- 1. SOURCE ---------------------------------------------------------->
  <div class="panel">
    <h2>1 · Connect to an MTX job (optional)</h2>
    <div class="row">
      <div class="field"><span>MTX Job ID</span><input id="mtxId" placeholder="e.g. 2423" style="width:120px"></div>
      <button onclick="loadJob()" style="align-self:flex-end">Load job</button>
      <div class="field"><span>Well / leg</span><select id="wellSel" style="width:260px" onchange="onWellChange()"></select></div>
      <div class="field"><span>T&amp;D scenario</span><select id="scenSel" style="width:180px"></select></div>
      <button onclick="loadBhaFromTD()" style="align-self:flex-end">⬇ Use saved T&amp;D BHA</button>
      <button onclick="loadSurveyFromJob()" style="align-self:flex-end">⬇ Use well survey</button>
    </div>
    <div id="jobStatus" class="muted"></div>
  </div>

  <!-- 2. BHA -------------------------------------------------------------->
  <div class="panel">
    <h2>2 · BHA (bit first)</h2>
    <div class="note">Same table format as the Torque &amp; Drag modeler, plus <b>Stiffness factor</b> and <b>Material</b>.
      Enter stabilisers as their own rows (SurQC treats a row as a stabiliser when OD &gt; 0.9 × bit OD and length &lt; 1.2 m).
      Hole size = bit OD. Beam computes weight from OD/ID and steel 7700 kg/m³ (as SurQC); Kinetic uses the Wt column when entered (else OD/ID × material density).
      Only ticked rows are analysed; loading from T&amp;D ticks rows that start within the BHA length limit.</div>
    <div class="row">
      <div class="field"><span>BHA length limit (<span class="uL">m</span>)</span><input type="number" id="bhaLimit" value="60" step="1" oninput="refreshBha();invalidate()"></div>
      <button onclick="applyLimit()" style="align-self:flex-end">Apply limit</button>
      <button onclick="addRow()" style="align-self:flex-end">+ Component</button>
      <button onclick="exportBha()" style="align-self:flex-end">⬇ Export to Excel</button>
      <label style="align-self:flex-end"><button onclick="document.getElementById('bhaFile').click()">⬆ Import from Excel</button>
        <input type="file" id="bhaFile" accept=".xlsx,.xls,.csv" style="display:none" onchange="importBha(event)"></label>
      <span id="bhaInfo" class="muted" style="align-self:flex-end"></span>
    </div>
    <div id="limitWarn" class="note warnbox" style="display:none">
    </div>
    <details style="margin:6px 0"><summary class="muted" style="cursor:pointer">Materials (used by Kinetic)</summary>
      <div class="note">Steel = 7700 kg/m³, 210 GPa (SurQC's values, built in). Add other materials with density and Young's modulus
        <b>from your vendor spec sheet</b> and note the source. Built-in reference materials (non-mag 15-15LC Mod, Monel K-500,
        Aluminium 2014-T6, Ti-6Al-4V) use published typical datasheet values — see the Source column; for a specific vendor grade add your own. Kinetic also uses the row's Wt (kg/m, air weight incl. tool joints)
        for the sag load when entered (blank = from OD/ID × density). <b>Beam ignores material and Wt</b> (same as SurQC).</div>
      <div class="row">
        <input id="matName" placeholder="Name (e.g. NMDC 15-15LC)" style="width:200px">
        <input type="number" id="matRho" placeholder="Density kg/m³" style="width:120px">
        <input type="number" id="matE" placeholder="E (GPa)" style="width:100px">
        <input id="matNotes" placeholder="Source (spec sheet / rev)" style="width:220px">
        <button onclick="addMaterial()">+ Add material</button>
      </div>
      <table style="width:auto"><thead><tr><th>Material</th><th>Density (kg/m³)</th><th>E (GPa)</th><th>Source</th><th>By</th><th></th></tr></thead>
        <tbody id="matBody"></tbody></table>
    </details>
    <div class="scroll" style="max-height:320px">
      <table>
        <thead><tr><th>Use</th><th>Component</th><th>OD (mm)</th><th>ID (mm)</th><th>Length (<span class="uL">m</span>)</th>
          <th>Wt (<span class="uW">kg/m</span>)</th><th>Stiffness factor</th><th>Material</th><th>From bit (<span class="uL">m</span>)</th><th></th></tr></thead>
        <tbody id="bhaBody"></tbody>
      </table>
    </div>
  </div>

  <!-- 3. SAG ANALYSIS ------------------------------------------------------->
  <div class="panel">
    <h2>3 · Sag analysis</h2>
    <div class="row">
      <div class="field"><span>Model</span><select id="modelSel" onchange="onModelChange()" style="width:120px">
        <option value="Beam">Beam</option><option value="Kinetic">Kinetic</option></select></div>
      <div class="field"><span>Sensor position from bit (<span class="uL">m</span>)</span><input type="number" id="sensor" value="15" step="0.01"></div>
      <div class="field"><span>Mud weight (<span class="uM">kg/m³</span>)</span><input type="number" id="mud" value="1200" step="1"></div>
      <div class="field"><span>Distance to bend (<span class="uL">m</span>)</span><input type="number" id="bendDist" value="0" step="0.01"></div>
      <div class="field"><span>Bend angle (°, + = high side)</span><input type="number" id="bendDeg" value="0" step="0.01"></div>
      <div class="field"><span>Gravity (m/s²)</span><input type="number" id="grav" value="9.80665" step="0.00001"></div>
      <div class="field"><span>Max iterations / Inc</span><input type="number" id="maxIter" value="2000000" step="100000"></div>
    </div>
    <div class="note" id="modelNote"></div>
    <!-- 2026-10-24: Kinetic options #6-#8 (planar). Hidden for Beam. -->
    <div id="kinOpts" class="panel" style="display:none;background:var(--panel2);margin:6px 0">
      <div class="row">
        <label class="muted"><input type="checkbox" id="kCurv" onchange="invalidate()"> Hole curvature from survey dogleg</label>
        <div class="field"><span>Bend orientation</span><select id="kBendTF" onchange="invalidate()">
          <option value="hs">High side (fixed, as Beam)</option><option value="survey">Survey toolface</option></select></div>
        <label class="muted"><input type="checkbox" id="kAxial" onchange="invalidate();refreshKinOpts()"> Axial load (WOB + BHA weight)</label>
        <div class="field"><span>WOB source</span><select id="kWobSrc" onchange="invalidate();refreshKinOpts()">
          <option value="one">One value per run</option><option value="dm">Drilling Mechanics WOB (job)</option></select></div>
        <div class="field" id="kWobField"><span>WOB (<span class="uF">kN</span>)</span><input type="number" id="kWob" value="0" step="1" oninput="invalidate()"></div>
        <div class="field"><span>Correction</span><select id="kCorr"><option value="inc">Inc only</option>
          <option value="incaz" disabled>Inc + Az (needs 3-D model — not yet available)</option></select></div>
      </div>
      <div class="note warnbox" style="margin:0">Planar model (high-side plane): only the build/drop part of the dogleg (DLS × cos TF) and of the bend
        (bend × cos TF) is used; right/left components are ignored, so no azimuth correction yet. Toolface and dogleg come from each station and the
        one before it (Bourgoyne Eqs. 8.45–8.49); for rotated intervals the survey toolface is the hole's, not necessarily the motor's at survey time.
        Surveys are usually taken off bottom — WOB is then ~0. Curvature, survey toolface or Drilling-Mechanics WOB switch to per-station solving.</div>
    </div>
    <div class="note">Per the SurQC manual: the bend is assumed to face high side — when dropping angle enter a <b>negative</b> bend angle.
      Gravity defaults to standard gravity 9.80665 m/s² (SurQC's own default value is not in the available source).</div>
    <div class="row">
      <div class="field"><span>Plot inclination (°)</span><input type="number" id="profInc" value="45" step="1" min="0" max="180"></div>
      <button class="primary" onclick="runProfile()" style="align-self:flex-end">Show plots</button>
      <button class="primary" onclick="runTable()" style="align-self:flex-end" id="btnTable">Correction table</button>
      <span style="align-self:flex-end"><span id="progress"><div></div></span> <span id="runStatus" class="muted"></span></span>
    </div>
    <div id="profStatus" class="muted"></div>
    <div class="grid2">
      <div><div id="pShear" class="plot"></div><div id="pMoment" class="plot"></div></div>
      <div><div id="pSag" class="plot"></div><div id="pDrop" class="plot"></div></div>
    </div>
    <div class="row" style="margin-top:10px">
      <b style="font-size:12px">Correction table at sensor position</b>
      <button onclick="exportTable()">⬇ Export table</button>
    </div>
    <div id="tableWarn"></div>
    <div class="scroll" style="max-height:300px"><table>
      <thead><tr><th>Inc (°)</th><th>Correction (°)</th><th>Status</th><th>Iterations</th><th>Residual out of hole (mm)</th></tr></thead>
      <tbody id="corrBody"></tbody></table></div>
  </div>

  <!-- 4. SURVEY ---------------------------------------------------------->
  <div class="panel">
    <h2>4 · Sag-corrected survey</h2>
    <div class="row">
      <label><button onclick="document.getElementById('svyFile').click()">⬆ Import survey (MD, INC, AZ)</button>
        <input type="file" id="svyFile" accept=".xlsx,.xls,.csv" style="display:none" onchange="importSurvey(event)"></label>
      <button class="primary" onclick="applyCorrection()">Apply sag correction</button>
      <button onclick="exportSurvey()">⬇ Export corrected survey</button>
      <button onclick="saveVersion()" id="btnSaveVer" disabled title="Available when the survey came from an MTX job well">💾 Save as new version in job</button>
      <span id="svyInfo" class="muted"></span>
    </div>
    <div id="saveVerPanel" class="note" style="display:none">
      <b>Save as new version</b> — ISCWSA toolcode for the corrected well (used by the Anti-collision plots):
      <div class="row" style="margin-top:6px">
        <span class="muted">Original: <b id="svOrig"></b></span>
        <select id="svCode" style="width:240px" onchange="checkToolcode()"></select>
        <button class="primary" onclick="confirmSaveVersion()">Save</button>
        <button onclick="$('saveVerPanel').style.display='none'">Cancel</button>
      </div>
      <div id="svWarn"></div>
    </div>
    <div class="note">Corrected Inc = measured Inc + correction interpolated from the table (SurQC). MD and Az are not changed by sag.
      TVD/N/E recomputed by minimum curvature from the first station (tie-on); *TVD columns are relative to the first station. Stations whose inclination falls on a
      non-converged table row are left uncorrected and flagged. "Save as new version" creates a new well
      (<i>&lt;well&gt; SAG &lt;date&gt;</i>, source SAGcorrection) in the job — the original survey is never modified.</div>
    <div class="scroll"><table>
      <thead><tr><th>MD</th><th>Inc meas (°)</th><th>Sag corr (°)</th><th>Inc corr (°)</th><th>Az (°)</th>
        <th>TVD meas*</th><th>TVD corr*</th><th>ΔTVD</th><th>ΔN</th><th>ΔE</th><th>DLS (°/30m)</th><th>Survey TF (°)</th><th>WOB used</th></tr></thead>
      <tbody id="svyBody"></tbody></table></div>
  </div>
</div>

<script>
// ===================================================================
// State
// ===================================================================
var UNIT = 'metric';
var FT = 0.3048;                 // m per ft (exact)
var PPG = 119.826427;            // kg/m3 per lb/US gal (= 0.45359237 kg / 3.785411784e-3 m3)
var KGM2LBFT = 0.671968975;      // lb/ft per kg/m (same constant as the T&D modeler)
var USER_ROLE = <%- JSON.stringify(user && user.role || '') %>;
var job = { noteId:null, title:'', mtxJobId:'', wells:[], td:null };
var survey = [];                 // [{md, inc, az}] metres/deg
var surveySource = null;         // {noteId, wellKey} when loaded from a job
var table = null;                // {rows, full}
var lastInputSig = null;         // inputs used for `table`
var corrected = [];
var worker = null;
var beamWarnHtml = '';

function $(id){ return document.getElementById(id); }
function L(v){ return UNIT === 'metric' ? v : v / FT; }      // m -> display
function Lm(v){ return UNIT === 'metric' ? v : v * FT; }     // display -> m
function fmt(v, d){ return (v == null || !isFinite(v)) ? '—' : (+v).toFixed(d); }

function setUnit(u){
  if(u === UNIT) return;
  var rows = readBha(true);
  var sensor = Lm(+$('sensor').value), bend = Lm(+$('bendDist').value), lim = Lm(+$('bhaLimit').value);
  var mud = UNIT === 'metric' ? +$('mud').value : +$('mud').value * PPG;
  UNIT = u;
  document.querySelectorAll('.uL').forEach(function(e){ e.textContent = u === 'metric' ? 'm' : 'ft'; });
  document.querySelectorAll('.uW').forEach(function(e){ e.textContent = u === 'metric' ? 'kg/m' : 'lb/ft'; });
  document.querySelectorAll('.uM').forEach(function(e){ e.textContent = u === 'metric' ? 'kg/m³' : 'ppg'; });
  document.querySelectorAll('.uF').forEach(function(e){ e.textContent = u === 'metric' ? 'kN' : 'klbf'; });
  $('kWob').value = +(u === 'metric' ? +$('kWob').value * 4.4482216152605 : +$('kWob').value / 4.4482216152605).toFixed(2);
  $('sensor').value = +L(sensor).toFixed(3); $('bendDist').value = +L(bend).toFixed(3); $('bhaLimit').value = +L(lim).toFixed(1);
  $('mud').value = u === 'metric' ? +mud.toFixed(1) : +(mud / PPG).toFixed(3);
  $('bhaBody').innerHTML = '';
  rows.forEach(function(r){ addRow(r); });
  renderSurvey();
}

// ===================================================================
// BHA table (stored internally in SI; displayed in current unit)
// ===================================================================
function addRow(r){
  r = r || {use:true, name:'', od_mm:'', id_mm:'', len_m:'', wt_kgm:'', sf:1, material:'Steel'};
  var tr = document.createElement('tr');
  var len = r.len_m === '' ? '' : +L(+r.len_m).toFixed(3);
  var wt = r.wt_kgm === '' ? '' : +(UNIT === 'metric' ? +r.wt_kgm : +r.wt_kgm * KGM2LBFT).toFixed(3);
  tr.innerHTML =
    '<td><input type="checkbox" ' + (r.use !== false ? 'checked' : '') + ' style="width:auto" onchange="refreshBha()"></td>' +
    '<td><input value="' + String(r.name || '').replace(/"/g,'&quot;') + '" style="min-width:140px"></td>' +
    '<td><input type="number" step="0.01" value="' + r.od_mm + '" oninput="refreshBha()"></td>' +
    '<td><input type="number" step="0.01" value="' + r.id_mm + '" oninput="refreshBha()"></td>' +
    '<td><input type="number" step="0.001" value="' + len + '" oninput="refreshBha()"></td>' +
    '<td><input type="number" step="0.001" value="' + wt + '"></td>' +
    '<td><input type="number" step="0.01" value="' + (r.sf == null ? 1 : r.sf) + '"></td>' +
    '<td><select class="matSel" onchange="invalidate()">' + materialOptions(r.material) + '</select></td>' +
    '<td class="fromBit">—</td>' +
    '<td><button onclick="this.closest(\'tr\').remove();refreshBha()">✕</button></td>';
  $('bhaBody').appendChild(tr);
  refreshBha();
}
// readBha(all): rows in SI. all=false -> only ticked + valid rows.
function readBha(all){
  return Array.from(document.querySelectorAll('#bhaBody tr')).map(function(tr){
    var ins = tr.querySelectorAll('input'), sel = tr.querySelector('select');
    var lenD = ins[4].value === '' ? '' : Lm(+ins[4].value);
    var wtD = ins[5].value === '' ? '' : (UNIT === 'metric' ? +ins[5].value : +ins[5].value / KGM2LBFT);
    return { use: ins[0].checked, name: ins[1].value, od_mm: ins[2].value === '' ? '' : +ins[2].value,
      id_mm: ins[3].value === '' ? '' : +ins[3].value, len_m: lenD, wt_kgm: wtD,
      sf: ins[6].value === '' ? 1 : +ins[6].value, material: sel.value };
  }).filter(function(r){ return all || (r.use && r.od_mm > 0 && r.len_m > 0 && r.id_mm >= 0 && r.id_mm < r.od_mm); });
}
function refreshBha(){
  var cum = 0, used = 0, n = 0;
  document.querySelectorAll('#bhaBody tr').forEach(function(tr){
    var ins = tr.querySelectorAll('input');
    tr.querySelector('.fromBit').textContent = fmt(L(cum), 2);
    var len = Lm(+ins[4].value || 0);
    if(ins[0].checked){ used += len; n++; }
    cum += len;
  });
  var rows = readBha(false);
  var bit = rows[0], stabs = 0;
  if(bit) rows.slice(1).forEach(function(r){ if(r.od_mm > bit.od_mm * 0.9 && r.len_m < 1.2) stabs++; });
  $('bhaInfo').textContent = n + ' rows used, length ' + fmt(L(used), 2) + (UNIT === 'metric' ? ' m' : ' ft') +
    (bit ? ' · hole = bit OD ' + bit.od_mm + ' mm · ' + stabs + ' stabiliser row(s)' : '');
  // 2026-10-24 (#1): warn when the ticked rows are longer than the BHA length
  // limit. Analysing hundreds of metres of drill pipe made Beam (SurQC) never
  // converge (e.g. 751 m -> -35.97 deg); the sensor correction depends only
  // on the BHA up to where it rests on the wall (industry practice: ~30 m of
  // assembly above the last stabilisation point, Innova SAG guide).
  var lim = Lm(+$('bhaLimit').value || 0), u2 = UNIT === 'metric' ? ' m' : ' ft';
  if(lim > 0 && used > lim + 1e-9){
    $('limitWarn').style.display = '';
    $('limitWarn').innerHTML = '⚠ Ticked rows total ' + fmt(L(used), 1) + u2 + ', longer than the BHA length limit (' + fmt(L(lim), 1) + u2 +
      '). The analysis uses only the first ' + fmt(L(lim), 1) + u2 + ' (the row crossing the limit is cut there; rows beyond it are ignored). ' +
      'Recommended: untick drill pipe / rows that run past the limit — Beam (SurQC) often cannot converge on long flexible pipe even when cut. ' +
      '<button onclick="untickBeyondLimit()">Untick rows that extend past the limit</button>';
  } else $('limitWarn').style.display = 'none';
}
// 2026-10-24 (#2): enforce the BHA length limit for BOTH models — only the
// first `limit` metres of the ticked rows are sent to the solver; the row
// that crosses the limit is shortened to end exactly at it.
function limitRows(rows){
  var lim = Lm(+$('bhaLimit').value || 0); if(!(lim > 0)) return rows;
  var out = [], cum = 0;
  for(var i = 0; i < rows.length && cum < lim - 1e-9; i++){
    var r = Object.assign({}, rows[i]); r.len_m = Math.min(r.len_m, lim - cum); out.push(r); cum += r.len_m; }
  return out;
}
// Button in the limit warning: untick every ticked row whose END is past the
// limit (e.g. a 704 m drill-pipe row starting at 47 m), so only whole BHA
// components inside the limit are analysed.
function untickBeyondLimit(){
  var lim = Lm(+$('bhaLimit').value || 0), cum = 0;
  document.querySelectorAll('#bhaBody tr').forEach(function(tr){
    var ins = tr.querySelectorAll('input'), len = Lm(+ins[4].value || 0);
    if(ins[0].checked){ if(cum + len > lim + 1e-9) ins[0].checked = false; else cum += len; }
  });
  refreshBha(); invalidate();
}
function applyLimit(){
  var lim = Lm(+$('bhaLimit').value || 0), cum = 0;
  document.querySelectorAll('#bhaBody tr').forEach(function(tr){
    var ins = tr.querySelectorAll('input');
    ins[0].checked = cum < lim;
    cum += Lm(+ins[4].value || 0);
  });
  refreshBha();
}
function exportBha(){
  var rows = readBha(true);
  if(!rows.length){ alert('BHA table is empty.'); return; }
  var M = UNIT === 'metric';
  var data = rows.map(function(r){
    var o = {};
    o['Component'] = r.name; o['OD (mm)'] = +r.od_mm || 0; o['ID (mm)'] = +r.id_mm || 0;
    o[M ? 'Length (m)' : 'Length (ft)'] = +(+L(+r.len_m || 0)).toFixed(3);
    o[M ? 'Wt (kg/m)' : 'Wt (lb/ft)'] = +(M ? +r.wt_kgm || 0 : (+r.wt_kgm || 0) * KGM2LBFT).toFixed(3);
    o['Stiffness factor'] = r.sf; o['Material'] = r.material; o['Use'] = r.use ? 1 : 0;
    return o;
  });
  var wb = XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(data), 'BHA');
  XLSX.writeFile(wb, 'SAG_BHA.xlsx');
}
// Same loose header matching as the T&D modeler's importBHAExcel; extra
// optional columns: Stiffness factor, Material, Use. Replaces the table.
function importBha(evt){
  var f = evt.target.files[0]; if(!f) return;
  var rd = new FileReader();
  rd.onload = function(e){
    try{
      var wb = XLSX.read(new Uint8Array(e.target.result), {type:'array'});
      var rows = XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]], {defval:''});
      if(!rows.length){ alert('No rows found.'); return; }
      var h = Object.keys(rows[0]);
      function col(re){ return h.filter(function(x){ return re.test(x); })[0]; }
      var cN = col(/component|name/i), cOD = col(/^od\b|od\s*\(/i), cID = col(/^id\b|id\s*\(/i),
          cLen = col(/length|len\b/i), cWt = col(/wt|weight/i), cSF = col(/stiff/i), cMat = col(/material/i), cUse = col(/^use$/i);
      if(!cN || !cOD || !cID || !cLen){ alert('Could not find Component, OD, ID, Length columns.\nFound: ' + h.join(', ')); return; }
      var lenFt = /\(ft\)/i.test(cLen), wtLb = cWt && /lb\s*\/\s*ft/i.test(cWt);
      $('bhaBody').innerHTML = '';
      rows.forEach(function(r){
        var len = (+r[cLen] || 0) * (lenFt ? FT : 1);
        var wt = cWt ? (+r[cWt] || 0) / (wtLb ? KGM2LBFT : 1) : '';
        addRow({ use: cUse ? !!+r[cUse] : true, name: String(r[cN] || ''), od_mm: +r[cOD] || 0, id_mm: +r[cID] || 0,
          len_m: len, wt_kgm: wt, sf: cSF && r[cSF] !== '' ? +r[cSF] : 1, material: cMat ? String(r[cMat] || 'Steel') : 'Steel' });
      });
      invalidate();
    }catch(err){ alert('Import failed: ' + err.message); }
    evt.target.value = '';
  };
  rd.readAsArrayBuffer(f);
}

