  [['PDC Bit',158.75,50.8,0.20,310.044],['Mud Motor',137,63.5,10.05,103.933],['DC 127mm',127,64,4.60,109.841],
   ['DC 121mm',121,68,9.29,109.841],['DC 120mm',120,76,1.60,109.841],['DC 122mm B',122,67,9.54,109.841],
   ['DC 122mm A',122,67,9.42,109.841],['Sub 137mm',137.16,48.77,1.18,155.379],['Underreamer',130,58,1.38,70.866]]
   .forEach(function(a){ addRow({use:true, name:a[0], od_mm:a[1], id_mm:a[2], len_m:a[3], wt_kgm:a[4], sf:1, material:'Steel'}); });
  refreshCases(); refreshMaterials();
