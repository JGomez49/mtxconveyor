function caseInput(){
  return { unit: UNIT, bhaRows: readBha(true), sensor_m: Lm(+$('sensor').value),
    mud_kgm3: UNIT === 'metric' ? +$('mud').value : +$('mud').value * PPG, bendDist_m: Lm(+$('bendDist').value),
