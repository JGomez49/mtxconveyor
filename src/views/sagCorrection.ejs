// ===================================================================
// Engine calls (Web Worker)
// ===================================================================
function engineInput(){
  var rows = limitRows(readBha(false));
  if(rows.length < 2) throw new Error('The BHA needs at least a bit and one more component.');
  var totLen = rows.reduce(function(a, r){ return a + r.len_m; }, 0);
  if(Lm(+$('sensor').value) >= totLen) throw new Error('The sensor position is beyond the analysed BHA length (' + fmt(L(totLen), 2) + (UNIT === 'metric' ? ' m' : ' ft') + '). Increase the BHA length limit or tick more rows.');
  return {
    // rho / E / wt are used by Kinetic only (#5); Beam ignores them (SurQC = steel, OD/ID weight).
    subComponents: rows.map(function(r){ var m = materialByName(r.material);
      return {name:r.name, od:r.od_mm / 1000, id:r.id_mm / 1000, len:r.len_m, sf:r.sf,
              rho:m.density, E:m.youngs, wt:(r.wt_kgm === '' || !(+r.wt_kgm > 0)) ? 0 : +r.wt_kgm}; }),
    sensorPosition: Lm(+$('sensor').value),
    mudDensity: UNIT === 'metric' ? +$('mud').value : +$('mud').value * PPG,
    gravity: +$('grav').value,
    bendDistance: Lm(+$('bendDist').value),
    bendAngleDeg: +$('bendDeg').value,
    // Kinetic-only options (#7 run-constant part; per-station values are set by the worker)
    axialLoad: $('modelSel').value === 'Kinetic' && $('kAxial').checked,
    wob: ($('modelSel').value === 'Kinetic' && $('kAxial').checked && $('kWobSrc').value === 'one') ? wobUnitToN(+$('kWob').value) : 0,
  };
}
function getWorker(){
  if(worker) worker.terminate();
  worker = new Worker('/js/sagWorker.js');
  return worker;
}
function invalidate(){ if(table){ $('tableWarn').innerHTML = '<div class="note warnbox">Inputs changed — press <b>Correction table</b> to update.</div>'; } }
['sensor','mud','bendDist','bendDeg','grav'].forEach(function(id){ document.addEventListener('DOMContentLoaded', function(){ $(id).addEventListener('input', invalidate); }); });
document.addEventListener('input', function(e){ if(e.target.closest && e.target.closest('#bhaBody')) invalidate(); });

function runProfile(){
  var inp; try{ inp = engineInput(); }catch(e){ alert(e.message); return; }
  var inc = +$('profInc').value;
  if(inc > 90) inc = 180 - inc;   // SurQC mirrors 90-180 onto 0-90
  $('profStatus').textContent = 'Solving at ' + inc + '°…';
  var w = getWorker();
  w.onmessage = function(ev){
    var m = ev.data;
    if(m.type === 'error'){ $('profStatus').innerHTML = '<span class="bad">' + m.error + '</span>'; return; }
    var r = m.res;
    $('profStatus').innerHTML = '<b>' + $('modelSel').value + '</b> · ' + (r.status === 'ok' ? '<span class="ok">Converged</span>' :
      '<span class="bad">Did not converge</span> (stopped at ' + r.iterations + ' iterations — SurQC would hang here)' +
        ($('modelSel').value === 'Beam' ? ' — Beam (SurQC) converges slowly with large motor bends (a 2–2.5° bend needed ~0.5 million iterations, ~9 s per inclination, in tests): raise "Max iterations / Inc". ' +
          'It cannot solve a stabiliser directly above the bit or long flexible pipe at all — untick drill-pipe rows or use Kinetic.' : '')) +
      ' · sag at sensor = ' + fmt(r.sensorSag, 3) + '° · residual out of hole ' + fmt(r.residualOutOfHole * 1000, 2) + ' mm';
    var x = r.x.map(L), xl = 'Distance from bit (' + (UNIT === 'metric' ? 'm' : 'ft') + ')';
    var lay = function(t, y){ return { title:{text:t, font:{size:12}}, margin:{l:60,r:10,t:28,b:36}, paper_bgcolor:'#171b21', plot_bgcolor:'#171b21',
      font:{color:'#e6e9ef', size:10}, xaxis:{title:xl, gridcolor:'#2a313c'}, yaxis:{title:y, gridcolor:'#2a313c'},
      shapes:[{type:'line', x0:L(inp.sensorPosition), x1:L(inp.sensorPosition), yref:'paper', y0:0, y1:1, line:{color:'#f5a623', dash:'dot', width:1}}] }; };
    var cfg = {displaylogo:false, responsive:true};
    Plotly.newPlot('pShear', [{x:x, y:r.shear, mode:'lines', line:{color:'#4da3ff'}}], lay('Shear Force @ ' + inc + '°', 'N'), cfg);
    Plotly.newPlot('pMoment', [{x:x, y:r.moment, mode:'lines', line:{color:'#4da3ff'}}], lay('Bending Moment', 'N·m'), cfg);
    Plotly.newPlot('pSag', [{x:x, y:r.sag, mode:'lines', line:{color:'#4da3ff'}}], lay('Sag (dashed = sensor)', '°'), cfg);
    Plotly.newPlot('pDrop', [{x:x, y:r.drop.map(function(v){ return v * 1000; }), mode:'lines', line:{color:'#4da3ff'}}], lay('Drop (negative = below centreline)', 'mm'), cfg);
  };
  w.postMessage({type:'profile', model:$('modelSel').value, input:inp, inc:inc, opts:{maxIterations:+$('maxIter').value}});
}

function runTable(){
  var inp; try{ inp = engineInput(); }catch(e){ alert(e.message); return; }
  $('corrBody').innerHTML = ''; $('tableWarn').innerHTML = ''; $('btnTable').disabled = true; beamWarnHtml = '';
  if($('modelSel').value === 'Beam' && inp.subComponents.some(function(c){ return c.rho !== 7700 || c.E !== 210e9; }))
    beamWarnHtml = $('tableWarn').innerHTML = '<div class="note warnbox">Beam (SurQC) uses steel for every row — non-steel materials are ignored. Use Kinetic to apply them.</div>';
  var t0 = Date.now(), w = getWorker();
  w.onmessage = function(ev){
    var m = ev.data;
    if(m.type === 'error'){ $('runStatus').innerHTML = '<span class="bad">' + m.error + '</span>'; $('btnTable').disabled = false; return; }
    if(m.type === 'row'){
      $('progress').firstElementChild.style.width = (100 * m.done / m.total) + '%';
      $('runStatus').textContent = m.done + ' / ' + m.total + ' inclinations';
      var r = m.row, ok = r.status === 'ok';
      var tr = document.createElement('tr');
      tr.innerHTML = '<td>' + r.inc.toFixed(1) + '</td><td>' + (ok ? fmt(r.corr, 3) : '<span class="bad">—</span>') + '</td><td class="' + (ok ? 'ok' : 'bad') + '">' +
        (ok ? 'converged' : (r.status === 'capped' ? 'did not converge' : r.status)) + '</td><td>' + r.iterations + '</td><td>' + fmt(r.residualOutOfHole * 1000, 2) + '</td>';
      $('corrBody').appendChild(tr);
    }
    if(m.type === 'table'){
      table = m.table; lastInputSig = JSON.stringify(inp) + '|' + m.table.model; $('btnTable').disabled = false;
      var bad = table.rows.filter(function(r){ return r.status !== 'ok'; });
      $('runStatus').textContent = table.model + ' · done in ' + ((Date.now() - t0) / 1000).toFixed(1) + ' s';
      $('tableWarn').innerHTML = beamWarnHtml + (bad.length ? '<div class="note warnbox">' + bad.length + ' inclination(s) did not converge (' +
        bad.map(function(r){ return r.inc; }).join(', ') + '°). These rows are not used.' + (table.model === 'Beam' ? ' Known SurQC limitation: a stabiliser directly above the bit ' +
        'makes the solver oscillate (this is what freezes SurQC) — try the Kinetic model.' : '') + '</div>' : '');
      if(survey.length) applyCorrection();
    }
  };
  w.postMessage({type:'table', model:$('modelSel').value, input:inp, opts:{maxIterations:+$('maxIter').value}});
}
function exportTable(){
  if(!table){ alert('Run the correction table first.'); return; }
  var data = table.rows.map(function(r){ return {'Model': table.model, 'Inc (deg)': r.inc, 'Correction (deg)': r.corr, 'Status': r.status, 'Iterations': r.iterations, 'Residual (mm)': +(r.residualOutOfHole * 1000).toFixed(3)}; });
  var wb = XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(data), 'Sag table');
  XLSX.writeFile(wb, 'SAG_correction_table_' + table.model + '.xlsx');
}

// ===================================================================
// Survey
// ===================================================================
function importSurvey(evt){
  var f = evt.target.files[0]; if(!f) return;
  var rd = new FileReader();
  rd.onload = function(e){
    try{
      var wb = XLSX.read(new Uint8Array(e.target.result), {type:'array'});
      var rows = XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]], {header:1, defval:''});
      // First row whose 3 first cells are numbers = data start; header text decides ft vs m.
      var hdr = rows.find(function(r){ return r.some(function(c){ return /md|depth/i.test(String(c)); }); }) || [];
      var mdFt = hdr.some(function(c){ return /md|depth/i.test(String(c)) && /ft|feet/i.test(String(c)); });
      survey = rows.filter(function(r){ return r.length >= 3 && [0,1,2].every(function(i){ return r[i] !== '' && isFinite(+r[i]); }); })
        .map(function(r){ return {md:+r[0] * (mdFt ? FT : 1), inc:+r[1], az:+r[2]}; });
      if(!survey.length) throw new Error('No numeric MD / INC / AZ rows found (columns A, B, C).');
      surveySource = null; $('btnSaveVer').disabled = true;
      $('svyInfo').textContent = survey.length + ' stations imported from ' + f.name + (mdFt ? ' (MD in ft, converted)' : ' (MD assumed m)');
      corrected = []; renderSurvey();
    }catch(err){ alert('Import failed: ' + err.message); }
    evt.target.value = '';
  };
  rd.readAsArrayBuffer(f);
}
var stationInfo = null;   // per-station geometry/WOB used (for display/export)
async function applyCorrection(){
  if(!survey.length){ alert('Load or import a survey first.'); return; }
  if(perStationMode()) return applyPerStation();
  stationInfo = null;
  if(!table){ alert('Run the correction table first.'); return; }
  try{ if(JSON.stringify(engineInput()) + '|' + $('modelSel').value !== lastInputSig){ if(!confirm('Inputs changed since the table was calculated. Apply the old table anyway?')) return; } }catch(e){}
  corrected = SagModel.correctSurvey(survey, table.full, {tvd:0, n:0, e:0});
  renderSurvey();
  var skipped = corrected.filter(function(s){ return s.corr == null; }).length;
  $('btnSaveVer').disabled = !surveySource || USER_ROLE === 'viewer';
  $('svyInfo').innerHTML = corrected.length + ' stations corrected' + (skipped ? ' · <span class="warn">' + skipped + ' left uncorrected (non-converged table rows)</span>' : '') +
    ' · ΔTVD at TD = ' + fmt(L(corrected[corrected.length - 1].dTvd), 3) + (UNIT === 'metric' ? ' m' : ' ft');
}
// Drilling Mechanics WOB (saved Pason "WOB vs Measured Depth" plot of the
// connected job; Average curve, kDaN -> N x 10000). Read at bit depth =
// station MD + sensor offset (the survey MD is the sensor's depth).
async function loadDmWob(){
  if(!job.noteId) throw new Error('Connect an MTX job (section 1) to use Drilling Mechanics WOB.');
  var doc = await (await fetch('/notes/pasonPlots/' + job.noteId)).json();
  var w = doc && doc.plots && doc.plots.wob;
  var pts = (w && w.rows || []).filter(function(r){ return r[1] !== '' && r[1] != null && isFinite(+r[0]) && isFinite(+r[1]); })
    .map(function(r){ return [+r[0], +r[1] * 10000]; }).sort(function(a, b){ return a[0] - b[0]; });
  if(!pts.length) throw new Error('No WOB vs Measured Depth plot saved in Drilling Mechanics for this job.');
  return function(md){ if(md <= pts[0][0]) return pts[0][1]; if(md >= pts[pts.length - 1][0]) return pts[pts.length - 1][1];
    for(var i = 1; i < pts.length; i++) if(pts[i][0] >= md){ var a = pts[i - 1], b = pts[i]; return a[1] + (md - a[0]) * (b[1] - a[1]) / ((b[0] - a[0]) || 1); } };
}
async function applyPerStation(){
  var inp; try{ inp = engineInput(); }catch(e){ alert(e.message); return; }
  var wobAt = null;
  if($('kAxial').checked && $('kWobSrc').value === 'dm'){ try{ wobAt = await loadDmWob(); }catch(e){ alert(e.message); return; } }
  var geo = SagKinetic.stationGeometry(survey), useC = $('kCurv').checked, useTF = $('kBendTF').value === 'survey';
  var stations = survey.map(function(s, i){ var gm = geo[i];
    return { md: s.md, inc: s.inc, curvatureV: useC ? gm.kappa * Math.cos(gm.tf * Math.PI / 180) : 0,
             bendTFDeg: useTF ? gm.tf : 0, wob: inp.axialLoad ? (wobAt ? wobAt(s.md + inp.sensorPosition) : inp.wob) : 0 }; });
  stationInfo = stations.map(function(st, i){ return { dls30: geo[i].dls30, tf: geo[i].tf, tfDefined: geo[i].tfDefined, wob: st.wob }; });
  $('svyInfo').textContent = 'Solving ' + stations.length + ' stations…';
  var t0 = Date.now(), w = getWorker();
  w.onmessage = function(ev){ var m = ev.data;
    if(m.type === 'error'){ $('svyInfo').innerHTML = '<span class="bad">' + m.error + '</span>'; return; }
    if(m.type === 'stationProgress'){ $('svyInfo').textContent = 'Solving stations ' + m.done + ' / ' + m.total + '…'; return; }
    if(m.type === 'stations'){
      corrected = SagModel.correctSurveyPerStation(survey, m.results.map(function(r){ return r.corr; }), {tvd:0, n:0, e:0});
      corrected.forEach(function(s, i){ s.status = m.results[i].status; });
      table = table || {model:'Kinetic', rows:[], full:[]}; table.model = 'Kinetic';
      renderSurvey();
      var bad = m.results.filter(function(r){ return r.status !== 'ok'; }).length;
      // Dawson & Paslay (JPT 1984) critical-load check: the planar model can't show buckling, so warn.
      var dpBad = m.results.filter(function(r){ return r.dp != null && r.dp < 1; }).length;
      $('btnSaveVer').disabled = !surveySource || USER_ROLE === 'viewer';
      $('svyInfo').innerHTML = 'Kinetic per-station · ' + corrected.length + ' stations in ' + ((Date.now() - t0) / 1000).toFixed(1) + ' s' +
        (bad ? ' · <span class="warn">' + bad + ' not solved (buckled / not converged) — left uncorrected</span>' : '') +
        (dpBad ? ' · <span class="warn">' + dpBad + ' station(s) with compression above the Dawson–Paslay critical buckling load — treat those corrections with caution</span>' : '') +
        ' · ΔTVD at TD = ' + fmt(L(corrected[corrected.length - 1].dTvd), 3) + (UNIT === 'metric' ? ' m' : ' ft');
    } };
  w.postMessage({type:'stations', input:inp, stations:stations, opts:{maxIterations:+$('maxIter').value}});
}
function renderSurvey(){
  var src = corrected.length ? corrected : survey.map(function(s){ return {md:s.md, incRaw:s.inc, az:s.az}; });
  $('svyBody').innerHTML = src.map(function(s, idx){
    var c = corrected.length, si = (c && stationInfo) ? stationInfo[idx] : null;
    return '<tr><td>' + fmt(L(s.md), 2) + '</td><td>' + fmt(s.incRaw, 3) + '</td><td' + (c && s.corr == null ? ' class="warn"' : '') + '>' +
      (c ? (s.corr == null ? 'n/c' : fmt(s.corr, 3)) : '') + '</td><td>' + (c ? fmt(s.inc, 3) : '') + '</td><td>' + fmt(s.az, 3) + '</td>' +
      '<td>' + (c ? fmt(L(s.tvdRaw), 2) : '') + '</td><td>' + (c ? fmt(L(s.tvd), 2) : '') + '</td><td>' + (c ? fmt(L(s.dTvd), 3) : '') + '</td>' +
      '<td>' + (c ? fmt(L(s.dN), 3) : '') + '</td><td>' + (c ? fmt(L(s.dE), 3) : '') + '</td><td>' + (c ? fmt(s.dls, 2) : '') + '</td>' +
      '<td>' + (si ? (si.tfDefined ? fmt(si.tf, 1) : '—') : '') + '</td><td>' + (si && $('kAxial').checked ? fmt(UNIT === 'metric' ? si.wob / 1000 : si.wob / 4448.2216152605, 1) + (UNIT === 'metric' ? ' kN' : ' klbf') : '') + '</td></tr>';
  }).join('');
}
function exportSurvey(){
  if(!corrected.length){ alert('Apply the sag correction first.'); return; }
  var u = UNIT === 'metric' ? 'm' : 'ft';
  var data = corrected.map(function(s){ var o = {};
    o['MD (' + u + ')'] = +L(s.md).toFixed(3); o['Inc measured (deg)'] = s.incRaw; o['Sag correction (deg)'] = s.corr;
    o['Inc corrected (deg)'] = +s.inc.toFixed(4); o['Az (deg)'] = s.az;
    o['TVD measured (' + u + ')'] = +L(s.tvdRaw).toFixed(3); o['TVD corrected (' + u + ')'] = +L(s.tvd).toFixed(3);
    o['dTVD (' + u + ')'] = +L(s.dTvd).toFixed(4); o['dN (' + u + ')'] = +L(s.dN).toFixed(4); o['dE (' + u + ')'] = +L(s.dE).toFixed(4);
    o['DLS (deg/30m)'] = +s.dls.toFixed(3);
    if(stationInfo){ var si = stationInfo[corrected.indexOf(s)]; o['Survey DLS used (deg/30m)'] = +si.dls30.toFixed(3); o['Survey TF used (deg)'] = si.tfDefined ? +si.tf.toFixed(2) : '';
      o['WOB used (N)'] = Math.round(si.wob); o['Status'] = s.status || ''; }
    return o; });
  var wb = XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(data), 'Sag corrected');
  if(table) XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(table.rows.map(function(r){ return {'Model':table.model, 'Inc (deg)':r.inc, 'Correction (deg)':r.corr, 'Status':r.status}; })), 'Sag table');
  XLSX.writeFile(wb, 'SAG_corrected_survey' + (surveySource ? '_' + surveySource.wellKey.replace(/[^a-z0-9\-_ ]/gi, '_') : '') + '.xlsx');
}
// Improvement #10 (2026-10-24): toolcode chosen at save time ("ask each
// time"). Suggestion = the toolcode with the same tokens plus "SAG"
// (e.g. MWD+SRGM -> MWD+SRGM+SAG, MWD+IFR1+MS_Fl -> MWD+IFR1+SAG+MS_Fl).
// The suggestion's term list is compared with the original's excluding the
// sag terms (SAG, SAGE): any other difference is shown as a warning — this
// caught MWD+HRGM, whose XYM3/XYM4/SAG terms were added from Compass's
// .ipm; since 2026-10-26 those legacy terms are treated as a known Compass
// revision difference (see COMPASS_MB_LEGACY below).
var TOOLCODES = null, svOrigCode = '';
var SAG_TERMS = ['SAG', 'SAGE'];
function tcTokens(code){ var fl = /_Fl$/.test(code); return {fl: fl, set: code.replace(/_Fl$/, '').split('+').sort().join('+')}; }
function sagCounterpart(code){
  if(!code || /(^|\+)SAG(\+|_|$)/.test(code)) return null;
  var t = tcTokens(code), want = code.replace(/_Fl$/, '').split('+').concat(['SAG']).sort().join('+');
  return Object.keys(TOOLCODES).find(function(k){ var u = tcTokens(k); return u.fl === t.fl && u.set === want; }) || null;
}
// 2026-10-26 (John, option 2): MTX's MWD+HRGM matches John's Compass .ipm
// (OWSG B001Mb, Rev 5 Nov-2019), which still carries the legacy terms SAG,
// XYM3 and XYM4 next to SAGE/XYM3E/XYM4E. The +SAG/+AX/+MS toolcodes come
// from the official OWSG Rev 5.1 workbook (B00xMc, Oct-2020), whose revision
// note says XYM3->XYM3E, XYM4->XYM4E, SAG->SAGE were REPLACED. Dropping those
// legacy terms is therefore a known revision difference, not a model change:
// it no longer blocks the suggestion and is shown as a note instead.
var COMPASS_MB_LEGACY = ['SAG', 'XYM3', 'XYM4'];
function legacyDropped(a, b){
  var A = {}, B = {}; (TOOLCODES[a] || []).forEach(function(t){ A[t.code] = 1; }); (TOOLCODES[b] || []).forEach(function(t){ B[t.code] = 1; });
  return COMPASS_MB_LEGACY.filter(function(k){ return A[k] && !B[k]; });
}
function nonSagDiff(a, b){
  var A = {}, B = {}, out = [];
  (TOOLCODES[a] || []).forEach(function(t){ A[t.code] = JSON.stringify(t); });
  (TOOLCODES[b] || []).forEach(function(t){ B[t.code] = JSON.stringify(t); });
  Object.keys(Object.assign({}, A, B)).forEach(function(k){
    if(SAG_TERMS.indexOf(k) >= 0) return;
    if(!(k in B) && COMPASS_MB_LEGACY.indexOf(k) >= 0) return; // known Compass Mb vs OWSG Mc difference (see above)
    if(!(k in B)) out.push(k + ' missing in ' + b); else if(!(k in A)) out.push(k + ' only in ' + b); else if(A[k] !== B[k]) out.push(k + ' differs');
  });
  return out;
}
function sagDiffText(a, b){
  var A = {}, B = {}, out = [];
  (TOOLCODES[a] || []).forEach(function(t){ if(SAG_TERMS.indexOf(t.code) >= 0) A[t.code] = t.magnitude; });
  (TOOLCODES[b] || []).forEach(function(t){ if(SAG_TERMS.indexOf(t.code) >= 0) B[t.code] = t.magnitude; });
  SAG_TERMS.forEach(function(k){ if(A[k] !== B[k]) out.push(k + ' ' + (A[k] == null ? '—' : A[k] + '°') + ' → ' + (B[k] == null ? '—' : B[k] + '°')); });
  return out.join(', ');
}
function checkToolcode(){
  var code = $('svCode').value, base = svOrigCode || 'MWD+SRGM', html = '';
  if(code !== base){
    var d = nonSagDiff(base, code), sd = sagDiffText(base, code);
    if(sd) html += '<div class="muted">Sag terms: ' + sd + '</div>';
    if(d.length) html += '<div class="warn">⚠ ' + code + ' also differs from ' + base + ' in non-sag terms: ' + d.join(', ') +
      '. Saving with it will change the AC ellipses beyond the sag correction.</div>';
  }
  var leg = code !== base ? legacyDropped(base, code) : [];
  if(leg.length) html += '<div class="muted">Note: ' + base + ' (Compass .ipm, OWSG Rev 5 B001Mb) has the legacy term(s) ' + leg.join(', ') +
    ' that OWSG Rev 5.1 replaced (XYM3→XYM3E, XYM4→XYM4E, SAG→SAGE); ' + code + ' is the official Rev 5.1 version without them.</div>';
  $('svWarn').innerHTML = html;
}
async function saveVersion(){
  if(!surveySource || !corrected.length) return;
  try{
    if(!TOOLCODES) TOOLCODES = await (await fetch('/data/iscwsaToolcodes.json')).json();
    var lst = await (await fetch('/notes/wellboreTrajectory/list/' + surveySource.noteId)).json();
    var t = (lst.trajectories || []).find(function(x){ return x.wellName === surveySource.wellKey && x.source !== 'SAGcorrection'; });
    svOrigCode = t ? (t.toolcode || '') : '';
  }catch(err){ alert('Could not load toolcodes: ' + err.message); return; }
  var base = svOrigCode || 'MWD+SRGM';
  var sug = sagCounterpart(base);
  // suggestion only if it is clean (no non-sag differences); otherwise keep original
  var pre = (sug && !nonSagDiff(base, sug).length) ? sug : base;
  $('svOrig').textContent = (svOrigCode || '(default MWD+SRGM)') + (sug && pre !== sug ? ' — suggested ' + sug + ' NOT preselected (non-sag differences)' : '');
  $('svCode').innerHTML = Object.keys(TOOLCODES).map(function(k){ return '<option' + (k === pre ? ' selected' : '') + '>' + k + '</option>'; }).join('');
  $('saveVerPanel').style.display = '';
  checkToolcode();
}
async function confirmSaveVersion(){
  try{
    var r = await fetch('/notes/sagCorrection/saveVersion', {method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({noteId: surveySource.noteId, wellKey: surveySource.wellKey, model: table ? table.model : 'Beam', toolcode: $('svCode').value,
        corrections: corrected.map(function(s){ return {md:s.md, inc:s.inc}; })})});
    var d = await r.json(); if(!d.ok) throw new Error(d.error);
    $('saveVerPanel').style.display = 'none';
    alert('Saved as "' + d.wellName + '" with toolcode ' + d.toolcode + '. The original survey was not changed.');
  }catch(err){ alert('Save failed: ' + err.message); }
}

// Model selector (2026-10-24). Beam = SurQC port (default, matches SurQC);
// Kinetic = same physics, exact FE + active-set wall contact (sagKinetic.js).
var MODEL_NOTES = {
  Beam: '<b>Beam</b> — line-by-line port of SurQC (2016 source), matches SurQC to round-off. Known SurQC limits kept: ' +
    'no convergence with a stabiliser directly above the bit; sensor read 0.1–0.2 m above the entered position; Inc 0° = 0; ' +
    'BHA may sit up to 2.5 mm inside the hole wall (contact tolerance).',
  Kinetic: '<b>Kinetic</b> — same physics as Beam (beam theory, buoyed weight, bit centred, top on low side), solved exactly: ' +
    'finite elements + exact wall contact (converges with near-bit stabilisers), slope read at the exact sensor position, bend at its exact ' +
    'distance and solved at Inc 0°. Differs from Beam by up to a few hundredths of a degree, mainly because Beam lets the BHA sit inside the wall.'
};
function onModelChange(){ $('modelNote').innerHTML = MODEL_NOTES[$('modelSel').value]; refreshKinOpts(); invalidate(); }
function refreshKinOpts(){
  var kin = $('modelSel').value === 'Kinetic';
  $('kinOpts').style.display = kin ? '' : 'none';
  $('kWobSrc').disabled = !$('kAxial').checked;
  $('kWobField').style.display = ($('kAxial').checked && $('kWobSrc').value === 'one') ? '' : 'none';
}
// Per-station solving is needed when an option varies along the survey.
function perStationMode(){
  return $('modelSel').value === 'Kinetic' && ($('kCurv').checked || $('kBendTF').value === 'survey' || ($('kAxial').checked && $('kWobSrc').value === 'dm'));
}
function wobUnitToN(v){ return UNIT === 'metric' ? v * 1000 : v * 4448.2216152605; }   // kN or klbf -> N (1 lbf = 4.4482216152605 N, exact)
document.addEventListener('DOMContentLoaded', function(){ $('modelNote').innerHTML = MODEL_NOTES.Beam; });

// ===================================================================
// Saved cases (same role matrix as 6-axis Data)
// ===================================================================
function caseInput(){
  return { unit: UNIT, bhaRows: readBha(true), sensor_m: Lm(+$('sensor').value),
    mud_kgm3: UNIT === 'metric' ? +$('mud').value : +$('mud').value * PPG, bendDist_m: Lm(+$('bendDist').value),
    bendDeg: +$('bendDeg').value, grav: +$('grav').value, maxIter: +$('maxIter').value, bhaLimit_m: Lm(+$('bhaLimit').value),
    profInc: +$('profInc').value, model: $('modelSel').value,
    kinetic: { curv: $('kCurv').checked, bendTF: $('kBendTF').value, axial: $('kAxial').checked, wobSrc: $('kWobSrc').value, wob_N: wobUnitToN(+$('kWob').value) },
    source: { mtxJobId: job.mtxJobId, surveySource: surveySource } };
}
async function refreshCases(){
  try{
    var d = await (await fetch('/notes/sagCorrection/cases')).json();
    window._cases = d;
    $('caseList').innerHTML = '<option value="">— saved cases —</option>' + d.cases.map(function(c){
      return '<option value="' + c._id + '">' + c.name + ' · ' + c.createdByName + ' · ' + new Date(c.createdAt).toLocaleDateString() + '</option>'; }).join('');
  }catch(e){}
}
async function saveCase(){
  var name = $('caseName').value.trim(); if(!name){ alert('Enter a case name.'); return; }
  var r = await fetch('/notes/sagCorrection/case', {method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({name:name, inputData:caseInput(), survey:survey})});
  var d = await r.json(); if(!d.ok){ alert(d.error); return; }
  refreshCases(); alert('Case saved.');
}
async function loadCase(){
  var id = $('caseList').value; if(!id) return;
  var d = await (await fetch('/notes/sagCorrection/case/' + id)).json(); if(!d.ok){ alert(d.error); return; }
  var c = d.case.inputData || {};
  $('unitSel').value = 'metric'; UNIT = 'metric'; setUnit('metric');
  $('sensor').value = c.sensor_m; $('mud').value = c.mud_kgm3; $('bendDist').value = c.bendDist_m; $('bendDeg').value = c.bendDeg;
  $('grav').value = c.grav || 9.80665; $('maxIter').value = Math.max(c.maxIter || 0, 2000000); $('bhaLimit').value = c.bhaLimit_m || 60; $('profInc').value = c.profInc || 45;  // 2026-10-24: maxIter floor 2e6 (older cases saved 200000, too low for large bends)
  $('bhaBody').innerHTML = ''; (c.bhaRows || []).forEach(function(r){ addRow(r); });
  survey = d.case.survey || []; surveySource = (c.source && c.source.surveySource) || null;
  corrected = []; table = null; $('corrBody').innerHTML = ''; renderSurvey(); $('btnSaveVer').disabled = true;
  $('caseName').value = d.case.name;
  $('modelSel').value = c.model === 'Kinetic' ? 'Kinetic' : 'Beam';
  var kn = c.kinetic || {}; $('kCurv').checked = !!kn.curv; $('kBendTF').value = kn.bendTF === 'survey' ? 'survey' : 'hs';
  $('kAxial').checked = !!kn.axial; $('kWobSrc').value = kn.wobSrc === 'dm' ? 'dm' : 'one'; $('kWob').value = ((kn.wob_N || 0) / 1000).toFixed(2);
  onModelChange();
  if(c.unit === 'imperial'){ $('unitSel').value = 'imperial'; setUnit('imperial'); }
  $('svyInfo').textContent = survey.length ? survey.length + ' stations (from case)' : '';
}
async function deleteCase(){
  var id = $('caseList').value; if(!id) return;
  if(!confirm('Delete this case?')) return;
  var d = await (await fetch('/notes/sagCorrection/case/' + id, {method:'DELETE'})).json();
  if(!d.ok){ alert(d.error); return; } refreshCases();
}

