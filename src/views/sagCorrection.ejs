async function loadJob(){
  var id = $('mtxId').value.trim(); if(!id){ $('jobStatus').textContent = 'Enter a Job ID first.'; return; }
  $('jobStatus').textContent = 'Loading…';
  try{
    var r = await fetch('/notes/tdModel/lookupByMtxId/' + encodeURIComponent(id));
    var d = await r.json();
    if(!r.ok) throw new Error(d.error || r.status);
    job = { noteId: d.noteId, title: d.title, mtxJobId: id, wells: d.subjectWells || [], td: null };
    var r2 = await fetch('/notes/tdModel/' + d.noteId); job.td = await r2.json();
    $('wellSel').innerHTML = job.wells.map(function(w, i){ return '<option value="' + i + '">' + w.wellKey + '</option>'; }).join('');
    onWellChange();
    $('jobStatus').innerHTML = '<span class="ok">✔ ' + d.title + '</span> · ' + job.wells.length + ' subject well(s)' +
      (job.td ? '' : ' · no saved T&D model in this job') + (d.duplicateWarning ? ' <span class="warn">' + d.duplicateWarning + '</span>' : '');
  }catch(err){ $('jobStatus').innerHTML = '<span class="bad">' + err.message + '</span>'; }
}
function onWellChange(){
  var w = job.wells[+$('wellSel').value]; var td = job.td;
  var opts = [];
  if(td && td.scenarios && w){
    Object.keys(td.scenarios).forEach(function(s){
      var rb = td.scenarios[s].resultsByWell || {};
      if(rb[w.wellKey] && rb[w.wellKey].bha && rb[w.wellKey].bha.length) opts.push(s);
    });
  }
  $('scenSel').innerHTML = opts.length ? opts.map(function(s){ return '<option' + (td.activeScenario === s ? ' selected' : '') + '>' + s + '</option>'; }).join('')
    : '<option value="">(no saved BHA for this well)</option>';
}
function loadBhaFromTD(){
  var w = job.wells[+$('wellSel').value], s = $('scenSel').value;
  if(!w || !s){ alert('Load a job and pick a well with a saved T&D BHA first.'); return; }
  var bha = job.td.scenarios[s].resultsByWell[w.wellKey].bha;
  // T&D getBHA(): {name, od_m, id_m, len (m), wt (kg/m)}, bit first.
  $('bhaBody').innerHTML = '';
  bha.forEach(function(c){ addRow({ use:true, name:c.name, od_mm:+(c.od_m * 1000).toFixed(2), id_mm:+(c.id_m * 1000).toFixed(2),
    len_m:+c.len, wt_kgm:c.wt == null ? '' : +c.wt, sf:1, material:'Steel' }); });
