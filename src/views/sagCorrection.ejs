    var lay3 = Object.assign({}, RP_LIGHT, {margin:{l:0, r:0, t:10, b:0}, showlegend:true, legend:{orientation:'h', x:0, y:0},
      scene:{xaxis:ax('xaxis'), yaxis:ax('yaxis'), zaxis:ax('zaxis'), aspectmode:fl ? fl.aspectmode : 'manual', aspectratio:fl ? Object.assign({}, fl.aspectratio) : undefined, camera:cam ? JSON.parse(JSON.stringify(cam)) : undefined, bgcolor:'#ffffff'}});
    var img3d = await Plotly.toImage({data:data3, layout:lay3}, {format:'png', width:1000, height:650, scale:2});
    var RI = null;   // 2026-11-07 runs: per-run inputs + tables for the report
    if(runsActive()){ runSave(); var keepR = activeRun, asg = runAssign(); RI = [];
      for(var q = 0; q < RUNS.length; q++){ runLoad(q, true); var R0 = RUNS[q], sr = runRange(R0);
        RI.push({name:R0.name, bitIn:R0.bitIn_m, bitOut:R0.bitOut_m, from:sr[0], to:sr[1], n:asg.filter(function(a){ return a === q; }).length, inp:engineInput(), table:runTables[q] || null}); }
      if(keepR >= 0) runLoad(keepR, true); }
    var imgTab = null, rows = (table && table.rows) || [];
    if(RI){ var trR = RI.filter(function(R){ return R.table && R.table.rows && R.table.rows.length; }).map(function(R){ return {x:R.table.rows.map(function(r){ return r.inc; }), y:R.table.rows.map(function(r){ return r.corr; }), mode:'lines+markers', name:R.name}; });
      if(trR.length){ await Plotly.newPlot('rpC', trR, Object.assign({}, RP_LIGHT, {margin:{l:60, r:10, t:30, b:40}, title:{text:'SAG correction vs inclination — per run (' + $('modelSel').value + ')', font:{size:12}}, xaxis:{title:'Inclination (°)', gridcolor:'#d9dde3'}, yaxis:{title:'Correction (°)', gridcolor:'#d9dde3'}}));
        imgTab = await rpImg('rpC', 1000, 300); }
      rows = []; }
    if(rows.length){ await Plotly.newPlot('rpC', [{x:rows.map(function(r){ return r.inc; }), y:rows.map(function(r){ return r.corr; }), mode:'lines+markers', line:{color:'#1f6fd1'}, name:table.model}],
      Object.assign({}, RP_LIGHT, {margin:{l:60, r:10, t:30, b:40}, title:{text:'SAG correction vs inclination (' + table.model + ')', font:{size:12}}, xaxis:{title:'Inclination (°)', gridcolor:'#d9dde3'}, yaxis:{title:'Correction (°)', gridcolor:'#d9dde3'}}));
      imgTab = await rpImg('rpC', 1000, 300); }
    st('Logo…');
    var logo = await rpDataUrl(RP_LOGO);
    rpOpen(rpHtml(inp, idx, secs, img3d, imgTab, logo, RI));
    st('Report opened in a new tab.');
  } catch(e){ alert('Report: ' + e.message); st(''); }
  finally { $('btnReport').disabled = false; $('rpOff').innerHTML = ''; }
}
function rpOpen(html){ var w = window.open('', '_blank'); if(!w){ alert('Allow pop-ups for this site to open the report.'); return; } w.document.open(); w.document.write(html); w.document.close(); }
function rpHtml(inp, idx, secs, img3d, imgTab, logo, RI){
  var u = UNIT === 'metric' ? 'm' : 'ft', today = new Date().toISOString().slice(0, 10), model = (table && table.model) || $('modelSel').value;
  var well = $('rpWell').value || (surveySource ? surveySource.wellKey : ''), jobT = $('rpJob').value || (job && job.mtxJobId ? job.mtxJobId + (job.title ? ' — ' + job.title : '') : '');
  var cs = corrected.filter(function(c){ return c.corr != null; }), maxC = cs.reduce(function(m, c){ return Math.abs(c.corr) > Math.abs(m) ? c.corr : m; }, 0);
  var last = corrected[corrected.length - 1], unc = corrected.length - cs.length;
  var tot = inp.subComponents.reduce(function(a, c){ return a + c.len; }, 0);
  var bad = (RI && RI.length ? RI.reduce(function(a, R){ return a.concat((R.table && R.table.rows) || []); }, []) : ((table && table.rows) || [])).filter(function(r){ return r.status !== 'ok'; });
  var row = function(cells, th){ return '<tr>' + cells.map(function(c){ return (th ? '<th>' : '<td>') + c + (th ? '</th>' : '</td>'); }).join('') + '</tr>'; };
  // print layout: fixed header/footer repeat on every printed page; a wrapping table's thead/tfoot reserve their space
  var css = '@page{size:auto;margin:8mm 12mm}body{font-family:Segoe UI,Arial,sans-serif;color:#1b1f24;font-size:11px;margin:0}' +
    'table.pg{width:100%;border:0;margin:0}table.pg>thead>tr>td,table.pg>tfoot>tr>td,table.pg>tbody>tr>td{border:0;padding:0;text-align:left}.sp-h{height:17mm}.sp-f{height:9mm}' +
    '.hdr{position:fixed;top:0;left:0;right:0;height:14mm;background:#fff;display:flex;align-items:center;justify-content:space-between;border-bottom:2px solid ' + RP_COLOR + ';font-size:10px;color:#444}' +
    '.hdr img{height:11mm}.ftr{position:fixed;bottom:0;left:0;right:0;height:7mm;background:#fff;font-size:9px;color:#666;display:flex;justify-content:space-between;border-top:1px solid #ccc;padding-top:2px}' +
    'h1{font-size:20px;margin:6px 0 2px}h2{font-size:14px;border-bottom:1px solid ' + RP_COLOR + ';padding-bottom:2px;margin:16px 0 6px;color:' + RP_COLOR + ';page-break-after:avoid}h3{font-size:12px;margin:10px 0 4px}' +
    'table{border-collapse:collapse;width:100%;margin:4px 0 8px}th,td{border:1px solid #cfd4da;padding:2px 5px;text-align:right;font-size:10px}th{background:#eef1f4}td:first-child,th:first-child{text-align:left}' +
    '.kv td:first-child{width:38%;background:#f7f8fa}.fig{width:100%;margin:4px 0}.two{display:flex;gap:6px}.two img{width:50%}.sec{page-break-inside:avoid}.pb{page-break-before:always}' +
    '.note{font-size:10px;color:#444;background:#f7f8fa;border-left:3px solid ' + RP_COLOR + ';padding:4px 8px;margin:6px 0}.ok{color:#1a7f37}.bad{color:#c8102e}.noprint{margin:8px 0}' +
    '@media print{.noprint{display:none}}@media screen{body{max-width:900px;margin:20px auto}.hdr,.ftr{position:static}.sp-h,.sp-f{height:0}}';
  var h = '<!doctype html><html><head><meta charset="utf-8"><title>SAG correction report — ' + rpEsc(well) + '</title><style>' + css + '</style></head><body>';
  h += '<div class="hdr"><img src="' + logo + '" alt="Canadian Natural"><div style="text-align:right"><b>SAG Correction — Technical Report</b><br>' + rpEsc(well) + ' · ' + rpEsc(jobT) + ' · ' + today + '</div></div>';
  h += '<div class="ftr"><span>MTX Conveyor · SAGcorrection · ' + rpEsc(model) + ' model</span><span>Prepared by ' + rpEsc($('rpBy').value) + (($('rpChk').value) ? ' · Checked by ' + rpEsc($('rpChk').value) : '') + '</span></div>';
  h += '<table class="pg"><thead><tr><td><div class="sp-h"></div></td></tr></thead><tfoot><tr><td><div class="sp-f"></div></td></tr></tfoot><tbody><tr><td>';
  h += '<div class="noprint"><button onclick="window.print()">🖨 Print / Save as PDF</button></div>';
  // 1 cover & summary
  h += '<h1>SAG Correction — Technical Report</h1><div style="color:#555;margin-bottom:8px">' + rpEsc(well) + '</div>';
  h += '<h2>1 · Summary</h2><table class="kv">' +
    [['Well', rpEsc(well)], ['Job / MTX ID', rpEsc(jobT)], ['Run / section', rpEsc($('rpRun').value)], ['Date', today], ['Prepared by', rpEsc($('rpBy').value)], ['Checked by', rpEsc($('rpChk').value)],
     ['Correction model', rpEsc(model) + (model === 'Kinetic' ? ' (finite-element beam with wall contact)' : ' (SurQC algorithm)')], ['Toolcode of the corrected well', rpEsc($('rpTool').value || '—')],
     ['Stations corrected', cs.length + ' of ' + corrected.length + (unc ? ' <span class="bad">(' + unc + ' left uncorrected)</span>' : '')],
     ['Largest correction', fmt(maxC, 3) + '°'], ['ΔTVD at last station', fmt(L(last.dTvd), 3) + ' ' + u], ['ΔN / ΔE at last station', fmt(L(last.dN), 3) + ' / ' + fmt(L(last.dE), 3) + ' ' + u],
     ['Runs / BHAs', RI && RI.length ? RI.map(function(R){ return rpEsc(R.name) + ': bit MD ' + fmt(L(R.bitIn), 1) + '–' + fmt(L(R.bitOut), 1) + ' ' + u + ' (' + R.n + ' st.)'; }).join('<br>') : 'single BHA'],
     ['Comments', rpEsc($('rpNotes').value || '—')]].map(function(r){ return row(r); }).join('') + '</table>';
  h += '<div class="sec"><img class="fig" src="' + img3d + '"><div class="note">3D view as set in the station view (panel 5). Measured (blue), SAG-corrected (green, dashed), BHA at the selected station (orange bar); orange dots = stations analysed in section 4.</div></div>';
  // 2 inputs
  // 2026-11-07: one block per run when runs are used (RI), else the single BHA
  var inBlock = function(inp, ttl){ var tot = inp.subComponents.reduce(function(a, c){ return a + c.len; }, 0), h = '';
  h += '<h3>' + ttl + 'BHA (bit first, analysed length ' + fmt(L(tot), 2) + ' ' + u + ')</h3><table>' + row(['#', 'Component', 'OD (mm)', 'ID (mm)', 'Length (' + u + ')', 'Weight (kg/m)', 'E (GPa)', 'ρ (kg/m³)', 'EI (kN·m²)'], true) +
    inp.subComponents.map(function(c, i){ return row([i + 1, rpEsc(c.name), fmt(c.od * 1000, 2), fmt(c.id * 1000, 2), fmt(L(c.len), 2), c.wt > 0 ? fmt(c.wt, 2) : 'from OD/ID', fmt(c.E / 1e9, 1), fmt(c.rho, 0), fmt(c.E * sdI(c) / 1000, 1)]); }).join('') + '</table>';
  h += '<table class="kv">' + [['Sensor distance from bit', fmt(L(inp.sensorPosition), 2) + ' ' + u], ['Hole diameter (= bit OD)', fmt(inp.subComponents[0].od * 1000, 2) + ' mm'],
    ['Motor bend', fmt(inp.bendAngleDeg, 2) + '° at ' + fmt(L(inp.bendDistance), 2) + ' ' + u + ' from bit'], ['Mud density', fmt(inp.mudDensity, 0) + ' kg/m³'], ['Gravity', fmt(inp.gravity, 5) + ' m/s²'],
    ['Kinetic options', 'hole curvature: ' + ($('kCurv').checked ? 'on' : 'off') + ' · bend toolface: ' + ($('kBendTF').value === 'survey' ? 'survey toolface' : 'high side') + ' · axial load / WOB: ' + ($('kAxial').checked ? 'on' : 'off')],
    ['Survey', corrected.length + ' stations, MD ' + fmt(L(survey[0].md), 2) + '–' + fmt(L(survey[survey.length - 1].md), 2) + ' ' + u + (surveySource ? ' (MTX job well ' + rpEsc(surveySource.wellKey) + ')' : ' (imported file)')]].map(function(r){ return row(r); }).join('') + '</table>';
  return h; };
  h += '<h2 class="pb">2 · Inputs</h2>' + (RI && RI.length ? RI.map(function(R){ return inBlock(R.inp, rpEsc(R.name) + ' — bit MD ' + fmt(L(R.bitIn), 2) + '–' + fmt(L(R.bitOut), 2) + ' ' + u + ' (survey MD ' + fmt(L(R.from), 2) + '–' + fmt(L(R.to), 2) + ', ' + R.n + ' stations) · '); }).join('') : inBlock(inp, ''));
  h += '<div class="note">Material column: E and ρ shown are the values used by Kinetic. Beam (SurQC) uses steel (E = 210 GPa, ρ = 7700 kg/m³) for every component.</div>';
  // 3 method, theory, assumptions
  h += '<h2 class="pb">3 · Method, theory and assumptions</h2>' +
    '<h3>3.1 Physical model</h3><p>The BHA is modelled as an elastic Euler–Bernoulli beam lying in the borehole under its own buoyed weight. Gravity acts towards the low side of the hole; the lateral distributed load per unit length is</p>' +
    '<p style="text-align:center"><i>q(x) = w(x) · sin(Inc)</i>, &nbsp; <i>w = m · g · (1 − ρ<sub>mud</sub>/ρ<sub>material</sub>)</i></p>' +
    '<p>where <i>m</i> is the mass per metre (weight column, or ρ·π(OD² − ID²)/4). The bit is held on the hole axis; stabilisers and any collar touching the low-side wall act as supports. Their locations are not known in advance: the solver finds them (a contact problem), so the beam is statically indeterminate.</p>' +
    '<p style="text-align:center"><i>EI · d⁴y/dx⁴ = q(x)</i> &nbsp; (Kinetic with axial load: <i>EI·y⁗ + P·y″ = q</i>)</p>' +
    '<h3>3.2 Results derived from the deflected shape</h3><table class="kv">' +
    [['Deflection y(x)', 'lateral position of the BHA centreline relative to the hole axis (negative = towards the low side)'], ['Slope θ(x)', 'θ = dy/dx — the angle between the BHA axis and the hole axis'],
     ['Bending moment M(x)', 'M = EI · d²y/dx²'], ['Shear force V(x)', 'lateral force on the section by statics, V = Σ reactions − ∫q dx (from the bit); each support / wall contact is a jump in V equal to its reaction. Without axial load V = dM/dx; with axial load (WOB) M also carries the P·dy/dx term, so V ≠ dM/dx'],
     ['Bending stress σ(x)', 'σ = M·c/I at the outer fibre, c = OD/2, I = π(OD⁴ − ID⁴)/64 — indicative only (no stress concentration at connections, no fatigue assessment)'],
     ['<b>SAG correction</b>', '<b>θ at the MWD sensor</b>: the inclination error of the sensor axis caused by the BHA bending. Corrected Inc = measured Inc + correction; MD and Az are not changed. TVD/N/E recomputed by minimum curvature.']].map(function(r){ return row(r); }).join('') + '</table>' +
    '<h3>3.3 Solvers</h3><p><b>Beam</b> — port of the SurQC sag algorithm (iterative solution of the beam equation; steel only; no hole curvature, toolface or WOB). Ported code matches the original C# to 7·10⁻¹⁵°.</p>' +
    '<p><b>Kinetic</b> — finite-element solution with Hermite cubic beam elements and an active-set wall-contact algorithm; includes materials, motor bend projected by its toolface, hole curvature (build/drop component of the dogleg) and optional axial load. Checked against the Timoshenko &amp; Gere closed-form beam-column solution (agreement 10⁻⁶°) and an independent finite-difference solution (5·10⁻⁴°). Buckling is screened with the Dawson &amp; Paslay (1984) critical load.</p>' +
    '<h3>3.4 Assumptions and limitations</h3><ul>' +
    ['Linear elastic, small deflections; plane bending in the high-side plane (lateral/azimuth sag not computed).', 'Hole is round and in gauge (diameter = bit OD); formation is rigid; no washouts.',
     'Bit centred on the hole axis; stabiliser blades in contact when the solution requires; contact tolerance 2.5 mm.', 'Surveys are taken off bottom (WOB ≈ 0) unless an axial load is entered.',
     'Inclinations above 90° are mirrored (180° − Inc), as in SurQC.', 'Bending stress is indicative only; it is not a strength or fatigue verification.',
     'The correction applies to the survey sensor position; the ISCWSA SAG/SAGE uncertainty term should be revised accordingly in the toolcode.'].map(function(t){ return '<li>' + t + '</li>'; }).join('') + '</ul>' +
    '<h3>3.5 References</h3><ul>' + ['Timoshenko, S.P. &amp; Gere, J.M., <i>Theory of Elastic Stability</i> / <i>Mechanics of Materials</i> — beam and beam-column theory.', 'SurQC — survey quality control software (sag correction algorithm, ported).',
      'Dawson, R. &amp; Paslay, P.R., "Drillpipe Buckling in Inclined Holes", JPT, Oct 1984.', 'ISCWSA — Definition of the ISCWSA Error Model, Rev 5 (SAG / SAGE terms); OWSG toolcode set Rev 5.1.',
      'Bourgoyne, A.T. et al., <i>Applied Drilling Engineering</i>, SPE 1986 — minimum curvature, dogleg and toolface (Eqs. 8.33–8.49).'].map(function(t){ return '<li>' + t + '</li>'; }).join('') + '</ul>';
  // 4 beam analysis
  h += '<h2 class="pb">4 · Beam analysis at representative stations</h2><div class="note">Both models are solved at each station. Solid / coloured = Kinetic (colour = outer-fibre bending stress), dashed red = Beam (SurQC). Radial axis in mm, length in ' + u + ' (deformation exaggerated by the axis scales). Green arrows = support / wall-contact reactions (resultant per contact zone); purple = distributed load.</div>';
  secs.forEach(function(sc, k){ var s = survey[sc.S.i];
    h += '<div class="' + (k ? 'pb' : '') + '"><h3>4.' + (k + 1) + ' Station ' + (sc.S.i + 1) + ' — MD ' + fmt(L(s.md), 2) + ' ' + u + ', Inc ' + fmt(s.inc, 2) + '°, Az ' + fmt(s.az, 2) + '°</h3>' +
      '<img class="fig" src="' + sc.imgs.bha + '"><div class="two"><img src="' + sc.imgs.v + '"><img src="' + sc.imgs.m + '"></div><div class="two"><img src="' + sc.imgs.t + '"><img src="' + sc.imgs.y + '"></div>' +
      sc.tableHtml.replace(/class="ok"/g, 'class="ok"') +
      (sc.eq ? '<div class="note">Equilibrium check (Kinetic): Σ reactions = ' + fmt(sc.eq.sumR, 1) + ' N; total lateral load ∫q dx = ' + fmt(sc.eq.sumQ, 1) + ' N; difference ' + fmt(sc.eq.sumR - sc.eq.sumQ, 2) + ' N.</div>'
              : '<div class="note">Equilibrium check not shown (axial load or hole curvature active — extra lateral force components).</div>') + '</div>'; });
  // 5 correction table (per run when runs are used)
  var tabBlock = function(tbl, img, ttl){ var rows = (tbl && tbl.rows) || [];
    return (ttl ? '<h3>' + ttl + '</h3>' : '') + (rows.length ? (img ? '<img class="fig" src="' + img + '">' : '') + '<table>' + row(['Inc (°)', 'Correction (°)', 'Status', 'Iterations', 'Residual out of hole (mm)'], true) +
    rows.map(function(r){ return row([fmt(r.inc, 1), r.corr == null ? '—' : fmt(r.corr, 3), r.status === 'ok' ? '<span class="ok">converged</span>' : '<span class="bad">' + rpEsc(r.status) + '</span>', r.iterations, fmt(r.residualOutOfHole * 1000, 2)]); }).join('') + '</table>' +
    '<div class="note">Inclinations 90–180° use the mirrored values (SurQC). Non-converged rows are never applied to a survey.</div>'
    : '<div class="note">Per-station Kinetic solution used (one solve per survey station with its own curvature / toolface / WOB) — no inclination table.</div>'); };
  var rows = (table && table.rows) || [];
  h += '<h2 class="pb">5 · Correction table</h2>' + (RI && RI.length ? (imgTab ? '<img class="fig" src="' + imgTab + '">' : '') + RI.map(function(R){ return tabBlock(R.table, null, rpEsc(R.name)); }).join('') : tabBlock(table, imgTab, ''));
  // 6 corrected survey
  h += '<h2 class="pb">6 · Corrected survey</h2><table>' + row(['MD (' + u + ')', 'Inc meas (°)', 'Correction (°)', 'Inc corr (°)', 'Az (°)', 'TVD meas*', 'TVD corr*', 'ΔTVD', 'ΔN', 'ΔE', 'Run'], true) +
    corrected.map(function(c){ return row([fmt(L(c.md), 2), fmt(c.incRaw, 2), c.corr == null ? '<span class="bad">—</span>' : fmt(c.corr, 3), fmt(c.inc, 3), fmt(c.az, 2), fmt(L(c.tvdRaw), 3), fmt(L(c.tvd), 3), fmt(L(c.dTvd), 3), fmt(L(c.dN), 3), fmt(L(c.dE), 3), rpEsc(c.run || '')]); }).join('') +
    '</table><div class="note">*TVD relative to the first station (tie-on). ΔTVD/ΔN/ΔE = corrected − measured, in ' + u + '.</div>';
  // 7 QA
  h += '<h2>7 · Quality checks</h2><table class="kv">' + [
    ['Correction table convergence', rows.length ? (bad.length ? '<span class="bad">' + bad.length + ' inclination(s) not converged: ' + bad.map(function(r){ return r.inc; }).join(', ') + '°</span>' : '<span class="ok">all ' + rows.length + ' inclinations converged</span>') : 'per-station solution'],
    ['Stations left uncorrected', unc ? '<span class="bad">' + unc + '</span>' : '<span class="ok">none</span>'],
    ['Kinetic vs Beam at analysed stations (SAG at sensor)', secs.map(function(sc){ var a = sc.S.res.kinetic, b = sc.S.res.beam; return 'St ' + (sc.S.i + 1) + ': ' + (a && a.sensorSag != null && b && b.sensorSag != null ? fmt(a.sensorSag - b.sensorSag, 3) + '°' : '—'); }).join(' · ')],
    ['Static equilibrium (Kinetic)', secs.filter(function(sc){ return sc.eq; }).length ? secs.filter(function(sc){ return sc.eq; }).map(function(sc){ return 'St ' + (sc.S.i + 1) + ': ' + fmt(Math.abs(sc.eq.sumR - sc.eq.sumQ), 2) + ' N'; }).join(' · ') : 'n/a'],
    ['Known model difference', 'Beam (SurQC) may let the BHA penetrate the wall slightly; Kinetic enforces the wall. Differences up to ~0.035° were accepted (2026-10-24).']].map(function(r){ return row(r); }).join('') + '</table>';
  // 8 sign-off
  h += '<h2>8 · Sign-off</h2><table>' + row(['', 'Name', 'Signature', 'Date'], true) + row(['Prepared by', rpEsc($('rpBy').value), '', today]) + row(['Checked by', rpEsc($('rpChk').value), '', '']) + row(['Approved by', '', '', '']) + '</table>';
  return h + '</td></tr></tbody></table></body></html>';
}

document.addEventListener('DOMContentLoaded', function(){
  $('sdSlider').addEventListener('input', function(){ sdDraw3d(); clearTimeout(sdTimer); sdTimer = setTimeout(sdSolve, 400); });
  $('sdShow3dCorr').addEventListener('change', sdDraw3d); $('sdZoom').addEventListener('change', sdDraw3d);
  sdInit();
});
</script>
