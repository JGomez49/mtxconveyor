<%# 2026-11-15 (John): phone / tablet layout of the top menu (#mtxNavbar, included by navigation_Admin / _Leader /
    _Member). Below the Bootstrap "lg" breakpoint the opened menu is a clean single column: full-width search,
    full-width "+ New Job", theme + font controls on their own rows, and the Member menu as a full-width button whose
    items open as a 2-column, scrollable list with large tap targets. Desktop (>= 992 px) is unchanged. %>
<style>
@media (max-width: 991.98px){
    #mtxNavbar .container-fluid { flex-wrap:wrap; padding:6px 12px; }
    #mtxNavbar .container-fluid > a img { height:40px; margin-right:0 !important; }
    #mtxNavbar .navbar-toggler { padding:6px 10px; }
    #mtxNavbar .navbar-collapse { width:100%; padding:10px 0 6px; }
    #mtxNavbar .navbar-collapse > * { width:100%; max-width:100%; margin:0 0 10px !important; display:flex; justify-content:center; align-items:center; flex-wrap:wrap; gap:8px; }
    #mtxNavbar .navbar-collapse form { width:100%; }
    #mtxNavbar .navbar-collapse .input-group { flex-wrap:nowrap; width:100%; }
    #mtxNavbar .navbar-collapse .input-group-text { display:none; }                 /* "Search:" label — the placeholder says it */
    #mtxNavbar .navbar-collapse input[type="search"] { font-size:16px; min-height:44px; } /* 16 px: no iOS auto-zoom */
    #mtxNavbar .navbar-collapse .btn { min-height:44px; font-size:15px; }
    #mtxNavbar .navbar-collapse .an-theme-wrap { justify-content:center; padding:6px 0; }
    #mtxNavbar .navbar-collapse .mtx-controls-wrap { width:100%; justify-content:center; flex-wrap:wrap; }
    #mtxNavbar .navbar-nav { width:100%; margin:0 !important; display:block; }
    #mtxNavbar .navbar-nav .nav-item { width:100%; }
    #mtxNavbar .navbar-nav .nav-link.dropdown-toggle { width:100%; text-align:center; font-size:16px; padding:10px; border:1px solid rgba(255,255,255,.35); border-radius:6px; }
    #mtxNavbar .dropdown-menu { position:static !important; transform:none !important; width:100%; float:none; margin-top:8px; max-height:60vh; overflow-y:auto; }
    #mtxNavbar .dropdown-menu.show { display:grid; grid-template-columns:1fr 1fr; gap:2px; }
    #mtxNavbar .dropdown-item { font-size:15px; padding:10px 12px; white-space:normal; border-radius:4px; }
}
@media (max-width: 380px){ #mtxNavbar .dropdown-menu.show { grid-template-columns:1fr; } }
</style>
