<%# ===================================================================
    FLOATING FILTER WINDOWS (ADDED 2026-11-08, John)
    The Gantt filter column (#ganttSidebar2) and the DP Stats filter column
    (#dptsSidebar) are hidden; the chart gets the full width. A "☰ Filters (n)"
    button at the top-left of each chart opens a floating window with the
    filter groups side by side in columns. An active-filter summary line sits
    under the button. The ORIGINAL sidebar element is MOVED into the window
    (same checkboxes, ids, handlers, Reset / Save filters / Clear saved) —
    only the layout changes. Phones: the window is full screen (replaces the
    2026-11-04 slide-in drawer for the Gantt, whose toggle is hidden).
    =================================================================== %>
<style>
    .mtxfp-bar { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
    .mtxfp-btn { width:auto !important; padding:4px 12px !important; margin:0 !important; white-space:nowrap; }
    .mtxfp-btn.active { border-color:#00c8ff !important; color:#00c8ff !important; }
    .mtxfp-sum { font-family:var(--an-mono,monospace); font-size:11px; color:var(--an-text-dim,#5a7080); margin:4px 0 6px; }
    .mtxfp-sum b { color:#ffb300; font-weight:600; }
    .mtxfp-modal { position:fixed; inset:0; z-index:1070; background:rgba(0,0,0,.55); display:none; align-items:flex-start; justify-content:center; padding:5vh 12px; }
    .mtxfp-modal.open { display:flex; }
    .mtxfp-win { width:min(1150px,96vw); max-height:88vh; display:flex; flex-direction:column; background:var(--an-panel,#111820);
                 border:1px solid #00c8ff; border-radius:6px; box-shadow:0 12px 40px rgba(0,0,0,.6); color:var(--an-text,#c8d8e8); }
    .mtxfp-hdr { display:flex; align-items:center; gap:10px; padding:10px 14px; border-bottom:1px solid var(--an-border,#1e2d3d); }
    .mtxfp-hdr h5 { flex:1; margin:0; font-family:var(--an-cond,sans-serif); font-size:16px; letter-spacing:1px; text-transform:uppercase; }
    .mtxfp-x { background:none; border:1px solid var(--an-border,#1e2d3d); color:inherit; width:32px; height:32px; border-radius:4px; font-size:18px; cursor:pointer; }
    .mtxfp-body { overflow-y:auto; padding:12px 14px; }
    /* the moved sidebar: no longer a narrow column */
    .mtxfp-in { position:static !important; transform:none !important; width:auto !important; min-width:0 !important; height:auto !important;
                max-height:none !important; border:none !important; box-shadow:none !important; padding:0 !important; overflow:visible !important; background:transparent !important; }
    .mtxfp-cols { display:grid; grid-template-columns:repeat(auto-fill,minmax(190px,1fr)); gap:10px 18px; align-items:start; }
    .mtxfp-col { border:1px solid var(--an-border,#1e2d3d); border-radius:4px; padding:8px 10px; min-width:0; }
    .mtxfp-col h6 { margin-top:0 !important; }
    .mtxfp-col .gantt-filter-group, .mtxfp-col .dpts-filter-group { max-height:260px; overflow-y:auto; }
    .mtxfp-foot { display:flex; gap:8px; flex-wrap:wrap; align-items:center; margin-top:12px; padding-top:10px; border-top:1px solid var(--an-border,#1e2d3d); }
    .mtxfp-foot button { width:auto !important; margin-top:0 !important; padding:5px 14px !important; }
    #ganttFilterToggle2, #ganttDrawerClose2, #ganttDrawerBackdrop2 { display:none !important; }
    @media (max-width:768px){
        .mtxfp-modal { padding:0; }
        .mtxfp-win { width:100vw; max-height:100vh; height:100%; border-radius:0; }
        .mtxfp-cols { grid-template-columns:1fr 1fr; }
        .mtxfp-col .gantt-filter-group label, .mtxfp-col .dpts-filter-group label { font-size:13px; margin:6px 0; }
    }
</style>
<script>
(function(){
    function setup(o){
        const sb = document.getElementById(o.sidebar), host = document.getElementById(o.host) || (sb && sb.parentNode.querySelector(o.hostSel));
        if(!sb || !host) return;
        // 1) group each heading with its filter list -> one column each; buttons/notes -> footer
        const cols = document.createElement('div'); cols.className = 'mtxfp-cols';
        const foot = document.createElement('div'); foot.className = 'mtxfp-foot';
        let col = null;
        Array.from(sb.children).forEach(el => {
            if(el.id === 'ganttDrawerClose2') return;                      // old phone drawer close
            if(el.tagName === 'H6'){ col = document.createElement('div'); col.className = 'mtxfp-col'; cols.appendChild(col); col.appendChild(el); return; }
            if(col && /filter-group/.test(el.className)){ col.appendChild(el); return; }
            foot.appendChild(el);                                          // Reset / Save / Clear saved / note
        });
        sb.appendChild(cols); sb.appendChild(foot);
        sb.classList.add('mtxfp-in'); sb.classList.remove('open');
        // 2) floating window, the sidebar moves inside it
        const modal = document.createElement('div'); modal.className = 'mtxfp-modal';
        modal.innerHTML = '<div class="mtxfp-win" role="dialog" aria-modal="true"><div class="mtxfp-hdr"><h5></h5><button type="button" class="mtxfp-x" aria-label="Close">&times;</button></div><div class="mtxfp-body"></div></div>';
        modal.querySelector('h5').textContent = o.title;
        modal.querySelector('.mtxfp-body').appendChild(sb);
        document.body.appendChild(modal);
        // 3) button + summary at the top-left of the chart
        const btn = document.createElement('button'); btn.type = 'button'; btn.className = o.btnClass + ' mtxfp-btn'; btn.textContent = '☰ Filters';
        const sum = document.createElement('div'); sum.className = 'mtxfp-sum';
        if(o.intoToolbar){ host.insertBefore(btn, host.firstChild); host.parentNode.insertBefore(sum, host.nextSibling); }
        else { const bar = document.createElement('div'); bar.className = 'mtxfp-bar'; bar.appendChild(btn); host.insertBefore(sum, host.firstChild); host.insertBefore(bar, sum); }
        const open = v => { modal.classList.toggle('open', v); if(!v) refresh(); };
        btn.addEventListener('click', () => open(true));
        modal.querySelector('.mtxfp-x').addEventListener('click', () => open(false));
        modal.addEventListener('click', e => { if(e.target === modal) open(false); });
        document.addEventListener('keydown', e => { if(e.key === 'Escape' && modal.classList.contains('open')) open(false); });
        // 4) active-filter count + summary (a group is "active" when not every box is ticked)
        let last = null;
        function refresh(){
            const parts = [];
            cols.querySelectorAll('.mtxfp-col').forEach(c => {
                const boxes = c.querySelectorAll('input[type=checkbox]'); if(!boxes.length) return;
                const on = Array.from(boxes).filter(b => b.checked).length;
                if(on < boxes.length){
                    const h = c.querySelector('h6'), name = h ? (h.childNodes[0] && h.childNodes[0].nodeType === 3 ? h.childNodes[0].textContent : h.textContent).trim() : '?';
                    parts.push('<b>' + name.replace(/</g, '&lt;') + '</b>: ' + (on ? on + ' of ' + boxes.length : 'none'));
                }
            });
            const key = parts.join('|'); if(key === last) return; last = key;
            btn.textContent = '☰ Filters' + (parts.length ? ' (' + parts.length + ')' : '');
            btn.classList.toggle('active', parts.length > 0);
            sum.innerHTML = parts.length ? 'Filtered — ' + parts.join(' · ') : 'No filters active — showing all';
        }
        sb.addEventListener('change', () => setTimeout(refresh, 0));
        sb.addEventListener('click', () => setTimeout(refresh, 0));      // All / None links, Reset, saved filters
        setInterval(refresh, 1000);                                       // lists are filled / restored asynchronously
        refresh();
        // the charts get the freed width (CHANGED 2026-11-08 round 10: the Gantt canvas width is measured when it
        // is drawn and the DP Stats Plotly charts are not 'responsive', so redraw / resize them explicitly)
        if(o.refit) setTimeout(o.refit, 60);
    }
    function refitGantt(){
        if(window.ganttApplyAndRender2Ref && window.chartInstances2Ref && window.chartInstances2Ref.length){
            try { window.ganttApplyAndRender2Ref(); } catch(e){ console.warn('[mtxfp] gantt refit', e); }
        }
    }
    function refitDpts(){
        if(typeof Plotly === 'undefined') return;
        ['dpBoxPlot', 'dpWellboresMonthlyPlot', 'dpWellboresBacklogPlot'].forEach(id => {
            const el = document.getElementById(id);
            if(el && el.data){ try { Plotly.Plots.resize(el); } catch(e){} }
        });
    }
    let rT = null, lastW = window.innerWidth;
    window.addEventListener('resize', () => {
        if(window.innerWidth === lastW) return;   // height-only changes (phone address bar) don't need a redraw
        lastW = window.innerWidth;
        clearTimeout(rT); rT = setTimeout(() => { refitGantt(); refitDpts(); }, 300);
    });
    function init(){
        setup({ sidebar: 'ganttSidebar2', hostSel: '.gantt-plot-wrap > .m-2', intoToolbar: true, title: 'Gantt filters', btnClass: 'gantt-reset-btn', refit: refitGantt });
        setup({ sidebar: 'dptsSidebar', hostSel: '.dpts-plot-wrap', intoToolbar: false, title: 'DP Stats filters', btnClass: 'dpts-reset-btn', refit: refitDpts });
    }
    if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
})();
</script>

<script>
    /* 2026-11-28: draw the three plots on load (was in the jobs page DOMContentLoaded handler) */
    document.addEventListener('DOMContentLoaded', function(){ renderDPStatsBoxPlot(); });
</script>

