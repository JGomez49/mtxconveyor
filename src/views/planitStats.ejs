                    font-family: var(--an-cond, sans-serif); font-size:10px;
                    font-weight:700; letter-spacing:1px; text-transform:uppercase;
                    padding:5px; border-radius:3px;
                    border:1px solid var(--an-border, #1e2d3d);
                    background:transparent; color: var(--an-text-dim, #5a7080);
                    cursor:pointer;
                }
                .dpts-reset-btn:hover{ border-color:#00c8ff; color:#00c8ff; }
            </style>
            <div class="dpts-outer">
                <div class="dpts-sidebar" id="dptsSidebar">
                    <h6>AFE Timing Year</h6>
                    <div class="dpts-filter-group" id="dptsAfeYear"></div>

                    <h6>Play Type</h6>
                    <div class="dpts-filter-group" id="dptsPlayType"></div>

                    <h6>DP Received Year</h6>
                    <div class="dpts-filter-group" id="dptsReceivedYear"></div>

                    <h6>DP Requested Year</h6>
                    <div class="dpts-filter-group" id="dptsRequestedYear"></div>

                    <h6>DP Type</h6>
                    <div class="dpts-filter-group" id="dptsDpType"></div>

                    <h6>DP Company</h6>
                    <div class="dpts-filter-group" id="dptsDpCompany"></div>

                    <h6>DP Current Plan</h6>
                    <div class="dpts-filter-group" id="dptsCurrentPlan"></div>

                    <button type="button" class="dpts-reset-btn" id="dptsResetBtn">Reset Filters</button>
                    <%# ADDED 2026-11-08 (John): same as the Gantt — save the filters for this user (this browser) %>
                    <button type="button" class="dpts-reset-btn" id="dptsSaveFilters">&#128190; Save filters</button>
                    <button type="button" class="dpts-reset-btn" id="dptsClearSaved" title="Forget the saved filters (back to defaults next time)">Clear saved</button>
                    <div id="dptsSavedNote" style="font-size:10px;color:var(--an-text-dim,#5a7080);margin-top:4px;"></div>
                </div>
                <div class="dpts-plot-wrap">
                    <div id="dpBoxPlot" style="width:100%;"></div>
                    <div id="dpWellboresMonthlyPlot" style="width:100%;margin-top:18px;"></div>
                    <%# ADDED 2026-11-04 (John): toggle for the "Open DP wellbores" trace (index 3) %>
                    <label style="display:block;margin-top:18px;font-size:12px;cursor:pointer;"><input type="checkbox" id="dpOpenBacklogToggle"> Open DP wellbores (requested, not yet received)</label>
                    <div id="dpWellboresBacklogPlot" style="width:100%;margin-top:4px;"></div>
                </div>
            </div>
</div>
    <div class="accordion mb-3" id="accordionExample">
            <% if (user.role == 'admin' || user.role == 'leader' || user.role == 'user' || user.role == 'viewer') { %>
                <div class="accordion-item">
                    <h2 class="accordion-header bg-dark">
                        <button class="accordion-button collapsed bg-dark" 
                                type="button" 
                                data-bs-toggle="collapse" 
                                data-bs-target="#collapseDPStats" 
                                aria-expanded="true"
                                aria-controls="collapseDPStats">
                            <h4 style="color: blueviolet;">DP Stats</h4>
                        </button>
                    </h2>
                    <div id="collapseDPStats" class="accordion-collapse collapse show_" data-bs-parent="#accordionExample">
                        <div class="accordion-body bg-dark">
                            <div class="accordion mb-4" id="accordionExample">
                                <div class="accordion-item bg-dark border-0">
                                    <h2 class="accordion-header" id="headingOne">
                                        <button class="accordion-button" 
                                            type="button" 
                                            data-bs-toggle="collapse" 
                                            style="background-color: #1a1a1a; color: #ffffff;" 
                                            data-bs-target="#collapseTable" 
                                            aria-expanded="true"
                                            aria-controls="collapseTable">
                                            📋 Stats Table
                                        </button>
                                    </h2>
                                    <div id="collapseTable" class="accordion-collapse collapse _show" aria-labelledby="headingOne">
                                        <div class="accordion-body" style="overflow-x:auto;">
                                            <% if (user.role == 'admin' || user.role == 'leader' || user.role == 'user' || user.role == 'viewer') { %>

                                                <!-- <button class="btn btn-info my-2" onclick="renderDPStatsBoxPlot();">📊 Show Stats</button>

                                                <div id="dpBoxPlot" style="width:100%;max-width:100%;"></div> -->

                                            <% } %>
                                            <table 
                                                id="DPStatsTable" 
                                                class="table table-dark table-striped table-bordered table-sm">
                                                <thead>
                                                    <tr>
                                                        <th>DP Version</th>
                                                        <th>DP Days</th>
                                                        <th>ETS ID</th>
                                                        <th>BH Location</th>
                                                        <th>Prospect Name</th>
                                                        <th>Explor Core Area</th>
                                                        <th>Field Name</th>
                                                        <th>Well Type</th>
                                                        <th>Op / Non-Op</th>
                                                        <th>AFE Timing Year</th>
                                                        <th>Play Type</th>
                                                        <th>Province</th>
                                                        <th>DP Proposed # of Wellbores (All Plans)</th>
                                                        <th>DP Proposed Total Drilled Meters (All Plans)</th>
                                                        <th>DP Proposed Total Lateral Length (All Plans)</th>
                                                        <th>DP Received Date (All Plans)</th>
                                                        <th>DP Request Date (All Plans)</th>
                                                        <th>DP Revised Survey No (All Plans)</th>
                                                        <th>DP Type (All Plans)</th>
                                                        <th>DP Company Name (All Plans)</th>
                                                        <th>DP Current Plan (All Plans)</th>
                                                        <th>DP Design/Plan No (All Plans)</th>
                                                        <th>DP Drill Approved (All Plans)</th>
                                                        <th>DP Geol Approved (All Plans)</th>
                                                        <th>DP Justification (All Plans)</th>
                                                        <th>DP Proposed # of Wellbores</th>
                                                        <th>DP Proposed Total Drilled Meters</th>
                                                        <th>DP Proposed Total Lateral Length</th>
                                                        <th>Rig</th>
                                                        <th>Rig Duration</th>
                                                        <th>Scheduled</th>
                                                        <th>Site Name</th>
                                                        <th>Spud Date</th>
                                                        <th>Rig Release Date</th>
                                                        <th>Est. Start Date</th>
                                                    </tr>
                                                </thead>
                                                <%# 2026-11-28 (John): SPEED — the rows are no longer written by the server. Was: all ~9,600 DP Stats rows × 35 columns in the
     jobs page on every load (most of its 33 MB). The table is now fetched (/notes/dpStatsRows, server memory cache) the first time
     this accordion is opened; the charts / filters read their 14 fields from #dptsData below instead of from this table. %>
                                                <tbody id="DPStatsBody"><tr><td colspan="35" style="color:#5a7080">Loading…</td></tr></tbody>
                                            </table>
                                            <script type="application/json" id="dptsData"><%- JSON.stringify((dpStats || []).map(function(d){
                                                var dt = function(v){ return v ? new Date(v).toISOString().slice(0, 10) : ''; }, t = function(v){ return (v === undefined || v === null) ? '' : String(v).trim(); };
                                                return [t(d.dpVersion), t(d.dpDays), t(d.afeTimingYear), t(d.playType), t(d.dpProposedWellboresAllPlans), dt(d.dpReceivedDateAllPlans), dt(d.dpRequestDateAllPlans),
                                                        t(d.dpTypeAllPlans), t(d.dpCompanyNameAllPlans), t(d.dpCurrentPlanAllPlans), t(d.rig), dt(d.estStartDate)];
                                            })).replace(/</g, '\\u003c') %></script>
                                            <script>
                                            (function(){
                                                var done = false;
                                                function fill(){
                                                    if(done) return; done = true;
                                                    var tb = document.getElementById('DPStatsBody');
                                                    fetch('/notes/dpStatsRows', { credentials: 'same-origin' }).then(function(r){ return r.json(); }).then(function(d){
                                                        var esc = function(v){ return (v === undefined || v === null) ? '' : String(v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); };
                                                        tb.innerHTML = (d.rows || []).map(function(r){ return '<tr>' + r.map(function(v){ return '<td>' + esc(v) + '</td>'; }).join('') + '</tr>'; }).join('');
                                                    }).catch(function(){ done = false; tb.innerHTML = '<tr><td colspan="35">Could not load DP Stats — reopen to retry.</td></tr>'; });
                                                }
                                                var c = document.getElementById('collapseDPStats');
                                                if(c){ c.addEventListener('show.bs.collapse', fill); if(c.classList.contains('show')) setTimeout(fill, 0); }
                                            })();
                                            </script>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>
    </div>
</div>

<script>
    // Column indices in #DPStatsTable (0-based), matching the <thead> order
    const DPTS_COL = {
        version:      0,
        days:         1,
        afeYear:      9,
        playType:     10,
        wellbores:    12,
        receivedDate: 15,
        requestDate:  16,
        dpType:       18,
        dpCompany:    19,
        currentPlan:  20,
        rig:          28,
        estStartDate: 34,
    };

    // Filters whose checked state defaults to a specific set of values
    const DPTS_DEFAULT_CHECKED = {
        dptsDpType:    ['PRELIM', 'EXEC'],
        dptsDpCompany: ['CNRL'],
    };

    // Year filters default to checked for (current year - 2) and any future year;
    // older years start unchecked. Returns true if `v` (a year string) should be checked.
    function dptsYearDefaultChecked(v){
        const year = parseInt(v, 10);
        if(isNaN(year)) return true;
        const cutoff = new Date().getFullYear() - 2;
        return year >= cutoff;
    }

    let dptsAllRows = [];     // cached full row data, built once per table render
    let dptsFiltersBuilt = false;

    function dptsExtractYear(dateStr){
        if(!dateStr) return '';
        const m = String(dateStr).match(/^(\d{4})/);
        return m ? m[1] : '';
    }

    // 2026-11-28 (John): reads the 14 fields from #dptsData (compact JSON written by the server) instead of the DP Stats table,
    // which is now only built when its accordion is opened. Same fields and conversions as before (text trimmed, numbers || 0).
    // JSON order: version, days, afeYear, playType, wellbores, received, requested, dpType, dpCompany, currentPlan, rig, estStart.
    function dptsReadTableRows(){
        let data = [];
        try { data = JSON.parse(document.getElementById('dptsData').textContent) || []; } catch(e){ console.warn('dptsData parse error', e); }
        return data.map(c => ({
            version: c[0], days: Number(c[1]) || 0, afeYear: c[2], playType: c[3], wellbores: Number(c[4]) || 0,
            receivedDateFull: c[5], requestDateFull: c[6], receivedYear: dptsExtractYear(c[5]), requestYear: dptsExtractYear(c[6]),
            dpType: c[7], dpCompany: c[8], currentPlan: c[9], rig: c[10], estStartDateFull: c[11],
        }));
    }

    // Build one filter group's checkboxes from unique values present in dptsAllRows
    function dptsBuildFilterGroup(containerId, fieldKey, defaultChecked){
        const container = document.getElementById(containerId);
        if(!container) return;
        container.innerHTML = '';

        const values = [...new Set(dptsAllRows.map(r => r[fieldKey]).filter(v => v !== ''))];
        values.sort();

        if(values.length === 0){
            container.innerHTML = '<div style="color:var(--an-text-dim,#5a7080);font-size:9.5px;">No data</div>';
            return;
        }

        values.forEach(v => {
            const label = document.createElement('label');
            const cb = document.createElement('input');
            cb.type = 'checkbox';
            cb.value = v;
            cb.dataset.field = fieldKey;
            if(typeof defaultChecked === 'function'){
                cb.checked = defaultChecked(v);
            } else {
                cb.checked = defaultChecked ? defaultChecked.includes(v) : true;
            }
            cb.addEventListener('change', dptsApplyFiltersAndRender);
            label.appendChild(cb);
            label.appendChild(document.createTextNode(v));
            container.appendChild(label);
        });
    }

    function dptsBuildAllFilters(){
        dptsBuildFilterGroup('dptsAfeYear',       'afeYear',      dptsYearDefaultChecked);
        dptsBuildFilterGroup('dptsPlayType',      'playType',     null);
        dptsBuildFilterGroup('dptsReceivedYear',  'receivedYear', dptsYearDefaultChecked);
        dptsBuildFilterGroup('dptsRequestedYear', 'requestYear',  dptsYearDefaultChecked);
        dptsBuildFilterGroup('dptsDpType',        'dpType',       DPTS_DEFAULT_CHECKED.dptsDpType);
        dptsBuildFilterGroup('dptsDpCompany',     'dpCompany',    DPTS_DEFAULT_CHECKED.dptsDpCompany);
        dptsBuildFilterGroup('dptsCurrentPlan',   'currentPlan',  null);

        // ADDED 2026-11-08 (John): saved filters, same model as the Gantt (mtxGanttFilters): the UNticked values
        // per field are stored, so values that appear later come in ticked. Applied once, on the first build only
        // (Reset Filters still goes back to the defaults).
        const DPTS_SAVE_KEY = 'mtxDptsFilters:' + (window.MTX_USER_ID || 'anon');
        const dNote = document.getElementById('dptsSavedNote');
        if(!window.dptsSavedApplied){
            window.dptsSavedApplied = true;
            let saved = null; try { saved = JSON.parse(localStorage.getItem(DPTS_SAVE_KEY) || 'null'); } catch(e){}
            if(saved && saved.off){
                Object.keys(saved.off).forEach(f => document.querySelectorAll(`#dptsSidebar input[type=checkbox][data-field="${f}"]`).forEach(cb => { cb.checked = !saved.off[f].includes(cb.value); }));
                if(dNote) dNote.textContent = 'Saved filters applied (' + (saved.at || '') + ')';
            }
        }
        const dSave = document.getElementById('dptsSaveFilters'), dClr = document.getElementById('dptsClearSaved');
        if(dSave && !dSave.dataset.wired){
            dSave.dataset.wired = '1';
            dSave.addEventListener('click', () => {
                const off = {}; document.querySelectorAll('#dptsSidebar input[type=checkbox][data-field]').forEach(cb => { if(!cb.checked) (off[cb.dataset.field] = off[cb.dataset.field] || []).push(cb.value); });
                const at = new Date().toLocaleString();
                try { localStorage.setItem(DPTS_SAVE_KEY, JSON.stringify({ off, at })); if(dNote) dNote.textContent = 'Filters saved (' + at + ')'; } catch(e){ if(dNote) dNote.textContent = 'Could not save in this browser.'; }
            });
            if(dClr) dClr.addEventListener('click', () => { try { localStorage.removeItem(DPTS_SAVE_KEY); } catch(e){} if(dNote) dNote.textContent = 'Saved filters cleared.'; });
        }
        dptsFiltersBuilt = true;

        const resetBtn = document.getElementById('dptsResetBtn');
        if(resetBtn && !resetBtn.dataset.wired){
            resetBtn.dataset.wired = '1';
            resetBtn.addEventListener('click', () => {
                dptsBuildAllFilters();   // rebuild = restores defaults (PRELIM/CNRL checked, rest checked)
                dptsApplyFiltersAndRender();
            });
        }
    }

    // Returns the set of checked values for a given field across the sidebar
    function dptsGetCheckedValues(fieldKey){
        const checked = [];
        document.querySelectorAll(`#dptsSidebar input[type=checkbox][data-field="${fieldKey}"]:checked`).forEach(cb => {
            checked.push(cb.value);
        });
        return checked;
    }

    function dptsApplyFiltersAndRender(){
        const fAfeYear      = dptsGetCheckedValues('afeYear');
        const fPlayType     = dptsGetCheckedValues('playType');
        const fReceivedYear = dptsGetCheckedValues('receivedYear');
        const fRequestYear  = dptsGetCheckedValues('requestYear');
        const fDpType       = dptsGetCheckedValues('dpType');
        const fDpCompany    = dptsGetCheckedValues('dpCompany');
        const fCurrentPlan  = dptsGetCheckedValues('currentPlan');

        const filtered = dptsAllRows.filter(r =>
            fAfeYear.includes(r.afeYear) &&
            fPlayType.includes(r.playType) &&
            fReceivedYear.includes(r.receivedYear) &&
            fRequestYear.includes(r.requestYear) &&
            fDpType.includes(r.dpType) &&
            fDpCompany.includes(r.dpCompany) &&
            fCurrentPlan.includes(r.currentPlan)
        );

        dptsRenderPlot(filtered);
        dptsRenderWellboresMonthlyPlot(filtered);
        dptsRenderWellboresBacklogPlot(filtered);
    }

    function dptsRenderPlot(rows){
        // Sort by numeric suffix of version label (P0 < P1 < P2 ...)
        const sorted = [...rows].sort((a, b) => {
            const na = parseInt(a.version.replace(/\D/g, ''), 10);
            const nb = parseInt(b.version.replace(/\D/g, ''), 10);
            return (isNaN(na) ? 999 : na) - (isNaN(nb) ? 999 : nb);
        });
        const sortedVersions = sorted.map(r => r.version);
        const sortedDays     = sorted.map(r => r.days);

        const isLight = document.body.classList.contains('light-mode');
        const fontColor  = isLight ? '#1a2535' : '#c8d8e8';
        const axisColor  = isLight ? '#2c3e50' : '#5a7080';
        const gridColor  = isLight ? '#aabbcc' : '#1e2d3d';

        Plotly.newPlot("dpBoxPlot", [{
            y: sortedDays,
            x: sortedVersions,
            type: "box",
            boxpoints: "outliers",
            marker: { color: "#0084c7" }
        }], {
            title: { text: `DP Timing Statistics (${rows.length} records)`, font: { color: fontColor, size: 14 } },
            yaxis: {
                title: { text: "Days", font: { color: axisColor } },
                range: [0, 60],
                fixedrange: false,
                color: fontColor,
                tickfont: { color: fontColor },
                gridcolor: gridColor,
                zerolinecolor: gridColor,
            },
            xaxis: {
                title: { text: "Version", font: { color: axisColor } },
                color: fontColor,
                tickfont: { color: fontColor },
                gridcolor: gridColor,
                categoryorder: 'array',
                categoryarray: sortedVersions,
            },
            paper_bgcolor: 'rgba(0,0,0,0)',
            plot_bgcolor:  'rgba(0,0,0,0)',
            font: { color: fontColor },
        });
    }

    // ── Monthly Requested vs Received counts ──────────────────────────────
    const DPTS_MONTH_NAMES = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

    function dptsMonthKey(dateStr){
        // dateStr format: YYYY-MM-DD -> returns {key:'2025-02', label:'Feb 2025', sortKey:202502}
        if(!dateStr) return null;
        const m = String(dateStr).match(/^(\d{4})-(\d{2})/);
        if(!m) return null;
        const year = parseInt(m[1], 10);
        const month = parseInt(m[2], 10); // 1-12
        return {
            key: `${m[1]}-${m[2]}`,
            label: `${DPTS_MONTH_NAMES[month-1]} ${year}`,
            sortKey: year * 100 + month,
        };
    }

    // ── Shared helper: bucket WELLBORE COUNTS (not row counts) by month ───
    // For each row, its `wellbores` value (DP Proposed # of Wellbores (All
    // Plans)) is added to both its request-month bucket and its
    // received-month bucket, using the same column for both sides.
    function dptsBucketWellboresByMonth(rows){
        const requestedSums = {};
        const receivedSums  = {};

        rows.forEach(r => {
            const wb = r.wellbores || 0;
            const reqK = dptsMonthKey(r.requestDateFull);
            if(reqK){
                if(!requestedSums[reqK.key]) requestedSums[reqK.key] = { label: reqK.label, sortKey: reqK.sortKey, sum: 0 };
                requestedSums[reqK.key].sum += wb;
            }
            const recK = dptsMonthKey(r.receivedDateFull);
            if(recK){
                if(!receivedSums[recK.key]) receivedSums[recK.key] = { label: recK.label, sortKey: recK.sortKey, sum: 0 };
                receivedSums[recK.key].sum += wb;
            }
        });

        const allKeys = [...new Set([...Object.keys(requestedSums), ...Object.keys(receivedSums)])];
        allKeys.sort((a, b) => {
            const sa = requestedSums[a]?.sortKey ?? receivedSums[a]?.sortKey;
            const sb = requestedSums[b]?.sortKey ?? receivedSums[b]?.sortKey;
            return sa - sb;
        });

        const labels  = allKeys.map(k => (requestedSums[k] || receivedSums[k]).label);
        const reqVals = allKeys.map(k => requestedSums[k] ? requestedSums[k].sum : 0);
        const recVals = allKeys.map(k => receivedSums[k]  ? receivedSums[k].sum  : 0);

        return { labels, reqVals, recVals };
    }

    function dptsRenderWellboresMonthlyPlot(rows){
        const { labels, reqVals, recVals } = dptsBucketWellboresByMonth(rows);

        const totalWellbores = rows.reduce((s, r) => s + (r.wellbores || 0), 0);

        const isLight = document.body.classList.contains('light-mode');
        const fontColor = isLight ? '#1a2535' : '#c8d8e8';
        const axisColor = isLight ? '#2c3e50' : '#5a7080';
        const gridColor = isLight ? '#aabbcc' : '#1e2d3d';

        const el = document.getElementById('dpWellboresMonthlyPlot');
        if(!el) return;

        Plotly.newPlot('dpWellboresMonthlyPlot', [
            {
                x: labels, y: reqVals, type: 'bar', name: 'Wellbores Requested',
                marker: { color: '#ff6b35' },
            },
            {
                x: labels, y: recVals, type: 'bar', name: 'Wellbores Received',
                marker: { color: '#0084c7' },
            },
        ], {
            title: { text: `DP Wellbores Requested vs Received by Month (${totalWellbores} total wellbores)`, font: { color: fontColor, size: 14 } },
            barmode: 'group',
            yaxis: {
                title: { text: 'Wellbores', font: { color: axisColor } },
                color: fontColor,
                tickfont: { color: fontColor },
                gridcolor: gridColor,
                zerolinecolor: gridColor,
                rangemode: 'tozero',
            },
            xaxis: {
                title: { text: 'Month', font: { color: axisColor } },
                color: fontColor,
                tickfont: { color: fontColor, size: 10 },
                gridcolor: gridColor,
                categoryorder: 'array',
                categoryarray: labels,
                tickangle: -45,
            },
            legend: {
                font: { color: fontColor },
                orientation: 'h',
                y: 1.12,
            },
            paper_bgcolor: 'rgba(0,0,0,0)',
            plot_bgcolor:  'rgba(0,0,0,0)',
            font: { color: fontColor },
            margin: { b: 90 },
        });
    }

    // ── DP Wellbore Backlog per month (Wellbores Received − Wellbores Requested) ──
    // 2026-11-04: Open DP wellbores toggle (trace 3 of the backlog plot), remembered in this browser
    function dptsWireOpenBacklogToggle(){ const cb = document.getElementById('dpOpenBacklogToggle'); if(!cb || cb.dataset.wired) return; cb.dataset.wired = '1';   // wired on first render (the tick sits below this script)
        // CHANGED 2026-11-08 (John): hidden by default; shown only when switched on (remembered in this browser)
        try { cb.checked = localStorage.getItem('mtxOpenDpBacklog') === '1'; } catch(e){ cb.checked = false; }
        cb.addEventListener('change', () => { try { localStorage.setItem('mtxOpenDpBacklog', cb.checked ? '1' : '0'); } catch(e){}
            const el = document.getElementById('dpWellboresBacklogPlot'); if(el && el.data && el.data.length > 3) Plotly.restyle(el, { visible: cb.checked ? true : 'legendonly' }, [3]); });
    }
    function dptsRenderWellboresBacklogPlot(rows){
        dptsWireOpenBacklogToggle();   // 2026-11-04
        const { labels, reqVals, recVals } = dptsBucketWellboresByMonth(rows);

        const monthlyDelta = labels.map((_, i) => recVals[i] - reqVals[i]);

        let running = 0;
        const cumulative = monthlyDelta.map(d => { running += d; return running; });

        const posSeries = new Array(cumulative.length).fill(null);
        const negSeries = new Array(cumulative.length).fill(null);

        for(let i = 0; i < cumulative.length; i++){
            const v = cumulative[i];
            if(v >= 0){
                posSeries[i] = v;
                if(i > 0 && cumulative[i-1] < 0) negSeries[i] = 0;
            } else {
                negSeries[i] = v;
                if(i > 0 && cumulative[i-1] >= 0) posSeries[i] = 0;
            }
        }

        const isLight = document.body.classList.contains('light-mode');
        const fontColor = isLight ? '#1a2535' : '#c8d8e8';
        const axisColor = isLight ? '#2c3e50' : '#5a7080';
        const gridColor = isLight ? '#aabbcc' : '#1e2d3d';

        const el = document.getElementById('dpWellboresBacklogPlot');
        if(!el) return;

        Plotly.newPlot('dpWellboresBacklogPlot', [
            {
                x: labels, y: monthlyDelta, type: 'bar', name: 'Monthly Backlog (Received − Requested)',
                marker: {
                    color: monthlyDelta.map(d => d >= 0 ? 'rgba(57,255,20,0.75)' : 'rgba(255,64,96,0.75)')
                },
            },
            {
                x: labels, y: posSeries, type: 'scatter', mode: 'lines', name: 'Cumulative Wellbore Backlog (+)',
                line: { color: '#39ff14', width: 2 },
                fill: 'tozeroy',
                fillcolor: 'rgba(57,255,20,0.25)',
                connectgaps: false,
                visible: 'legendonly',
            },
            {
                x: labels, y: negSeries, type: 'scatter', mode: 'lines', name: 'Cumulative Wellbore Backlog (−)',
                line: { color: '#ff4060', width: 2 },
                fill: 'tozeroy',
                fillcolor: 'rgba(255,64,96,0.25)',
                connectgaps: false,
                visible: 'legendonly',
            },
            // ADDED 2026-11-04 (John): the real backlog = wellbores requested and not yet received at the end of each
            // month = −(cumulative received − requested). Always ≥ 0 (a DP can't be received before it is requested),
            // which is why the green "Cumulative (+)" trace never showed. Includes requested-only rows (no received date).
            // On/off with the "Open DP wellbores" tick above the plot (remembered in this browser) or the legend.
            {
                x: labels, y: cumulative.map(v => Math.max(0, -v)), type: 'scatter', mode: 'lines', name: 'Open DP wellbores (requested, not yet received)',
                line: { color: '#ffb300', width: 2.5 },
                fill: 'tozeroy',
                fillcolor: 'rgba(255,179,0,0.18)',
                visible: (() => { try { return localStorage.getItem('mtxOpenDpBacklog') === '1' ? true : 'legendonly'; } catch(e){ return 'legendonly'; } })(),   // 2026-11-08: hidden by default
            },
        ], {
            title: { text: `DP Wellbore Backlog by Month (Received − Requested)`, font: { color: fontColor, size: 14 } },
            yaxis: {
                title: { text: 'Backlog (wellbores)', font: { color: axisColor } },
                color: fontColor,
                tickfont: { color: fontColor },
                gridcolor: gridColor,
                zerolinecolor: gridColor,
                zerolinewidth: 2,
            },
            xaxis: {
                title: { text: 'Month', font: { color: axisColor } },
                color: fontColor,
                tickfont: { color: fontColor, size: 10 },
                gridcolor: gridColor,
                categoryorder: 'array',
                categoryarray: labels,
                tickangle: -45,
            },
            legend: {
                font: { color: fontColor },
                orientation: 'h',
                y: 1.12,
            },
            paper_bgcolor: 'rgba(0,0,0,0)',
            plot_bgcolor:  'rgba(0,0,0,0)',
            font: { color: fontColor },
            margin: { b: 90 },
        });
    }



    function renderDPStatsBoxPlot() {
