<style>
/* ── Techy CSS variables ── */
:root {
    --an-bg:           #0a0e14;
    --an-panel:        #111820;
    --an-panel2:       #161e28;
    --an-border:       #1e2d3d;
    --an-accent:       #00c8ff;
    --an-accent2:      #ff6b35;
    --an-text:         #c8d8e8;
    --an-text-dim:     #5a7080;
    --an-text-bright:  #e8f4ff;
    --an-mono:         'Share Tech Mono', monospace;
    --an-sans:         'Barlow', sans-serif;
    --an-cond:         'Barlow Condensed', sans-serif;
}
body.light-mode {
    --an-bg:          #f0f4f8;
    --an-panel:       #ffffff;
    --an-panel2:      #e8edf2;
    --an-border:      #c8d4de;
    --an-accent:      #0077a8;
    --an-accent2:     #c04010;
    /* Darkened 2026-08-26 (was #2c3e50/#607080/#111820) — the Anti-collision
       Plots section has many small (10-11px) labels/values; the previous
       medium-tone values read as washed-out/low-contrast on the white
       panel background. Darkened for a black/near-black, high-contrast
       reading per the person's direct request. */
    --an-text:        #10161c;
    --an-text-dim:    #3d4a56;
    --an-text-bright: #000000;
}
body {
    background: var(--an-bg) !important;
    color: var(--an-text) !important;
    font-family: var(--an-sans) !important;
    transition: background .25s, color .25s;
}
body::before {
    content: '';
    position: fixed; inset: 0;
    background-image:
        linear-gradient(rgba(0,200,255,.025) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,200,255,.025) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none; z-index: 0;
    transition: opacity .25s;
}
body.light-mode::before { opacity: 0; }
body > *, #navbar { position: relative; z-index: 1; }
/* Navbar */
.navbar, .navbar.bg-dark, nav.navbar {
    background: var(--an-panel) !important;
    border-bottom: 1px solid var(--an-border) !important;
    padding: 6px 16px !important;
    font-family: var(--an-cond) !important;
}
.navbar-brand, .nav-link {
    color: var(--an-text) !important;
    font-family: var(--an-cond) !important;
    font-size: 12px !important;
    letter-spacing: 1px !important;
    text-transform: uppercase !important;
}
.nav-link:hover { color: var(--an-accent) !important; }
.navbar-toggler { border-color: var(--an-border) !important; }
.navbar-toggler-icon { filter: invert(.7); }
.dropdown-menu {
    background: var(--an-panel) !important;
    border: 1px solid var(--an-border) !important;
}
.dropdown-item { color: var(--an-text) !important; }
.dropdown-item:hover { background: var(--an-panel2) !important; color: var(--an-accent) !important; }
/* Theme toggle pill */
.an-theme-wrap {
    display: inline-flex; align-items: center; gap: .4rem;
    font-size: 12px;
    background: var(--an-panel);
    border: 1px solid var(--an-border);
    border-radius: 20px; padding: 3px 10px;
    transition: background .2s, border-color .2s;
    flex-shrink: 0;
}
.an-theme-wrap .bi-moon-stars-fill { color: var(--an-accent); }
.an-theme-wrap .bi-sun-fill        { color: var(--an-accent2); }
.form-check-input:checked {
    background-color: var(--an-accent) !important;
    border-color:     var(--an-accent) !important;
}
/* Buttons */
.btn {
    font-family: var(--an-cond) !important;
    font-size: 11px !important; font-weight: 700 !important;
    letter-spacing: 1.5px !important; text-transform: uppercase !important;
    border-radius: 3px !important; transition: all .15s !important;
}
.btn-warning { background:transparent !important; border:1px solid var(--an-accent) !important; color:var(--an-accent) !important; }
.btn-warning:hover { background:var(--an-accent) !important; color:var(--an-bg) !important; }
.btn-primary { background:transparent !important; border:1px solid #79c0ff !important; color:#79c0ff !important; }
.btn-primary:hover { background:#79c0ff !important; color:var(--an-bg) !important; }
.btn-block { display:block; width:100%; }
/* Cards */
.card, .card.bg-dark { background: var(--an-panel) !important; border-color: var(--an-border) !important; color: var(--an-text) !important; }
/* canvas override */
canvas { background-color: transparent !important; box-shadow: none !important; }

/* ── Accordion titles: transparent background, theme-aware text ── */
.accordion-button,
.accordion-button.btn-primary,
.accordion-button:not(.collapsed),
.accordion-button.collapsed {
    background: transparent !important;
    background-color: transparent !important;
    color: var(--an-text-bright) !important;
    border: none !important;
    box-shadow: none !important;
    font-family: var(--an-cond) !important;
    font-weight: 600 !important;
    letter-spacing: 1px !important;
}
.accordion-button:hover { background: rgba(0,200,255,.06) !important; }
.accordion-button::after { filter: invert(.5) sepia(1) saturate(3) hue-rotate(165deg); }
.accordion-item { background: var(--an-panel) !important; border-color: var(--an-border) !important; }
.accordion-body { background: var(--an-bg) !important; }
/* Light mode: black text on accordion titles */
body.light-mode .accordion-button,
body.light-mode .accordion-button.btn-primary,
body.light-mode .accordion-button:not(.collapsed),
body.light-mode .accordion-button.collapsed {
    color: #111820 !important;
}
body.light-mode .accordion-button::after { filter: invert(1) brightness(0); }
/* T&D charts, 2-column layout (viewer role) — see tdChartsWrap in job.ejs.
   Canvas width is measured per-panel in JS (buildTDCharts), so this works
   correctly whether td-2col is applied or not. */
.td-2col { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
.td-2col .td-chart-panel { margin-bottom: 0 !important; }
/* PAD AC risk colours */
.risk-red   { background-color: #b22222 !important; color: #fff !important; }
.risk-amber { background-color: #f0c640 !important; color: #000 !important; }
.risk-green { background-color: #2e7d32 !important; color: #fff !important; }

/* Pad Trajectory Summary / score cards: light-mode background + readable text */
body.light-mode .wbt-root {
    --wbt-bg: #ffffff;
    --wbt-panel: #f8f9fa;
    --wbt-panel2: #ffffff;
    --wbt-border: #dee2e6;
    /* Darkened 2026-08-26 (was #212529/#6c757d/#111820) — this override
       WAS being applied correctly, but at 9-10px uppercase letter-spaced
       label sizes (Frac Planes / Polylines field labels, status text) the
       previous medium-tone values still read as washed-out. Darkened to
       near-black for real high-contrast reading, same reasoning as the
       --an-text-dim darkening above. */
    --wbt-text: #0a0d10;
    --wbt-text-dim: #454e57;
    --wbt-text-bright: #000000;
}

/* Logs section: dark mode keeps its current background but forces white
   text; light mode switches to a white background with black text. */
#logsSection, #logsSection .card, #logsSection .card-body { color: #ffffff !important; }
body.light-mode #logsSection { background-color: #ffffff !important; color: #000000 !important; }
body.light-mode #logsSection .card { background-color: #ffffff !important; color: #000000 !important; border-color: #dee2e6 !important; }
body.light-mode #logsSection .card-body { color: #000000 !important; }

/* Job info textboxes (Task, MTX_ID, Priority, Created, Customer, etc.):
   dark mode keeps current background but forces white text; light mode
   switches to a white background with black text. */
.form-control.bg-dark.text-white,
.input-group-text.bg-dark.text-white { color: #ffffff !important; }
body.light-mode .form-control.bg-dark.text-white,
body.light-mode .input-group-text.bg-dark.text-white {
    background-color: #ffffff !important;
    color: #000000 !important;
    border-color: #ced4da !important;
}

/* Torque & Drag chart panel titles: white in dark mode, black in light mode. */
.td-chart-title { color: #ffffff; font-family: 'Share Tech Mono', monospace; font-weight: 600; }
body.light-mode .td-chart-title { color: #000000 !important; }

/* Log entry display textareas (existing log text, e.g. inside #logsSection
   cards) — these use an inline color:gray instead of the text-white class,
   so they need their own rule with !important to win over that inline style. */
#logsSection textarea.form-control.bg-dark { color: #ffffff !important; }
body.light-mode #logsSection textarea.form-control.bg-dark {
    background-color: #ffffff !important;
    color: #000000 !important;
    border-color: #ced4da !important;
}

/* Status textbox: its text colour is set inline per-status (white/aqua/red/
   orange/chartreuse/green) instead of using the text-white class, so it
   needs its own !important override to win over those inline styles. */
#statusTextbox { color: #ffffff !important; }
body.light-mode #statusTextbox {
    background-color: #ffffff !important;
    color: #000000 !important;
    border-color: #ced4da !important;
}
</style>

