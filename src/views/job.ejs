                                        /* ── Viewer layout: sidebar + canvas ── */
                    .wbt-viewer-outer{
                        display:flex; gap:0; border:1px solid var(--wbt-border);
                        border-radius:4px; overflow:hidden; margin-bottom:10px;
                        height:78vh; /* bounds all three columns to the same height;
                                        without this, the tallest child (often the
                                        well list) stretches the whole row and every
                                        other column just to match it, leaving blank
                                        space instead of each column scrolling on its own */
                    }
                    .wbt-sidebar{
                        width:220px; min-width:220px; flex-shrink:0;
                        background: rgba(17,24,32,0.97); border-right:1px solid var(--wbt-border);
                        padding:10px; overflow-y:auto; display:flex; flex-direction:column; gap:0;
                        font-size:11px; color:#ffffff;
                    }
                    .wbt-sidebar h6, .wbt-sidebar label{ color:#ffffff !important; }
                    /* Right-hand sidebar (wellbores tree): mirrors the left one
                       but borders on its left edge, and lets its single section
                       stretch to the viewer's full height so the tree scrolls
                       within the plot height rather than being capped short. */
                    .wbt-sidebar-right{
                        border-right:none; border-left:1px solid var(--wbt-border);
                        width:250px; min-width:250px; overflow:hidden;
                    }
                    .wbt-sidebar-right .wbt-section{ border-bottom:none; margin-bottom:0; padding-bottom:0; }
