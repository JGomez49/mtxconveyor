                                        <input class="form-check-input" type="checkbox" id="padACfSemi" checked>
                                        <label class="form-check-label" for="padACfSemi">Semi Majors</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="padACfW2W" checked>
                                        <label class="form-check-label" for="padACfW2W">W2W</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="padACfE2Ecol" checked>
                                        <label class="form-check-label" for="padACfE2Ecol">E2E</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="padACfMinSep" checked>
                                        <label class="form-check-label" for="padACfMinSep">Min.Sep.</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="padACfProbPct" checked>
                                        <label class="form-check-label" for="padACfProbPct">Prob.%</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="padACfWarn" checked>
                                        <label class="form-check-label" for="padACfWarn">Warning</label>
                                    </div>
                                    <button id="padACDownloadBtn" class="btn btn-sm btn-outline-info ms-2" disabled
                                            title="Download the table as shown (with colours)">
                                        ⬇ Download Table
                                    </button>
