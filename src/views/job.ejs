                                <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                                    <label style="font-size:11px;color:var(--an-text,#c8d8e8);">Well/Leg:</label>
                                    <select id="tdWellSelect2" class="form-select form-select-sm" style="max-width:220px;display:none;"></select>
