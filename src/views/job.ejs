                        .wbt-fpm{ position:fixed; inset:0; z-index:1060; background:rgba(0,0,0,.55); display:none; align-items:center; justify-content:center; padding:16px; }
                        .wbt-fpm.open{ display:flex; }
                        .wbt-fpm-win{ background:var(--wbt-panel); border:1px solid var(--wbt-accent); border-radius:6px; width:100%; max-width:560px; max-height:88vh;
                                      display:flex; flex-direction:column; color:#fff; box-shadow:0 10px 40px rgba(0,0,0,.5); }
                        .wbt-fpm-hdr{ display:flex; align-items:center; padding:10px 14px; border-bottom:1px solid var(--wbt-border); }
                        .wbt-fpm-hdr h5{ flex:1; margin:0; font-size:15px; letter-spacing:1px; text-transform:uppercase; color:var(--wbt-text-bright); }
