                                    <label>TVDss To (m)</label>
                                    <input type="number" id="wbtPolyTo" step="0.1">
                                </div>
                                <div class="wbt-fp-field w80">
                                    <label>Color</label>
                                    <input type="color" id="wbtPolyColor" value="#ff0000">
                                </div>
