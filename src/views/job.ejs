                                <div class="d-flex justify-content-end mb-1"><button type="button" class="mtx-help-btn" title="How the planned time is calculated" aria-label="Help" onclick="mtxHelp('dm')">?</button></div><%# 2026-11-22 help %>

                                <% if (user.role === 'admin' || user.role === 'leader' || user.role === 'user') { %>
