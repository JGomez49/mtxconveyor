                    let nb = null, bd = Infinity;
                    for(const nd of nodes){ const d = (nd.s.n - qs.n) ** 2 + (nd.s.e - qs.e) ** 2 + (nd.s.tvd - qs.tvd) ** 2; if(d < bd){ bd = d; nb = nd; } }
