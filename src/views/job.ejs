                        .ipl-root.open .ipl-body{ display:flex; gap:12px; flex-wrap:wrap; }
                        .ipl-col-list{ width:240px; min-width:220px; }
                        .ipl-col-edit{ flex:1; min-width:520px; }
                        /* ADDED 2026-11-06 (John): Compass-style plan grid to the right of the editor (below it when narrow) */
                        .ipl-ed-wrap{ display:flex; flex-wrap:wrap; gap:14px; align-items:flex-start; }
                        .ipl-ed-left{ flex:1 1 520px; min-width:0; }
                        .ipl-ed-right{ flex:1 1 900px; min-width:0; }
                        /* CHANGED 2026-11-06 (John): one text size everywhere in the grid (inputs included), every cell and header centred */
                        .ipl-grid-tbl{ border-collapse:collapse; font-family:var(--wbt-mono); font-size:12px; width:100%; }
                        .ipl-grid-tbl th{ position:sticky; top:0; background:var(--wbt-panel,#111820); color:var(--wbt-text-dim); font-weight:600; font-size:12px; padding:3px 4px; border:1px solid var(--wbt-border); white-space:nowrap; z-index:1; text-align:center; vertical-align:middle; }
                        .ipl-grid-tbl td{ border:1px solid var(--wbt-border); padding:0 4px; text-align:center; vertical-align:middle; white-space:nowrap; height:22px; font-size:12px; background:rgba(128,128,128,.12); }
                        .ipl-grid-tbl td.in{ background:var(--wbt-input-bg,#fff); padding:0; }
                        .ipl-root .ipl-grid-tbl td.in input{ width:100%; min-width:58px; border:0 !important; background:transparent !important; text-align:center; font-family:var(--wbt-mono); font-size:12px !important; color:#000 !important; padding:2px 4px; }
                        .ipl-grid-tbl td.bad{ color:#ff4c4c; font-weight:700; }
                        .ipl-grid-tbl tr.sel td{ outline:1px solid #00c8ff; }
                        .ipl-grid-tbl td.rn{ text-align:center; cursor:pointer; color:var(--wbt-text-dim); }
                        .ipl-grid-tbl td.tg{ color:#00e676; }
                        .ipl-pm{ border:1px solid var(--wbt-border); border-radius:3px; padding:6px; margin-top:6px; }
                        .ipl-pm label{ margin-right:10px; white-space:nowrap; }
                        .ipl-root input[type=number], .ipl-root input[type=text], .ipl-root select{
                            background:var(--wbt-panel2); color:var(--wbt-text); border:1px solid var(--wbt-border);
                            border-radius:3px; padding:2px 5px; font-size:12px; font-family:var(--wbt-mono);
                        }
                        .ipl-root input[type=number]{ width:90px; }
                        .ipl-scn{ display:flex; align-items:center; gap:6px; padding:4px 6px; border:1px solid var(--wbt-border); border-radius:3px; margin-bottom:4px; cursor:pointer; }
                        .ipl-scn.sel{ border-color:#00e676; box-shadow:0 0 0 1px #00e676 inset; }
                        .ipl-scn .nm{ flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
                        .ipl-grid{ display:grid; grid-template-columns:repeat(4, auto); gap:4px 10px; align-items:center; justify-content:start; margin:6px 0; }
                        .ipl-grid label{ color:var(--wbt-text-dim); font-size:11px; }
                        .ipl-sec{ border:1px solid var(--wbt-border); border-radius:3px; padding:5px 6px; margin-bottom:4px; display:flex; flex-wrap:wrap; gap:6px; align-items:center; }
                        .ipl-sec .idx{ color:#00e676; font-weight:700; width:22px; }
                        .ipl-sec .fld{ display:flex; align-items:center; gap:3px; }
                        .ipl-sec .fld span{ color:var(--wbt-text-dim); font-size:11px; }
                        .ipl-res{ flex-basis:100%; font-family:var(--wbt-mono); font-size:11px; color:var(--wbt-text-dim); padding-left:28px; }
                        .ipl-res.bad{ color:#ff4c4c; }
                        .ipl-h{ font-family:var(--wbt-cond); font-size:11px; letter-spacing:1px; text-transform:uppercase; color:var(--wbt-text-dim); margin:8px 0 4px; }
                        .ipl-sum{ font-family:var(--wbt-mono); font-size:11px; margin-top:6px; }
                        body.light-mode .ipl-root{ background:#ffffff; }
                        body.light-mode .ipl-root input, body.light-mode .ipl-root select{ background:#f1f3f5 !important; color:#000 !important; border-color:#ced4da !important; }
                        body.light-mode .ipl-head .ipl-title{ color:#00873c; }
                        /* 2026-11-15 (John): iPad title blue (techy) so it is not confused with iPlan (green) */
                        #ipdRoot .ipl-head .ipl-title{ color:#00b4ff; text-shadow:0 0 6px rgba(0,180,255,.35); }
                        body.light-mode #ipdRoot .ipl-head .ipl-title{ color:#0060c0; text-shadow:none; }
                        /* 2026-11-15 (John): iLab purple; iPlan / iPad / iLab headers same size as Frac Planes / Polylines */
                        .ipl-head .ipl-title.ilab-title{ color:#c084fc; text-shadow:0 0 6px rgba(192,132,252,.35); }
                        body.light-mode .ipl-head .ipl-title.ilab-title{ color:#7e22ce; text-shadow:none; }
                        .ipl-root > .ipl-head{ padding:14px 16px; }
                        .ipl-root > .ipl-head .ipl-title{ font-size:16px; }
                        .ipl-root > .ipl-head > span:last-child{ font-size:12px !important; }
                    </style>
                    <div class="ipl-root" id="iplRoot">
                        <div class="ipl-head" id="iplHead">
                            <span class="ipl-title">&#9679; iPlan &mdash; Scenario Trajectories</span>
                            <span style="font-size:11px;color:var(--wbt-text-dim);" id="iplHeadInfo">click to open</span>
                        </div>
                        <div class="ipl-body">
                            <%# CHANGED 2026-11-06 (John: "at the right is too tight ... below the 3D viewer"): plan grid + Planning Methods full width, first thing under the viewer %>
                            <div id="iplGridHost" style="flex:1 1 100%;min-width:0;"><div class="ipl-h" style="margin-top:0;">Stations Grid</div><div id="iplGridBox"><div style="color:var(--wbt-text-dim);">Select a scenario.</div></div><div id="iplPmBox"></div></div>
                            <div class="ipl-col-list">
                                <button type="button" class="wbt-btn" id="iplNewBtn" style="width:100%;margin-bottom:6px;">+ New Scenario</button>
                                <div id="iplList"></div>
                                <div style="font-size:10px;color:var(--wbt-text-dim);margin-top:6px;">
                                    Scenarios are drawn in green. Tick to show them in 3D and in the Anti-collision Plots. Saved automatically for everyone on this job; all start unticked when the page loads.
                                </div>
                            </div>
                            <div class="ipl-col-edit" id="iplEditor">
                                <div style="color:var(--wbt-text-dim);">Create or select a scenario.</div>
                            </div>
                        </div>
                    </div>

                    <% if (user.role === 'admin') { %><!-- CHANGED 2026-10-12: iPad visible to admins only (server also blocks /notes/iplan/batch for non-admins) -->
                    <!-- ── iPad: pad planner (ADDED 2026-10-12, phase 1) ─────────────────────
                         Plans many wells at once: surface slots + landing targets (pattern or
                         pasted from Excel), assigned in order, one template solved per well
                         (vertical → KOP → curve → tangent → curve to land → lateral). Every well
                         it creates is an ordinary iPlan scenario tagged with a group, so 3D,
                         Anti-collision, saving and the wizards all work on them unchanged. -->
                    <%# 2026-10-31 (John): readable iPad tables — cell padding, row lines, zebra rows, sticky header %>
                    <style>
                        #ipdBody table{border-collapse:collapse;}
                        #ipdBody th{position:sticky;top:0;z-index:1;background:var(--wbt-panel2,#1e232b);padding:3px 10px !important;border-bottom:1px solid var(--wbt-border,#2a313c);text-align:left;white-space:nowrap;}
                        #ipdBody td{padding:2px 10px !important;border-bottom:1px solid var(--wbt-border,#2a313c);white-space:nowrap;}
                        #ipdBody tr:nth-child(even) td{background:rgba(127,127,127,0.07);}
                        #ipdBody tr:hover td{background:rgba(77,163,255,0.12);}
                    </style>
                    <div class="ipl-root" id="ipdRoot">
                        <div class="ipl-head" id="ipdHead">
                            <span class="ipl-title">&#9679; iPad &mdash; Pad Planner</span>
                            <span style="font-size:11px;color:var(--wbt-text-dim);" id="ipdHeadInfo">click to open</span>
                        </div>
                        <div class="ipl-body" style="display:none;flex-direction:column;" id="ipdBody"></div>
                    </div>

                    <% } %>
                    <% if (user.role === 'admin') { %>
                    <!-- ── iLab (ADDED 2026-11-09, admin only, EXPERIMENTAL) ── John's sandbox for new ideas
                         (phase 1: occupancy grid of cubes around the subject well; later: surface-to-ICP paths
                         through the free cubes). All logic is in the separate "iLAB SCRIPT" block at the end of
                         the iPlan scripts; delete both to remove iLab. -->
                    <div class="ipl-root" id="ilabRoot">
                        <div class="ipl-head" id="ilabHead">
                            <span class="ipl-title ilab-title">&#9679; iLab &mdash; Experiments</span><%# 2026-11-15: purple (was inline orange #ffb74d, too close to Frac Planes) %>
                            <span style="font-size:11px;color:var(--wbt-text-dim);">admin only &middot; click to open</span>
                        </div>
                        <div class="ipl-body" style="display:none;flex-direction:column;" id="ilabBody"></div>
                    </div>
                    <% } %>
                    <!-- ── FracPlane Controller Panel (accordion) ──────────────────
                         FIX 2026-09-13: this whole panel (including the read-only
                         list and the 3D rendering of existing Frac Planes) used to
                         be wrapped in the admin/leader/user role check below. Any
                         other role (e.g. a Directional Engineer account tagged with
                         a different role string) got NONE of the panel's HTML at
                         all — and because wbtFPInit() (called unconditionally from
                         initScene()) unconditionally did
                         document.getElementById('wbtFPWell').addEventListener(...),
                         it threw a TypeError on a null element for those roles,
                         which silently aborted the rest of initScene() — including
                         the very next line, wbtPolyInit() — so Polylines never
                         rendered either for those roles. Fix: the edit FORM/BUTTONS
                         stay role-gated below (no server-side role check exists on
                         the fracPlane/polyline routes, so this client-side gate is
                         the only thing stopping non-editor roles from writing), but
                         the accordion, the read-only list, and the 3D rendering are
                         now unconditional for every role. See the matching
                         defensive guards added in wbtFPInit()/wbtFPSetupButtons()
                         and wbtPolyInit()/wbtPolySetupFileInput() below. -->
                    <% const wbtCanEdit = (user.role == 'admin' || user.role == 'leader' || user.role == 'user'); %>
                    <div class="wbt-fp-accordion-wrap">
                        <div class="wbt-fp-acc-header" id="wbtFPAccHeader">
                            <span><span class="wbt-dot" style="background:#ffd060;box-shadow:0 0 7px #ffd060;width:7px;height:7px;border-radius:50%;display:inline-block;margin-right:8px;"></span>Frac Planes</span>
                            <span class="wbt-fp-acc-icon">&#9660;</span>
                        </div>
                        <div class="wbt-fp-acc-body collapsed" id="wbtFPAccBody">
                        <div class="wbt-fp-root" id="wbtFPRoot">
                            <% if (wbtCanEdit) { %>
                            <!-- Row 1: Well + Label + MD + Geometry type -->
                            <div class="wbt-fp-row">
                                <div class="wbt-fp-field w160">
                                    <label>Wellbore</label>
                                    <select id="wbtFPWell"></select>
                                </div>
                                <div class="wbt-fp-field w80">
                                    <label>Label</label>
                                    <input type="text" id="wbtFPLabel" placeholder="FP-1">
                                </div>
                                <div class="wbt-fp-field w80">
                                    <label>MD (m)</label>
                                    <input type="number" id="wbtFPMD" value="500" step="0.1">
                                </div>
                                <div class="wbt-fp-field w100">
                                    <label>Geometry</label>
                                    <select id="wbtFPGeometry" onchange="wbtFPOnGeomChange()">
                                        <option value="box">Box</option>
                                        <option value="cylinder">Cylinder</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Box inputs -->
                            <div class="wbt-fp-row" id="wbtFPBoxInputs">
                                <div class="wbt-fp-field w60">
                                    <label>DX (m)</label>
                                    <input type="number" id="wbtFPDX" value="10" step="0.5">
                                </div>
                                <div class="wbt-fp-field w60">
                                    <label>DY (m)</label>
                                    <input type="number" id="wbtFPDY" value="10" step="0.5">
                                </div>
                                <div class="wbt-fp-field w60">
                                    <label>DZ (m)</label>
                                    <input type="number" id="wbtFPDZ" value="10" step="0.5">
                                </div>
                                <div class="wbt-fp-field w60">
                                    <label>Roll X°</label>
                                    <input type="number" id="wbtFPAX" value="0" step="1">
                                </div>
                                <div class="wbt-fp-field w60">
                                    <label>Pitch Y°</label>
                                    <input type="number" id="wbtFPAY" value="0" step="1">
                                </div>
                                <div class="wbt-fp-field w60">
                                    <label>Yaw Z°</label>
                                    <input type="number" id="wbtFPAZ" value="0" step="1">
                                </div>
                            </div>

                            <!-- Cylinder inputs (hidden by default) -->
                            <div class="wbt-fp-row" id="wbtFPCylInputs" style="display:none">
                                <div class="wbt-fp-field w80">
                                    <label>Radius (m)</label>
                                    <input type="number" id="wbtFPRadius" value="10" step="0.5" min="0.1">
                                </div>
                                <div class="wbt-fp-field w80">
                                    <label>Distance (m)</label>
                                    <input type="number" id="wbtFPDist" value="30" step="0.5" min="0.1">
                                </div>
                                <div class="wbt-fp-field w60">
                                    <label>Roll X°</label>
                                    <input type="number" id="wbtFPCAX" value="0" step="1">
                                </div>
                                <div class="wbt-fp-field w60">
                                    <label>Pitch Y°</label>
                                    <input type="number" id="wbtFPCAY" value="0" step="1">
                                </div>
                                <div class="wbt-fp-field w60">
                                    <label>Yaw Z°</label>
                                    <input type="number" id="wbtFPCAZ" value="0" step="1">
                                </div>
                            </div>

                            <div class="wbt-fp-btns">
                                <button type="button" class="wbt-fp-btn wbt-fp-btn-add" id="wbtFPAddBtn">+ ADD</button>
                                <button type="button" class="wbt-fp-btn wbt-fp-btn-upd" id="wbtFPUpdBtn" disabled>UPDATE</button>
                                <button type="button" class="wbt-fp-btn wbt-fp-btn-del" id="wbtFPDelBtn" disabled>DELETE</button>
                                <button type="button" class="wbt-fp-btn" id="wbtFPClearBtn">CLEAR</button>
                            </div>
                            <div class="wbt-fp-status" id="wbtFPStatus">Select a wellbore and enter parameters to add a Frac Plane.</div>
                            <% } else { %>
                            <div class="wbt-fp-status" style="margin-bottom:6px;">View-only — editing Frac Planes requires an admin, leader, or user account.</div>
                            <% } %>
                            <div class="wbt-fp-list" id="wbtFPList"></div>
                        </div>
                        </div>
                    </div>

                    <!-- ── Polylines Controller Panel (accordion) ──────────────────
                         Added 2026-08-25: a sibling accordion below Frac Planes (NOT
                         nested inside it) — a closed map-view outline (Northing/
                         Easting, e.g. an imported channel/geobody extent) is
                         extruded between two TVDss depths into a solid volume in the
                         viewer. Not tied to any one wellbore (job-level, keyed only
                         by noteId), so there's no wellbore selector here. Reuses the
                         .wbt-fp-* CSS classes from the Frac Plane panel above for a
                         consistent look.

                         FIX 2026-09-13: same restructuring as the Frac Plane panel
                         above (see that comment) — the accordion and read-only list
                         are unconditional; only the edit form+buttons stay role-gated
                         (wbtCanEdit, set above). -->
                    <div class="wbt-fp-accordion-wrap">
                        <div class="wbt-fp-acc-header collapsed" id="wbtPolyAccHeader">
                            <span><span class="wbt-dot" style="background:#ff4060;box-shadow:0 0 7px #ff4060;width:7px;height:7px;border-radius:50%;display:inline-block;margin-right:8px;"></span>Polylines</span>
                            <span class="wbt-fp-acc-icon">&#9660;</span>
                        </div>
                        <div class="wbt-fp-acc-body collapsed" id="wbtPolyAccBody">
                        <div class="wbt-fp-root" id="wbtPolyRoot">
                            <% if (wbtCanEdit) { %>
                            <div class="wbt-fp-row">
