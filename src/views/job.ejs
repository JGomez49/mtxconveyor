                    if(v){ v.nodes = [Ks].concat(tree.map(x => x.s)); v.nodePm = [Kpm].concat(tree.map(x => x.pm)); v.treeSecs = tree.map(x => x.sec); v.conn = cs2; addDistinct(cands, v, 60); return true; }
                }
