                const parts = series.map(sr => { let bi = 0, bd = Infinity; sr.rows.forEach((r, i) => { const d = Math.abs(r.md - md); if(d < bd){ bd = d; bi = i; } }); return { sr, r: sr.rows[bi] }; });
                const f2 = (v, d) => (v == null || !isFinite(v)) ? '-' : (+v).toFixed(d);
