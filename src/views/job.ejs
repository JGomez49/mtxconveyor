                    dN = o[0] * h[0] + o[1] * l[0] + o[2] * a[0]; dE = o[0] * h[1] + o[1] * l[1] + o[2] * a[1]; dD = o[0] * h[2] + o[1] * l[2] + o[2] * a[2];
