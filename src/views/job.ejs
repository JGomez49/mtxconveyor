                        .wbt-tb-wrap:fullscreen{ background:var(--wbt-bg); padding:8px; overflow:auto; }
                        .wbt-tb-wrap:fullscreen .wbt-viewer-outer{ height:calc(100vh - 80px); }
                        @media (max-width:768px){
                            .wbt-fpm{ padding:0; }
                            .wbt-fpm-win{ max-width:none; width:100vw; height:100%; max-height:100vh; border-radius:0; }
