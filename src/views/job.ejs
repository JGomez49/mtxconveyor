                        <button type="button" id="jobFolderBtn" class="btn btn-outline-info"></button>
                    </div>
                    <script>
                    (function(){
                        var inp = document.getElementById('jobFolderUrl'), btn = document.getElementById('jobFolderBtn');
                        var v = inp.value.trim(), isWeb = /^https?:\/\//i.test(v);
                        btn.textContent = isWeb ? '📂 Open' : '📋 Copy path';
                        btn.title = isWeb ? 'Open the folder in a new tab' : 'Copy the path, then paste it in File Explorer (Win+E, Ctrl+L, Ctrl+V, Enter)';
                        btn.addEventListener('click', function(){
                            if(isWeb){ window.open(v, '_blank', 'noopener'); return; }
                            var done = function(){ var t = btn.textContent; btn.textContent = '✔ Copied — paste in File Explorer'; setTimeout(function(){ btn.textContent = t; }, 2500); };
                            if(navigator.clipboard && window.isSecureContext){ navigator.clipboard.writeText(v).then(done, function(){ inp.select(); document.execCommand('copy'); done(); }); }
                            else { inp.select(); document.execCommand('copy'); done(); }
                        });
                    })();
                    </script>
                <% } %>

