    <script>
        // ── Delete log entry (admin only) ──────────────────────────────
        async function deleteLogEntry(logId, btn) {
            if (!confirm('Delete this log entry? This cannot be undone.')) return;
            btn.disabled = true;
            try {
                const res = await fetch('/notes/log/' + logId, { method: 'DELETE' });
                const data = await res.json();
                if (res.ok && data.success) {
                    const card = btn.closest('.card');
                    if (card) card.remove();
                } else {
                    alert('Failed to delete: ' + (data.error || res.statusText));
                    btn.disabled = false;
                }
            } catch(e) {
                alert('Error: ' + e.message);
                btn.disabled = false;
            }
        }
    </script>



