                                        </div>
                                        <div>
                                            <label class="form-label mb-1" style="font-size:11px;">SF threshold</label>
                                            <input id="padACThSF" type="number" class="form-control form-control-sm" style="width:90px;" step="0.01" value="1.25">
                                        </div>
                                        <button id="padACParseBtn" class="btn btn-sm btn-success align-self-end">
                                            ⚙ Parse
