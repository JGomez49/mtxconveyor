    // ── Well selection, status text, auto-recalculation ───────────────────
    const wellSelect = document.getElementById('tdWellSelect2');
    const scenarioSelect = document.getElementById('tdScenarioSelect2');
    const statusText = document.getElementById('tdStatusText');
    const emptyMsg = document.getElementById('tdEmptyMsg');
    const chartsWrap = document.getElementById('tdChartsWrap');

    // Scenarios are job-wide (shared names across every well) — see
    // models/TDModel.js. currentScenario starts as whichever scenario the
    // document says is active; picking a different one from the dropdown
    // just previews it (recalculating per well as needed) — it does NOT
    // change which scenario is "active" for the job. Use the modeler's
    // "Set as Active" button for that.
    let currentScenario = (tdDoc && tdDoc.activeScenario) || 'Default';

    function scenarioEntry(scenarioName, wellKey){
        const scen = tdDoc && tdDoc.scenarios && tdDoc.scenarios[scenarioName];
        if(scen && scen.resultsByWell && scen.resultsByWell[wellKey]) return scen.resultsByWell[wellKey];
        // Fall back to the top-level mirror (covers legacy documents saved
        // before scenarios existed, and the case where the active scenario
        // itself is selected).
        return tdDoc && tdDoc.resultsByWell ? tdDoc.resultsByWell[wellKey] : null;
    }

    function initScenarioSelect(){
        if(!tdDoc || !tdDoc.scenarios || !Object.keys(tdDoc.scenarios).length){
            scenarioSelect.style.display = 'none';
            return;
        }
        scenarioSelect.innerHTML = '';
        Object.keys(tdDoc.scenarios).forEach(function(name){
            const opt = document.createElement('option');
            opt.value = name;
            opt.textContent = name + (name === tdDoc.activeScenario ? ' \u2b50 (active)' : '');
            scenarioSelect.appendChild(opt);
        });
        scenarioSelect.value = currentScenario;
        scenarioSelect.style.display = '';
        scenarioSelect.addEventListener('change', function(){
            currentScenario = scenarioSelect.value;
            const wellKey = wellSelect.value;
            if(!wellKey) return;
            const existing = scenarioEntry(currentScenario, wellKey);
            if(existing && existing.results){ showWellEntry(wellKey, existing); }
            else { recalcAndShow(wellKey); }
        });
    }

    // "Current settings" — whichever well's casings/bha/params were most
    // recently in play. Reused as-is when switching wells, so a well switch
    // is a true apples-to-apples comparison ("same settings, different well").
    let currentCasings = null, currentBha = null, currentParams = null, currentResults = null;

    // Grade / weight / thread for the schematic's casing labels come from
    // the Casing Design module — it's the source of truth for that info,
    // the T&D casing table only stores OD/ID/top/shoe. Already embedded
    // server-side (#casingDesignData, same pattern as #tdModelData) — no
    // extra fetch needed. Matched to the T&D casings by name.
    //
    // Looks in the active scenario first (top-level resultsByWell, same
    // mirror convention as TDModel/CasingDesign use everywhere else), then
    // falls back to ANY scenario that has a saved string for this well —
    // the T&D casing table isn't scenario-aware, so this is friendlier
    // than requiring an exact scenario match the person may not know about.
    let casingDesignDoc = null;
    (function loadCasingDesignData(){
        const dataEl = document.getElementById('casingDesignData');
        if(!dataEl) return;
        try {
            casingDesignDoc = JSON.parse(dataEl.textContent);
        } catch(err) {
            console.warn('[T&D] Failed to parse casingDesignData JSON:', err);
        }
        if(!casingDesignDoc) console.log('[T&D] No Casing Design saved for this job yet — Grade/Weight/Thread won\'t show on the schematic.');
    })();
    function casingDesignInfoFor(wellKey, casingName){
        if(!casingDesignDoc || !wellKey) return null;
        const norm = s => (s || '').trim().toLowerCase();
        function findIn(resultsByWell){
            if(!resultsByWell || !resultsByWell[wellKey]) return null;
            const strings = resultsByWell[wellKey].casingStrings || [];
            return strings.find(s => norm(s.name) === norm(casingName)) || null;
        }
        let match = findIn(casingDesignDoc.resultsByWell);
        if(match) return match;
        const scenarios = casingDesignDoc.scenarios || {};
        for(const name of Object.keys(scenarios)){
            match = findIn(scenarios[name] && scenarios[name].resultsByWell);
            if(match) return match;
        }
        return null;
    }

    function fmtWhen(iso){
        if(!iso) return '';
        return new Date(iso).toLocaleString();
    }

    function showWellEntry(wellKey, entry){
        if(!entry || !entry.results || !entry.results.mds || !entry.results.mds.length){
            if(chartsWrap) chartsWrap.style.display = 'none';
            var schematicWrap0 = document.getElementById('tdSchematicWrap');
            if(schematicWrap0) schematicWrap0.style.display = 'none';
            if(emptyMsg){
                emptyMsg.style.display = '';
                emptyMsg.textContent = 'No results yet for ' + wellKey + ' — select a well with results, or use "Recalculate" below.';
            }
            statusText.textContent = 'No results for ' + wellKey + '.';
            return;
        }
        currentCasings = entry.casings; currentBha = entry.bha; currentParams = entry.params;
        currentResults = entry.results;
        if(emptyMsg) emptyMsg.style.display = 'none';
        if(chartsWrap) chartsWrap.style.display = '';
        statusText.textContent = 'Last calculated: ' + fmtWhen(entry.calculatedAt) +
            (entry.calculatedByName ? ' by ' + entry.calculatedByName : '') +
            ' — Well/Leg: ' + wellKey;
        renderTDSchematic();
        buildTDCharts(entry.results);
    }

    // Reused settings ("apples-to-apples" casings/bha/params) get carried
    // over when the well changes, but casing tops/shoes and TD are specific
    // to each well's own trajectory — reusing them verbatim would show the
    // wrong schema for the newly-selected well (e.g. a shallower well
    // showing a negative-depth BHA top). This re-anchors the casing shoes
    // (surface = trajectory SC, deepest casing = trajectory ICP/Landing,
    // any strings in between scaled proportionally to their original
    // spacing) and TD to the SELECTED well's own score-card depths —
    // exactly the SC / ICP(LP) / TD values already computed for the
    // Wellbore Trajectory dashboard (window.mtxGetWellKeyDepths). OD/ID and
    // any other per-string settings are left untouched.
    function syncCasingsToWell(wellKey, casings, params){
        const depths = (typeof window.mtxGetWellKeyDepths === 'function') ? window.mtxGetWellKeyDepths(wellKey) : null;
        if(!depths || !casings || !casings.length) return { casings, params };
        const sorted = casings.slice().sort((a, b) => a.shoe - b.shoe);
        const out = sorted.map(c => Object.assign({}, c));
        const n = out.length;
        const origFirstShoe = sorted[0].shoe;
        const origLastShoe  = sorted[n - 1].shoe;
        const newFirstShoe  = depths.scMD  != null ? depths.scMD  : origFirstShoe;
        const newLastShoe   = depths.icpMD != null ? depths.icpMD : origLastShoe;
        out[0].top = 0;
        out[0].shoe = newFirstShoe;
        if(n > 1){
            const origSpan = origLastShoe - origFirstShoe;
            const newSpan  = newLastShoe - newFirstShoe;
            for(let i = 1; i < n; i++){
                if(i === n - 1){
                    out[i].shoe = newLastShoe;
                } else if(origSpan > 0){
                    const frac = (sorted[i].shoe - origFirstShoe) / origSpan;
                    out[i].shoe = newFirstShoe + frac * newSpan;
                } else {
                    out[i].shoe = newFirstShoe + (newSpan * i / (n - 1));
                }
                out[i].top = out[i - 1].shoe;
            }
        }
        const newParams = Object.assign({}, params);
        if(depths.tdMD != null) newParams.td = depths.tdMD;
        // Open hole conventionally starts where the deepest casing shoe is.
        newParams.ohTop = out[n - 1].shoe;
        // 2026-11-08 (T&D hole sections + BHA runs): params.plan holds section
        // limits and run From/To in MD. Stretch them with the SAME piecewise-
        // linear map used for the casing shoes (surface -> each shoe -> TD,
        // old well -> this well), so sections/runs stay tied to the shoes;
        // the deepest run is then forced to end exactly at this well's TD.
        if(params && params.plan){
            newParams.plan = remapTdPlan(params.plan,
                [0].concat(sorted.map(c => c.shoe)).concat([params.td]),
                [0].concat(out.map(c => c.shoe)).concat([newParams.td]),
                newParams.td);
        }
        return { casings: out, params: newParams };
    }

    // Piecewise-linear MD map between two ordered breakpoint lists (same length).
    function remapTdPlan(plan, oldB, newB, newTD){
        const pts = [];
        for(let i = 0; i < oldB.length; i++){
            if(!isFinite(oldB[i]) || !isFinite(newB[i])) continue;
            if(pts.length && oldB[i] <= pts[pts.length - 1][0]) continue; // keep strictly increasing
            pts.push([oldB[i], newB[i]]);
        }
        const map = function(md){
            if(!isFinite(md) || pts.length < 2) return md;
            if(md <= pts[0][0]) return md - pts[0][0] + pts[0][1];
            for(let i = 1; i < pts.length; i++){
                if(md <= pts[i][0]){
                    const a = pts[i - 1], b = pts[i];
                    return a[1] + (md - a[0]) / (b[0] - a[0]) * (b[1] - a[1]);
                }
            }
            const a = pts[pts.length - 2], b = pts[pts.length - 1];
            return b[1] + (md - b[0]) * ((b[1] - a[1]) / (b[0] - a[0]));
        };
        const p = JSON.parse(JSON.stringify(plan));
        (p.sections || []).forEach(s => { s.from = map(s.from); s.to = map(s.to); });
        (p.runs || []).forEach(r => { r.from = map(r.from); r.to = map(r.to); });
        if(p.snapMD != null) p.snapMD = map(p.snapMD);
        if(isFinite(newTD)){
            const used = (p.runs || []).filter(r => r.use !== false);
            const pool = used.length ? used : (p.runs || []);
            if(pool.length){ pool.reduce((a, b) => (b.to >= a.to ? b : a)).to = newTD; }
            const secs = (p.sections || []).slice().sort((a, b) => a.from - b.from);
            if(secs.length) secs[secs.length - 1].to = newTD;
        }
        return p;
    }

    async function recalcAndShow(wellKey){
        if(!currentCasings || !currentBha || !currentParams){
            statusText.textContent = 'No saved parameters to reuse yet — run the model for at least one well in the modeler first.';
            if(emptyMsg){ emptyMsg.style.display = ''; emptyMsg.textContent = 'No Torque & Drag parameters saved yet for this job.'; }
            if(chartsWrap) chartsWrap.style.display = 'none';
            return;
        }
        const synced = syncCasingsToWell(wellKey, currentCasings, currentParams);
        currentCasings = synced.casings;
        currentParams = synced.params;
        statusText.textContent = 'Recalculating for ' + wellKey + '…';
        try {
            const res = await fetch('/notes/tdModel/recalculate/' + PASON_NOTE_ID, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ wellKey, casings: currentCasings, bha: currentBha, params: currentParams, scenario: currentScenario })
            });
            const data = await res.json();
            if(!res.ok){
                statusText.textContent = '❌ ' + (data.error || res.statusText);
                console.error('[T&D] recalculate failed:', data);
                return;
            }
            const entry = {
                casings: currentCasings, bha: currentBha, params: currentParams,
                results: data.results, calculatedAt: data.calculatedAt, calculatedByName: data.calculatedByName,
            };
            tdDoc.scenarios = tdDoc.scenarios || {};
            tdDoc.scenarios[currentScenario] = tdDoc.scenarios[currentScenario] || { resultsByWell: {} };
            tdDoc.scenarios[currentScenario].resultsByWell[wellKey] = entry;
            if(data.activeScenario === currentScenario){
                tdDoc.resultsByWell[wellKey] = entry;
            }
            console.log('[T&D] Recalculated and saved for', wellKey, 'scenario', currentScenario, 'at', data.calculatedAt, 'by', data.calculatedByName);
            showWellEntry(wellKey, entry);
        } catch(err) {
            statusText.textContent = '❌ Error: ' + err.message;
            console.error('[T&D] recalculate error:', err);
        }
    }

    function onWellChange(){
        const wellKey = wellSelect.value;
        if(!wellKey) return;
        const existing = scenarioEntry(currentScenario, wellKey);
        // Auto-recalculate using the currently-loaded settings every time the
        // well changes, so the comparison is always apples-to-apples — unless
        // this is the very first load and that well already has a saved run,
        // in which case just show it (avoids an unnecessary recalculation
        // the instant the page opens).
        if(existing && existing.results && !onWellChange._loaded){
            onWellChange._loaded = true;
            showWellEntry(wellKey, existing);
        } else {
            recalcAndShow(wellKey);
        }
    }

    function initTD(){
        if(!tdDoc){
            statusText.textContent = 'No Torque & Drag model saved yet for this job.';
            emptyMsg.style.display = '';
            return;
        }
        const subjectWells = getSubjectWellKeys();
        if(!subjectWells.length){
            statusText.textContent = 'No subject-well trajectories uploaded for this job yet.';
            emptyMsg.style.display = '';
            return;
        }
        wellSelect.innerHTML = '';
        subjectWells.forEach(function(wk){
            const opt = document.createElement('option');
            opt.value = wk; opt.textContent = wk;
            wellSelect.appendChild(opt);
        });
        wellSelect.style.display = '';
        wellSelect.addEventListener('change', onWellChange);
        initScenarioSelect();

        // Default: whichever well has the MOST RECENT calculatedAt, else the
        // first subject well alphabetically.
        let defaultWell = subjectWells[0];
        let latest = null;
        Object.keys(tdDoc.resultsByWell).forEach(function(wk){
            const entry = tdDoc.resultsByWell[wk];
            if(!entry || !entry.calculatedAt) return;
            if(!latest || new Date(entry.calculatedAt) > new Date(latest)){
                latest = entry.calculatedAt;
                if(subjectWells.indexOf(wk) !== -1) defaultWell = wk;
            }
        });
        wellSelect.value = defaultWell;
        onWellChange();
    }

    // Build the first time the accordion is actually opened — guarantees
    // #tdChartsWrap has real dimensions instead of the 0x0 it would report
    // while the accordion is still collapsed.
    let tdInitDone = false;
    function initTDOnce(){ if(tdInitDone) return; tdInitDone = true; initTD(); }
    const collapseEl = document.getElementById('collapseTD');
    if(collapseEl){
        collapseEl.addEventListener('shown.bs.collapse', initTDOnce);
        if(collapseEl.classList.contains('show')) initTDOnce();
    } else {
        initTDOnce();
    }
})();
</script>
<!-- ================= END TORQUE & DRAG MODEL SCRIPT ================= -->

<!-- ================= BIT HYDRAULICS PROGRAM SCRIPT (read-only) ================= -->
<script>
(function(){
    const HYD_NOTE_ID = "<%- note._id %>";
    if(!document.getElementById('hydWellSelect2')) return;
    const dataEl = document.getElementById('hydraulicsModelData');
    if(!dataEl){ console.log('[Hyd] #hydraulicsModelData element not found on this page.'); return; }
    let hydDoc;
    try { hydDoc = JSON.parse(dataEl.textContent); } catch(e){ console.error('[Hyd] Failed to parse hydraulicsModelData JSON:', e); hydDoc = null; }
    if(hydDoc && !hydDoc.resultsByWell) hydDoc.resultsByWell = {};

    function hydIsSubjectWell(well){
        var wn = (well.wellName || '').trim();
        if(well.wellCategory === 'subject') return true;
        if(well.wellCategory === 'offset') return false;
        return /^\[\d+\]/.test(wn) && /_L\d+$/i.test(wn);
    }
    function getSubjectWellKeys(){
        var dataEl2 = document.getElementById('wbtData');
        if(!dataEl2) return [];
        var wbtArr;
        try { wbtArr = JSON.parse(dataEl2.textContent); } catch(e){ return []; }
        return wbtArr.filter(function(w){ return w.survey && w.survey.length && hydIsSubjectWell(w); })
                      .map(function(w){ return w.wellName; })
                      .sort();
    }

    const wellSelect = document.getElementById('hydWellSelect2');
    const scenarioSelect = document.getElementById('hydScenarioSelect2');
    const statusText = document.getElementById('hydStatusText');
    const emptyMsg = document.getElementById('hydEmptyMsg');
    const resultsWrap = document.getElementById('hydResultsWrap');

    function fmt(v, d){ return (v == null || isNaN(v)) ? '—' : Number(v).toFixed(d != null ? d : 1); }

    function renderEntry(entry){
        if(!entry || !entry.results){
            resultsWrap.style.display = 'none';
            emptyMsg.style.display = 'block';
            emptyMsg.textContent = 'No saved run for this well/scenario yet<% if (canUseModelers) { %> — use "Open in Bit Hydraulics Program" to set one up.<% } else { %>.<% } %>';
            statusText.textContent = '';
            return;
        }
        emptyMsg.style.display = 'none';
        resultsWrap.style.display = 'block';
        var r = entry.results;

        var warnEl = document.getElementById('hydWarnings');
        warnEl.innerHTML = '';
        (r.warnings || []).forEach(function(w){
            var d = document.createElement('div');
            var severe = /No pressure available|higher than maximum/.test(w);
            d.style.cssText = 'border:1px solid ' + (severe ? '#ff4060' : '#ffd060') + ';background:rgba(' + (severe ? '255,64,96' : '255,208,96') + ',.08);color:' + (severe ? '#ff4060' : '#ffd060') + ';border-radius:4px;padding:8px 10px;font-size:11px;margin-bottom:6px;';
            d.textContent = '⚠ ' + w;
            warnEl.appendChild(d);
        });

        var cardsEl = document.getElementById('hydResultCards');
        cardsEl.innerHTML = '';
        if(r.bitHydraulics){
            var bh = r.bitHydraulics;
            // Same conversion constants as uploadHydraulics.ejs.
            var IN2_PER_MM2 = 645.16;
            var FT_PER_M = 1 / 0.3048;
            var PSI_PER_KPA = 1 / 6.894757293168;
            var HP_PER_W = 1 / 745.699872;
            var LBF_PER_N = 1 / 4.4482216152605;
            var PPG_PER_KGM3 = 1 / 119.826427;
            var cards = [
                ['Min. TFA', fmt(bh.minTfa_mm2,1) + ' mm²', fmt(bh.minTfa_mm2/IN2_PER_MM2,3) + ' in²'],
                ['Total TFA', fmt(bh.totalTfa_mm2,1) + ' mm²', fmt(bh.totalTfa_mm2/IN2_PER_MM2,3) + ' in²'],
                ['Jet Velocity', fmt(bh.jetVelocity_ms,2) + ' m/s', fmt(bh.jetVelocity_ms*FT_PER_M,1) + ' ft/s'],
                ['Bit Pressure Drop', fmt(bh.bitPressureDrop_kPa,0) + ' kPa', fmt(bh.bitPressureDrop_kPa*PSI_PER_KPA,0) + ' psi'],
                ['Bit Hyd. Power', fmt(bh.bitHydraulicPower_W,0) + ' W', fmt(bh.bitHydraulicPower_W*HP_PER_W,2) + ' hp'],
                ['H.S.I.', fmt(bh.hsi_Wmm2,3) + ' W/mm²', fmt(bh.hsi_Wmm2*IN2_PER_MM2*HP_PER_W,3) + ' hp/in²'],
                ['Impact Force', fmt(bh.impactForce_N,0) + ' N', fmt(bh.impactForce_N*LBF_PER_N,1) + ' lbf'],
                ['ECD', fmt(bh.ecd_kgm3,1) + ' kg/m³', fmt(bh.ecd_kgm3*PPG_PER_KGM3,3) + ' ppg'],
                ['Standpipe Pressure', fmt(bh.standpipePressure_kPa,0) + ' kPa', fmt(bh.standpipePressure_kPa*PSI_PER_KPA,0) + ' psi'],
            ];
            if(bh.nozzleSizes_mm && bh.nozzleSizes_mm.length){
                cards.push(['Nozzles',
                    bh.nozzleSizes_mm.map(function(v){ return fmt(v,2); }).join(', ') + ' mm',
                    bh.nozzleSizes_mm.map(function(v){ return Math.round(v/25.4*32); }).join(', ') + ' /32in']);
            }
            cards.forEach(function(c){
                var d = document.createElement('div');
                d.style.cssText = 'background:var(--an-panel2,#161e28);border:1px solid var(--an-border);border-radius:4px;padding:8px 10px;';
                d.innerHTML = '<div style="font-size:10px;color:var(--an-text-dim,#5a7080);text-transform:uppercase;letter-spacing:.5px;">'+c[0]+'</div><div style="font-family:monospace;font-size:15px;color:var(--an-text-bright,#e8f4ff);">'+c[1]+'</div><div style="font-family:monospace;font-size:11px;color:var(--an-text-dim,#5a7080);margin-top:2px;">'+c[2]+'</div>';
                cardsEl.appendChild(d);
            });
        }

        var pct = r.pressureLossPct || {};
        var segs = [
            { label:'DS', pct: pct.drillString || 0, color:'#00c8ff' },
            { label:'ANN', pct: pct.annulus || 0, color:'#ff6b35' },
            { label:'SURF', pct: pct.surface || 0, color:'#39ff14' },
            { label:'BIT', pct: pct.bit || 0, color:'#ffd060' },
        ];
        var bar = document.getElementById('hydPlBar');
        bar.innerHTML = '';
        segs.forEach(function(s){
            if(s.pct <= 0) return;
            var d = document.createElement('div');
            d.style.cssText = 'display:flex;align-items:center;justify-content:center;font-size:9px;color:#000;font-family:monospace;width:' + s.pct + '%;background:' + s.color + ';';
            d.title = s.label + ': ' + s.pct.toFixed(1) + '%';
            d.textContent = s.pct > 6 ? (s.label + ' ' + s.pct.toFixed(0) + '%') : '';
            bar.appendChild(d);
        });

        var dsBody = document.querySelector('#hydDsTable tbody');
        dsBody.innerHTML = '';
        (r.pipeRows || []).forEach(function(row){
            var tr = document.createElement('tr');
            tr.innerHTML = '<td>'+row.name+'</td><td>'+fmt(row.capacity_bbl,2)+'</td><td>'+fmt(row.pressureLoss_kPa,0)+'</td>';
            dsBody.appendChild(tr);
        });

        var annBody = document.querySelector('#hydAnnTable tbody');
        annBody.innerHTML = '';
        (r.annulusRows || []).forEach(function(row){
            var tr = document.createElement('tr');
            tr.innerHTML = '<td>'+row.section+'</td><td>'+fmt(row.length_m,1)+'</td><td>'+row.flowRegime+'</td><td>'+fmt(row.pressureLoss_kPa,0)+'</td>';
            annBody.appendChild(tr);
        });

        statusText.textContent = entry.calculatedAt
            ? ('Calculated ' + new Date(entry.calculatedAt).toLocaleString() + (entry.calculatedByName ? ' by ' + entry.calculatedByName : ''))
            : '';
    }

    function onWellChange(){
        var wk = wellSelect.value;
        var scenarios = hydDoc && hydDoc.scenarios ? hydDoc.scenarios : {};
        var scenarioName = scenarioSelect.value || (hydDoc && hydDoc.activeScenario);
        var rbw = (scenarios[scenarioName] && scenarios[scenarioName].resultsByWell) || (hydDoc && hydDoc.resultsByWell) || {};
        renderEntry(rbw[wk]);
    }

    async function onScenarioChange(){
        var scenarioName = scenarioSelect.value;
        if(!hydDoc || scenarioName === hydDoc.activeScenario){ onWellChange(); return; }
        try {
            var res = await fetch('/notes/hydraulicsModel/' + HYD_NOTE_ID + '/scenario/setActive', {
                method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ scenario: scenarioName })
            });
            if(res.ok){
                var res2 = await fetch('/notes/hydraulicsModel/' + HYD_NOTE_ID);
                hydDoc = await res2.json();
                if(hydDoc && !hydDoc.resultsByWell) hydDoc.resultsByWell = {};
            }
        } catch(e){ console.error('[Hyd] scenario switch failed:', e); }
        onWellChange();
    }

    function initHyd(){
        if(!hydDoc){
            emptyMsg.style.display = 'block';
            emptyMsg.textContent = 'No Bit Hydraulics model saved yet for this job.';
            statusText.textContent = '';
            return;
        }
        var subjectWells = getSubjectWellKeys();
        var wellKeys = Object.keys(hydDoc.resultsByWell || {});
        // Union of tagged subject wells and whatever wells actually have a
        // saved run (covers the "General" fallback key used when a job has
        // no subject-well trajectories tagged yet).
        var allKeys = subjectWells.slice();
        wellKeys.forEach(function(k){ if(allKeys.indexOf(k) === -1) allKeys.push(k); });
        if(!allKeys.length){
            emptyMsg.style.display = 'block';
            emptyMsg.textContent = 'No Bit Hydraulics model saved yet for this job.';
            statusText.textContent = '';
            return;
        }
        wellSelect.innerHTML = '';
        allKeys.forEach(function(wk){
            var opt = document.createElement('option');
            opt.value = wk; opt.textContent = wk;
            wellSelect.appendChild(opt);
        });
        wellSelect.style.display = '';
        wellSelect.addEventListener('change', onWellChange);

        var scenarioNames = hydDoc.scenarios ? Object.keys(hydDoc.scenarios) : ['Default'];
        if(!scenarioNames.length) scenarioNames = ['Default'];
        scenarioSelect.innerHTML = '';
        scenarioNames.forEach(function(n){
            var opt = document.createElement('option');
            opt.value = n; opt.textContent = n;
            scenarioSelect.appendChild(opt);
        });
        scenarioSelect.value = (hydDoc.activeScenario && scenarioNames.indexOf(hydDoc.activeScenario) !== -1) ? hydDoc.activeScenario : scenarioNames[0];
        scenarioSelect.style.display = '';
        scenarioSelect.addEventListener('change', onScenarioChange);

        // Default to whichever well/scenario has the most recent calculation.
        var latest = null, defaultWell = allKeys[0];
        Object.keys(hydDoc.resultsByWell || {}).forEach(function(wk){
            var entry = hydDoc.resultsByWell[wk];
            if(!entry || !entry.calculatedAt) return;
            if(!latest || new Date(entry.calculatedAt) > new Date(latest)){
                latest = entry.calculatedAt;
                defaultWell = wk;
            }
        });
        wellSelect.value = defaultWell;
        onWellChange();
    }

    let hydInitDone = false;
    function initHydOnce(){ if(hydInitDone) return; hydInitDone = true; initHyd(); }
    const collapseHydEl = document.getElementById('collapseHyd');
    if(collapseHydEl){
        collapseHydEl.addEventListener('shown.bs.collapse', initHydOnce);
        if(collapseHydEl.classList.contains('show')) initHydOnce();
    } else {
        initHydOnce();
    }
})();
</script>
<!-- ================= END BIT HYDRAULICS PROGRAM SCRIPT ================= -->

<!-- ================= CASING DESIGN SCRIPT (read-only) ================= -->
<script>
(function(){
    const CSD_NOTE_ID = "<%- note._id %>";
    if(!document.getElementById('csdWellSelect2')) return;
    const dataEl = document.getElementById('casingDesignData');
    if(!dataEl){ console.log('[Csd] #casingDesignData element not found on this page.'); return; }
    let csdDoc;
    try { csdDoc = JSON.parse(dataEl.textContent); } catch(e){ console.error('[Csd] Failed to parse casingDesignData JSON:', e); csdDoc = null; }
    if(csdDoc && !csdDoc.resultsByWell) csdDoc.resultsByWell = {};

    function csdIsSubjectWell(well){
        var wn = (well.wellName || '').trim();
        if(well.wellCategory === 'subject') return true;
        if(well.wellCategory === 'offset') return false;
        return /^\[\d+\]/.test(wn) && /_L\d+$/i.test(wn);
    }
    function getSubjectWellKeys(){
        var dataEl2 = document.getElementById('wbtData');
        if(!dataEl2) return [];
        var wbtArr;
        try { wbtArr = JSON.parse(dataEl2.textContent); } catch(e){ return []; }
        return wbtArr.filter(function(w){ return w.survey && w.survey.length && csdIsSubjectWell(w); })
                      .map(function(w){ return w.wellName; })
                      .sort();
    }

    const wellSelect = document.getElementById('csdWellSelect2');
    const scenarioSelect = document.getElementById('csdScenarioSelect2');
    const statusText = document.getElementById('csdStatusText');
    const emptyMsg = document.getElementById('csdEmptyMsg');
    const resultsWrap = document.getElementById('csdResultsWrap');

    function fmt(v, d){ return (v == null || isNaN(v)) ? '—' : Number(v).toFixed(d != null ? d : 1); }
    function fmtPa_kPa(pa){ return fmt(pa/1000, 0); }
    function fmtN_kN(n){ return fmt(n/1000, 0); }

    var csdCharts = {};
    function renderTriaxialChart(name, triaxial, buckling){
        var canvasId = 'csdTriChart_' + name.replace(/[^a-z0-9]/gi, '_');
        var canvas = document.getElementById(canvasId);
        if(!canvas) return;
        // Themed per 2026-08-26 light-mode fix (same isLight pattern as
        // renderPasonChart/buildTDCharts/renderPlot) — this chart's axis
        // title/tick/grid colors were hardcoded to the dark-theme values.
        var isLight = document.body.classList.contains('light-mode');
        var csdAxisTitleColor = isLight ? '#495057' : '#5a7080';
        var csdTickColor = isLight ? '#000000' : '#c8d8e8';
        var csdGridColor = isLight ? 'rgba(0,0,0,.15)' : '#1e2d3d';
        var envelope = triaxial.envelope;
        var high = envelope.map(function(p){ return { x: p.dp_Pa/1e6, y: p.FaHigh_N/1000 }; });
        var low = envelope.map(function(p){ return { x: p.dp_Pa/1e6, y: p.FaLow_N/1000 }; });
        var designEnv = triaxial.designEnvelope || [];
        var designHigh = designEnv.map(function(p){ return { x: p.dp_Pa/1e6, y: p.FaHigh_N/1000 }; });
        var designLow = designEnv.map(function(p){ return { x: p.dp_Pa/1e6, y: p.FaLow_N/1000 }; });
        var bucklingLine = (triaxial.bucklingLine || []).map(function(p){ return { x: p.dp_Pa/1e6, y: p.Fa_N/1000 }; });
        var loadPts = triaxial.points.map(function(p){ return { x: p.dp_Pa/1e6, y: p.Fa_N/1000, label: p.label }; });
        var simplePts = loadPts.filter(function(p){ return p.label.indexOf('simple') !== -1; });
        var altPts = loadPts.filter(function(p){ return p.label.indexOf('alternative') !== -1; });
        var engPts = loadPts.filter(function(p){ return p.label.indexOf('engineered') !== -1; });

        // "As landed" reference — vertical line at that condition's dp
        // (see casingLoadCases.js), spanning the chart's y-range, plus a
        // marker at the actual as-landed Fa.
        var asLandedLine = [], asLandedPt = [];
        if(buckling && buckling.asLanded){
            var al = buckling.asLanded;
            var allY = high.map(function(p){ return p.y; }).concat(low.map(function(p){ return p.y; }));
            var yMin = allY.length ? Math.min.apply(null, allY) : -1000;
            var yMax = allY.length ? Math.max.apply(null, allY) : 1000;
            var x0 = al.dp_Pa / 1e6;
            asLandedLine = [{ x: x0, y: yMin }, { x: x0, y: yMax }];
            asLandedPt = [{ x: x0, y: al.Fa_N / 1000, label: 'As Landed' }];
        }

        if(csdCharts[name]) csdCharts[name].destroy();
        csdCharts[name] = new Chart(canvas.getContext('2d'), {
            type: 'scatter',
            data: {
                datasets: [
                    { label: 'VME — MYS', data: high, showLine: true, borderColor: '#00c8ff', backgroundColor: 'transparent', pointRadius: 0, borderWidth: 1.5 },
                    { label: 'VME — MYS', data: low, showLine: true, borderColor: '#00c8ff', backgroundColor: 'transparent', pointRadius: 0, borderWidth: 1.5 },
                    { label: 'VME — Design Factor', data: designHigh, showLine: true, borderColor: '#ff4060', backgroundColor: 'transparent', pointRadius: 0, borderWidth: 1.5 },
                    { label: 'VME — Design Factor', data: designLow, showLine: true, borderColor: '#ff4060', backgroundColor: 'transparent', pointRadius: 0, borderWidth: 1.5 },
                    { label: 'Buckling threshold (Goins)', data: bucklingLine, showLine: true, borderColor: '#7d9e34', backgroundColor: 'transparent', pointRadius: 0, borderWidth: 1.5, borderDash: [5,3] },
                    { label: 'As Landed (ref.)', data: asLandedLine, showLine: true, borderColor: '#c8d8e8', backgroundColor: 'transparent', pointRadius: 0, borderWidth: 1, borderDash: [2,2] },
                    { label: 'As Landed', data: asLandedPt, showLine: false, backgroundColor: '#ffffff', borderColor: '#111820', borderWidth: 1.5, pointStyle: 'crossRot', pointRadius: 7, pointHoverRadius: 9 },
                    { label: 'Simple', data: simplePts, showLine: false, backgroundColor: '#ff6b35', pointRadius: 5 },
                    { label: 'Alternative', data: altPts, showLine: false, backgroundColor: '#ffd060', pointStyle: 'triangle', pointRadius: 6 },
                    { label: 'Engineered', data: engPts, showLine: false, backgroundColor: '#39ff14', pointStyle: 'rect', pointRadius: 5 }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: { callbacks: { label: function(ctx){
                        var d = ctx.raw;
                        return (d.label || ctx.dataset.label) + ': Δp=' + d.x.toFixed(2) + ' MPa, Fa=' + d.y.toFixed(0) + ' kN';
                    } } },
                    zoom: {
                        pan: { enabled: true, mode: 'xy' },
                        zoom: { wheel: { enabled: true, speed: 0.08 }, pinch: { enabled: true }, mode: 'xy' },
                        limits: { x: { min: 'original', max: 'original' }, y: { min: 'original', max: 'original' } }
                    }
                },
                scales: {
                    x: { title: { display: true, text: 'Δp = pi − po (MPa)', color: csdAxisTitleColor }, grid: { color: csdGridColor }, ticks: { color: csdTickColor } },
                    y: { title: { display: true, text: 'Fa (kN)', color: csdAxisTitleColor }, grid: { color: csdGridColor }, ticks: { color: csdTickColor } }
                }
            }
        });
    }

    function renderEntry(entry){
        if(!entry || !entry.results || !entry.results.byString){
            resultsWrap.style.display = 'none';
            emptyMsg.style.display = 'block';
            emptyMsg.textContent = 'No saved run for this well/scenario yet<% if (canUseModelers) { %> — use "Open in Casing Design" to set one up.<% } else { %>.<% } %>';
            statusText.textContent = '';
            return;
        }
        emptyMsg.style.display = 'none';
        resultsWrap.style.display = 'block';

        var cardsEl = document.getElementById('csdStringCards');
        cardsEl.innerHTML = '';
        var pendingCharts = [];
        Object.keys(entry.results.byString).forEach(function(name){
            var e = entry.results.byString[name];
            var gov = e.governing;
            var row = document.createElement('div');
            row.style.cssText = 'border:1px solid var(--an-border);border-radius:4px;padding:8px 10px;';
            var pieces = ['burst', 'collapse', 'tension'].map(function(key){
                var label = key.charAt(0).toUpperCase() + key.slice(1);
                var g = gov[key];
                var src = g.governedBy === 'engineered' ? e.engineered.check[key] : (g.governedBy === 'alternative' ? e.alternative.check[key] : e.simple.check[key]);
                var isForce = key === 'tension';
                var color = g.status === 'pass' ? '#39ff14' : '#ff4060';
                var loadStr = isForce ? fmtN_kN(src.load) + ' kN' : fmtPa_kPa(src.load) + ' kPa';
                var methodTag = g.governedBy === 'engineered' ? ' [eng]' : (g.governedBy === 'alternative' ? ' [alt]' : '');
                return '<span style="margin-right:14px;">' + label + ' <b style="color:' + color + ';">DF ' + fmt(src.achievedDF, 2) +
                    '</b><span style="color:var(--an-text-dim,#5a7080);">' + methodTag + ' (req ' + fmt(src.requiredDF, 2) + ', load ' + loadStr + ')</span></span>';
            }).join('');
            var parentLine = '';
            if(e.parentCheck && !e.parentCheck.error){
                var pc = e.parentCheck;
                var pcOk = pc.check.burst.pass && pc.check.collapse.pass && pc.check.tension.pass;
                parentLine = '<div style="font-size:10px;color:' + (pcOk?'#39ff14':'#ff4060') + ';margin-top:3px;">Parent (' + pc.parentStringName + ') check: ' + (pcOk?'pass':'FAIL') + '</div>';
            }
            var overpullLine = '';
            if(e.overpull){
                var op = e.overpull;
                overpullLine = '<div style="font-size:10px;color:' + (op.pass?'#39ff14':'#ffd060') + ';margin-top:3px;">Overpull: ' +
                    (op.pass?'OK':'SHORT') + ' — ' + fmt(op.availableOverpull_kdaN,1) + ' kdaN available (tension governed by ' + op.governedBy + ')</div>';
            }
            var bucklingLine2 = '';
            if(e.buckling){
                var bk = e.buckling, al = bk.asLanded, bkOk = !al.willBuckle;
                bucklingLine2 = '<div style="font-size:10px;color:' + (bkOk?'#39ff14':'#ffd060') + ';margin-top:3px;">Buckling (As Landed): ' +
                    (bkOk?'OK':'BUCKLES') + ' — Fbu ' + fmt(al.Fbu_N/1000,0) + ' kN';
                if(bk.parentStringName){
                    bucklingLine2 += ', Δr ' + fmt(bk.radialClearance_mm,1) + ' mm (inside ' + bk.parentStringName + ')';
                    if(bk.lengthChange_m != null) bucklingLine2 += ', length change ' + fmt(bk.lengthChange_m*1000,1) + ' mm';
                }
                bucklingLine2 += '</div>';
            }
            var canvasId = 'csdTriChart_' + name.replace(/[^a-z0-9]/gi, '_');
            var chartHtml = '';
            if(e.triaxial && e.triaxial.envelope && e.triaxial.envelope.length){
                chartHtml = '<div style="height:260px;background:var(--an-panel2,#161e28);border:1px solid var(--an-border);border-radius:4px;padding:6px;margin-top:8px;">' +
                    '<canvas id="' + canvasId + '"></canvas></div>';
            }
            row.innerHTML = '<div style="font-family:var(--cond, inherit);font-weight:700;color:var(--an-text-bright,#e8f4ff);margin-bottom:4px;">' + name + '</div>' +
                '<div style="font-size:11px;font-family:monospace;">' + pieces + '</div>' + parentLine + overpullLine + bucklingLine2 + chartHtml;
            cardsEl.appendChild(row);
            if(e.triaxial && e.triaxial.envelope && e.triaxial.envelope.length){
                pendingCharts.push({ name: name, triaxial: e.triaxial, buckling: e.buckling });
            }
        });
        pendingCharts.forEach(function(c){ renderTriaxialChart(c.name, c.triaxial, c.buckling); });

        statusText.textContent = entry.calculatedAt
            ? ('Calculated ' + new Date(entry.calculatedAt).toLocaleString() + (entry.calculatedByName ? ' by ' + entry.calculatedByName : ''))
            : '';
    }

    function onWellChange(){
        var wk = wellSelect.value;
        var scenarios = csdDoc && csdDoc.scenarios ? csdDoc.scenarios : {};
        var scenarioName = scenarioSelect.value || (csdDoc && csdDoc.activeScenario);
        var rbw = (scenarios[scenarioName] && scenarios[scenarioName].resultsByWell) || (csdDoc && csdDoc.resultsByWell) || {};
        renderEntry(rbw[wk]);
    }

    async function onScenarioChange(){
        var scenarioName = scenarioSelect.value;
        if(!csdDoc || scenarioName === csdDoc.activeScenario){ onWellChange(); return; }
        try {
            var res = await fetch('/notes/casingDesign/' + CSD_NOTE_ID + '/scenario/setActive', {
                method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ scenario: scenarioName })
            });
            if(res.ok){
                var res2 = await fetch('/notes/casingDesign/' + CSD_NOTE_ID);
                csdDoc = await res2.json();
                if(csdDoc && !csdDoc.resultsByWell) csdDoc.resultsByWell = {};
            }
        } catch(e){ console.error('[Csd] scenario switch failed:', e); }
        onWellChange();
    }

    function initCsd(){
        if(!csdDoc){
            emptyMsg.style.display = 'block';
            emptyMsg.textContent = 'No Casing Design model saved yet for this job.';
            statusText.textContent = '';
            return;
        }
        var subjectWells = getSubjectWellKeys();
        var wellKeys = Object.keys(csdDoc.resultsByWell || {});
        var allKeys = subjectWells.slice();
        wellKeys.forEach(function(k){ if(allKeys.indexOf(k) === -1) allKeys.push(k); });
        if(!allKeys.length){
            emptyMsg.style.display = 'block';
            emptyMsg.textContent = 'No Casing Design model saved yet for this job.';
            statusText.textContent = '';
            return;
        }
        wellSelect.innerHTML = '';
        allKeys.forEach(function(wk){
            var opt = document.createElement('option');
            opt.value = wk; opt.textContent = wk;
            wellSelect.appendChild(opt);
        });
        wellSelect.style.display = '';
        wellSelect.addEventListener('change', onWellChange);

        var scenarioNames = csdDoc.scenarios ? Object.keys(csdDoc.scenarios) : ['Default'];
        if(!scenarioNames.length) scenarioNames = ['Default'];
        scenarioSelect.innerHTML = '';
        scenarioNames.forEach(function(n){
            var opt = document.createElement('option');
            opt.value = n; opt.textContent = n;
            scenarioSelect.appendChild(opt);
        });
        scenarioSelect.value = (csdDoc.activeScenario && scenarioNames.indexOf(csdDoc.activeScenario) !== -1) ? csdDoc.activeScenario : scenarioNames[0];
        scenarioSelect.style.display = '';
        scenarioSelect.addEventListener('change', onScenarioChange);

        var latest = null, defaultWell = allKeys[0];
        Object.keys(csdDoc.resultsByWell || {}).forEach(function(wk){
            var entry = csdDoc.resultsByWell[wk];
            if(!entry || !entry.calculatedAt) return;
            if(!latest || new Date(entry.calculatedAt) > new Date(latest)){
                latest = entry.calculatedAt;
                defaultWell = wk;
            }
        });
        wellSelect.value = defaultWell;
        onWellChange();
    }

    let csdInitDone = false;
    function initCsdOnce(){ if(csdInitDone) return; csdInitDone = true; initCsd(); }
    const collapseCsdEl = document.getElementById('collapseCsd');
    if(collapseCsdEl){
        collapseCsdEl.addEventListener('shown.bs.collapse', initCsdOnce);
        if(collapseCsdEl.classList.contains('show')) initCsdOnce();
    } else {
        initCsdOnce();
    }
})();
</script>
<!-- ================= END CASING DESIGN SCRIPT ================= -->

