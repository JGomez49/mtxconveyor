            nice(y0, y1, 5).forEach(v => { svg += `<line x1="${L}" x2="${W - R}" y1="${sy(v)}" y2="${sy(v)}" stroke="${grid}"/><text x="${L - 4}" y="${sy(v) + 3}" fill="${txt}" font-size="10" text-anchor="end">${v}</text>`; });
