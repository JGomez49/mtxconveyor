                <!-- ================= TORQUE & DRAG MODEL ================= -->
                <div class="accordion mb-2" id="accordionTD">
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#collapseTD"
                                    aria-expanded="false">
                                🔧 Torque &amp; Drag
                            </button>
