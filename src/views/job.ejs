                                <input type="range" id="wbtFormationDensity" min="2" max="60" step="1" value="60">
                                <div style="font-size:9px;color:var(--wbt-text-dim);text-align:right;" id="wbtFormationDensityVal">60 &times; 60</div>
                            </div>
                            <div class="wbt-section">
                                <h6>Rotation Axis</h6>
                                <select id="wbtRotationAxis">
                                    <option value="none">Free orbit</option>
                                    <option value="x">X (East-West)</option>
                                    <option value="y">Y (Vertical/TVD)</option>
                                    <option value="z">Z (North-South)</option>
                                </select>
                            </div>
                            <div class="wbt-section">
                                <h6>Line Thickness</h6>
                                <!-- CHANGED 2026-10-11: separate sliders per group + per-trajectory override.
                                     id wbtLineThickness kept (now = Subjects) so existing listeners still work. -->
                                <div style="font-size:10px;">Subjects <span id="wbtLtSubjVal"></span></div>
                                <input type="range" id="wbtLineThickness" min="0.1" max="5" step="0.1" value="0.5">
                                <div style="font-size:10px;margin-top:4px;">Offsets <span id="wbtLtOffVal"></span></div>
                                <input type="range" id="wbtLineThicknessOffset" min="0.1" max="5" step="0.1" value="0.5">
                                <div style="font-size:10px;margin-top:4px;">Scenarios (iPlan) <span id="wbtLtScnVal"></span></div>
                                <input type="range" id="wbtLineThicknessScenario" min="0.1" max="5" step="0.1" value="0.5">
                                <!-- ADDED 2026-10-31 (John): thickness of the iPad preview ("prototype") ghost wells -->
                                <div style="font-size:10px;margin-top:4px;">iPad previews <span id="wbtLtIpadVal"></span></div>
                                <input type="range" id="wbtLineThicknessIpad" min="0.1" max="5" step="0.1" value="1">
                                <!-- ADDED 2026-10-31 (John): markers at the iPad export "Comments" points (SurfaceCasing, Nudge, KickOff, tangents, IntermediateCasing, formation tops, TD) -->
                                <div style="font-size:10px;margin-top:4px;display:flex;justify-content:space-between;align-items:center;"><span>iPad markers <span id="wbtLtIpadMkVal">× 1.0</span></span><label style="font-size:10px;"><input type="checkbox" id="wbtIpadMkShow" checked> show</label></div>
                                <input type="range" id="wbtIpadMkSize" min="0.1" max="5" step="0.1" value="1">
                                <div style="font-size:10px;margin-top:8px;">Individual trajectory</div>
                                <select id="wbtLtIndivSel" style="margin:3px 0;"><option value="">— select —</option></select>
                                <input type="range" id="wbtLtIndiv" min="0.1" max="5" step="0.1" value="0.5" disabled>
                                <div style="display:flex;justify-content:space-between;align-items:center;font-size:10px;">
                                    <span id="wbtLtIndivVal"></span>
                                    <button type="button" class="wbt-btn" id="wbtLtIndivReset" style="padding:2px 8px;" disabled title="Back to its group's thickness">Reset</button>
                                </div>
                            </div>
                            <div class="wbt-section">
                                <h6>Marker Size</h6>
                                <input type="range" id="wbtMarkerSize" min="0.1" max="3" step="0.05" value="0.4">
                            </div>
                            <div class="wbt-section">
                                <button type="button" class="wbt-btn" id="wbtResetView" style="width:100%;">Reset View</button>
                            </div>
                        </div>

                        <!-- Canvas + legend overlay -->
                        <div class="wbt-viewer-canvas-wrap">
                            <canvas class="wbt-viewer" id="wbtViewer"></canvas>
                            <div class="wbt-panel wbt-legend" id="wbtLegendPanel">
                                <h6>Legend</h6>
                                <div id="wbtLegendList"></div>
                            </div>
                        </div>

                        <!-- Right sidebar: wellbores tree (full viewer height) -->
                        <div class="wbt-sidebar wbt-sidebar-right">
                            <div class="wbt-section" style="display:flex;flex-direction:column;flex:1;min-height:0;">
                                <h6>Wellbores</h6>
                                <div id="wbtWellList" style="flex:1;min-height:0;overflow-y:auto;"></div>
                            </div>
                        </div>

                    </div>

                    <%# ADDED 2026-11-11 (John): Gantt-style toolbar above the 3D plot (better on phones). The two side panels move
                         into floating windows ("☰ Display" = left controls, "▦ Wellbores" = tree) so the plot gets the full width.
                         Quick chips: Axes / Grid / Legend (drive the original checkboxes), Subject / Offset (tick or untick every
                         pad in that category of the tree), Reset view (the original button) and Full screen. All original
                         controls keep their ids and listeners — they are only moved, not rebuilt. %>
