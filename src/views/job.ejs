            prog.textContent = 'Loading toolcodes…';
            await A.ready();
            const run = ++ipdRun, prefix = '__ipd' + run + '__ ';
            const ref = A.surfaceLatLon(ipd.refWell);
            // preview wells as AC pseudo-wells (Sub-Sea = surface RKB elev. - TVD, same as iPlan scenarios)
            const news = wells.map(w => ({
                label: w.name, maxMd: depth === 'icp' ? w.landMd : Infinity,
                well: { wellName: prefix + w.name, toolcode: ref.toolcode,
                        survey: w.st.map(p => ({ md:p.md, incl:p.inc, azim:p.az, tvd:p.tvd, northing:p.n, easting:p.e, subSea:n(w.s.ss) - p.tvd, latitude:ref.lat, longitude:ref.lon })) }
            }));
            const others = [];
            const cats = { planned: document.getElementById('ipdSepPlanned').checked, offset: document.getElementById('ipdSepOffset').checked };
            A.baseWells().forEach(x => { if(cats[x.cat]) others.push({ label: x.well.wellName, cat: x.cat, well: x.well }); });
            if(document.getElementById('ipdSepScn').checked) A.scenarioWells().forEach(w => others.push({ label: w.wellName, cat: 'scenario', well: w }));
            const vsNew = document.getElementById('ipdSepNew').checked;
            const cols = (vsNew ? news.map(x => ({ label: x.label, cat: 'new', well: x.well, isNew: true })) : []).concat(others);
            // pairs: new i vs new j (once, i<j, both directions take the min), new i vs others
            const res = news.map(() => cols.map(() => null));
            const jobs = [];
            news.forEach((a, i) => cols.forEach((c, j) => {
                if(c.isNew){ if(j > i) jobs.push([i, j]); } else jobs.push([i, j]);
            }));
            let done = 0;
            for(const [i, j] of jobs){
                if(run !== ipdRun) return;   // a newer run started
                const c = cols[j];
                let r = A.pairMinSF(news[i].well, c.well, news[i].maxMd);
                if(c.isNew){
                    const r2 = A.pairMinSF(news[j].well, news[i].well, news[j].maxMd);   // check from the other side too
                    if(r2 && (!r || r2.sf < r.sf)) r = { sf:r2.sf, c2c:r2.c2c, refMd:r2.offMd, offMd:r2.refMd, real:r2.real };
                    res[j][i] = r ? Object.assign({}, r, { refMd: r.offMd, offMd: r.refMd }) : null;   // mirror (row j, column i): swap MDs to row j's view
                }
                res[i][j] = r;
                if(++done % 15 === 0){ prog.textContent = `Computing… ${done} / ${jobs.length} pairs`; await new Promise(rs => setTimeout(rs, 0)); }
            }
            A.forget(prefix);
            prog.textContent = `${jobs.length} pairs checked.`;
            const col = sf => sf == null ? 'inherit' : sf < red ? '#ff4c4c' : sf < orange ? '#ff9f1c' : '#00e676';
            // per-well summary
            const summ = news.map((a, i) => {
                let b = null, bj = -1;
                res[i].forEach((r, j) => { if(r && (!b || r.sf < b.sf)){ b = r; bj = j; } });
                return { a, b, other: bj >= 0 ? cols[bj].label : '—' };
            });
            ipd.sepSumm = summ;   // 2026-11-01: Min SF row on the iPad preview score cards
            const nRed = summ.filter(x => x.b && x.b.sf < red).length, nOr = summ.filter(x => x.b && x.b.sf >= red && x.b.sf < orange).length;
            let html = `<div style="margin-bottom:4px;">${nRed ? `<b style="color:#ff4c4c;">${nRed} well(s) below SF ${red}</b> · ` : ''}${nOr ? `<b style="color:#ff9f1c;">${nOr} well(s) below SF ${orange}</b> · ` : ''}${(!nRed && !nOr) ? '<b style="color:#00e676;">All new wells ≥ SF ' + orange + '</b>' : ''}</div>`;
            html += `<table style="font-size:11px;font-family:var(--wbt-mono);"><tr>${['Well','Min SF','Against','C2C (m)','at MD','offset MD'].map(h => `<th style="padding:0 8px 0 0;text-align:left;">${h}</th>`).join('')}</tr>` +
                summ.map(x => `<tr><td style="padding-right:8px;">${esc(x.a.label)}</td><td style="color:${col(x.b && x.b.sf)};font-weight:700;">${x.b ? f(Math.min(x.b.sf, 99), 2) : '—'}</td><td>${esc(x.other)}</td><td>${x.b ? f(x.b.c2c, 2) : '—'}</td><td>${x.b ? f(x.b.refMd, 1) : '—'}</td><td>${x.b ? f(x.b.offMd, 1) : '—'}</td></tr>`).join('') + '</table>';
            // matrix — CHANGED 2026-11-02 (John: with the existing wells as vertical column headers the long
            // names filled the scroll box and the rows could not be seen). TRANSPOSED: rows = existing / other wells
            // (full names readable, horizontal), columns = the new pad wells (short names); header row and name column
            // are sticky; rows sorted by their lowest SF; filter "only rows below the orange SF". Excel unchanged.
            const cc = c => c.cat === 'planned' ? '#0066ff' : c.cat === 'offset' ? '#ff4c4c' : c.cat === 'scenario' ? '#00e676' : 'var(--wbt-text)';
            const mRows = cols.map((c, j) => { let mn = Infinity; news.forEach((a, i) => { const r = res[i][j]; if(r && !(c.isNew && j === i) && r.sf < mn) mn = r.sf; }); return { c, j, mn }; }).sort((x, y) => x.mn - y.mn);
            html += `<details style="margin-top:6px;" open><summary style="cursor:pointer;">Matrix (rows = wells checked against, columns = new wells; sorted by lowest SF; hover a cell for C2C / MDs)</summary>
                <label style="font-size:11px;"><input type="checkbox" id="ipdSepOnlyBad"> only rows with SF &lt; ${orange}</label>
                <div style="max-height:420px;max-width:100%;overflow:auto;margin-top:3px;">
                <table style="font-size:10px;font-family:var(--wbt-mono);border-collapse:separate;border-spacing:0;"><tr><th style="position:sticky;top:0;left:0;z-index:3;background:var(--wbt-panel,#0d131b);text-align:left;padding:2px 6px;">Well \ new well</th>${news.map(a => `<th style="position:sticky;top:0;z-index:2;background:var(--wbt-panel,#0d131b);padding:2px 4px;white-space:nowrap;">${esc(String(a.label).split(' ').pop())}</th>`).join('')}<th style="position:sticky;top:0;z-index:2;background:var(--wbt-panel,#0d131b);padding:2px 4px;">Min</th></tr>` +
                mRows.map(({ c, j, mn }) => `<tr data-ipdmn="${isFinite(mn) ? mn : 99}"><th style="position:sticky;left:0;z-index:1;background:var(--wbt-panel,#0d131b);text-align:left;padding:1px 6px;white-space:nowrap;color:${cc(c)};font-weight:400;">${esc(c.label)}</th>` + news.map((a, i) => {
                    const r = res[i][j];
                    if(c.isNew && j === i) return '<td style="background:#222;"></td>';
                    if(!r) return '<td style="padding:1px 3px;color:var(--wbt-text-dim);text-align:center;">—</td>';
                    const bg = r.sf < red ? 'rgba(255,76,76,.35)' : r.sf < orange ? 'rgba(255,159,28,.35)' : 'rgba(0,230,118,.12)';
                    return `<td title="${esc(a.label)} vs ${esc(c.label)}: SF ${f(r.sf,2)}, C2C ${f(r.c2c,2)} m at MD ${f(r.refMd,1)} (offset MD ${f(r.offMd,1)})${r.real ? '' : ' — simplified model (no toolcode/magnetics)'}" style="padding:1px 4px;text-align:center;background:${bg};">${f(Math.min(r.sf, 99), 2)}</td>`;
                }).join('') + `<td style="padding:1px 4px;text-align:center;color:${col(mn)};font-weight:700;">${isFinite(mn) ? f(Math.min(mn, 99), 2) : '—'}</td></tr>`).join('') + '</table></div></details>';
            html += `<button type="button" class="wbt-btn" id="ipdSepXls" style="margin-top:6px;">&#11015; Download Excel</button>`;
            out.innerHTML = html;
            document.getElementById('ipdSepOnlyBad').addEventListener('change', e => { out.querySelectorAll('tr[data-ipdmn]').forEach(tr => { tr.style.display = (e.target.checked && +tr.dataset.ipdmn >= orange) ? 'none' : ''; }); });   // 2026-11-02
            document.getElementById('ipdSepXls').addEventListener('click', () => {
                if(typeof XLSX === 'undefined'){ alert('Excel library not loaded.'); return; }
                const wb = XLSX.utils.book_new();
                const s1 = [['Well','Min SF','Against','C2C (m)','at MD (m)','Offset MD (m)']].concat(summ.map(x => [x.a.label, x.b ? +x.b.sf.toFixed(3) : '', x.other, x.b ? +x.b.c2c.toFixed(2) : '', x.b ? +x.b.refMd.toFixed(1) : '', x.b ? +x.b.offMd.toFixed(1) : '']));
                XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(s1), 'Summary');
                const s2 = [[''].concat(cols.map(c => c.label))].concat(news.map((a, i) => [a.label].concat(cols.map((c, j) => res[i][j] ? +res[i][j].sf.toFixed(3) : ''))));
                XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(s2), 'Min SF matrix');
                XLSX.writeFile(wb, (ipd.name || 'pad').replace(/[^\w\- ]+/g, '_') + '_separation.xlsx');
            });
        }

        async function ipdCreate(){
            const wells = (ipd.preview || []).filter(w => w.r.ok && !w.over);
            if(!wells.length) return;
            let group = ipd.name.trim() || 'Pad iPad';
            if(scenarios.some(sc => sc.group === group) && !confirm('A pad group named "' + group + '" already exists. Add these wells to it?')) return;
            const ref = WELLS.find(w => String(w._id) === String(ipd.refWell)) || WELLS[0];
            const items = wells.map(w => ({
                name: w.name, group, startMode: 'surface', wellId: ref ? String(ref._id) : '', tieMd: 0,
                start: { md:0, tvd:0, n:n(w.s.n), e:n(w.s.e), inc:0, az:0, rkb:n(w.s.ss) },
                // CHANGED 2026-11-06 (John): a back-projected iPad well is stored as an iPlan Optimum Align LIVE GROUP
                // (KOP / nudge rows, then the align + Project Back chain to the ICP, then the lateral) when the core
                // confirmed it with the Compass-validated solver (w.r.oaPlan); otherwise the plain sections (fallback).
                sections: w.r.oaPlan ? (() => { const g = 'g' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6), P = w.r.oaPlan;
                    return P.pre.map(x => Object.assign({}, x)).concat([{ kind: 'hold', cl: 0, oaG: g, oaPart: 'oa', oaDef: JSON.parse(JSON.stringify(P.def)) }], P.post.map(x => Object.assign({}, x))); })() : w.r.sections,
                targets: [{ name: w.tg.name, n:n(w.tg.n), e:n(w.tg.e), ss:n(w.tg.ss), r:15 }],
                toolcode: null
            }));
            let docs;
            try { docs = await apiJson('/notes/iplan/batch/' + NOTE_ID, 'POST', { items }); }
            catch(err){ alert('Could not create the pad: ' + err.message); return; }
            ipdClearGhosts();
            docs.forEach(doc => { const sc = fromDoc(doc); sc.visible = true; compute(sc); draw(sc); drawTargets(sc); scenarios.push(sc); });
            selId = String(docs[0]._id);
            window.dispatchEvent(new CustomEvent('iplanScenariosChanged', { detail: { group } }));
            renderList(); renderEditor(); ipdRender();
            document.getElementById('ipdOut').innerHTML = `<span style="color:#00e676;">Created ${docs.length} scenario(s) in group "${esc(group)}".</span>`;
        }
        // 2026-10-12: panel only exists for admins (EJS role check) -> skip wiring otherwise
        if(document.getElementById('ipdHead')) document.getElementById('ipdHead').addEventListener('click', () => {
            const b = document.getElementById('ipdBody');
            const open = b.style.display === 'none';
            b.style.display = open ? 'flex' : 'none';
            if(open) ipdRender();
        });

        // Load the job's saved scenarios (all inactive/unticked by default).
        apiJson('/notes/iplan/list/' + NOTE_ID, 'GET').then(list => {
            (list || []).forEach(doc => { const sc = fromDoc(doc); compute(sc); scenarios.push(sc); });
            if(scenarios.length && !selId) selId = scenarios[0].id;
            renderList(); renderEditor();
        }).catch(err => console.warn('[iPlan] could not load saved scenarios:', err));
    })();
    </script>
    <!-- ================= END iPLAN SCRIPT ================= -->
    <% if (user.role === 'admin') { %>
    <!-- ================= iLAB SCRIPT (ADDED 2026-11-09, admin only, EXPERIMENTAL) =================
         John's idea, phase 1: a 3D grid of cubes (default 10 m) centred on the surface location of
         the subject (planned) well, +/- a half-width in E and N, from surface down to the deepest
         Sub-Sea. A cube is OCCUPIED when the centre of the cube is within the clearance distance of
         any ticked trajectory (straight segments between stations, same as the profile panel's
         separation). Later phases search free paths from surface to ICP through the empty cubes.
         Self-contained: reads window.wbtSceneApi (WELLBORES, 3D group) and window.IPLAN_SCENARIOS,
         writes nothing to the server and changes no other module. To remove iLab: delete this
         script block and the "iLab" panel next to iPad. Grid is exposed as window.ILAB.grid.
         Geometry only (point-to-segment distance, grid indexing) - no drilling formulas here.
         PHASE 2 (2026-11-09): "Paths to ICP" - see the comment above pathSearch(). -->
    <script>
    (function(){
        const api = window.wbtSceneApi, head = document.getElementById('ilabHead'), body = document.getElementById('ilabBody');
        if(!api || !head || !body || !window.THREE) return;
        const num = v => { const x = parseFloat(v); return isNaN(x) ? 0 : x; };
        const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
        const f = (v, d) => (v == null || !isFinite(v)) ? '—' : Number(v).toFixed(d);
        const MAX_CELLS = 80e6, MAX_SHOW = 150000;
        const KIND = { offset:{ bit:1, lbl:'Offset wells', col:0xff3030, def:true }, subject:{ bit:2, lbl:'Subject wells', col:0x3f8cff, def:true },
                       scenario:{ bit:4, lbl:'iPlan scenarios', col:0x00e676, def:false }, ipad:{ bit:8, lbl:'iPad previews', col:0xffd060, def:false } };
        const L = { cell:10, half:2000, clear:10, top:null, bot:null, center:null, ticks:{}, grid:null, mesh:null, frame:null, show:true, showTop:null, showBot:null };
        window.ILAB = L;

        // Subject/offset rule = the 3D viewer's (wellCategory tag, else the [NN]..._LNN name pattern).
        function isSubj(w){ const wn = (w.wellName || '').trim(); if(w.wellCategory === 'subject') return true; if(w.wellCategory === 'offset') return false; return /^\[\d+\]/.test(wn) && /_L\d+$/i.test(wn); }
        // Every trajectory loaded in the job: {key, kind, name, pts:[{md,n,e,ss}]}, ss = Sub-Sea elevation (m, +up), as the 3D scene.
        function sources(){
            const out = [];
            (api.WELLBORES || []).forEach((w, i) => {
                const s = (w.survey || []).filter(r => isFinite(parseFloat(r.md))); if(s.length < 2) return;
                const pts = s.map(r => ({ md: num(r.md), n: num(r.northing), e: num(r.easting), ss: r._ss != null ? r._ss : -num(r.tvd) })), r0 = s[0];
                out.push({ key: 'w' + i, kind: isSubj(w) ? 'subject' : 'offset', name: w.wellName || ('well ' + (i + 1)), pts, wellId: w._id ? String(w._id) : null,
                    start: { md: num(r0.md), tvd: num(r0.tvd), n: num(r0.northing), e: num(r0.easting), inc: num(r0.incl), az: num(r0.azim), rkb: pts[0].ss + num(r0.tvd) } });
            });
            (window.IPLAN_SCENARIOS || []).forEach(sc => {
                const st = (sc._calc && !sc._calc.error && sc._calc.stations) || []; if(st.length < 2) return;
                out.push({ key: 's' + sc.id, kind: 'scenario', name: sc.name || 'Scenario', pts: st.map(s => ({ md: s.md, n: s.n, e: s.e, ss: s.subSea })), wellId: sc.wellId || null,
                    start: { md: st[0].md, tvd: st[0].tvd, n: st[0].n, e: st[0].e, inc: st[0].inc, az: st[0].az, rkb: st[0].subSea + st[0].tvd } });
            });
            const seen = {};
            api.getGroup().traverse(o => {
                const nm = o.userData && o.userData.pickName || '';
                if(!/\(iPad preview\)$/.test(nm) || typeof o.userData.pick !== 'function' || seen[nm]) return;
                let p = null; try { p = o.userData.pick(); } catch(e){ return; }
                if(!p || !p.rows || p.rows.length < 2) return; seen[nm] = 1;
                out.push({ key: 'p' + nm, kind: 'ipad', name: nm.replace(/ \(iPad preview\)$/, ''), pts: p.rows.map(r => ({ md: r.md, n: r.n, e: r.e, ss: r.ss })) });
            });
            return out;
        }
        function centerList(src){ return src.filter(s => s.kind === 'scenario').concat(src.filter(s => s.kind === 'subject')); }

        function render(){
            const src = sources(), cl = centerList(src);
            if(!L.center || !cl.some(s => s.key === L.center)){
                const sel = window.IPLAN_SELECTED_ID ? window.IPLAN_SELECTED_ID() : null;
                L.center = (cl.find(s => s.key === 's' + sel) || cl[0] || {}).key || null;
            }
            src.forEach(s => { if(!(s.key in L.ticks)) L.ticks[s.key] = KIND[s.kind].def; });
            const cols = Object.keys(KIND).map(k => {
                const items = src.filter(s => s.kind === k);
                return `<div style="min-width:180px;flex:1;"><div style="font-weight:700;margin-bottom:3px;"><span style="display:inline-block;width:10px;height:10px;background:#${KIND[k].col.toString(16).padStart(6,'0')};margin-right:4px;"></span>${KIND[k].lbl} (${items.length})
                    <a href="#" data-all="${k}" style="font-weight:400;margin-left:6px;">all</a> <a href="#" data-none="${k}" style="font-weight:400;">none</a></div>
                    <div style="max-height:150px;overflow:auto;">${items.map(s => `<label style="display:block;white-space:nowrap;${s.key === L.center ? 'opacity:.45;' : ''}"><input type="checkbox" data-tk="${esc(s.key)}" ${L.ticks[s.key] ? 'checked' : ''} ${s.key === L.center ? 'disabled title="Subject well of the grid (never an obstacle)"' : ''}> ${esc(s.name)}</label>`).join('') || '<span style="color:var(--wbt-text-dim);">none loaded</span>'}</div></div>`;
            }).join('');
            const g = L.grid;
            body.innerHTML = `<div style="font-size:11px;color:#ffb74d;margin-bottom:6px;">EXPERIMENTAL (admin only). Phase 1: occupancy grid. Nothing here is saved or changes other modules.</div>
                <div style="display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end;font-size:12px;">
                    <label>Subject (grid centre = its surface)<br><select data-k="center" style="max-width:260px;">${cl.map(s => `<option value="${esc(s.key)}" ${s.key === L.center ? 'selected' : ''}>${esc(s.name)}${s.kind === 'scenario' ? ' (scenario)' : ''}</option>`).join('')}</select></label>
                    <label>Cube side (m)<br><input type="number" data-k="cell" value="${L.cell}" min="1" step="any" style="width:70px;"></label>
                    <label>Half-width ± (m)<br><input type="number" data-k="half" value="${L.half}" min="1" step="any" style="width:80px;"></label>
                    <label title="A cube is occupied when its centre is within this distance of a ticked trajectory">Clearance (m)<br><input type="number" data-k="clear" value="${L.clear}" min="0" step="any" style="width:70px;"></label>
                    <label title="Blank = surface of the subject">Top Sub-Sea (m)<br><input type="number" data-k="top" value="${L.top == null ? '' : L.top}" placeholder="auto" step="any" style="width:80px;"></label>
                    <label title="Blank = deepest Sub-Sea of the subject and ticked trajectories inside the area">Bottom Sub-Sea (m)<br><input type="number" data-k="bot" value="${L.bot == null ? '' : L.bot}" placeholder="auto" step="any" style="width:80px;"></label>
                    <button type="button" class="wbt-btn" data-build>Build grid</button>
                    <button type="button" class="wbt-btn" data-clear>Clear</button>
                </div>
                <div style="display:flex;flex-wrap:wrap;gap:14px;margin-top:8px;font-size:11px;">${cols}</div>
                <div style="display:flex;flex-wrap:wrap;gap:10px;align-items:flex-end;margin-top:8px;font-size:12px;">
                    <label><input type="checkbox" data-show ${L.show ? 'checked' : ''}> Show occupied cubes in 3D</label>
                    <label>Show Sub-Sea from<br><input type="number" data-k="showTop" value="${L.showTop == null ? '' : L.showTop}" placeholder="top" step="any" style="width:80px;"></label>
                    <label>to<br><input type="number" data-k="showBot" value="${L.showBot == null ? '' : L.showBot}" placeholder="bottom" step="any" style="width:80px;"></label>
                    <button type="button" class="wbt-btn" data-redraw>Redraw</button>
                </div>
                <div data-out style="font-family:var(--wbt-mono,monospace);font-size:11px;margin-top:8px;white-space:pre-wrap;">${g ? esc(g.info) : 'No grid yet.'}</div>
                ${renderPaths()}`;
            const numOrNull = v => (String(v).trim() === '' || !isFinite(parseFloat(v))) ? null : parseFloat(v);
            body.querySelectorAll('[data-k]').forEach(el => el.addEventListener('change', () => {
                const k = el.dataset.k;
                if(k === 'center'){ L.center = el.value; render(); return; }
                if(k === 'top' || k === 'bot' || k === 'showTop' || k === 'showBot') L[k] = numOrNull(el.value);
                else { const v = parseFloat(el.value); if(isFinite(v) && v > (k === 'clear' ? -1e-9 : 0)) L[k] = v; else el.value = L[k]; }
            }));
            body.querySelectorAll('[data-tk]').forEach(el => el.addEventListener('change', () => { L.ticks[el.dataset.tk] = el.checked; }));
            body.querySelectorAll('[data-all],[data-none]').forEach(a => a.addEventListener('click', e => {
                e.preventDefault(); const k = a.dataset.all || a.dataset.none, on = !!a.dataset.all;
                src.filter(s => s.kind === k).forEach(s => { L.ticks[s.key] = on; }); render(); }));
            body.querySelector('[data-build]').addEventListener('click', () => { build(); render(); });
            body.querySelector('[data-clear]').addEventListener('click', () => { clear3D(); L.grid = null; render(); });
            body.querySelector('[data-show]').addEventListener('change', e => { L.show = e.target.checked; draw(); });
            body.querySelector('[data-redraw]').addEventListener('click', () => { draw(); render(); });
            wirePaths();
        }

        // ---------- grid ----------
        // Cell (i, j, k): i along Easting, j along Northing, k down from the top. Index = (k*ny + j)*nx + i.
        // Centre: E = x0 + (i+0.5)c, N = y0 + (j+0.5)c, SS = top - (k+0.5)c. occ[idx] = OR of KIND bits of the
        // trajectories within the clearance (so the cube colour shows what blocks it).
        // Distance from the point a + t*(dx,dy,dz), t in [0,1], to an axis-aligned box: the point-to-box distance is
        // convex and t -> point is affine, so the composition is convex in t -> golden-section search finds its minimum.
        function segBoxDist(a, dx, dy, dz, xa, xb, ya, yb, za, zb){
            const D = t => { const x = a.e + t * dx, y = a.n + t * dy, z = a.ss + t * dz;
                const ex = x < xa ? xa - x : x > xb ? x - xb : 0, ey = y < ya ? ya - y : y > yb ? y - yb : 0, ez = z < za ? za - z : z > zb ? z - zb : 0;
