                                    <label>Display</label>
                                    <select id="wbtPolyStyle">
                                        <option value="solid">Solid (fill)</option>
                                        <option value="wireframe">Wireframe</option>
                                        <option value="lines">Lines (as entered)</option>
                                    </select>
                                </div>
                                <div class="wbt-fp-field w160">
                                    <label>Excel file (Northing, Easting)</label>
                                    <input type="file" id="wbtPolyFile" accept=".xlsx,.xls,.csv">
                                </div>
                            </div>
                            <div class="wbt-fp-status" id="wbtPolyImportStatus">No file imported yet.</div>

                            <div class="wbt-fp-btns">
                                <button type="button" class="wbt-fp-btn wbt-fp-btn-add" id="wbtPolyAddBtn">+ ADD</button>
                                <button type="button" class="wbt-fp-btn wbt-fp-btn-upd" id="wbtPolyUpdBtn" disabled>UPDATE</button>
                                <button type="button" class="wbt-fp-btn wbt-fp-btn-del" id="wbtPolyDelBtn" disabled>DELETE</button>
                                <button type="button" class="wbt-fp-btn" id="wbtPolyClearBtn">CLEAR</button>
                            </div>
                            <div class="wbt-fp-status" id="wbtPolyStatus">Import an Excel file (Northing, Easting columns), enter the TVDss range and a color, then click + ADD.</div>
                            <% } else { %>
                            <div class="wbt-fp-status" style="margin-bottom:6px;">View-only — editing Polylines requires an admin, leader, or user account.</div>
                            <% } %>
                            <div class="wbt-fp-list" id="wbtPolyList"></div>
                        </div>
                        </div>
                    </div>



                    <!-- Trajectories accordion (subject wells only) -->
                    <div class="wbt-accordion-item">
                        <div class="wbt-accordion-header collapsed" id="wbtAccordionHeader">
                            <span><span class="wbt-dot" style="background:#00c8ff;box-shadow:0 0 7px #00c8ff;width:7px;height:7px;border-radius:50%;display:inline-block;margin-right:8px;"></span>Trajectories</span>
                            <span class="wbt-acc-icon">&#9660;</span>
