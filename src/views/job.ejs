// ── Build legs data server-side ──────────────────────────────────────────
function _extractWellAndLeg(wellName) {
    var wn = (wellName || '').trim();
    var bm = wn.match(/^(\[\d+\])/);
    var wellKey = bm ? bm[1] : wn;
    var lm = wn.match(/_L(\d+)$/i);
    var legNum = lm ? 'L' + lm[1].padStart(2,'0') : 'L01';
    return { well: wellKey, legNum: legNum };
}
var _wbtAll2 = (typeof wellboreTrajectories !== 'undefined' && wellboreTrajectories) ? wellboreTrajectories : [];
// Legs Summary reports SUBJECT wells only (offset wells still render in the
// 3D view). Same rule used elsewhere in this file: explicit wellCategory
// tag wins; legacy data with no tag falls back to the [NN]..._LNN naming
// convention.
function _legsIsSubject(traj){
    var wn = (traj.wellName || '').trim();
    if(traj.wellCategory === 'subject') return true;
    if(traj.wellCategory === 'offset') return false;
    return /^\[\d+\]/.test(wn) && /_L\d+$/i.test(wn);
}
var _wellMap2 = {};
_wbtAll2.forEach(function(traj) {
    if(!traj.survey || !traj.survey.length) return;
    if(!_legsIsSubject(traj)) return;
    var _p  = _extractWellAndLeg(traj.wellName || '');
    var _wk = _p.well;
    var _ln = _p.legNum;
    var _sv = traj.survey;
    var _td = _sv[_sv.length - 1];
    var _tdMD  = _td ? _td.md  : null;
    var _tdTVD = _td ? _td.tvd : null;
    if(!_wellMap2[_wk]) _wellMap2[_wk] = { legs: [] };
    // Same ICP/Landing priority as the Score Cards (wbtComputeMetrics
    // above): prefer whichever of IntermediateCasing/Landing is DEEPER
    // (not just whichever comes first in the survey), falling back to the
    // first incl >= 88 point, so a leg with only a "Landing" comment (no
    // IntermediateCasing) still gets a tie-on/lateral calculated instead
    // of showing "–".
    var _icPt = _sv.reduce(function(acc, pt) {
        if(acc) return acc;
        return /^(ICP|IntermediateCasing)/i.test((pt.comments || '').trim()) ? pt : null;
    }, null);
    var _lpPt = _sv.reduce(function(acc, pt) {
        if(acc) return acc;
        return /^Landing/i.test((pt.comments || '').trim()) ? pt : null;
    }, null);
    var _icpPt;
    if(_lpPt && (!_icPt || Number(_lpPt.md) > Number(_icPt.md))){
        _icpPt = _lpPt;
    } else if(_icPt && (!_lpPt || Number(_icPt.md) >= Number(_lpPt.md))){
        _icpPt = _icPt;
    } else {
        _icpPt = _sv.find(function(pt){ return Number(pt.incl) >= 88; }) || null;
    }
    var _stkPt = null, _stkComment = null;
    _sv.forEach(function(pt) {
        var _cm = (pt.comments || '').trim();
        if(/^STK/i.test(_cm)) { _stkPt = pt; _stkComment = _cm; } // keep overwriting → last STK wins
    });
    var _parentLabel = _stkPt ? _stkComment : (_icpPt ? 'Main' : null);
    var _tieOnMD    = _stkPt ? _stkPt.md  : (_icpPt ? _icpPt.md  : null);
    var _isLeg1     = !!_icpPt && !_stkPt;
    _wellMap2[_wk].legs.push({
        wellName:    traj.wellName || '',
        legNum:      _ln,
        parentLabel: _parentLabel,
        isLeg1:      _isLeg1,
        tieOnMD:     _tieOnMD,
        tdMD:        _tdMD,
        lateral:     (_tieOnMD !== null && _tdMD !== null)
                         ? Math.round((_tdMD - _tieOnMD) * 10) / 10
                         : null,
    });
});
var _wellsArr2 = Object.keys(_wellMap2).sort().map(function(wk) {
    var w = _wellMap2[wk];
    w.legs.sort(function(a,b){ return a.wellName.localeCompare(b.wellName); });
    var totalLateral = 0, icpMD = null;
    w.legs.forEach(function(leg) {
        if(leg.lateral !== null) totalLateral += leg.lateral;
        if(leg.isLeg1 && leg.tieOnMD !== null) icpMD = leg.tieOnMD;
    });
    totalLateral = Math.round(totalLateral * 10) / 10;
    var totalMD = (icpMD !== null) ? Math.round((icpMD + totalLateral) * 10) / 10 : null;
    return { wellKey: wk, legs: w.legs, totalLateral: totalLateral, totalMD: totalMD, icpMD: icpMD };
});
