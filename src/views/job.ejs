<script>
(function(){
    var legsEl   = document.getElementById('legsContainer');
    var empty    = document.getElementById('legsEmpty');
    var dlBtn    = document.getElementById('legsDownloadBtn');
    var dataEl   = document.getElementById('legsData');
    if(!dataEl) return;
    var wellsArr = JSON.parse(dataEl.textContent);
    if(!wellsArr.length){ if(empty) empty.style.display=''; return; }
    if(empty) empty.style.display='none';
    if(!legsEl) return;
    legsEl.innerHTML = '';

    // Sort wells by wellKey
    wellsArr.sort(function(a,b){ return a.wellKey.localeCompare(b.wellKey); });

    function fmt(v,d){
        if(v===null||v===undefined||isNaN(Number(v))) return String.fromCharCode(8212);
        return Number(v).toFixed(d);
    }

    // ── Render each well ──────────────────────────────────────────────
    wellsArr.forEach(function(well){
        var wrap = document.createElement('div');
        wrap.style.cssText = 'margin-bottom:20px;';

        // ── Header / highlights ───────────────────────────────────────
        var header = document.createElement('div');
        header.style.cssText = 'background:var(--an-panel,#111820);border:1px solid var(--an-border,#1e2d3d);border-radius:4px 4px 0 0;padding:10px 14px;display:flex;gap:14px;align-items:stretch;flex-wrap:wrap;';

        var wellLabel = document.createElement('span');
        wellLabel.style.cssText = 'font-weight:700;font-size:14px;letter-spacing:1px;color:var(--an-text-bright,#e8f4ff);align-self:center;margin-right:6px;';
        wellLabel.textContent = well.wellKey;
        header.appendChild(wellLabel);

        function makeChip(label, value, bg, fg){
            var chip = document.createElement('div');
            chip.style.cssText = 'background:'+bg+';color:'+fg+';border-radius:4px;padding:6px 14px;display:flex;flex-direction:column;align-items:center;min-width:130px;user-select:all;cursor:text;';
            var lbl = document.createElement('div');
            lbl.style.cssText = 'font-size:9px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;opacity:0.85;margin-bottom:2px;';
            lbl.textContent = label;
            var val = document.createElement('div');
            val.style.cssText = 'font-size:16px;font-weight:700;font-family:monospace;letter-spacing:0.5px;';
            val.textContent = value;
            chip.appendChild(lbl);
            chip.appendChild(val);
            return chip;
        }

        header.appendChild(makeChip('Total Lateral', fmt(well.totalLateral,1)+' m', 'var(--an-accent,#00c8ff)', '#000'));
        if(well.totalMD !== null)
            header.appendChild(makeChip('Total MD', fmt(well.totalMD,1)+' m', 'var(--an-accent2,#ff6b35)', '#fff'));
        if(well.icpMD !== null)
            header.appendChild(makeChip('Tie-on MD', fmt(well.icpMD,1)+' m', 'var(--an-panel2,#161e28)', 'var(--an-text,#c8d8e8)'));

        wrap.appendChild(header);

        // ── Table ─────────────────────────────────────────────────────
        var tableWrap = document.createElement('div');
        tableWrap.style.cssText = 'overflow-x:auto;';
        var table = document.createElement('table');
        table.className = 'table table-dark table-hover table-bordered table-sm mb-0';
        table.style.fontSize = '11px';
        table.dataset.wellKey = well.wellKey;

        var thead = document.createElement('thead');
        var trh = document.createElement('tr');
        ['Wellbore','Parent / Tie-on','Tie-on MD (m)','TD MD (m)','Lateral (m)'].forEach(function(h){
            var th = document.createElement('th'); th.textContent = h; trh.appendChild(th);
        });
        thead.appendChild(trh);
        table.appendChild(thead);

        var tbody = document.createElement('tbody');
        // Sort legs by wellName
        well.legs.sort(function(a,b){ return a.wellName.localeCompare(b.wellName); });
        well.legs.forEach(function(leg){
            var tr = document.createElement('tr');
            if(leg.isLeg1) tr.style.borderLeft = '3px solid var(--an-accent,#00c8ff)';
            [
                leg.wellName,
                leg.parentLabel || String.fromCharCode(8212),
                leg.tieOnMD !== null ? fmt(leg.tieOnMD,1) : String.fromCharCode(8212),
                fmt(leg.tdMD,1),
                fmt(leg.lateral,1),
            ].forEach(function(val){
                var td = document.createElement('td'); td.textContent = val; tr.appendChild(td);
            });
            tbody.appendChild(tr);
        });
        table.appendChild(tbody);
        tableWrap.appendChild(table);
        wrap.appendChild(tableWrap);
        legsEl.appendChild(wrap);
    });

    // ── Enable download button ────────────────────────────────────────
    if(dlBtn) dlBtn.disabled = false;

    // ── Excel download ────────────────────────────────────────────────
    if(dlBtn){
        dlBtn.addEventListener('click', function(){
            if(typeof XLSX === 'undefined'){ alert('Excel library not loaded.'); return; }
            var wb = XLSX.utils.book_new();

            wellsArr.forEach(function(well){
                // Sheet name: sanitise wellKey
                var sheetName = well.wellKey.replace(/[\[\]\*\/\\\?:]/g,'').slice(0,31) || 'Well';

                var aoa = [];
                // Highlight rows
                aoa.push(['Total Lateral (m)', well.totalLateral]);
                if(well.totalMD !== null) aoa.push(['Total MD (m)', well.totalMD]);
                if(well.icpMD  !== null) aoa.push(['Tie-on MD (m)', well.icpMD]);
                aoa.push([]);
                // Table header
                aoa.push(['Wellbore','Parent / Tie-on','Tie-on MD (m)','TD MD (m)','Lateral (m)']);
                // Rows
                well.legs.forEach(function(leg){
                    aoa.push([
                        leg.wellName,
                        leg.parentLabel || '',
                        leg.tieOnMD !== null ? leg.tieOnMD : '',
                        leg.tdMD !== null ? leg.tdMD : '',
                        leg.lateral !== null ? leg.lateral : '',
                    ]);
                });

                var ws = XLSX.utils.aoa_to_sheet(aoa);

                // Style highlight rows cyan/orange
                var range = XLSX.utils.decode_range(ws['!ref']);
                // Rows 0-2 are highlights — bold them
                [0,1,2].forEach(function(r){
                    var cellA = XLSX.utils.encode_cell({r:r,c:0});
                    var cellB = XLSX.utils.encode_cell({r:r,c:1});
                    if(ws[cellA]) ws[cellA].s = {font:{bold:true},fill:{fgColor:{rgb:'00C8FF'}}};
                    if(ws[cellB]) ws[cellB].s = {font:{bold:true}};
                });
                // Header row (row 4 = index 4)
                for(var ci=0; ci<=4; ci++){
                    var hCell = XLSX.utils.encode_cell({r:4,c:ci});
                    if(ws[hCell]) ws[hCell].s = {font:{bold:true},fill:{fgColor:{rgb:'1E2D3D'}}};
                }
                // Column widths
                ws['!cols'] = [{wch:30},{wch:20},{wch:14},{wch:12},{wch:12}];

                XLSX.utils.book_append_sheet(wb, ws, sheetName);
            });

            XLSX.writeFile(wb, 'legs_summary.xlsx');
        });
    }
})();
</script>
<!-- ================= END LEGS SUMMARY SCRIPT ================= -->

<!-- ================= PASON EDR PLOTS SCRIPT ================= -->
<script>
(function(){
    const PASON_NOTE_ID = "<%- note._id %>";

    // Same 7 plots / titles / units as uploadPason.ejs, so the viewer here
    // matches the source page exactly. Colours also match: Avg=cyan,
    // Max=green, Min=red.
    const PLOT_REGISTRY = [
        { id:'td',   name:'Hole Depth vs Time (days)',   xTitle:'Time (days from start)',  yTitle:'Hole Depth (m)',   reversedY:true  },
        { id:'hl',   name:'Hook Load vs Measured Depth', xTitle:'Measured Depth (m)',      yTitle:'Hook Load (kDaN)', reversedY:false },
        { id:'tq',   name:'Torque vs Measured Depth',    xTitle:'Measured Depth (m)',      yTitle:'Torque (kN·m)',    reversedY:false },
        { id:'wob',  name:'WOB vs Measured Depth',       xTitle:'Measured Depth (m)',      yTitle:'WOB (kDaN)',       reversedY:false },
        { id:'rop',  name:'ROP vs Measured Depth',       xTitle:'Measured Depth (m)',      yTitle:'ROP (m/h)',        reversedY:false },
        { id:'mse',  name:'MSE vs Measured Depth',       xTitle:'Measured Depth (m)',      yTitle:'MSE (ksi)',        reversedY:false },
        { id:'flow', name:'Flow vs Measured Depth',      xTitle:'Measured Depth (m)',      yTitle:'Flow (m³/min)',    reversedY:false },
    ];
    const SHEET_NAME_TO_ID = { 'hook load':'hl', 'torque':'tq', 'wob':'wob', 'rop':'rop', 'mse':'mse', 'flow':'flow', 'hole depth vs time':'td' };

    let _plots = null;      // { hl: {xHeader, rows}, tq: {...}, ... }
    let _chart = null;

    const el = id => document.getElementById(id);

    function setStatus(msg){ const s = el('pasonPlotsStatus'); if(s) s.textContent = msg; }

    // ── Load existing data on page open ─────────────────────────────────
    function loadFromEmbedded(){
        const dataEl = el('pasonPlotsData');
        if(!dataEl) return;
        let doc;
        try { doc = JSON.parse(dataEl.textContent); } catch(e){ return; }
        if(!doc || !doc.plots || !Object.keys(doc.plots).length) return;
        _plots = doc.plots;
        showViewer();
        const meta = el('pasonPlotsMeta');
        if(meta){
            const when = doc.uploadedAt ? new Date(doc.uploadedAt).toLocaleString() : '';
            meta.textContent = `Uploaded ${when}` + (doc.user ? '' : '');
        }
    }

    function populateDropdown(){
        const sel = el('pasonPlotSelect');
        if(!sel) return;
        sel.innerHTML = '';
        PLOT_REGISTRY.forEach(p => {
            if(!_plots[p.id]) return; // only list plots that actually have data
            const opt = document.createElement('option');
            opt.value = p.id;
            opt.textContent = p.name;
            sel.appendChild(opt);
        });
        // Default: Hook Load vs Measured Depth if present, else first available
        sel.value = _plots['td'] ? 'td' : (sel.options[0] ? sel.options[0].value : '');
    }

    function showViewer(){
        populateDropdown();
        const sel = el('pasonPlotSelect');
        if(!sel || !sel.value){ return; } // nothing to show
        el('pasonPlotsViewer').style.display = '';
        el('pasonPlotsEmpty').style.display = 'none';
        renderPasonChart(sel.value);
    }

    function renderPasonChart(plotId){
        const plotDef = PLOT_REGISTRY.find(p => p.id === plotId);
        const data = _plots && _plots[plotId];
        const canvas = el('pasonChart');
        if(!plotDef || !data || !canvas) return;

        if(_chart){ try{ _chart.destroy(); }catch(e){} _chart = null; }

        const isLight = document.body.classList.contains('light-mode');
        const wrap = el('pasonChartWrap');
        if(wrap) wrap.style.background = isLight ? '#ffffff' : '#1b1e21';
        const textColor = isLight ? '#212529' : '#e9ecef';
        const tickColor = isLight ? '#495057' : '#adb5bd';
        const gridColor = isLight ? 'rgba(0,0,0,0.12)' : 'rgba(173,181,189,0.2)';

        const rows = data.rows || [];
        const avgPts = [], maxPts = [], minPts = [];
        rows.forEach(r => {
            const x = r[0];
            if(r[1] !== '' && r[1] !== null && r[1] !== undefined) avgPts.push({x, y:r[1]});
            if(r[2] !== '' && r[2] !== null && r[2] !== undefined) maxPts.push({x, y:r[2]});
            if(r[3] !== '' && r[3] !== null && r[3] !== undefined) minPts.push({x, y:r[3]});
        });

        const datasets = [];
        // For "Hole Depth vs Time (days)" specifically, only the Calculated
        // Time vs Depth curve is shown — the raw Min/Max/Average lines from
        // the EDR export aren't meaningful for a planned-trajectory view.
        if(plotId !== 'td'){
            if(minPts.length) datasets.push({ label:'Min', data:minPts, borderColor:'#ff0000', backgroundColor:'#ff0000', showLine:true, borderWidth:2, pointRadius:0, fill:false, tension:0.25 });
            if(maxPts.length) datasets.push({ label:'Max', data:maxPts, borderColor:'#00ff00', backgroundColor:'#00ff00', showLine:true, borderWidth:2, pointRadius:0, fill:false, tension:0.25 });
            if(avgPts.length) datasets.push({ label:'Average', data:avgPts, borderColor:'#00e5ff', backgroundColor:'#00e5ff', showLine:true, borderWidth:2, pointRadius:0, fill:false, tension:0.25 });
        }

        // Optional: imported raw rig X,Y data for this plot, shown as dots.
        const raw = data.raw;
        const dotSizeRow = el('pasonDotSizeRow');
        if(raw && raw.points && raw.points.length){
            const pointSize = raw.pointSize || 3;
            datasets.push({
                label: 'Raw X,Y', data: raw.points.map(p => ({x:p[0], y:p[1]})),
                showLine:false, pointRadius: pointSize, pointHoverRadius: pointSize+2,
                borderColor:'#ffa500', backgroundColor:'#ffa500',
            });
            if(dotSizeRow){
                dotSizeRow.style.display = '';
                const slider = el('pasonDotSizeSlider'), val = el('pasonDotSizeVal');
                if(slider){ slider.value = pointSize; }
                if(val){ val.textContent = pointSize; }
            }
        } else if(dotSizeRow){
            dotSizeRow.style.display = 'none';
        }

        // Optional: calculated Time vs Depth curve (only meaningful for 'td' plot).
        // Reads a saved per-well curve if one exists; otherwise auto-computes
        // an ephemeral, view-only preview (using default pause values, never
        // saved to MongoDB) so anyone — including viewer — can explore any
        // well's planned Time vs Depth just by selecting it.
        const tdWellSel = el('pasonTDWellSelect');
        const selectedWellKey = tdWellSel && tdWellSel.value;
        const tdCalcRow = el('pasonTDCalcRow');
        if(tdCalcRow) tdCalcRow.style.display = (plotId === 'td') ? '' : 'none';

        let calc = null, isPreview = false;
        if(plotId === 'td' && selectedWellKey){
            const savedByWell = data.calculatedByWell && data.calculatedByWell[selectedWellKey];
            if(savedByWell){
                calc = savedByWell;
            } else if(typeof calculateTimeVsDepth === 'function'){
                const previewResult = calculateTimeVsDepth(selectedWellKey, 0.15, 1.0);
                if(!previewResult.error){
                    calc = { points: previewResult.points };
                    isPreview = true;
                }
            }
        }
        const tdPreviewNote = el('pasonTDPreviewNote');
        if(tdPreviewNote) tdPreviewNote.style.display = (plotId === 'td' && isPreview) ? '' : 'none';

        if(plotId === 'td' && calc && calc.points && calc.points.length){
            datasets.push({
                label: isPreview ? 'Calculated Time vs Depth (preview, unsaved)' : 'Calculated Time vs Depth',
                data: calc.points.map(p => ({x:p[0], y:p[1]})),
                showLine:true, pointRadius:0, borderWidth:2, borderDash:[6,3], fill:false, tension:0,
                borderColor:'#b264ff', backgroundColor:'#b264ff',
            });
        }

        const ctx = canvas.getContext('2d');
        _chart = new Chart(ctx, {
            type: 'line',
            data: { datasets },
            options: {
                responsive: true,
                plugins: {
                    legend: { display:true, labels:{ color:textColor } },
                    tooltip: {
                        mode:'nearest', intersect:false,
                        callbacks: { label: (ctx) => {
                            const y = ctx.parsed.y, x = ctx.parsed.x;
                            const name = ctx.dataset.label || 'Series';
                            const xf = Number.isFinite(x) ? x.toFixed(2) : '—';
                            const yf = Number.isFinite(y) ? y.toFixed(2) : '—';
                            return `${name}: ${yf} @ ${xf}`;
                        }}
                    },
                    zoom: { pan:{enabled:true, mode:'xy'}, zoom:{ wheel:{enabled:true, modifierKey:'ctrl'}, pinch:{enabled:true}, mode:'xy' } }
                },
                scales: {
                    x: { type:'linear', title:{display:true, text:plotDef.xTitle, color:textColor}, ticks:{color:tickColor}, grid:{color:gridColor} },
                    y: { type:'linear', reverse: !!plotDef.reversedY, title:{display:true, text:plotDef.yTitle, color:textColor}, ticks:{color:tickColor}, grid:{color:gridColor} },
                }
            }
        });
    }

    // ── Upload + parse xlsx (admin/leader/user only) ─────────────────────
    const fileInput = el('pasonPlotsFileInput');
    const uploadBtn = el('pasonPlotsUploadBtn');
    let _parsedForUpload = null;

    if(fileInput){
        fileInput.addEventListener('change', function(e){
            const file = e.target.files[0];
            if(!file) return;
            uploadBtn.disabled = true;
            _parsedForUpload = null;
            setStatus('Reading file…');
            const reader = new FileReader();
            reader.onload = function(ev){
                try {
                    const wb = XLSX.read(ev.target.result, { type:'array' });
                    const plots = {};
                    wb.SheetNames.forEach(sheetName => {
                        const id = SHEET_NAME_TO_ID[sheetName.trim().toLowerCase()];
                        if(!id) return; // unrecognised sheet — skip
                        const ws = wb.Sheets[sheetName];
                        const aoa = XLSX.utils.sheet_to_json(ws, { header:1, defval:'' });
                        if(aoa.length < 2) return;
                        const xHeader = aoa[0][0] || 'X';
                        const rows = aoa.slice(1)
                            .filter(r => r.length && r[0] !== '' && r[0] !== null && r[0] !== undefined)
                            .map(r => [Number(r[0]), r[1]===''?'':Number(r[1]), r[2]===''?'':Number(r[2]), r[3]===''?'':Number(r[3])]);
                        plots[id] = { xHeader, rows };
                    });
                    if(!Object.keys(plots).length){
                        setStatus('⚠ No recognised plot sheets found in this file. Expected sheet names: Hook Load, Torque, WOB, ROP, MSE, Flow, Hole Depth vs Time.');
                        return;
                    }
                    _parsedForUpload = plots;
                    setStatus(`✅ Parsed ${Object.keys(plots).length} plot(s). Click Save to store.`);
                    uploadBtn.disabled = false;
                } catch(err){
                    console.error(err);
                    setStatus('❌ Parse error: ' + err.message);
                }
            };
            reader.readAsArrayBuffer(file);
        });
    }

    if(uploadBtn){
        uploadBtn.addEventListener('click', async function(){
            if(!_parsedForUpload) return;
            setStatus('Saving…');
            uploadBtn.disabled = true;
            try {
                const res = await fetch('/notes/pasonPlots/' + PASON_NOTE_ID, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ noteId: PASON_NOTE_ID, plots: _parsedForUpload }),
                });
                const data = await res.json();
                if(res.ok){
                    setStatus(`✅ Saved ${data.plotCount} plot(s) to this job.`);
                    _plots = _parsedForUpload;
                    showViewer();
                } else {
                    setStatus('❌ Save failed: ' + (data.error || res.statusText));
                    uploadBtn.disabled = false;
                }
            } catch(err){
                setStatus('❌ Error: ' + err.message);
                uploadBtn.disabled = false;
            }
        });
    }

    // ── Import raw X,Y (dots) for the currently selected plot ────────────
    const rawFileInput = el('pasonRawXYFileInput');
    const rawImportBtn = el('pasonRawXYImportBtn');
    let _parsedRawXY = null;

    async function persistPlots(successMsg){
        const res = await fetch('/notes/pasonPlots/' + PASON_NOTE_ID, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ noteId: PASON_NOTE_ID, plots: _plots }),
        });
        const data = await res.json();
        if(res.ok){ setStatus(successMsg); return true; }
        setStatus('❌ Save failed: ' + (data.error || res.statusText));
        return false;
    }

    if(rawFileInput){
        rawFileInput.addEventListener('change', function(e){
            const file = e.target.files[0];
            if(!file) return;
            rawImportBtn.disabled = true;
            _parsedRawXY = null;
            const rawStatus = el('pasonRawXYStatus');
            if(rawStatus) rawStatus.textContent = 'Reading file…';
            const reader = new FileReader();
            reader.onload = function(ev){
                try {
                    const wb = XLSX.read(ev.target.result, { type:'array' });
                    const ws = wb.Sheets[wb.SheetNames[0]];
                    const aoa = XLSX.utils.sheet_to_json(ws, { header:1, defval:'' });
                    if(aoa.length < 2) throw new Error('File has no data rows.');
                    const points = aoa.slice(1)
                        .filter(r => r.length >= 2 && r[0] !== '' && r[1] !== '' && r[0] !== null && r[1] !== null)
                        .map(r => [Number(r[0]), Number(r[1])])
                        .filter(p => Number.isFinite(p[0]) && Number.isFinite(p[1]));
                    if(!points.length) throw new Error('No valid numeric X,Y rows found.');
                    _parsedRawXY = points;
                    if(rawStatus) rawStatus.textContent = `✅ Parsed ${points.length} points. Click Import to add as dots.`;
                    rawImportBtn.disabled = false;
                } catch(err){
                    if(rawStatus) rawStatus.textContent = '❌ ' + err.message;
                }
            };
            reader.readAsArrayBuffer(file);
        });
    }

    if(rawImportBtn){
        rawImportBtn.addEventListener('click', async function(){
            if(!_parsedRawXY || !_plots) return;
            const sel = el('pasonPlotSelect');
            const plotId = sel && sel.value;
            if(!plotId){ return; }
            const rawStatus = el('pasonRawXYStatus');
            if(rawStatus) rawStatus.textContent = 'Saving…';
            rawImportBtn.disabled = true;

            if(!_plots[plotId]) _plots[plotId] = { xHeader:'X', rows:[] };
            const existingPointSize = (_plots[plotId].raw && _plots[plotId].raw.pointSize) || 3;
            _plots[plotId].raw = { points: _parsedRawXY, pointSize: existingPointSize };

            const ok = await persistPlots(`✅ Imported ${_parsedRawXY.length} X,Y points for this plot.`);
            if(ok){
                if(rawStatus) rawStatus.textContent = `✅ Imported ${_parsedRawXY.length} points and saved.`;
                renderPasonChart(plotId);
            } else {
                rawImportBtn.disabled = false;
            }
        });
    }

    const removeRawBtn = el('pasonRawXYRemoveBtn');
    if(removeRawBtn){
        removeRawBtn.addEventListener('click', async function(){
            const sel = el('pasonPlotSelect');
            const plotId = sel && sel.value;
            if(!plotId || !_plots || !_plots[plotId] || !_plots[plotId].raw) return;
            if(!confirm('Remove the imported X,Y dots for this plot?')) return;
            delete _plots[plotId].raw;
            const ok = await persistPlots('✅ Removed imported dots and saved.');
            if(ok) renderPasonChart(plotId);
        });
    }

    const dotSizeSlider = el('pasonDotSizeSlider');
    if(dotSizeSlider){
        // Live-update the dot size as the slider is dragged (no server call).
        dotSizeSlider.addEventListener('input', function(){
            const val = Number(dotSizeSlider.value);
            const valLabel = el('pasonDotSizeVal');
            if(valLabel) valLabel.textContent = val;
            if(_chart){
                const ds = _chart.data.datasets.find(d => d.label === 'Raw X,Y');
                if(ds){ ds.pointRadius = val; ds.pointHoverRadius = val + 2; _chart.update('none'); }
            }
        });
        // Persist the chosen size once the user releases the slider.
        dotSizeSlider.addEventListener('change', async function(){
            const sel = el('pasonPlotSelect');
            const plotId = sel && sel.value;
            if(!plotId || !_plots || !_plots[plotId] || !_plots[plotId].raw) return;
            _plots[plotId].raw.pointSize = Number(dotSizeSlider.value);
            await persistPlots('✅ Dot size saved.');
        });
    }

    // ── Calculated Time vs Depth (uses planned trajectory + ROP average) ──
    // Reuses the same well-grouping / leg-numbering / STK-detection
    // conventions already established in the Legs Summary feature, applied
    // client-side here since this script runs independently of that one.
    function tdExtractWellAndLeg(wellName){
        var wn = (wellName || '').trim();
        var bm = wn.match(/^(\[\d+\])/);
        var wellKey = bm ? bm[1] : wn;
        var lm = wn.match(/_L(\d+)$/i);
        var legNum = lm ? 'L' + lm[1].padStart(2,'0') : 'L01';
        return { well: wellKey, legNum: legNum };
    }

    // Same logic as wbtIsSubjectWell in the 3D viewer script (duplicated here
    // since this script block runs independently): explicit wellCategory tag
    // takes priority; untagged legacy wells fall back to the name pattern.
    function tdIsSubjectWell(well){
        var wn = (well.wellName || '').trim();
        if(well.wellCategory === 'subject') return true;
        if(well.wellCategory === 'offset') return false;
        return /^\[\d+\]/.test(wn) && /_L\d+$/i.test(wn);
    }

    function getTrajectoryWellGroups(){
        var dataEl = el('wbtData');
        if(!dataEl) return { wells: {}, keys: [] };
        var wbtArr;
        try { wbtArr = JSON.parse(dataEl.textContent); } catch(e){ return { wells: {}, keys: [] }; }

        var wells = {}; // wellKey -> array of { traj, legNum }
        wbtArr.forEach(function(traj){
            if(!traj.survey || !traj.survey.length) return;
            if(!tdIsSubjectWell(traj)) return;
            var p = tdExtractWellAndLeg(traj.wellName || '');
            if(!wells[p.well]) wells[p.well] = [];
            wells[p.well].push({ traj: traj, legNum: p.legNum });
        });
        Object.keys(wells).forEach(function(k){
            wells[k].sort(function(a,b){ return a.legNum.localeCompare(b.legNum); });
        });
        var keys = Object.keys(wells).sort();
        return { wells: wells, keys: keys };
    }

    function populateTDWellDropdown(){
        var sel = el('pasonTDWellSelect');
        if(!sel) return;
        var groups = getTrajectoryWellGroups();
        sel.innerHTML = '';
        if(!groups.keys.length){
            var opt = document.createElement('option');
            opt.value = ''; opt.textContent = 'No trajectory uploaded';
            sel.appendChild(opt);
            return;
        }
        groups.keys.forEach(function(k){
            var opt = document.createElement('option');
            opt.value = k; opt.textContent = k;
            sel.appendChild(opt);
        });

        // Prefer a well that already has a saved Calculated Time vs Depth
        // curve, so the user sees what was saved rather than an arbitrary
        // well. Falls back to alphabetically first (which will show an
        // ephemeral preview) if no well has been saved yet.
        var savedWellKey = null;
        var dataEl = el('pasonPlotsData');
        if(dataEl){
            try {
                var doc = JSON.parse(dataEl.textContent);
                var byWell = doc && doc.plots && doc.plots['td'] && doc.plots['td'].calculatedByWell;
                if(byWell){
                    savedWellKey = groups.keys.find(function(k){ return !!byWell[k]; }) || null;
                }
            } catch(e){}
        }
        sel.value = savedWellKey || groups.keys[0];
    }

    // Build per-leg milestone info: SurfaceCasing / IntermediateCasing (Leg1
    // only) / STK tie-on (sidetracks only) / TD, matching the exact same
    // comment-keyword detection used by the scorecards and Legs Summary.
    function tdBuildLegInfo(legEntry){
        var sv = legEntry.traj.survey;
        var td = sv[sv.length - 1];

        var scPt = null, icpPt = null, stkPt = null, stkComment = null;
        sv.forEach(function(pt){
            var cm = (pt.comments || '').trim();
            if(!cm) return;
            if(!scPt && /^SURFACECASING/i.test(cm.replace(/\s+/g,''))) scPt = pt;
            if(!icpPt && /^(ICP|IntermediateCasing)/i.test(cm)) icpPt = pt;
            if(/^STK/i.test(cm)){ stkPt = pt; stkComment = cm; } // last STK wins, matching Legs Summary
        });

        return {
            legNum: legEntry.legNum,
            wellName: legEntry.traj.wellName,
            scMD: scPt ? Number(scPt.md) : null,
            icpMD: icpPt ? Number(icpPt.md) : null,
            stkMD: stkPt ? Number(stkPt.md) : null,
            tdMD: Number(td.md),
        };
    }

    // Average the ROP-vs-Measured-Depth "Average" curve's y-values across
    // [mdStart, mdEnd]. Returns null (no fabricated fallback) if the ROP
    // plot hasn't been uploaded or has no points in that range.
    function averageROPInRange(mdStart, mdEnd){
        var ropData = _plots && _plots['rop'];
        if(!ropData || !ropData.rows || !ropData.rows.length) return null;
        var lo = Math.min(mdStart, mdEnd), hi = Math.max(mdStart, mdEnd);
        var sum = 0, count = 0;
        ropData.rows.forEach(function(r){
            var md = Number(r[0]), avg = r[1];
            if(avg === '' || avg === null || avg === undefined) return;
            if(md >= lo && md <= hi){ sum += Number(avg); count++; }
        });
        return count ? (sum / count) : null;
    }

    function calculateTimeVsDepth(wellKey, pauseDefault, pauseIC){
        var groups = getTrajectoryWellGroups();
        var legs = groups.wells[wellKey];
        if(!legs || !legs.length) return { error: 'No trajectory found for well ' + wellKey + '.' };

        var legInfos = legs.map(tdBuildLegInfo);
        var points = [];
        var t = 0; // cumulative time, days
        points.push([0, 0]);

        // ── Leg 1: surface → SurfaceCasing → IntermediateCasing → Leg1 TD ──
        var leg1 = legInfos[0];
        var prevMD = 0;
        var milestones1 = [];
        if(leg1.scMD !== null) milestones1.push({ md: leg1.scMD, pause: pauseDefault, label:'SurfaceCasing' });
        if(leg1.icpMD !== null) milestones1.push({ md: leg1.icpMD, pause: pauseIC, label:'IntermediateCasing' });
        milestones1.push({ md: leg1.tdMD, pause: pauseDefault, label:'Leg1 TD' });

        for(var i=0; i<milestones1.length; i++){
            var m = milestones1[i];
            var rop = averageROPInRange(prevMD, m.md);
            if(rop === null || rop <= 0){
                return { error: 'No ROP Average data found between MD ' + prevMD.toFixed(0) + ' and ' + m.md.toFixed(0) + ' m — upload/verify the ROP vs Measured Depth plot first.' };
            }
            var distance = m.md - prevMD;
            var hours = distance / rop;
            var days = hours / 24;
            t += days;
            points.push([t, m.md]);       // arrival at milestone
            t += m.pause;
            points.push([t, m.md]);       // pause (flat)
            prevMD = m.md;
        }

        // ── Subsequent legs: trip back to STK MD, pause, drill to leg TD ──
        for(var li=1; li<legInfos.length; li++){
            var leg = legInfos[li];
            if(leg.stkMD === null){
                return { error: 'No STK tie-on point found for ' + leg.wellName + ' — cannot determine where this sidetrack ties in.' };
            }
            // Trip back (depth-only jump, no drilling — takes pauseDefault)
            t += pauseDefault;
            points.push([t, leg.stkMD]);
            // Pause at STK before drilling the new leg
            t += pauseDefault;
            points.push([t, leg.stkMD]);

            // Drill STK MD → this leg's TD
            var rop2 = averageROPInRange(leg.stkMD, leg.tdMD);
            if(rop2 === null || rop2 <= 0){
                return { error: 'No ROP Average data found between MD ' + leg.stkMD.toFixed(0) + ' and ' + leg.tdMD.toFixed(0) + ' m for ' + leg.wellName + '.' };
            }
            var distance2 = leg.tdMD - leg.stkMD;
            var hours2 = distance2 / rop2;
            var days2 = hours2 / 24;
            t += days2;
            points.push([t, leg.tdMD]);
            t += pauseDefault;
            points.push([t, leg.tdMD]);
        }

        return { points: points };
    }

    // Populate the well dropdown once, and wire the Calculate button.
    populateTDWellDropdown();
    const tdWellSelectEl = el('pasonTDWellSelect');
    if(tdWellSelectEl){
        tdWellSelectEl.addEventListener('change', function(){
            const sel = el('pasonPlotSelect');
            if(sel && sel.value === 'td') renderPasonChart('td');
        });
    }

    const tdCalcBtn = el('pasonTDCalcBtn');
    if(tdCalcBtn){
        tdCalcBtn.addEventListener('click', async function(){
            const wellSel = el('pasonTDWellSelect');
            const wellKey = wellSel && wellSel.value;
            const pauseDefault = Number(el('pasonTDPauseDefault').value) || 0.15;
            const pauseIC = Number(el('pasonTDPauseIC').value) || 1.0;
            const calcStatus = el('pasonTDCalcStatus');
            if(!wellKey){ if(calcStatus) calcStatus.textContent = '⚠ No well selected.'; return; }

            if(calcStatus) calcStatus.textContent = 'Calculating…';
            tdCalcBtn.disabled = true;

            const result = calculateTimeVsDepth(wellKey, pauseDefault, pauseIC);
            if(result.error){
                if(calcStatus) calcStatus.textContent = '❌ ' + result.error;
                tdCalcBtn.disabled = false;
                return;
            }

            if(!_plots['td']) _plots['td'] = { xHeader:'Time_days', rows: [] };
            if(!_plots['td'].calculatedByWell) _plots['td'].calculatedByWell = {};
            _plots['td'].calculatedByWell[wellKey] = { points: result.points, pauseDefault: pauseDefault, pauseIC: pauseIC };

            const ok = await persistPlots('✅ Calculated Time vs Depth for ' + wellKey + ' and saved.');
            tdCalcBtn.disabled = false;
            if(ok){
                if(calcStatus) calcStatus.textContent = '✅ Saved (' + result.points.length + ' points).';
                renderPasonChart('td');
            }
        });
    }


    // ── Dropdown + zoom reset ─────────────────────────────────────────────
    const selectEl = el('pasonPlotSelect');
    if(selectEl) selectEl.addEventListener('change', () => renderPasonChart(selectEl.value));

    const resetZoomBtn = el('pasonZoomResetBtn');
    if(resetZoomBtn) resetZoomBtn.addEventListener('click', () => { if(_chart && _chart.resetZoom) _chart.resetZoom(); });

    window.addEventListener('mtxThemeChange', function(){
        const sel = el('pasonPlotSelect');
        if(sel && sel.value) renderPasonChart(sel.value);
    });

    loadFromEmbedded();
})();
</script>
<!-- ================= END PASON EDR PLOTS SCRIPT ================= -->

<!-- ================= TORQUE & DRAG MODEL SCRIPT (read-only + live recalc) ================= -->
<script>
(function(){
    const PASON_NOTE_ID = "<%- note._id %>";
    // The T&D accordion is now available to every role. This guard just
    // protects against the element genuinely being absent for any reason.
    if(!document.getElementById('tdWellSelect2')) return;
    const dataEl = document.getElementById('tdModelData');
    if(!dataEl){ console.log('[T&D] #tdModelData element not found on this page.'); return; }
    let tdDoc;
    try { tdDoc = JSON.parse(dataEl.textContent); } catch(e){ console.error('[T&D] Failed to parse tdModelData JSON:', e); tdDoc = null; }
    if(tdDoc && !tdDoc.resultsByWell) tdDoc.resultsByWell = {};
    console.log('[T&D] tdModel loaded:', tdDoc ? { wellsWithResults: Object.keys(tdDoc.resultsByWell || {}) } : null);

    // Same bracket-prefix + _LNN subject-well convention used everywhere else.
    function tdIsSubjectWell(well){
        var wn = (well.wellName || '').trim();
        if(well.wellCategory === 'subject') return true;
        if(well.wellCategory === 'offset') return false;
        return /^\[\d+\]/.test(wn) && /_L\d+$/i.test(wn);
    }
    function getSubjectWellKeys(){
        var dataEl2 = document.getElementById('wbtData');
        if(!dataEl2) return [];
        var wbtArr;
        try { wbtArr = JSON.parse(dataEl2.textContent); } catch(e){ return []; }
        return wbtArr.filter(function(w){ return w.survey && w.survey.length && tdIsSubjectWell(w); })
                      .map(function(w){ return w.wellName; })
                      .sort();
    }

    const isLight = document.body.classList.contains('light-mode');
    const tdTextColor = isLight ? '#000000' : '#ffffff';
    const tdTickColor = isLight ? '#495057' : '#ffffff';
    const tdGridColor = isLight ? 'rgba(0,0,0,.15)' : 'rgba(30,45,61,.6)';
    const tdTooltipBg = isLight ? '#ffffff' : '#161e28';
    const tdTooltipBorder = isLight ? '#c8d4de' : '#1e2d3d';
    const tdWrapEl = document.getElementById('tdChartsWrap');
    if(tdWrapEl) tdWrapEl.style.background = isLight ? '#ffffff' : '#1b1e21';

    const CO = {
        responsive: false,
        maintainAspectRatio: false,
        animation: { duration: 400 },
        plugins: {
            legend: { labels: { color: tdTextColor, font: { family: 'Share Tech Mono', size: 13 }, boxWidth: 14, padding: 10 } },
            tooltip: {
                bodyFont: { family: 'Share Tech Mono', size: 13 }, titleFont: { family: 'Share Tech Mono', size: 13 },
                backgroundColor: tdTooltipBg, borderColor: tdTooltipBorder, borderWidth: 1, padding: 7,
                bodyColor: tdTextColor, titleColor: tdTextColor
            },
            zoom: { pan:{enabled:true, mode:'xy'}, zoom:{ wheel:{enabled:true, modifierKey:'ctrl'}, pinch:{enabled:true}, mode:'xy' } }
        },
        scales: {
            x: { type: 'linear', ticks: { color: tdTickColor, font: { family: 'Share Tech Mono', size: 12 }, maxTicksLimit: 8 }, grid: { color: tdGridColor } },
            y: { ticks: { color: tdTickColor, font: { family: 'Share Tech Mono', size: 12 } }, grid: { color: tdGridColor } }
        }
    };
    function axT(txt){ return { display:true, text:txt, color: tdTickColor, font:{family:'Share Tech Mono', size:13} }; }
    function hexToRgba(hex, alpha){
        var h = String(hex).replace('#','');
        if(h.length === 3) h = h.split('').map(c => c + c).join('');
        var r = parseInt(h.substring(0,2),16), g = parseInt(h.substring(2,4),16), b = parseInt(h.substring(4,6),16);
        return 'rgba(' + r + ',' + g + ',' + b + ',' + alpha + ')';
    }

    function mkLine(lbl, data, xdata, color, dash, fillIt){
        return {
            label: lbl,
            data: xdata.map((x,i) => ({x, y: data[i]})),
            borderColor: color,
            backgroundColor: fillIt ? hexToRgba(color, 0.15) : undefined,
            borderWidth: 1.8, pointRadius: 0, fill: fillIt ? 'origin' : false,
            tension: 0.3, borderDash: dash || [], parsing: false, type: 'line'
        };
    }

    // Give a canvas an explicit pixel size (attribute + inline CSS, both
    // required) so Chart.js never needs to measure a possibly-hidden
    // ancestor's layout box.
    function sizeCanvas(canvas, w, h){
        canvas.width = w; canvas.height = h;
        canvas.style.width = w + 'px'; canvas.style.height = h + 'px';
    }

    let tdChartInstances = [];
    function destroyTDCharts(){
        tdChartInstances.forEach(ch => { try{ ch.destroy(); }catch(e){} });
        tdChartInstances = [];
    }

    // =============================================================
    // WELLBORE GEOMETRY + BHA SCHEMATIC — ported from uploadTorqueAndDrag.ejs
    // (see that file for the fuller commentary on the design decisions:
    // bit-driven width ratio, min-max width stretch, equal-height BHA
    // rows, bit-only photo). Reads from currentCasings/currentBha/
    // currentParams (already loaded for the selected well/scenario, and
    // always metric — job.ejs never runs in imperial) instead of live
    // form inputs, since there's no editable T&D form on this page.
    // =============================================================
    function renderTDSchematic(){
        var inner = document.getElementById('tdSchematicInner');
        var wrap = document.getElementById('tdSchematicWrap');
        if(!inner || !wrap) return;
        var casings = currentCasings || [];
        var p = currentParams || {};
        var td_m = p.td;
        if(!casings.length && !(currentBha || []).length || !td_m){ wrap.style.display = 'none'; return; }
        var ohDiam_mm = (p.ohDiam_m || 0) * 1000;
        var ohTop_m = p.ohTop || 0;
        var currentWellKey = wellSelect ? wellSelect.value : null;

        // Display-only BHA: the modeled BHA's cumulative length rarely lands
        // exactly on this well's own TD (which can differ well-to-well).
        // Overshoot (BHA longer than TD, e.g. a full-string model run
        // against a shallower well) is handled by trimming meters off the
        // shallow end (never the bit, which is bha[0] — see the modeler's
        // bit-first ordering): the exceeding length is cut from the
        // shallowest element first; if that element isn't long enough to
        // absorb it, it's dropped entirely and the remainder carries over
        // to the next element in, stopping as soon as the excess reaches
        // zero. No real component's length is ever stretched to cover an
        // overshoot — only trimmed or dropped. A shortfall (BHA doesn't
        // reach surface) is filled by extending the shallowest surviving
        // element, since that's filler pipe rather than a real measured
        // joint. This never touches the saved BHA, only what's drawn.
        function getDisplayBha(bhaArr, tdVal){
            if(!bhaArr || !bhaArr.length) return [];
            var disp = bhaArr.map(function(c){ return Object.assign({}, c); });
            var MIN_LEN = 0.1;
            var total = disp.reduce(function(s, c){ return s + c.len; }, 0);
            if(total > tdVal){
                var excess = total - tdVal;
                while(excess > 0 && disp.length > 1){
                    var lastIdx = disp.length - 1;
                    var lastLen = disp[lastIdx].len;
                    if(excess >= lastLen){
                        disp.pop();
                        excess -= lastLen;
                    } else {
                        disp[lastIdx].len = lastLen - excess;
                        excess = 0;
                    }
                }
                if(excess > 0){
                    // Only the bit is left and it's still longer than TD on
                    // its own — a data problem elsewhere, not something to
                    // paper over further; just floor it so nothing breaks.
                    disp[0].len = Math.max(MIN_LEN, disp[0].len - excess);
                }
            } else if(total < tdVal){
                var delta = tdVal - total;
                disp[disp.length - 1].len += delta;
            }
            return disp;
        }
        var bha = getDisplayBha(currentBha || [], td_m);

        // Inclination-at-MD, interpolated from this well's own computed T&D
        // survey (currentResults.mds / .incArr) — already on hand from the
        // last calculation, so no extra lookup is needed.
        function inclAtMD(md){
            var r = currentResults;
            if(!r || !r.mds || !r.mds.length || !r.incArr || !r.incArr.length) return null;
            var mds = r.mds, incs = r.incArr;
            if(md <= mds[0]) return incs[0];
            if(md >= mds[mds.length - 1]) return incs[incs.length - 1];
            for(var i = 1; i < mds.length; i++){
                if(md <= mds[i]){
                    var m0 = mds[i - 1], m1 = mds[i], i0 = incs[i - 1], i1 = incs[i];
                    if(m1 === m0) return i0;
                    return i0 + (i1 - i0) * (md - m0) / (m1 - m0);
                }
            }
            return incs[incs.length - 1];
        }
        function fmtDI(md){
            var inc = inclAtMD(md);
            return md.toFixed(0) + ' m' + (inc != null ? ', ' + inc.toFixed(1) + '\u00b0' : '');
        }

        var isLight = document.body.classList.contains('light-mode');
        var COL = {
            bg: isLight ? '#ffffff' : '#111820',
            border: isLight ? '#c8d4de' : '#1e2d3d',
            text: isLight ? '#000000' : '#c8d8e8',
            textDim: isLight ? '#495057' : '#5a7080',
            formation: isLight ? 'rgba(180,150,110,.30)' : 'rgba(180,150,110,.18)',
            casing: isLight ? '#9aa5b1' : '#6b7686',
            casingStroke: isLight ? '#5a6472' : '#3a4552',
            pipe: isLight ? '#7a8b9a' : '#5a7080',
            collarStroke: isLight ? '#5a6472' : '#4a5561',
            tick: isLight ? '#495057' : '#5a7080'
        };
        var TYPE_PALETTE = ['#8a95a1', '#5a7080', '#7d9e34', '#d6336c', '#16a085', '#9b59b6', '#e67e22', '#3498db'];
        function hashColor(name){
            var h = 0;
            for (var i = 0; i < name.length; i++) h = (h * 31 + name.charCodeAt(i)) >>> 0;
            return TYPE_PALETTE[h % TYPE_PALETTE.length];
        }
        function componentColor(name){
            var n = (name || '').toLowerCase();
            if (n.indexOf('bit') !== -1) return '#c0392b';
            if (/nmdc|non[-\s]?mag/.test(n)) return '#8e44ad';
            if (n.indexOf('stab') !== -1) return '#d4a017';
            if (n.indexOf('motor') !== -1) return '#16a085';
            if (n.indexOf('underream') !== -1) return '#7d9e34';
            if (n.indexOf('accelerat') !== -1) return '#d6336c';
            if (n.indexOf('heavy weight') !== -1 || n.indexOf('hwdp') !== -1) return '#e67e22';
            if (n.indexOf('collar') !== -1) return '#7a8590';
            if (n.indexOf('drill pipe') !== -1 || /^dp\b/.test(n)) return '#2e86c1';
            if (n.indexOf('sub') !== -1) return '#5a7080';
            return hashColor(n);
        }
        var BIT_ICON_URL = 'https://res.cloudinary.com/metacortexjohn/image/upload/v1665762065/bit-pdc-2-removebg-preview_jqyvef.png';
        function isBit(name){ return /\bbit\b/i.test(name || ''); }
        function bitIconRect(x, y, w, h){
            var minH = Math.max(h, 40);
            var yy = y - (minH - h) / 2;
            return '<image href="' + BIT_ICON_URL + '" xlink:href="' + BIT_ICON_URL + '" x="' + x + '" y="' + yy +
              '" width="' + w + '" height="' + minH + '" preserveAspectRatio="xMidYMid slice"/>';
        }
        function esc(s){ return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;'); }
        function fmtD(md){ return md.toFixed(0) + ' m'; }

        // ---------------- Panel A: full wellbore, true MD scale ----------------
        var pA_h = 620, pA_top = 20, pA_bot = pA_h - 20, pA_cx = 130, pA_maxHalfW = 55;
        var odsForScale = casings.map(function (c) { return c.od_m * 1000; }).concat([ohDiam_mm]).filter(function (v) { return v > 0; });
        var minOD_A = odsForScale.length ? Math.min.apply(null, odsForScale) : 1;
        var maxOD_A = odsForScale.length ? Math.max.apply(null, odsForScale) : 1;
        var A_MIN_FRAC = 0.45;
        function yA(md){ return pA_top + (md / td_m) * (pA_bot - pA_top); }
        function hwA(od_mm){
            if (maxOD_A <= minOD_A) return pA_maxHalfW;
            var frac = A_MIN_FRAC + (1 - A_MIN_FRAC) * (od_mm - minOD_A) / (maxOD_A - minOD_A);
            return Math.max(3, frac * pA_maxHalfW);
        }

        var svgA = '<svg viewBox="0 0 640 ' + pA_h + '" preserveAspectRatio="none" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" style="background:' + COL.bg + ';display:block;">';
        var ohTopY = yA(Math.max(ohTop_m, 0)), ohBotY = yA(td_m), ohHw = hwA(ohDiam_mm);
        svgA += '<rect x="' + (pA_cx - ohHw) + '" y="' + ohTopY + '" width="' + (ohHw * 2) + '" height="' + (ohBotY - ohTopY) + '" fill="' + COL.formation + '" stroke="' + COL.tick + '" stroke-width="1" stroke-dasharray="2,3"/>';
        svgA += '<text x="' + (pA_cx + ohHw + 10) + '" y="' + ((ohTopY + ohBotY) / 2) + '" font-size="11" fill="' + COL.textDim + '" font-family="monospace">Open Hole, ' + ohDiam_mm.toFixed(2) + ' mm</text>';
        var cdMissLogged = false;
        casings.forEach(function (c) {
            var top = yA(c.top), bot = yA(c.shoe), hw = hwA(c.od_m * 1000);
            svgA += '<rect x="' + (pA_cx - hw) + '" y="' + top + '" width="' + (hw * 2) + '" height="' + (bot - top) + '" fill="' + COL.casing + '" stroke="' + COL.casingStroke + '" stroke-width="1.5"/>';
            svgA += '<text x="' + (pA_cx + hw + 10) + '" y="' + (bot - 33) + '" font-size="11" fill="' + COL.text + '" font-family="monospace" font-weight="bold">' + esc(c.name) + '</text>';
            svgA += '<text x="' + (pA_cx + hw + 10) + '" y="' + (bot - 20) + '" font-size="10" fill="' + COL.textDim + '" font-family="monospace">OD ' + (c.od_m * 1000).toFixed(2) + ' mm, ID ' + (c.id_m * 1000).toFixed(2) + ' mm</text>';
            // Grade / weight / thread — from the Casing Design module (the
            // source of truth for this info; the T&D casing table itself
            // only stores OD/ID/top/shoe). Only shown once loaded/matched.
            var cdInfo = casingDesignInfoFor(currentWellKey, c.name);
            if(cdInfo){
                var gwt = [
                    cdInfo.grade || null,
                    (cdInfo.weight_kgpm != null && !isNaN(cdInfo.weight_kgpm) ? Number(cdInfo.weight_kgpm).toFixed(1) + ' kg/m' : null),
                    cdInfo.thread || null
                ].filter(function (v) { return v; }).join(', ');
                if(gwt) svgA += '<text x="' + (pA_cx + hw + 10) + '" y="' + (bot - 7) + '" font-size="10" fill="' + COL.textDim + '" font-family="monospace">' + esc(gwt) + '</text>';
            } else if(!cdMissLogged){
                cdMissLogged = true;
                console.log('[T&D] No Casing Design match for well "' + currentWellKey + '" casing "' + c.name +
                    '" — check the Casing Design module has a string with that exact name saved for this well.');
            }
            [c.top, c.shoe].forEach(function (md) {
                var y = yA(md);
                svgA += '<line x1="8" y1="' + y + '" x2="' + (pA_cx - hw) + '" y2="' + y + '" stroke="' + COL.tick + '" stroke-width="1" stroke-dasharray="1,2"/>';
                svgA += '<text x="4" y="' + (y + 3) + '" font-size="9" fill="' + COL.textDim + '" font-family="monospace" text-anchor="start">' + fmtD(md) + '</text>';
            });
        });
        var bhaTop_m = td_m;
        bha.forEach(function (c) { bhaTop_m -= c.len; });
        if (bhaTop_m > 0) {
            var dpTopY = yA(0), dpBotY = yA(bhaTop_m);
            svgA += '<rect x="' + (pA_cx - 5) + '" y="' + dpTopY + '" width="10" height="' + (dpBotY - dpTopY) + '" fill="' + COL.pipe + '" stroke="' + COL.casingStroke + '" stroke-width="1"/>';
        }
        [0, td_m].forEach(function (md) {
            var y = yA(md);
            svgA += '<line x1="8" y1="' + y + '" x2="' + pA_cx + '" y2="' + y + '" stroke="' + COL.tick + '" stroke-width="1"/>';
            svgA += '<text x="4" y="' + (y + 3) + '" font-size="9" fill="' + COL.text + '" font-family="monospace" font-weight="bold">' + fmtD(md) + '</text>';
        });
        svgA += '</svg>';

        // ---------------- Panel B: BHA detail, equal-height rows ----------------
        var svgB = '';
        if (bha.length) {
            // pB_cx pushed right (was 50) to leave room for the tick labels,
            // which now carry "MD, inclination°" (longer than plain MD) —
            // at the old position that text ran directly into the component
            // boxes and was unreadable.
            var pB_top = 20, pB_cx = 120, pB_maxHalfW = 15;
            var OTHER_ROW_H = 50;
            var maxOD_B = bha.reduce(function (m, c) { return Math.max(m, c.od_m * 1000); }, 1);
            function hwB(od_mm){ return Math.max(4, (od_mm / maxOD_B) * pB_maxHalfW); }
            var bitEntry = bha.filter(function (c) { return isBit(c.name); })[0] || bha[0];
            var baseBitHw = hwB(bitEntry.od_m * 1000);
            var otherHw = baseBitHw * 0.75 * 0.8;
            var bitHw = baseBitHw * 1.2 * 1.2;
            var BIT_ROW_H = Math.max(40, bitHw * 1.9);

            var cursor = td_m;
            var withMD = bha.map(function (c) {
                var bot = cursor, top = cursor - c.len; cursor = top;
                return { c: c, top: top, bot: bot };
            });
            var bhaTopMD = cursor;
            var stack = withMD.slice().reverse();
            var pB_h = pB_top + stack.reduce(function (h, r) { return h + (isBit(r.c.name) ? BIT_ROW_H : OTHER_ROW_H); }, 0) + 20;

            svgB = '<svg viewBox="0 0 640 ' + pB_h + '" preserveAspectRatio="none" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" style="background:' + COL.bg + ';display:block;">';
            svgB += '<line x1="8" y1="' + pB_top + '" x2="' + pB_cx + '" y2="' + pB_top + '" stroke="' + COL.tick + '" stroke-width="1"/>';
            svgB += '<text x="4" y="' + (pB_top + 3) + '" font-size="9" fill="' + COL.text + '" font-family="monospace" font-weight="bold">' + fmtDI(bhaTopMD) + '</text>';

            var y = pB_top;
            stack.forEach(function (r) {
                var c = r.c, bit = isBit(c.name);
                var rowH = bit ? BIT_ROW_H : OTHER_ROW_H;
                var yTop = y, yBot = y + rowH;
                var hw = bit ? bitHw : otherHw;
                var fill = bit ? 'none' : componentColor(c.name);
                svgB += '<rect x="' + (pB_cx - hw) + '" y="' + yTop + '" width="' + (hw * 2) + '" height="' + rowH + '" fill="' + fill + '"' + (bit ? '' : ' stroke="' + COL.collarStroke + '" stroke-width="1"') + '/>';
                if (bit) svgB += bitIconRect(pB_cx - hw, yTop, hw * 2, rowH);
                svgB += '<text x="' + (pB_cx + hw + 10) + '" y="' + ((yTop + yBot) / 2 - 4) + '" font-size="11" fill="' + COL.text + '" font-family="monospace" font-weight="bold">' + esc(c.name) + '</text>';
                svgB += '<text x="' + (pB_cx + hw + 10) + '" y="' + ((yTop + yBot) / 2 + 9) + '" font-size="10" fill="' + COL.textDim + '" font-family="monospace">OD ' + (c.od_m * 1000).toFixed(2) + ' mm, ID ' + (c.id_m * 1000).toFixed(2) + ' mm, ' + c.wt.toFixed(2) + ' kg/m</text>';
                svgB += '<line x1="8" y1="' + yBot + '" x2="' + (pB_cx - hw) + '" y2="' + yBot + '" stroke="' + COL.tick + '" stroke-width="1" stroke-dasharray="1,2"/>';
                svgB += '<text x="4" y="' + (yBot + 3) + '" font-size="9" fill="' + COL.textDim + '" font-family="monospace">' + fmtDI(r.bot) + '</text>';
                y = yBot;
            });
            svgB += '</svg>';
        }

        // Both containers share the taller panel's height, with the shorter
        // SVG centered inside its own box — so a BHA with few components
        // (short SVG) doesn't look like it's floating at a different height
        // than the always-620px full wellbore panel next to it.
        var sharedH = Math.max(pA_h, svgB ? pB_h : 0);
        inner.innerHTML =
            '<div style="width:640px;">' +
              '<div class="hint" style="margin-bottom:4px;font-weight:bold;color:' + COL.textDim + ';font-size:11px;">Full Wellbore (true scale)</div>' +
              '<div style="width:640px;height:' + sharedH + 'px;">' + svgA + '</div>' +
            '</div>' +
            (svgB ? '<div style="width:640px;">' +
              '<div class="hint" style="margin-bottom:4px;font-weight:bold;color:' + COL.textDim + ';font-size:11px;">BHA Detail</div>' +
              '<div style="width:640px;height:' + sharedH + 'px;">' + svgB + '</div>' +
            '</div>' : '');
        wrap.style.display = '';
    }

