                                            <input class="form-check-input" type="checkbox" id="padACfRefMD" checked>
                                            <label class="form-check-label" for="padACfRefMD">Hide: Ref.MD &lt; 100</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="padACfE2E" checked>
                                            <label class="form-check-label" for="padACfE2E">E2E empty</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="padACfProb">
                                            <label class="form-check-label" for="padACfProb">Prob &lt; 1 in 1E+9</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="padACfDup" checked>
                                            <label class="form-check-label" for="padACfDup">Hide duplicates</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="padACfAND">
                                            <label class="form-check-label" for="padACfAND">Show only: C2C&lt;15 AND SF&lt;1</label>
                                        </div>
                                    </div>

                                    <!-- Row 3: exports + delete + reset + status -->
                                    <div class="d-flex flex-wrap gap-2 mt-2 align-items-center">
                                        <button id="padACCsvBtn" class="btn btn-outline-light btn-sm" disabled>⬇ CSV</button>
                                        <button id="padACXlsxBtn" class="btn btn-outline-light btn-sm" disabled>⬇ Excel</button>
                                        <button id="padACSelectSiteBtn" class="btn btn-outline-info btn-sm" disabled title="Select all rows sharing the same site as currently checked rows">🎯 Select Same Site</button>
                                        <button id="padACLateralBtn" class="btn btn-outline-info btn-sm" disabled title="Select rows where Ref. Well inclination at Ref. MD is > 88°">📐 All in Lateral</button>
                                        <button id="padACDupMDBtn" class="btn btn-outline-info btn-sm" disabled title="Select all rows with a duplicated Ref. MD value">🔁 Same Ref.MD</button>
                                        <button id="padACDeleteBtn" class="btn btn-outline-danger btn-sm" disabled>🗑 Delete Selected</button>
                                        <button id="padACResetBtn" class="btn btn-outline-warning btn-sm">↺ Reset</button>
