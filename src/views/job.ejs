                if(!isFinite(cl1) || !isFinite(cl2) || x[2] < 0) continue;
                if(cl1 > 1e-6) out.push({ kind: 'direct', inc: x[0], az: x[1], cl: cl1 });
                if(x[2] > 1e-6) out.push({ kind: 'hold', cl: x[2] });
                if(cl2 > 1e-6) out.push({ kind: 'direct', inc: incT, az: azT, cl: cl2 });
