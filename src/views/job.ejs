<!-- ================= BATCH DAYS (Gantt stretch, admin only) ================= -->
<% if (user.role === 'admin') { %>
<div class="card bg-secondary border-0 mb-2 p-2" style="max-width:420px;">
    <label class="form-label mb-1" style="font-size:11px;color:var(--an-text-bright,#e8f4ff);font-family:monospace;">
        📊 Gantt — Batch Days
    </label>
    <div class="d-flex align-items-center gap-2">
        <input id="batchDaysInput" type="number" min="0" step="1"
               class="form-control form-control-sm" style="width:100px;"
               value="<%= note.batchDays || 0 %>">
        <button id="batchDaysSaveBtn" class="btn btn-sm btn-success">💾 Save</button>
        <span id="batchDaysStatus" style="font-size:11px;color:#00c8ff;font-family:monospace;"></span>
    </div>
    <div style="font-size:10px;color:var(--an-text-dim,#aaa);margin-top:4px;">
        Stretches the first (earliest) Gantt bar for this job's pad backward by this many days.
        End date stays the same.
    </div>
</div>
<script>
(function(){
    const input  = document.getElementById('batchDaysInput');
    const btn    = document.getElementById('batchDaysSaveBtn');
    const status = document.getElementById('batchDaysStatus');
    if (!btn) return;
    btn.addEventListener('click', async () => {
        const days = Number(input.value);
        if (isNaN(days) || days < 0) {
            status.textContent = '⚠ Enter a non-negative number.';
            return;
        }
        status.textContent = 'Saving…';
        btn.disabled = true;
        try {
            const res = await fetch('/notes/batchDays/<%- note._id %>', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ batchDays: days }),
            });
            const data = await res.json();
            if (res.ok) {
                status.textContent = '✅ Saved (' + data.batchDays + ' days).';
            } else {
                status.textContent = '❌ ' + (data.error || res.statusText);
            }
        } catch(e) {
            status.textContent = '❌ ' + e.message;
        }
        btn.disabled = false;
    });
})();
</script>
<% } %>
