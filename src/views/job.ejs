                                       class="btn btn-sm btn-outline-info">🔧 Open in Torque &amp; Drag Modeler</a>
                                    <% } %>
                                </div>
                                <div id="tdEmptyMsg" style="color:var(--an-text-dim,#5a7080);font-size:12px;font-family:monospace;padding:8px;display:none;">
                                    No Torque &amp; Drag model saved yet for this job.
                                </div>
                                <div id="tdSchematicWrap" style="display:none;overflow-x:auto;margin-bottom:1rem;">
                                    <div class="td-chart-title" style="font-size:15px;margin-bottom:6px;">Wellbore Geometry &amp; BHA</div>
