                q('[data-k=pt]').innerHTML = `Inc ${f(P.inc,2)}° · Az ${f(P.az,2)}° · TVD ${f(P.tvd,2)} · SS ${f(P.ss,2)}<br>N ${f(P.n,2)} · E ${f(P.e,2)}`;
                const o = [0, 1, 2].map(i => parseFloat(q(`[data-o="${i}"]`).value) || 0), R = Math.PI / 180;
                let dN, dE, dD;
