<%- include ('partials/header.ejs') %>

<%# 2026-11-28 (John): sign-in page simplified for SPEED and readability on PC and phone.
     Removed: the full-screen background video (1080p MP4 from video.wixstatic.com, ~2 MB, autoplay/loop) and its poster image from
     static.wixstatic.com — both were downloaded before the page settled. Now: plain black background, one centred column
     (max 420 px on PC, full width with 16 px margins on phone), banner limited in height so the form is visible without scrolling,
     16 px inputs (no iOS zoom on focus) and 44 px tap targets. Form fields, names and the POST to /users/signin are unchanged. %>
<style>
    html, body { background-color: #000 !important; }
    .signin-page { min-height: 100vh; min-height: 100dvh; display: flex; align-items: center; justify-content: center; padding: 16px; }
    .signin-box { width: 100%; max-width: 420px; text-align: center; }
    .signin-box h4 { color: #e9ecef; margin: 0 0 12px; font-weight: 600; }
    .signin-banner { display: block; margin: 0 auto 16px; width: 100%; max-width: 420px; height: auto; max-height: 42vh; object-fit: contain; }
    .signin-box .form-control { font-size: 16px; min-height: 44px; margin-bottom: 10px; }
    .signin-box .btn { font-size: 16px; min-height: 44px; width: 100%; }
    .signin-box a { display: inline-block; margin-top: 12px; font-size: 14px; color: #aaa; padding: 6px; }
</style>

<div class="signin-page">
    <div class="signin-box">
        <h4>Account Login</h4>
        <img src="<%= bannerUrl %>" class="signin-banner" alt="PlanIT" decoding="async" fetchpriority="high">
        <form action="/users/signin" method="post">
            <input type="email" class="form-control" name="email" placeholder="Email" autocomplete="username" required>
            <input type="password" class="form-control" name="password" placeholder="Password" autocomplete="current-password" required>
            <button class="btn btn-success">OK</button>
        </form>
        <a href="/users/forgot-password">Forgot password?</a>
    </div>
</div>

<%- include ('partials/footer.ejs') %>
